#Q#CREATE PARTITION FUNCTION IntPartitionFunction (int)
AS RANGE RIGHT FOR VALUES (0, 1000, 500);

#Q#CREATE PARTITION FUNCTION BigIntPartitionFunction (sys.bigint)
AS RANGE RIGHT FOR VALUES (0, 10000, 100, 1000);

#Q#CREATE PARTITION FUNCTION SmallIntPartitionFunction (smallint)
AS RANGE RIGHT FOR VALUES (cast(32767 as bigint), -32768, 0);

#Q#CREATE PARTITION FUNCTION TinyIntPartitionFunction (sys.tinyint)
AS RANGE RIGHT FOR VALUES (0, cast(255 as varchar), 128);

#Q#CREATE PARTITION FUNCTION DecimalPartitionFunction (decimal(10, 5))
AS RANGE RIGHT FOR VALUES (0.0, 300.0, 200.0, 100.0);

#Q#CREATE PARTITION FUNCTION NumericPartitionFunction (numeric(5, 2))
AS RANGE RIGHT FOR VALUES (0.0, 30.0, 10.0, 20.0);

#Q#CREATE PARTITION FUNCTION MoneyPartitionFunction (MONEY)
AS RANGE RIGHT FOR VALUES ($2.56789, ¥4.91, $3.56789);

#Q#CREATE PARTITION FUNCTION SmallMoneyPartitionFunction (SMALLMONEY)
AS RANGE RIGHT FOR VALUES ($2.56789, ¥4.91, $3.56789);

#Q#CREATE PARTITION FUNCTION DatePartitionFunction (date)
AS RANGE RIGHT FOR VALUES ('2022-07-01', '2022-01-01','2023-01-01');

#Q#CREATE PARTITION FUNCTION DateTimePartitionFunction (datetime)
AS RANGE RIGHT FOR VALUES ('2022-01-01', '2022-07-01 00:00:00', '2019-01-01 00:00:00');

#Q#CREATE PARTITION FUNCTION DateTime2PartitionFunction (datetime2(3))
AS RANGE RIGHT FOR VALUES ('2022-01-01 00:00:00.000', '2022-07-01 00:00:00.000', '2019-01-01 00:00:00.000');

#Q#CREATE PARTITION FUNCTION SmallDateTimePartitionFunction (smalldatetime)
AS RANGE RIGHT FOR VALUES ('2022-01-01', '2022-07-01', '2019-01-01');

#Q#CREATE PARTITION FUNCTION CharPartitionFunction (char(5))
AS RANGE RIGHT FOR VALUES ('A', 'F', 'K', 'P', 'U', 'Z', 'D');

#Q#CREATE PARTITION FUNCTION VarCharPartitionFunction (varchar(10))
AS RANGE RIGHT FOR VALUES ('Apple', 'Banana', 'Mango', 'Cherry', 'Date');

#Q#CREATE PARTITION FUNCTION NVarCharPartitionFunction (nvarchar(10))
AS RANGE RIGHT FOR VALUES (N'Apple', N'Banana', N'Mango', N'Cherry', N'Date');

#Q#CREATE PARTITION FUNCTION NCharPartitionFunction (nchar(5))
AS RANGE RIGHT FOR VALUES (N'A', N'F', N'K', N'P', N'U', N'Z', N'B');

#Q#CREATE PARTITION FUNCTION BinaryPartitionFunction (binary(4))
AS RANGE RIGHT FOR VALUES (0x000, 0x800, 0x400, 0xC000);

#Q#CREATE PARTITION FUNCTION VarBinaryPartitionFunction (varbinary(8))
AS RANGE RIGHT FOR VALUES (0x0000000000000000, 0x8000000000000000, 0x4000000000000000, 0xC000000000000000);

#Q#CREATE PARTITION FUNCTION UniqueIdentifierPartitionFunction (uniqueidentifier)
AS RANGE RIGHT FOR VALUES ('00000000-0000-0000-0000-000000000000', 'FFFFFFFF-FFFF-FFFF-FFFF-FFFFFFFFFFFF', '6F9619FF-8B86-D011-B42D-00C04FC964FF');

#Q#CREATE PARTITION FUNCTION PartitionFunctionNameGreaterThan64AndLessThan128abcdefghijklmnopqrstuvwxyz (bigint)
AS RANGE RIGHT FOR VALUES (0, 10000, 100, 1000);

#Q#CREATE PARTITION FUNCTION PartitionFunctionNameGreaterThan64AndLessThan128HavingEmoji😎$123🌍rder (bigint)
AS RANGE RIGHT FOR VALUES (0, 10000, 100, 1000);

#Q#CREATE PARTITION FUNCTION PartitionFunctionHavingDifferentCollationInput (NVARCHAR(50))
AS RANGE RIGHT
FOR VALUES (
    N'John Doe',
    N'Jane Smith' COLLATE Latin1_General_CI_AS,
    N'châu phố' COLLATE Vietnamese_CI_AS,
    N'Müller GmbH' COLLATE Traditional_Spanish_CI_AS
);

#Q#CREATE PARTITION SCHEME IntPartitionScheme AS
PARTITION IntPartitionFunction
TO ([PRIMARY], [PRIMARY], [PRIMARY], [PRIMARY]);

