-- tsql
-- FOR SAME-TYPE BINARY OPERATORS
-- Equality operator
SELECT COUNT(*) as result FROM BABEL_6098_binary_test 
WHERE binary_col = CAST(0x01 AS BINARY(10));
GO
~~START~~
int
3
~~END~~


-- Not equal operator
SELECT COUNT(*) as result FROM BABEL_6098_binary_test 
WHERE binary_col <> CAST(0x05 AS BINARY(10));
GO
