-- psql
-- Verify owner/auth/dependency metadata is created through core dblink path
SELECT (SELECT COUNT(*) FROM pg_dblink l JOIN pg_roles r ON l.dblowner = r.oid WHERE l.dblname = 'mssql_server' AND r.rolname = current_user) AS owner_matches_current_user,
             (SELECT COUNT(*) FROM pg_dblink WHERE dblname = 'mssql_server' AND dblauth = 'c') AS authmode_current_user,
             (SELECT COUNT(*) FROM pg_depend d
                        JOIN pg_foreign_server s ON d.classid = 'pg_foreign_server'::regclass AND d.objid = s.oid
                        JOIN pg_dblink l ON d.refclassid = 'pg_dblink'::regclass AND d.refobjid = l.oid
                    WHERE l.dblname = 'mssql_server' AND s.srvname = 'mssql_server' AND d.deptype = 'i') AS server_internal_dep_count
GO
~~START~~
int8#!#int8#!#int8
0#!#1#!#1
~~END~~


-- psql
-- Verify SQL Server-style host,port endpoint is normalized into foreign-server options
SELECT (SELECT COUNT(*)
                            FROM pg_foreign_server s,
                                     LATERAL pg_options_to_table(s.srvoptions) AS o
                         WHERE s.srvname = 'mssql_server5'
                             AND o.option_name = 'servername'
                             AND o.option_value = 'localhost') AS host_option_rows,
                         (SELECT COUNT(*)
                                FROM pg_foreign_server s,
                                         LATERAL pg_options_to_table(s.srvoptions) AS o
                             WHERE s.srvname = 'mssql_server5'
                                 AND o.option_name = 'port'
                             AND o.option_value = '11433') AS port_option_rows,
                         (SELECT COUNT(*)
                                FROM pg_foreign_server s,
                                         LATERAL pg_options_to_table(s.srvoptions) AS o
                             WHERE s.srvname = 'mssql_server5'
                                 AND o.option_name = 'servername'
                             AND o.option_value = 'localhost,11433') AS unsplit_servername_rows,
                         (SELECT COUNT(*) FROM pg_foreign_server WHERE srvname = 'mssql_server6') AS invalid_endpoint_server_rows
GO
~~START~~
int8#!#int8#!#int8#!#int8
1#!#1#!#0#!#0
~~END~~


-- tsql user=linked_server_login_861 password=password_861
-- Non-owner should not be able to alter/drop linked server dblink metadata
EXEC sp_serveroption @server='mssql_server1', @optname='query timeout', @optvalue='9'
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: must be owner of database link "mssql_server1")~~


EXEC sp_dropserver @server = 'mssql_server1', @droplogins = 'droplogins'
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: must be owner of database link "mssql_server1")~~


-- psql
-- Verify failed synchronization does not persist partial pg_dblink changes
SELECT (SELECT COUNT(*) FROM pg_dblink WHERE dblname = 'mssql_server1') AS dblink_rows_after_failed_sync,
             (SELECT COUNT(*) FROM pg_depend d
                        JOIN pg_foreign_server s ON d.classid = 'pg_foreign_server'::regclass AND d.objid = s.oid
                        JOIN pg_dblink l ON d.refclassid = 'pg_dblink'::regclass AND d.refobjid = l.oid
                    WHERE l.dblname = 'mssql_server1' AND s.srvname = 'mssql_server1' AND d.deptype = 'i') AS server_dep_rows_after_failed_sync,
             (SELECT COUNT(*) FROM pg_dblink l,
                     LATERAL pg_options_to_table(l.dbloptions) AS o
                 WHERE l.dblname = 'mssql_server1' AND o.option_name = 'query_timeout' AND o.option_value = '9') AS failed_option_update_rows
GO
~~START~~
int8#!#int8#!#int8
1#!#1#!#0
~~END~~


