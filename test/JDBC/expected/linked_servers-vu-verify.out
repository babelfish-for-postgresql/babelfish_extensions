-- psql
-- Plain PostgreSQL foreign servers that are not backed by pg_dblink should remain directly droppable
CREATE SERVER plain_pg_server FOREIGN DATA WRAPPER tds_fdw OPTIONS (servername 'localhost', database 'master')
GO

DROP SERVER plain_pg_server
GO

SELECT COUNT(*) AS plain_server_rows FROM pg_foreign_server WHERE srvname = 'plain_pg_server'
GO
~~START~~
int8
0
~~END~~


