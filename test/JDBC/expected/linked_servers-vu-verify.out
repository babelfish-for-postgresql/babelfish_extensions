-- psql
-- Verify dblink row and dependency are removed through core drop path
SELECT (SELECT COUNT(*) FROM pg_dblink WHERE dblname = 'mssql_server') AS dblink_rows,
             (SELECT COUNT(*) FROM pg_foreign_server WHERE srvname = 'mssql_server') AS server_rows,
             (SELECT COUNT(*) FROM pg_user_mapping m
                        JOIN pg_foreign_server s ON m.umserver = s.oid
                    WHERE s.srvname = 'mssql_server') AS mapping_rows,
             (SELECT COUNT(*) FROM pg_depend d
                        JOIN pg_foreign_server s ON d.classid = 'pg_foreign_server'::regclass AND d.objid = s.oid
                    WHERE d.refclassid = 'pg_dblink'::regclass AND s.srvname = 'mssql_server') AS dangling_server_dep_rows
GO
~~START~~
int8#!#int8#!#int8#!#int8
0#!#0#!#0#!#0
~~END~~


