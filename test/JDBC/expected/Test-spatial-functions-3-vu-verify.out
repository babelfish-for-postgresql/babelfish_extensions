-- =============================================
-- CASE STATEMENT
-- =============================================
SELECT ID,
    CASE
        WHEN GeomData.MakeValid().STArea() > 50 THEN 'Large'
        WHEN GeomData.MakeValid().STArea() > 0 THEN 'Small'
        ELSE 'No Area'
    END AS SizeCategory
FROM TestSpatialFunc3_GeomMetrics
WHERE GeomData IS NOT NULL
ORDER BY ID;
