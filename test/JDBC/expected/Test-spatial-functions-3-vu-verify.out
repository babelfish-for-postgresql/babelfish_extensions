-- Nested functions test
SELECT ID, geom_type,
       ABS(geom.STNumPoints() - 5) AS diff_from_5,
       COALESCE(NULLIF(geom.STNumPoints(), 0), -1) AS pts_or_neg1
FROM STNumPoints_geom_test
ORDER BY ID;
