        WHEN 2 THEN 1
        WHEN 3 THEN 2
        WHEN 4 THEN 3
        WHEN 5 THEN 5
        WHEN 6 THEN 4
        WHEN 7 THEN 5
        WHEN 8 THEN 0
        WHEN 9 THEN 0
        WHEN 10 THEN 1     
        WHEN 11 THEN 0     
        WHEN 12 THEN 0     
    END AS expected_result
FROM STNumPoints_geog_test
ORDER BY ID;
