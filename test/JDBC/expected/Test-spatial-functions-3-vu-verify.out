--  JOIN on ID
SELECT g.ID, g.GeomColumn.STGeometryType() AS GeomType,
       geo.GeogColumn.STGeometryType() AS GeogType
FROM TestGeospatialMethods3_STGeometryType_GEOM_db g
JOIN TestGeospatialMethods3_STGeometryType_GEOG_db geo ON g.ID = geo.ID
ORDER BY g.ID;
go
~~START~~
int#!#nvarchar#!#nvarchar
1#!#Point#!#Point
2#!#LineString#!#LineString
3#!#Polygon#!#Polygon
4#!#Point#!#Point
5#!#LineString#!#LineString
6#!#Polygon#!#Polygon
7#!#Point#!#Point
8#!#Point#!#Point
~~END~~


--  JOIN on STGeometryType match
SELECT g.ID AS GeomID, geo.ID AS GeogID,
       g.GeomColumn.STGeometryType() AS MatchedType
FROM TestGeospatialMethods3_STGeometryType_GEOM_db g
JOIN TestGeospatialMethods3_STGeometryType_GEOG_db geo
  ON g.GeomColumn.STGeometryType() = geo.GeogColumn.STGeometryType()
ORDER BY g.ID, geo.ID;
go
~~START~~
int#!#int#!#nvarchar
1#!#1#!#Point
1#!#4#!#Point
1#!#7#!#Point
1#!#8#!#Point
2#!#2#!#LineString
2#!#5#!#LineString
3#!#3#!#Polygon
3#!#6#!#Polygon
4#!#1#!#Point
4#!#4#!#Point
4#!#7#!#Point
4#!#8#!#Point
5#!#2#!#LineString
5#!#5#!#LineString
6#!#3#!#Polygon
6#!#6#!#Polygon
7#!#1#!#Point
7#!#4#!#Point
7#!#7#!#Point
7#!#8#!#Point
8#!#1#!#Point
8#!#4#!#Point
8#!#7#!#Point
8#!#8#!#Point
~~END~~


