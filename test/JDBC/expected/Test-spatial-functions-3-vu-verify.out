
--Parse functions test 
-- geometry::Parse with POINT
DECLARE @geomText NVARCHAR(MAX);
SET @geomText = 'POINT(1.0 2.0)';
SELECT geometry::Parse(@geomText).STAsText() AS ParsedGeometry;
go
~~START~~
nvarchar
POINT(1 2)
~~END~~


