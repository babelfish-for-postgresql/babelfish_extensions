--  CTE Combined
WITH GeomCTE AS (
    SELECT ID, GeomColumn.STGeometryType() AS GeomType
    FROM TestGeospatialMethods3_STGeometryType_GEOM_db
),
GeogCTE AS (
    SELECT ID, GeogColumn.STGeometryType() AS GeogType
    FROM TestGeospatialMethods3_STGeometryType_GEOG_db
)
SELECT g.ID, g.GeomType, gg.GeogType
FROM GeomCTE g
JOIN GeogCTE gg ON g.ID = gg.ID
ORDER BY g.ID;
go
~~START~~
int#!#nvarchar#!#nvarchar
1#!#Point#!#Point
2#!#LineString#!#LineString
3#!#Polygon#!#Polygon
4#!#Point#!#Point
5#!#LineString#!#LineString
6#!#Polygon#!#Polygon
7#!#Point#!#Point
8#!#Point#!#Point
~~END~~


--  Window ROW_NUMBER - Geometry
SELECT ID, GeomColumn.STGeometryType() AS GeomType,
       ROW_NUMBER() OVER (ORDER BY GeomColumn.STGeometryType()) AS RowNum
FROM TestGeospatialMethods3_STGeometryType_GEOM_db
ORDER BY RowNum;
go
~~START~~
int#!#nvarchar#!#bigint
5#!#LineString#!#1
2#!#LineString#!#2
8#!#Point#!#3
4#!#Point#!#4
7#!#Point#!#5
1#!#Point#!#6
3#!#Polygon#!#7
6#!#Polygon#!#8
~~END~~


--  Window COUNT PARTITION - Geometry
SELECT ID, GeomColumn.STGeometryType() AS GeomType,
       COUNT(*) OVER (PARTITION BY GeomColumn.STGeometryType()) AS TypeCount
FROM TestGeospatialMethods3_STGeometryType_GEOM_db
ORDER BY ID;
go
~~START~~
int#!#nvarchar#!#int
1#!#Point#!#4
2#!#LineString#!#2
3#!#Polygon#!#2
4#!#Point#!#4
5#!#LineString#!#2
6#!#Polygon#!#2
7#!#Point#!#4
8#!#Point#!#4
~~END~~


--  Window LAG/LEAD - Geography
SELECT ID, GeogColumn.STGeometryType() AS GeogType,
       LAG(GeogColumn.STGeometryType()) OVER (ORDER BY ID) AS PrevType,
       LEAD(GeogColumn.STGeometryType()) OVER (ORDER BY ID) AS NextType
FROM TestGeospatialMethods3_STGeometryType_GEOG_db
ORDER BY ID;
go
~~START~~
int#!#nvarchar#!#nvarchar#!#nvarchar
1#!#Point#!#<NULL>#!#LineString
2#!#LineString#!#Point#!#Polygon
3#!#Polygon#!#LineString#!#Point
4#!#Point#!#Polygon#!#LineString
5#!#LineString#!#Point#!#Polygon
6#!#Polygon#!#LineString#!#Point
7#!#Point#!#Polygon#!#Point
8#!#Point#!#Point#!#<NULL>
~~END~~


--  Subquery - Geometry
SELECT * FROM (
    SELECT ID, GeomColumn.STGeometryType() AS GeomType
    FROM TestGeospatialMethods3_STGeometryType_GEOM_db
) AS Sub
WHERE GeomType = 'Polygon'
ORDER BY ID;
go
