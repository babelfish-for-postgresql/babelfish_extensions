-- sp_helpuser/helprole/helprolemember in long-named database
USE Very_Long_Database_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_VU;
GO
DECLARE @t1 TABLE(userName sys.SYSNAME, roleName sys.SYSNAME, loginName sys.SYSNAME NULL, defdb sys.SYSNAME NULL, defschema sys.SYSNAME, userid INT, sid sys.VARBINARY(85));
INSERT INTO @t1 EXEC sp_helpuser;
SELECT userName, roleName, loginName, defdb, defschema FROM @t1 ORDER BY userName;
GO
~~ROW COUNT: 2~~

~~START~~
varchar#!#varchar#!#varchar#!#varchar#!#varchar
dbo#!#db_owner#!#jdbc_user#!#<NULL>#!#dbo
guest#!#public#!#<NULL>#!#<NULL>#!#guest
~~END~~

DECLARE @t2 TABLE(RoleName sys.SYSNAME, RoleId INT, IsAppRole INT);
INSERT INTO @t2 EXEC sp_helprole;
SELECT RoleName, IsAppRole FROM @t2 ORDER BY RoleName;
GO
~~ROW COUNT: 6~~

~~START~~
varchar#!#int
db_accessadmin#!#0
db_datareader#!#0
db_datawriter#!#0
db_ddladmin#!#0
db_owner#!#0
db_securityadmin#!#0
~~END~~

DECLARE @t3 TABLE(DbRole sys.SYSNAME, MemberName sys.SYSNAME, MemberSID sys.VARBINARY(85));
INSERT INTO @t3 EXEC sp_helprolemember;
SELECT DbRole, MemberName FROM @t3 ORDER BY DbRole, MemberName;
GO
~~ROW COUNT: 1~~

~~START~~
varchar#!#varchar
db_owner#!#dbo
