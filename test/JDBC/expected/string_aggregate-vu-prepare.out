INSERT INTO babel_5688_all_types (col_nchar, col_char, col_nvarchar, col_varchar, col_category, col_amount) VALUES 
(NULL, NULL, NULL, NULL, 'NullTest', 0)
GO
~~ROW COUNT: 1~~



