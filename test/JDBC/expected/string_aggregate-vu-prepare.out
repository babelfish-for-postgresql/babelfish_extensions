-- COALESCE/ISNULL 
CREATE TABLE babel_5688_table2 (col1_nchar NCHAR(20), col1_char CHAR(20));
GO

INSERT INTO babel_5688_table2 (col1_nchar, col1_char) VALUES 
('Apple', NULL), 
(NULL, 'Banana'), 
('Cherry', 'Date'),
(NULL, NULL);
GO
~~ROW COUNT: 4~~



