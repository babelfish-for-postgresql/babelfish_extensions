BEGIN TRANSACTION;
EXEC ls_svr.master.dbo.rp_txn_insert @tag=5001;
COMMIT TRANSACTION;
SELECT COUNT(*) AS count_after_local_commit
FROM dbo.rp_txn_log
WHERE tag = 5001;
GO
~~START~~
text
1
~~END~~

~~START~~
int
1
~~END~~


BEGIN TRANSACTION;
EXEC ls_svr.master.dbo.rp_txn_insert @tag=5002;
ROLLBACK TRANSACTION;
SELECT COUNT(*) AS count_after_local_rollback
FROM dbo.rp_txn_log
WHERE tag = 5002;
GO
~~START~~
text
1
~~END~~

~~START~~
int
1
~~END~~


