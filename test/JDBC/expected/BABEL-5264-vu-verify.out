-- UDF calling temp table functions
CREATE FUNCTION dbo.babel5264_test_func(@tablename varchar(256))
RETURNS TABLE
AS
RETURN (SELECT * FROM sys.sp_tablecollations_100_enr(@tablename))
GO

CREATE TABLE #funcTest(col1 varchar(50) COLLATE SQL_Latin1_General_CP1_CI_AS)
GO

SELECT * FROM dbo.babel5264_test_func('#funcTest')
GO
~~START~~
int#!#varchar#!#nvarchar
1#!#col1#!#bbf_unicode_cp1_ci_as
~~END~~


DROP TABLE #funcTest
GO

DROP FUNCTION dbo.babel5264_test_func
GO

-- psql
-- PG dialect on non-TDS connection (should return empty)
SELECT * FROM sys.sp_tablecollations_100_enr('#nonexistent_temp');
GO
~~START~~
int4#!#"sys"."varchar"#!#"sys"."varchar"
~~END~~


SELECT COUNT(*) AS attr_count FROM sys.babelfish_get_temp_table_attributes('#nonexistent_temp');
GO
~~START~~
int8
0
~~END~~


SELECT * FROM sys.sp_tablecollations_100_enr(NULL);
GO
~~START~~
int4#!#"sys"."varchar"#!#"sys"."varchar"
~~END~~


SELECT COUNT(*) AS attr_count FROM sys.babelfish_get_temp_table_attributes(NULL);
GO
~~START~~
int8
0
~~END~~


-- tsql
-- PG dialect on TDS connection (should return results)
CREATE TABLE #pgDialectTdsTest(col1 varchar(50) COLLATE SQL_Latin1_General_CP1_CI_AS, col2 nvarchar(100) COLLATE SQL_Latin1_General_CP1_CI_AS)
GO

SELECT COUNT(*) AS tsql_result_count FROM sys.sp_tablecollations_100_enr('#pgDialectTdsTest')
GO
~~START~~
int
2
~~END~~


SELECT COUNT(*) AS tsql_attr_count FROM sys.babelfish_get_temp_table_attributes('#pgDialectTdsTest')
GO
~~START~~
int
8
~~END~~


SELECT set_config('babelfishpg_tsql.sql_dialect', 'postgres', false)
GO
~~START~~
text
postgres
~~END~~


SELECT COUNT(*) AS pg_dialect_tds_result_count FROM sys.sp_tablecollations_100_enr('#pgDialectTdsTest')
GO
~~START~~
int
2
~~END~~


SELECT COUNT(*) AS pg_dialect_tds_attr_count FROM sys.babelfish_get_temp_table_attributes('#pgDialectTdsTest')
GO
~~START~~
int
8
~~END~~


SELECT set_config('babelfishpg_tsql.sql_dialect', 'tsql', false)
GO
~~START~~
text
tsql
~~END~~


DROP TABLE #pgDialectTdsTest
GO
