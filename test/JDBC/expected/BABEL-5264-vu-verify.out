-- Test babelfish_get_all_temp_table_attributes function directly
CREATE TABLE #attrTest(col1 int, col2 varchar(50) collate bbf_unicode_cp1_ci_as, col3 nvarchar(100) collate bbf_unicode_cp1_ci_as)
GO

SELECT attname, attnum FROM sys.babelfish_get_all_temp_table_attributes() 
WHERE attnum > 0 ORDER BY attrelid, attnum
GO
~~START~~
varchar#!#smallint
col1#!#1
col2#!#2
col3#!#3
chunk_id#!#1
chunk_seq#!#2
chunk_data#!#3
chunk_id#!#1
chunk_seq#!#2
~~END~~


DROP TABLE #attrTest
GO

