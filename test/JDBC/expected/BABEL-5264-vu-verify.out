6#!#f#!#<NULL>
7#!#g#!#bbf_unicode_cp1_ci_as
8#!#h#!#bbf_unicode_cp1_ci_as
~~END~~


EXEC tempdb.dbo.sp_tablecollations_100 '#collTest2'
GO
~~START~~
int#!#varchar#!#binary#!#nvarchar
1#!#a#!#<NULL>#!#<NULL>
2#!#b#!#0904D00034#!#bbf_unicode_cp1_ci_as
3#!#c#!#0904D00034#!#bbf_unicode_cp1_ci_as
4#!#d#!#0904D00034#!#bbf_unicode_cp1_ci_as
5#!#e#!#<NULL>#!#<NULL>
6#!#f#!#<NULL>#!#<NULL>
7#!#g#!#0904D00034#!#bbf_unicode_cp1_ci_as
