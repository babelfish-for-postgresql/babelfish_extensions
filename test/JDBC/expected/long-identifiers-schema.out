
-- tsql

-- BABEL-5975: Long schema name (> 63 bytes) must display as the full original
-- name in system catalogs, information_schema views, and system procedures.
-- Only valid (SQL Server compatible) inputs are tested: the full schema name.
-- ===========================================
-- SETUP: schema whose name exceeds the 63-byte PostgreSQL NAME limit
-- ===========================================
CREATE SCHEMA Babel5975_Long_Schema_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_Sch;
GO

CREATE TABLE Babel5975_Long_Schema_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_Sch.t1 (
    id INT NOT NULL,
    col2 INT,
    CONSTRAINT ck_schema_test CHECK (col2 > 0),
    CONSTRAINT pk_schema_test PRIMARY KEY (id)
);
GO

CREATE TABLE Babel5975_Long_Schema_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_Sch.child (
    id INT,
    pid INT,
    CONSTRAINT fk_schema_test FOREIGN KEY (pid) REFERENCES Babel5975_Long_Schema_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_Sch.t1(id)
);
GO

CREATE VIEW Babel5975_Long_Schema_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_Sch.v1
AS SELECT id FROM Babel5975_Long_Schema_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_Sch.t1;
GO

CREATE PROCEDURE Babel5975_Long_Schema_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_Sch.p1
AS BEGIN SELECT 1 END;
GO

CREATE SEQUENCE Babel5975_Long_Schema_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_Sch.sq1 AS INT START WITH 1;
GO

CREATE TYPE Babel5975_Long_Schema_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_Sch.ty1 FROM INT;
GO

-- ===========================================
-- sys.schemas exposes the full original schema name
-- ===========================================
SELECT name FROM sys.schemas WHERE name LIKE 'Babel5975_Long_Schema%';
GO
~~START~~
varchar
Babel5975_Long_Schema_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_Sch
~~END~~


