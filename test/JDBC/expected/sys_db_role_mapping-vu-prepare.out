-- create a login and user which is a member of db_securityadmin role
-- tsql
create login sys_db_role_mapping_vu_login with password = '12345678';
GO

create user userof_sys_db_role_mapping_vu_login for login sys_db_role_mapping_vu_login
GO

alter role db_securityadmin add member userof_sys_db_role_mapping_vu_login;
GO
