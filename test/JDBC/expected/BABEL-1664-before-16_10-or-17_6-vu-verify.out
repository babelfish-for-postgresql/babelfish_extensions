-- Functional tests with different edge cases
SELECT CAST(CAST('2016-12-12 12:12:12.123' AS DATETIME) AS VARCHAR(100)) AS dt_varchar,
       CAST(CAST('2016-12-12 12:12:12.123' AS SMALLDATETIME) AS VARCHAR(100)) AS sdt_varchar;
GO
~~START~~
varchar#!#varchar
Dec 12 2016 12:12PM#!#Dec 12 2016 12:12PM
~~END~~


SELECT CAST(CAST('2001-5-20 12:12:12.123' AS DATETIME) AS VARCHAR(100)) AS dt_varchar,
       CAST(CAST('2001-5-20 12:12:12.123' AS SMALLDATETIME) AS VARCHAR(100)) AS sdt_varchar;
GO
~~START~~
varchar#!#varchar
May 20 2001 12:12PM#!#May 20 2001 12:12PM
~~END~~


