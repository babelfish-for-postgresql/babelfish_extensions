-- DATETIME, DATETIME2, SMALLDATETIME is retrived directly
SELECT CAST('2016-12-12 12:12:12.123' AS DATETIME) AS dt,
       CAST('2016-12-12 12:12:12.123' AS SMALLDATETIME) AS sdt;
GO
~~START~~
datetime#!#smalldatetime
2016-12-12 12:12:12.123#!#2016-12-12 12:12:00.0
~~END~~


