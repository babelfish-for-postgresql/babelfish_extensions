-- Tests with different DATEFORMAT and LANGUAGE settings
-- TODO: BABEL-6258,
-- Currently Babelfish does not support setting LANGUAGE 
-- to anything other than default language which is US_ENGLISH 
-- hence output of following tests for other language will differ. 
-- Default DATEFORMAT and LANGUAGE
SELECT CAST(dt AS VARCHAR(50)) AS dt_varchar, 
       CAST(sdt AS VARCHAR(50)) AS sdt_varchar 
FROM babel_1664_vu_prepare_t1;
GO
~~START~~
varchar#!#varchar
Dec 25 2023  2:30PM#!#Dec 25 2023  2:31PM
