-- ===========================================
-- Cross-session FK constraint violation (tests hook, not session cache)
-- The FK constraint is created in this connection but the violation will
-- be triggered from a separate connection below.
-- ===========================================
CREATE TABLE babel5975_fk_cross_parent (id INT PRIMARY KEY);
GO
INSERT INTO babel5975_fk_cross_parent VALUES (1);
GO
~~ROW COUNT: 1~~

CREATE TABLE babel5975_fk_cross_child (
    id INT,
    parent_id INT,
    CONSTRAINT Very_Long_FK_Cross_Session_Constraint_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three FOREIGN KEY (parent_id) REFERENCES babel5975_fk_cross_parent(id)
);
GO

-- tsql
-- This is a NEW connection - the FK constraint name is NOT in this session's cache.
-- The hook must resolve it from babelfish_identifier_mapping catalog.
INSERT INTO babel5975_fk_cross_child VALUES (1, 999);
GO
~~ERROR (Code: 547)~~

~~ERROR (Message: insert or update on table "babel5975_fk_cross_child" violates foreign key constraint "very_long_fk_cross_session_constraint_name_that_exceeds_postgresql_limit_of_sixty_three")~~


-- tsql
-- Also test DELETE on parent that violates FK (ON DELETE NO ACTION)
DELETE FROM babel5975_fk_cross_parent WHERE id = 1;
GO
~~ROW COUNT: 1~~


-- tsql
-- Cleanup
DROP TABLE babel5975_fk_cross_child;
GO
DROP TABLE babel5975_fk_cross_parent;
GO

