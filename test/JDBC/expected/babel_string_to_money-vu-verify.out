--Function
SELECT * FROM dbo.money_func();
GO
~~START~~
money#!#money#!#money#!#money
123.4500#!#-123.4500#!#<NULL>#!#0.6570
~~END~~

--complex case 
SELECT 
    id,
    debit,
    credit,
    balance,
    CASE 
        WHEN balance > '$0' THEN 'Positive'
        WHEN balance < '$0' THEN 'Negative'
        ELSE 'Zero'
    END AS balance_status
FROM transactions;
GO
~~START~~
int#!#money#!#money#!#money#!#varchar
1#!#100.0000#!#95.0000#!#5.0000#!#Positive
2#!#75.5000#!#80.0000#!#-4.5000#!#Negative
3#!#400.0000#!#390.0000#!#10.0000#!#Positive
~~END~~


