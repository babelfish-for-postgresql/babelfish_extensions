GO
~~ROW COUNT: 1~~


INSERT INTO redundant_test VALUES (4, 'Test4', 'Required4');
GO
~~ROW COUNT: 1~~


SELECT * FROM redundant_test;
GO
~~START~~
int#!#varchar#!#varchar
