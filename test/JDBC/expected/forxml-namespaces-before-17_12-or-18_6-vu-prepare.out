-- ============================================
-- SECTION: Dependent Views
-- ============================================
CREATE VIEW forxml_ns_view1 AS
SELECT EmpID, EmpName FROM forxml_ns_employees;
GO

CREATE VIEW forxml_ns_view2 AS
SELECT a, b FROM forxml_ns_simple;
GO
