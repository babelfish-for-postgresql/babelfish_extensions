----------------------------------------------------
-- 1. Basic split with comma separator
----------------------------------------------------
SELECT value
FROM STRING_SPLIT('a,b,c', ',');
-- Expected: a | b | c
GO
~~START~~
varchar
a
b
c
~~END~~


----------------------------------------------------
-- 2. Empty substrings with consecutive delimiters
----------------------------------------------------
SELECT value
FROM STRING_SPLIT('a,,b', ',');
-- Expected: a | (empty) | b
GO
~~START~~
varchar
a

b
~~END~~


----------------------------------------------------
-- 3. NULL input string
----------------------------------------------------
SELECT value
FROM STRING_SPLIT(NULL, ',');
-- Expected: Empty result set
GO
~~START~~
varchar
~~END~~


