EXEC p_drop_create_schema_change
GO
~~ROW COUNT: 1~~

~~ROW COUNT: 1~~

~~START~~
int#!#int#!#varchar
10#!#20#!#changed schema
~~END~~


CREATE TABLE #t(final_col int)
INSERT INTO #t VALUES (777)
SELECT * FROM #t
GO
~~ROW COUNT: 1~~

~~START~~
int
777
~~END~~


DROP TABLE #t
GO

