-2#!#-2
-1#!#-1
~~END~~


-- Source table's next identity value should be 10 since we did DBCC reseed previously
INSERT INTO babel_5661_source VALUES (-10)
GO
~~ROW COUNT: 1~~

SELECT * FROM babel_5661_source ORDER BY id
