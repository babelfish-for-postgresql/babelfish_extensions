-6#!#-6
-5#!#-5
-4#!#-4
-3#!#-3
-2#!#-2
-1#!#-1
~~END~~

-- identity should start from 7
INSERT INTO #babel_5661_new1 VALUES (-7)
GO
~~ROW COUNT: 1~~

