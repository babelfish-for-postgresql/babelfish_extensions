
-- Invalid Function Param ,  without catch flag set 
SELECT SET_CONFIG('babelfishpg_tsql.catch_unmapped_errors','off',false)
GO
~~START~~
text
off
~~END~~



BEGIN TRY 
SELECT SWITCHOFFSET('2025-07-23 12:00:00 +00:00', 'abc') AS shifted_time; 
END TRY
BEGIN CATCH 
 SELECT ERROR_NUMBER() AS tsql_error_number, ERROR_MESSAGE() AS message_text;  
END CATCH;
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: The timezone provided to builtin function todatetimeoffset is invalid.)~~


-- Invalid Function Param, with catch flag set 
SELECT SET_CONFIG('babelfishpg_tsql.catch_unmapped_errors','on',false)
GO
~~START~~
text
on
~~END~~



BEGIN TRY 
SELECT SWITCHOFFSET('2025-07-23 12:00:00 +00:00', 'abc') AS shifted_time; 
END TRY
BEGIN CATCH 
    SELECT 'Catch Error ';
    SELECT ERROR_NUMBER() AS tsql_error_number, ERROR_MESSAGE() AS message_text;  
END CATCH;
GO
~~START~~
varchar
Catch Error 
~~END~~

~~START~~
int#!#nvarchar
33557097#!#The timezone provided to builtin function todatetimeoffset is invalid.
~~END~~




-- time field value out of range, Termination scenario
SELECT SET_CONFIG('babelfishpg_tsql.catch_unmapped_errors','off',false);
GO
~~START~~
text
off
~~END~~


BEGIN TRY
    SELECT CAST('2025-13-40 25:61:61' AS DATETIME);  
END TRY
BEGIN CATCH
    SELECT 'Catch Error ';
    SELECT ERROR_NUMBER() AS tsql_error_number, ERROR_MESSAGE() AS message_text;
END CATCH;
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: date/time field value out of range: "2025-13-40 25:61:61")~~



