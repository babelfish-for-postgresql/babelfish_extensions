-- numeric field overflow, without catch flag set
SELECT SET_CONFIG('babelfishpg_tsql.catch_unmapped_errors','off',false)
GO
~~START~~
text
off
~~END~~


BEGIN TRY
    SELECT CAST(123456 AS DECIMAL(5,2));  -- exceeds precision -> overflow at runtime
END TRY
BEGIN CATCH
    SELECT 'Catch Error ';
    SELECT ERROR_NUMBER() AS tsql_error_number, ERROR_MESSAGE() AS message_text;
END CATCH;
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: numeric field overflow)~~



