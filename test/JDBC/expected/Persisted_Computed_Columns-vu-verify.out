-- ALTER TABLE ADD PERSISTED computed col to partitioned table
CREATE TABLE pcc_part_base (
    id INT,
    x INT,
    y INT
) ON pcc_part_scheme(id)
GO

INSERT INTO pcc_part_base VALUES (5, 10, 20), (15, 30, 40)
GO
