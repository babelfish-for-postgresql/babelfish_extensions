-- JOINs
-- Self-JOIN with correct GUCs
SELECT t1.id, t1.c, t2.id AS id2, t2.c AS c2
FROM pcc_concat t1 JOIN pcc_concat t2 ON t1.c = t2.c
WHERE t1.id < t2.id
ORDER BY t1.id
GO
~~START~~
int#!#varchar#!#int#!#varchar
~~END~~


