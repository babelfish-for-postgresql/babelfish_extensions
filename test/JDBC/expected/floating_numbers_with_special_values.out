GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: syntax error near '(' at line 1 and character position 31)~~

SELECT TRY_CAST(N'1.1' AS FLOAT(0));
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: precision for type float must be at least 1 bit)~~

SELECT TRY_CAST(N'3.1' AS FLOAT);
GO
~~START~~
float
3.1
~~END~~

SELECT TRY_CAST(N'9.99909' AS FLOAT(53));
GO
~~START~~
float
9.99909
~~END~~

SELECT TRY_CAST(N'123.321' AS FLOAT);
GO
