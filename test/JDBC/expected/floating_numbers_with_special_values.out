-- ======== FLOAT with different precisions
SELECT CAST(N'1.1' AS FLOAT(58));
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: precision for type float must be less than 54 bits)~~

SELECT CAST(N'' AS FLOAT(56));
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: precision for type float must be less than 54 bits)~~

SELECT CAST(N'1.1' AS FLOAT(-1));
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: syntax error near '(' at line 1 and character position 27)~~

SELECT CAST(N'1.1' AS FLOAT(0));
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: precision for type float must be at least 1 bit)~~

SELECT CAST(N'3.1' AS FLOAT);
GO
~~START~~
float
3.1
~~END~~

SELECT CAST(N'9.99909' AS FLOAT(53));
GO
~~START~~
float
9.99909
~~END~~

SELECT CAST(N'123.321' AS FLOAT);
GO
~~START~~
float
123.321
~~END~~

SELECT CAST(N'1000.10001' AS FLOAT(53));
GO
~~START~~
float
1000.10001
~~END~~



SELECT TRY_CAST(N'1.1' AS FLOAT(58));
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: precision for type float must be less than 54 bits)~~

SELECT TRY_CAST(N'' AS FLOAT(56));
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: precision for type float must be less than 54 bits)~~

