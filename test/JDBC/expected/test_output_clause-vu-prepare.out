-- Setup EPQ test table
CREATE TABLE EPQTest_Delete_Update (
    ID INT PRIMARY KEY,
    Name NVARCHAR(50),
    Value INT,
    Counter INT DEFAULT 0,
    Status NVARCHAR(20) DEFAULT 'Active'
);
