-- Tests for colon_colon syntax
select geometry::STGeomFromText('POINT (1 2)', 0)
go
~~START~~
geometry
00000000010C000000000000F03F0000000000000040
~~END~~


select sys.geometry::STGeomFromText('POINT (1 2)', 0)
go
~~START~~
geometry
00000000010C000000000000F03F0000000000000040
~~END~~


select [sys].[geometry]::STGeomFromText('POINT (1 2)', 0)
go
~~START~~
geometry
00000000010C000000000000F03F0000000000000040
~~END~~


select geography::STGeomFromText('POINT (1 2)', 4326)
go
~~START~~
geography
E6100000010C0000000000000040000000000000F03F
~~END~~


select sys.geography::STGeomFromText('POINT (1 2)', 4326)
go
~~START~~
geography
E6100000010C0000000000000040000000000000F03F
~~END~~


select [sys].[geography]::STGeomFromText('POINT (1 2)', 4326)
go
~~START~~
geography
E6100000010C0000000000000040000000000000F03F
~~END~~


select [geography]::STGeomFromText('POINT (1 2)', 4326)
go
~~START~~
geography
E6100000010C0000000000000040000000000000F03F
~~END~~


select [geometry]::STGeomFromText('POINT (1 2)', 0)
go
~~START~~
geometry
00000000010C000000000000F03F0000000000000040
~~END~~


select (geography)::STGeomFromText('POINT (1 2)', 4326)
go
~~ERROR (Code: 33557097)~~

~~ERROR (Message: syntax error near ':' at line 1 and character position 18)~~


select (geometry)::STGeomFromText('POINT (1 2)', 0)
go
~~ERROR (Code: 33557097)~~

~~ERROR (Message: syntax error near ':' at line 1 and character position 17)~~


select "geography"::STGeomFromText('POINT (1 2)', 4326)
go
~~START~~
geography
E6100000010C0000000000000040000000000000F03F
~~END~~


select "geometry"::STGeomFromText('POINT (1 2)', 0)
go
~~START~~
geometry
00000000010C000000000000F03F0000000000000040
~~END~~


