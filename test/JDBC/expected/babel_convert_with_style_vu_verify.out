-- Test from tables
SELECT 'MONEY Conversions' AS test_type;
SELECT test_value, style_number, 
       TRY_CONVERT(VARCHAR, test_value, CAST(style_number AS INT)) AS converted_value,
       description
FROM money_style_conversion_test
ORDER BY id;
GO
~~START~~
varchar
MONEY Conversions
~~END~~

~~START~~
money#!#sql_variant#!#varchar#!#varchar
1234.1357#!#0#!#1234.14#!#Basic decimal - style 0
1234.1357#!#1#!#1,234.14#!#Basic decimal - style 1
1234.1357#!#2#!#1234.1357#!#Basic decimal - style 2
1234.1357#!#126#!#1234.1357#!#Basic decimal - style 126
1234.1357#!#<NULL>#!#<NULL>#!#Basic decimal - NULL style
-1234.1357#!#0#!#-1234.14#!#Negative decimal - style 0
-1234.1357#!#1#!#-1,234.14#!#Negative decimal - style 1
-1234.1357#!#2#!#-1234.1357#!#Negative decimal - style 2
922337203685477.5807#!#0#!#922337203685477.58#!#Maximum MONEY value
-922337203685477.5808#!#0#!#-922337203685477.58#!#Minimum MONEY value
922337203685477.5807#!#1#!#922,337,203,685,477.58#!#Maximum MONEY value with comma format
-922337203685477.5808#!#1#!#-922,337,203,685,477.58#!#Minimum MONEY value with comma format
0.0000#!#0#!#0.00#!#Zero value - style 0
0.0000#!#1#!#0.00#!#Zero value - style 1
0.0000#!#2#!#0.0000#!#Zero value - style 2
1234.1000#!#0#!#1234.10#!#Two decimal places
1234.1000#!#0#!#1234.10#!#One decimal place
1234.0000#!#0#!#1234.00#!#Four trailing zeros
0.1234#!#0#!#0.12#!#Leading zero decimal
123.4500#!#-1#!#123.45#!#Negative style -1
123.4500#!#-126#!#123.45#!#Negative style -126
123.4568#!#0#!#123.46#!#Float-like decimal
-123.4568#!#0#!#-123.46#!#Negative float-like decimal
123456789.1234#!#0#!#123456789.12#!#Large number with decimals
-123456789.1234#!#1#!#-123,456,789.12#!#Large negative with comma format
123.4500#!#0#!#123.45#!#Currency symbol value
-123.4500#!#1#!#-123.45#!#Negative currency symbol value
~~END~~


