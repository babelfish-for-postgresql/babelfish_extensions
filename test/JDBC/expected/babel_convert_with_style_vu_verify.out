SELECT CONVERT(VARCHAR, @sval, 0);
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: "@sval" is not a known variable)~~


SET @sval = -214748.3648;  -- Min SMALLMONEY
SELECT CONVERT(VARCHAR, @sval, 0);
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: "@sval" is not a known variable)~~


-- Negative numbers
SET @sval = -1234.1357;
SELECT CONVERT(VARCHAR, @sval, 0);
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: "@sval" is not a known variable)~~


SET @sval = -1234.1357;
SELECT CONVERT(VARCHAR, @sval, 1);
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: "@sval" is not a known variable)~~


-- Test invalid conversions (should fail)
-- Decimal style
SELECT CONVERT(VARCHAR, CAST(123.45 AS MONEY), 1.8);
GO
~~START~~
varchar
~~ERROR (Code: 33557097)~~

~~ERROR (Message: Argument data type numeric is invalid for argument 3 of convert function)~~


-- Overflow tests
SELECT CONVERT(VARCHAR, CAST(214748.3648 AS SMALLMONEY));  -- SMALLMONEY overflow
GO
~~START~~
varchar
~~ERROR (Code: 220)~~

~~ERROR (Message: value for domain smallmoney violates check constraint "smallmoney_check")~~


SELECT CONVERT(VARCHAR, CAST(-214748.3649 AS SMALLMONEY));  -- SMALLMONEY underflow
GO
~~START~~
varchar
~~ERROR (Code: 220)~~

~~ERROR (Message: value for domain smallmoney violates check constraint "smallmoney_check")~~


-- Test NULL handling
SELECT CONVERT(VARCHAR, CAST(NULL AS MONEY));
GO
~~START~~
varchar
<NULL>
~~END~~


SELECT CONVERT(VARCHAR, CAST(NULL AS SMALLMONEY));
GO
~~START~~
varchar
<NULL>
~~END~~

