-- Test MONEY direct conversions
DECLARE @val MONEY;
-- Basic style tests
SET @val = 1234.1357;
SELECT CONVERT(VARCHAR, @val);
GO
~~START~~
varchar
1234.14
~~END~~


SET @val = 1234.1357;
SELECT CONVERT(VARCHAR, @val, 0);
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: "@val" is not a known variable)~~


SET @val = 1234.1357;
SELECT CONVERT(VARCHAR, @val, 1);
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: "@val" is not a known variable)~~


-- Edge cases
SET @val = 922337203685477.5807;  -- Max MONEY
SELECT CONVERT(VARCHAR, @val, 0);
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: "@val" is not a known variable)~~


SET @val = -922337203685477.5808;  -- Min MONEY
SELECT CONVERT(VARCHAR, @val, 0);
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: "@val" is not a known variable)~~


-- Negative numbers
SET @val = -1234.1357;
SELECT CONVERT(VARCHAR, @val, 0);
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: "@val" is not a known variable)~~


SET @val = -1234.1357;
SELECT CONVERT(VARCHAR, @val, 1);
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: "@val" is not a known variable)~~


-- Float-like values
SET @val = 123.45678901234;
SELECT CONVERT(VARCHAR, @val, 0);
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: "@val" is not a known variable)~~


SET @val = -123.45678901234;
SELECT CONVERT(VARCHAR, @val, 2);
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: "@val" is not a known variable)~~


-- Zero values
SET @val = 0.00;
SELECT CONVERT(VARCHAR, @val, 0);
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: "@val" is not a known variable)~~


SET @val = 0.00;
SELECT CONVERT(VARCHAR, @val, 1);
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: "@val" is not a known variable)~~



-- Test SMALLMONEY direct conversions
DECLARE @sval SMALLMONEY;
-- Basic style tests
SET @sval = 1234.1357;
SELECT CONVERT(VARCHAR, @sval);
GO
~~START~~
varchar
1234.14
~~END~~


