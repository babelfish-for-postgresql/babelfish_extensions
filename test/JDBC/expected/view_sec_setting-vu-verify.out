-- tsql
create view v6031_new as select * from t6031_1;
go

grant select on v6031_new to l6031_1;
go

-- psql
SELECT c.relname as view_name, CASE WHEN 'security_barrier=true' = ANY (c.reloptions) THEN 'SECURITY DEFINER' ELSE 'SECURITY INVOKER' END as security_type FROM pg_class c WHERE c.relkind = 'v' AND relname LIKE 'v6031_%' ORDER BY view_name;
go
~~START~~
name#!#text
v6031_existing#!#SECURITY INVOKER
v6031_new#!#SECURITY INVOKER
~~END~~


