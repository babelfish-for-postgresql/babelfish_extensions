
-- ======================================================================
-- Babelfish STR() vs SQL Server — Regression Suite (deduplicated/organized)
-- ======================================================================
/* =========================
   0) Smoke: basic rounding (1 d.p., 2 d.p.)
   ========================= */
SELECT STR(123.355, 10, 1) AS s_1dp_up;          -- MSSQL: '     123.4'
GO
~~START~~
varchar
     123.4
~~END~~

SELECT STR(123.340, 10, 1) AS s_1dp_down;        -- MSSQL: '     123.3'
GO
~~START~~
varchar
     123.3
~~END~~

SELECT STR(123.350, 10, 1) AS s_1dp_tie;         -- MSSQL (float edge): often '     123.3'
GO
~~START~~
varchar
     123.4
~~END~~

SELECT STR(123.358, 10, 1) AS s_1dp_up2;         -- MSSQL: '     123.4'
GO
~~START~~
varchar
     123.4
~~END~~


SELECT STR(123.355, 10, 2) AS s_2dp_up;          -- MSSQL: '    123.36'
GO
~~START~~
varchar
    123.36
~~END~~

SELECT STR(123.340, 10, 2) AS s_2dp_down;        -- MSSQL: '    123.34'
GO
~~START~~
varchar
    123.34
~~END~~

SELECT STR(123.350, 10, 2) AS s_2dp_tie;         -- MSSQL: '    123.35'
GO
~~START~~
varchar
    123.35
~~END~~

SELECT STR(123.358, 10, 2) AS s_2dp_up2;         -- MSSQL: '    123.36'
GO
~~START~~
varchar
    123.36
~~END~~



/* =========================
   1) HP — 17 significant digits rule
   ========================= */
SELECT STR(12345678901234567890, 20) AS hp1;                         -- MSSQL: '12345678901234567000'
GO
~~START~~
varchar
12345678901234568000
~~END~~

SELECT STR(1234567890123456789.12345678901234567, 22, 20) AS hp2;    -- MSSQL: '1234567890123456800.00'
GO
~~START~~
varchar
1234567890123456800.00
~~END~~

SELECT STR(1234567890123456.12345678901234567, 22, 20) AS hp3;       -- MSSQL: '1234567890123456.00000'
GO
~~START~~
varchar
1234567890123456.10000
~~END~~

SELECT STR(99999999999999999.95, 22, 2) AS hp4;                      -- MSSQL: ' 100000000000000000.00'
GO
~~START~~
varchar
 100000000000000000.00
~~END~~

SELECT STR(1234567890.1234567890, 22, 20) AS hp5;                    -- MSSQL: '1234567890.12345670000'
GO
~~START~~
varchar
1234567890.12345680000
~~END~~



/* =========================
   2) DP — Fraction cap (max 16) & padding
   ========================= */
SELECT STR(0.123456789012345678, 20, 20) AS dp1;                     -- MSSQL: '  0.1234567890123457'
GO
~~START~~
varchar
  0.1234567890123457
~~END~~

SELECT STR(-0.123456789012345678, 20, 20) AS dp2;                    -- MSSQL: ' -0.1234567890123457'
GO
~~START~~
varchar
 -0.1234567890123457
~~END~~

SELECT STR(123.4567890123456789, 20, 20) AS dp3;                     -- MSSQL: '123.4567890123456800'
GO
~~START~~
varchar
123.4567890123456800
~~END~~

SELECT STR(0.99999999999999995, 22, 20) AS dp4;                      -- MSSQL: '    1.0000000000000000'
GO
~~START~~
varchar
    1.0000000000000000
~~END~~

SELECT STR(0.12345678901234565, 22, 16) AS dp5;                      -- MSSQL: '    0.1234567890123457'
GO
~~START~~
varchar
    0.1234567890123457
~~END~~


-- Bracketed padding checks (helps detect leading/trailing space handling)
SELECT '[' + STR(0.123456789012345678, 20, 20) + ']' AS pad_dp1;     -- MSSQL: '[  0.1234567890123457]'
GO
~~START~~
varchar
[  0.1234567890123457]
~~END~~

SELECT '[' + STR(0.123456789012345678, 20, 16) + ']' AS pad_dp2;     -- MSSQL: '[  0.1234567890123457]'
GO
~~START~~
varchar
[  0.1234567890123457]
~~END~~

SELECT '[' + STR(0.123456789012345678, 18, 20) + ']' AS pad_dp3;     -- MSSQL: '[0.1234567890123457]'
GO
~~START~~
varchar
[0.1234567890123457]
~~END~~


-- Same numeric value with a leading zero in the literal (parsing should not change the value)
SELECT '[' + STR(01.123456789012345678, 20, 20) + ']' AS pad_dp4;    -- MSSQL: '[  1.1234567890123457]'
GO
~~START~~
varchar
[  1.1234567890123457]
~~END~~

SELECT '[' + STR(01.123456789012345678, 20, 16) + ']' AS pad_dp5;    -- MSSQL: '[  1.1234567890123457]'
GO
~~START~~
varchar
[  1.1234567890123457]
~~END~~

SELECT '[' + STR(01.123456789012345678, 18, 20) + ']' AS pad_dp6;    -- MSSQL: '[1.1234567890123457]'
GO
~~START~~
varchar
[1.1234567890123457]
~~END~~



/* =========================
   3) CR — Carry & boundary rounding
   ========================= */
SELECT STR(1.9999, 6, 3)  AS cr1;                                    -- MSSQL: ' 2.000'
GO
~~START~~
varchar
 2.000
~~END~~

SELECT STR(0.9995, 6, 3)  AS cr2;                                    -- MSSQL: ' 1.000'
GO
~~START~~
varchar
 1.000
~~END~~

SELECT STR(-0.9995, 7, 3) AS cr3;                                    -- MSSQL: '-1.000'
GO
~~START~~
varchar
 -1.000
~~END~~

SELECT STR(-999.9, 6, 0)  AS cr4;                                    -- MSSQL: ' -1000'
GO
~~START~~
varchar
 -1000
~~END~~


-- Float-sensitive boundaries (expected to match MSSQL with Babelfish rounding patch)
SELECT STR(9.9995, 6, 3)  AS cr5_float_edge;                         -- MSSQL: ' 9.999'
GO
~~START~~
varchar
10.000
~~END~~

SELECT STR(2.675, 10, 2)  AS cr6_float_edge;                         -- MSSQL: '      2.67'
GO
~~START~~
varchar
      2.68
~~END~~

-- DECIMAL references (deterministic; serves as a control)
SELECT STR(CAST(9.9995 AS decimal(38,4)), 6, 3) AS cr7_dec_ref;      -- MSSQL: '10.000'
GO
~~START~~
varchar
10.000
~~END~~

SELECT STR(CAST(2.675  AS decimal(38,3)), 10, 2) AS cr8_dec_ref;     -- MSSQL: '      2.68'
GO
~~START~~
varchar
      2.68
~~END~~



/* =========================
   4) LC — Length constraint: effective decimals squeezed by length
   ========================= */
SELECT STR(1234.5678, 8, 4)  AS lc1;                                 -- MSSQL: '1234.568' (only 3 d.p. fit)
GO
~~START~~
varchar
1234.568
~~END~~

SELECT STR(1234.5673, 8, 4)  AS lc2;                                 -- MSSQL: '1234.567'
GO
~~START~~
varchar
1234.567
~~END~~

SELECT STR(-1234.5678, 9, 4) AS lc3;                                 -- MSSQL: '-1234.568'
GO
~~START~~
varchar
-1234.568
~~END~~

SELECT STR(12.3456, 5, 4)    AS lc4;                                 -- MSSQL: '12.35'
GO
~~START~~
varchar
12.35
~~END~~

SELECT STR(0.12345, 6, 4)    AS lc5;                                 -- MSSQL: '0.1235'
GO
~~START~~
varchar
0.1235
~~END~~

SELECT STR(99.999,  6, 4)    AS lc6;                                 -- MSSQL: '99.999'
GO
~~START~~
varchar
99.999
~~END~~



/* =========================
   5) OF — Overflow → stars
   ========================= */
SELECT STR(12345, 4, 0) AS of1;                                      -- MSSQL: '****'
GO
~~START~~
varchar
****
~~END~~

SELECT STR(-1234, 4, 0) AS of2;                                      -- MSSQL: '****'
GO
~~START~~
varchar
****
~~END~~

SELECT STR(123.45, 5, 2) AS of3;                                     -- MSSQL: '****' (3 + '.' + 2 = 6 > 5)
GO
~~START~~
varchar
123.5
~~END~~

SELECT STR(99999.99, 5, 1) AS of4;                                   -- MSSQL: '*****'
GO
~~START~~
varchar
*****
~~END~~



/* =========================
   6) SP — Sign, padding, zeros
   ========================= */
SELECT '[' + STR(12345, 10, 0) + ']' AS sp1;                         -- MSSQL: '[     12345]'
GO
~~START~~
varchar
[     12345]
~~END~~

SELECT '[' + STR(-1234, 5, 0)  + ']' AS sp2;                         -- MSSQL: '[-1234]'
GO
~~START~~
varchar
[-1234]
~~END~~

SELECT '[' + STR(0, 6, 3)      + ']' AS sp3;                         -- MSSQL: '[  0.000]'
GO
~~START~~
varchar
[ 0.000]
~~END~~

SELECT '[' + STR(-0.0001, 8, 4) + ']' AS sp4;                        -- MSSQL: '[ -0.0001]'
GO
~~START~~
varchar
[ -0.0001]
~~END~~



/* =========================
   7) FS — Float vs DECIMAL comparisons
   ========================= */
SELECT STR(123.350, 10, 1) AS fs1_float;                             -- MSSQL (float edge): may be '     123.3'
GO
~~START~~
varchar
     123.4
~~END~~

SELECT STR(CAST(123.350 AS decimal(38,3)), 10, 1) AS fs1_decimal;    -- MSSQL: '     123.4'
GO
~~START~~
varchar
     123.4
~~END~~

SELECT STR(0.1 + 0.2, 10, 1) AS fs2_float;                           -- MSSQL: '       0.3' (computed via float)
GO
~~START~~
varchar
       0.3
~~END~~

SELECT STR(CAST(0.1 AS decimal(38,4)) + CAST(0.2 AS decimal(38,4)), 10, 1) AS fs2_decimal; -- '       0.3'
GO
~~START~~
varchar
       0.3
~~END~~



/* =========================
   8) VAL — Validity & NULL behavior
   ========================= */
SELECT STR(NULL, 10, 2) AS v_null;                                   -- MSSQL: NULL
GO
~~START~~
varchar
<NULL>
~~END~~

SELECT STR(123.45, 0,  2) AS v_len0;                                 -- MSSQL: NULL
GO
~~START~~
varchar
<NULL>
~~END~~

SELECT STR(123.45, 9001, 2) AS v_len9001;                            -- MSSQL: NULL (length > 8000)
GO
~~START~~
varchar
<NULL>
~~END~~

SELECT STR(123.45, 10, -1) AS v_decneg;                              -- MSSQL: NULL
GO
~~START~~
varchar
<NULL>
~~END~~



/* =========================
   9) REPEAT — Critical HP/DP sanity repeats (quick sentinels)
   ========================= */
SELECT STR(12345678901234567890, 20)          AS hp1_repeat;         -- MSSQL: '12345678901234567000'
GO
~~START~~
varchar
12345678901234568000
~~END~~

SELECT STR(1234567890.1234567890, 22, 20)     AS hp5_repeat;         -- MSSQL: '1234567890.12345670000'
GO
~~START~~
varchar
1234567890.12345680000
~~END~~

SELECT STR(0.123456789012345678, 20, 20)      AS dp1_repeat;         -- MSSQL: '  0.1234567890123457'
GO
~~START~~
varchar
  0.1234567890123457
~~END~~

