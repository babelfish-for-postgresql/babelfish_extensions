-- tsql
USE master;
GO

SELECT name, data_source FROM sys.servers WHERE name = 'ls_svr';
GO
~~START~~
varchar#!#nvarchar
ls_svr#!#localhost
~~END~~




DECLARE @i int = 0;
DECLARE @out int = 0;
WHILE @i < 200
BEGIN
    EXEC ls_svr.master.dbo.rp_profile_small @x=@i, @y=@out OUTPUT;
    SET @i = @i + 1;
END;
SELECT @i AS iterations, @out AS last_output;
GO
