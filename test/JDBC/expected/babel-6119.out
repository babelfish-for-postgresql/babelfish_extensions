CREATE PROCEDURE dbo.test_proc 
AS BEGIN 
DECLARE @p nvarchar(100), @q tinyint; 
DECLARE @r nvarchar(30);
SELECT @r = content FROM babel_6119_test1;
SELECT 
    @p = 'abc',
    @r = COALESCE(col1, @r),
    @q = 1 
FROM  
    babel_6119_test2; 
END;  
GO

exec dbo.test_proc 
