-- sp_stored_procedures with long name
EXEC sp_stored_procedures @sp_name = 'Very_Long_Procedure_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing';
GO
~~START~~
varchar#!#varchar#!#nvarchar#!#int#!#int#!#int#!#varchar#!#smallint
master#!#dbo#!#Very_Long_Procedure_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing;1#!#-1#!#-1#!#-1#!#<NULL>#!#2
~~END~~


-- BABEL-5321: sp_stored_procedures must also resolve the object when the caller
-- supplies the MD5-truncated physical name, and must return the full original
-- name in PROCEDURE_NAME. The truncated name is non-deterministic (contains an
-- MD5 hash), so compute it at runtime and assert on the returned PROCEDURE_NAME.
DECLARE @trunc_proc sys.sysname = sys.babelfish_truncate_identifier(LOWER('Very_Long_Procedure_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing'));
DECLARE @sp_res TABLE (a sys.sysname, b sys.sysname, procedure_name sys.nvarchar(134), d int, e int, f int, g sys.nvarchar(254), h smallint);
INSERT INTO @sp_res EXEC sys.sp_stored_procedures @sp_name = @trunc_proc;
SELECT procedure_name FROM @sp_res WHERE procedure_name LIKE 'Very_Long_Procedure_Name%';
GO
~~ROW COUNT: 1~~

~~START~~
nvarchar
Very_Long_Procedure_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing;1
~~END~~


-- BABEL-5321 / BABEL-5975: sp_sproc_columns must display the full original
-- procedure name and match both the full and the truncated name.
-- (a) full name
SELECT DISTINCT PROCEDURE_NAME FROM sys.sp_sproc_columns_view WHERE original_procedure_name LIKE 'Very_Long_Procedure_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing';
GO
~~START~~
nvarchar
Very_Long_Procedure_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing;1
~~END~~

-- (b) truncated name resolves to the same (full) PROCEDURE_NAME
DECLARE @trunc_sc sys.sysname = sys.babelfish_truncate_identifier(LOWER('Very_Long_Procedure_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing'));
SELECT DISTINCT PROCEDURE_NAME FROM sys.sp_sproc_columns_view WHERE sys.babelfish_truncate_identifier(pg_catalog.lower(original_procedure_name)) = @trunc_sc AND PROCEDURE_NAME LIKE 'Very_Long_Procedure_Name%';
GO
~~START~~
nvarchar
Very_Long_Procedure_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing;1
~~END~~


-- BABEL-5321: sp_procedure_params_100_managed must resolve the procedure by both
-- its full and its MD5-truncated name. Use a short parameter name so the check
-- targets procedure-name matching (parameter-name display is a separate axis).
-- The truncated name is computed at runtime because it is non-deterministic.
CREATE PROCEDURE dbo.babel5975_pp_long_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars @p1 INT AS SELECT @p1;
GO
-- full name resolves via the managed proc
EXEC sys.sp_procedure_params_100_managed @procedure_name = 'babel5975_pp_long_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars', @parameter_name = '@p1';
GO
~~START~~
varchar#!#smallint#!#smallint#!#int#!#smallint#!#smallint#!#nvarchar#!#nvarchar#!#nvarchar#!#nvarchar#!#nvarchar#!#nvarchar#!#int
@p1#!#1#!#8#!#<NULL>#!#10#!#<NULL>#!#<NULL>#!#<NULL>#!#int#!#<NULL>#!#<NULL>#!#<NULL>#!#<NULL>
~~END~~

-- truncated name resolves to the same proc
DECLARE @trunc_pp sys.sysname = sys.babelfish_truncate_identifier(LOWER('babel5975_pp_long_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars'));
EXEC sys.sp_procedure_params_100_managed @procedure_name = @trunc_pp, @parameter_name = '@p1';
GO
~~START~~
varchar#!#smallint#!#smallint#!#int#!#smallint#!#smallint#!#nvarchar#!#nvarchar#!#nvarchar#!#nvarchar#!#nvarchar#!#nvarchar#!#int
@p1#!#1#!#8#!#<NULL>#!#10#!#<NULL>#!#<NULL>#!#<NULL>#!#int#!#<NULL>#!#<NULL>#!#<NULL>#!#<NULL>
~~END~~

DROP PROCEDURE dbo.babel5975_pp_long_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars;
GO

