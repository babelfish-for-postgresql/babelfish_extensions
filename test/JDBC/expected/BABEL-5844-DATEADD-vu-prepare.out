SELECT set_config('babelfishpg_tsql.escape_hatch_rowversion', 'ignore', 'false')
GO
~~START~~
text
ignore
~~END~~


CREATE TYPE UDT_TIME FROM TIME NOT NULL
CREATE TYPE UDT_DATE FROM DATE NOT NULL
CREATE TYPE UDT_DATETIME FROM DATETIME NOT NULL
CREATE TYPE UDT_DATETIME2 FROM DATETIME2 NOT NULL
CREATE TYPE UDT_TIMESTAMP FROM TIMESTAMP NOT NULL
CREATE TYPE UDT_SMALLDATETIME FROM SMALLDATETIME NOT NULL
CREATE TYPE UDT_DATETIMEOFFSET FROM DATETIMEOFFSET NOT NULL
GO
CREATE TABLE UdtTable
(
    ID INT PRIMARY KEY,
    UdtTime UDT_TIME,
    UdtDate UDT_DATE,
    UdtDatetime UDT_DATETIME,
    UdtDatetime2 UDT_DATETIME2,
    UdtTimestamp UDT_TIMESTAMP,
    UdtSmalldatetime UDT_SMALLDATETIME,
    UdtDatetimeOffset UDT_DATETIMEOFFSET
)
GO

-- Valid values
INSERT INTO UdtTable (ID, UdtTime, UdtDate, UdtDatetime, UdtDatetime2, UdtTimestamp, UdtSmalldatetime, UdtDatetimeOffset) 
VALUES (1, '14:30:25', '2024-12-09', '2024-12-09 14:30:25.123', '2024-12-09 14:30:25.1234567', '2024-12-09 14:30:25', '2024-12-09 14:30:00', CAST('2025-12-15 20:43:34.7733333 +00:00' AS DATETIMEOFFSET));
GO
~~ROW COUNT: 1~~


DECLARE @time TIME, @date DATE, @datetime DATETIME, @datetime2 DATETIME2, @timestamp TIMESTAMP, @smalldatetime SMALLDATETIME, @datetimeoffset DATETIMEOFFSET
SET @time = CAST('14:30:25.4444' AS TIME)
SET @date = CAST('2024-12-09 14:30:25.123' AS DATE)
SET @datetime = CAST('2024-12-09 14:30:25.123' AS DATETIME)
SET @datetime2 = CAST('2024-12-09 14:30:25' AS DATETIME2)
SET @timestamp = CAST('2038-01-19 03:14:07.9999999' AS TIMESTAMP)
SET @smalldatetime = CAST('2069-06-06 23:58:59.99999' AS SMALLDATETIME)
SET @datetimeoffset = CAST('2025-12-15 20:48:42.7933333 +00:00' AS DATETIMEOFFSET)
INSERT INTO UdtTable (ID, UdtTime, UdtDate, UdtDatetime, UdtDatetime2, UdtTimestamp, UdtSmalldatetime, UdtDatetimeOffset) 
VALUES (2, @time, @date, @datetime, @datetime2, @timestamp, @smalldatetime, @datetimeoffset);
GO
~~ROW COUNT: 1~~

-- String literals
INSERT INTO UdtTable (ID, UdtTime, UdtDate, UdtDatetime, UdtDatetime2, UdtTimestamp, UdtSmalldatetime, UdtDatetimeOffset) 
VALUES (3, '23:59:59', '1900-01-01', '1753-01-01 00:00:00', '0001-01-01 00:00:00', '1900-01-01 00:00:00', '1900-01-01 00:00:00', CAST('2025-12-15 20:48:42.7933333 +00:00' AS DATETIMEOFFSET));
GO
~~ROW COUNT: 1~~

-- Edge cases
INSERT INTO UdtTable (ID, UdtTime, UdtDate, UdtDatetime, UdtDatetime2, UdtTimestamp, UdtSmalldatetime, UdtDatetimeOffset) 
VALUES (4, '00:00:00', '1994-12-31', '9999-01-31 23:59:59.997', '9995-12-31 23:59:59.9999999', '2038-01-19 03:14:07', '2069-06-06 23:59:00', CAST('2080-12-31 00:00:00.00 +00:00' AS DATETIMEOFFSET));
GO
~~ROW COUNT: 1~~

-- String representations (days since base date)
INSERT INTO UdtTable (ID, UdtTime, UdtDate, UdtDatetime, UdtDatetime2, UdtTimestamp, UdtSmalldatetime, UdtDatetimeOffset) 
VALUES (5, '12:00:00', CAST('20241212' AS DATE), CAST('20241212' AS DATETIME), CAST('20241212' AS DATETIME2), CAST('20241212' AS TIMESTAMP), CAST('20241212' AS SMALLDATETIME), CAST('20241212' AS DATETIMEOFFSET));
GO
~~ROW COUNT: 1~~


