
-- tsql
-- Regression tests: failed sp_getapplock / APPLOCK_TEST calls
-- must not leak error state (the 5th failure in a session used to PANIC with
-- ERRORDATA_STACK_SIZE exceeded), and a cancel or statement_timeout while
-- waiting for an applock must stop the batch instead of returning -2.
CREATE LOGIN bbf7287_holder WITH PASSWORD = '12345678';
GO

-- tsql user=bbf7287_holder password=12345678
-- a second session holds the lock
exec sp_getapplock @Resource = 'bbf7287', @LockMode = 'Exclusive', @LockOwner = 'Session';
GO

-- tsql
-- a session-level lock timeout that every failed call must restore
SET LOCK_TIMEOUT 1500;
GO
SELECT current_setting('lock_timeout');
GO
~~START~~
text
1500ms
~~END~~


-- 10 failed no-wait attempts in one batch: -999 every time, no crash
DECLARE @r int, @i int = 1, @s varchar(200) = '';
WHILE @i <= 10
BEGIN
    EXEC @r = sp_getapplock @Resource = 'bbf7287', @LockMode = 'Exclusive', @LockOwner = 'Session', @LockTimeout = 0;
    SET @s = @s + CAST(@r AS varchar(10)) + ' ';
    SET @i += 1;
END
SELECT @s;
GO
~~WARNING (Code: 0)~~

