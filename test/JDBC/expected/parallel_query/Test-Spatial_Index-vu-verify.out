PASS
~~END~~


-- ============================================================
-- SECTION 49: PREDICATE-CONTEXT GUARD — no bbox injection inside CASE WHEN
-- A spatial method inside a CASE WHEN branch is not index-sargable: PostgreSQL
-- cannot push the && into an index scan inside a CASE expression. The injector
-- must therefore skip the prefilter there (plan shows NO sys.&&), while a plain
-- WHERE in the same statement must STILL inject. The decision is taken at the
-- nearest enclosing search_condition, so a spatial predicate in a subquery's own
-- WHERE stays eligible even when the subquery is nested inside an outer CASE.
-- ============================================================
SELECT set_config('enable_seqscan', 'off', false)
GO
