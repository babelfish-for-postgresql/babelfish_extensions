-- 49.9 Parenthesized operand ((col.STIntersects(...)) = 1): the "= 1" sits OUTSIDE
-- the parens, so injecting inside them would leave a bare "(col && arg) AND
-- STIntersects(...)" that fails to type-check (boolean AND bit). Prefilter must
-- therefore NOT be injected (no sys.&&); the bare predicate runs cleanly and
-- returns the same count as the plain WHERE.
SELECT COUNT(*) AS t49_paren FROM si_geom_tbl
WHERE (si_geom_tbl.geom.STIntersects(geometry::STGeomFromText('POLYGON((100 100, 200 100, 200 200, 100 200, 100 100))', 4326))) = 1;
GO
