-- SECTION 27: INDEX LIFECYCLE (drop + recreate)
-- ============================================================
-- 27.1 Baseline count with existing index
DECLARE @before INT;
SELECT @before = COUNT(*) FROM si_geom_tbl
WHERE si_geom_tbl.geom.STIntersects(
