WHERE si_geom_tbl.geom.STDistance(geometry::STGeomFromText('POINT(500 500)', 4326)) >= 100
  AND si_geom_tbl.geom IS NOT NULL;
SELECT CASE WHEN @ndist = @gedist THEN 'PASS' ELSE 'FAIL' END AS t13_6;
GO
