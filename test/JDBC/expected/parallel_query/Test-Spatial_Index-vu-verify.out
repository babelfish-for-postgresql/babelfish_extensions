-- 48.4 Correctness: every guarded form must equal the literal-threshold count.
DECLARE @subq INT, @func INT, @glob INT, @lit INT;
SELECT @subq = COUNT(*) FROM si_geom_tbl
WHERE si_geom_tbl.geom.STDistance(geometry::STGeomFromText('POINT(500 500)', 4326)) < (SELECT 100);
SELECT @func = COUNT(*) FROM si_geom_tbl
WHERE si_geom_tbl.geom.STDistance(geometry::STGeomFromText('POINT(500 500)', 4326)) < ABS(-100);
SELECT TOP 0 id FROM si_geom_tbl;
SELECT @glob = COUNT(*) FROM si_geom_tbl
WHERE si_geom_tbl.geom.STDistance(geometry::STGeomFromText('POINT(500 500)', 4326)) < 100 + @@ROWCOUNT;
SELECT @lit = COUNT(*) FROM si_geom_tbl
WHERE si_geom_tbl.geom.STDistance(geometry::STGeomFromText('POINT(500 500)', 4326)) < 100;
SELECT CASE WHEN @subq = @lit AND @func = @lit AND @glob = @lit THEN 'PASS' ELSE 'FAIL' END AS t48_equiv;
GO
