SET BABELFISH_STATISTICS PROFILE OFF;
GO

-- 49.10 Correctness: every non-sargable wrapper form (CASE WHEN, IIF, simple CASE,
-- COALESCE, ISNULL, NULLIF, arithmetic) AND the parenthesized direct form must all
-- return the same count as the plain WHERE.
DECLARE @w INT, @c INT, @i INT, @s INT, @co INT, @is INT, @nu INT, @ar INT, @pa INT;
SELECT @w = COUNT(*) FROM si_geom_tbl
WHERE si_geom_tbl.geom.STIntersects(geometry::STGeomFromText('POLYGON((100 100, 200 100, 200 200, 100 200, 100 100))', 4326)) = 1;
SELECT @c = COUNT(*) FROM si_geom_tbl
WHERE (CASE WHEN si_geom_tbl.geom.STIntersects(geometry::STGeomFromText('POLYGON((100 100, 200 100, 200 200, 100 200, 100 100))', 4326)) = 1 THEN 1 ELSE 0 END) = 1;
SELECT @i = COUNT(*) FROM si_geom_tbl
WHERE IIF(si_geom_tbl.geom.STIntersects(geometry::STGeomFromText('POLYGON((100 100, 200 100, 200 200, 100 200, 100 100))', 4326)) = 1, 1, 0) = 1;
SELECT @s = COUNT(*) FROM si_geom_tbl
WHERE (CASE si_geom_tbl.geom.STIntersects(geometry::STGeomFromText('POLYGON((100 100, 200 100, 200 200, 100 200, 100 100))', 4326)) WHEN 1 THEN 1 ELSE 0 END) = 1;
SELECT @co = COUNT(*) FROM si_geom_tbl
WHERE COALESCE(si_geom_tbl.geom.STIntersects(geometry::STGeomFromText('POLYGON((100 100, 200 100, 200 200, 100 200, 100 100))', 4326)), 0) = 1;
SELECT @is = COUNT(*) FROM si_geom_tbl
WHERE ISNULL(si_geom_tbl.geom.STIntersects(geometry::STGeomFromText('POLYGON((100 100, 200 100, 200 200, 100 200, 100 100))', 4326)), 0) = 1;
SELECT @nu = COUNT(*) FROM si_geom_tbl
WHERE NULLIF(si_geom_tbl.geom.STIntersects(geometry::STGeomFromText('POLYGON((100 100, 200 100, 200 200, 100 200, 100 100))', 4326)), 0) = 1;
SELECT @ar = COUNT(*) FROM si_geom_tbl
WHERE (si_geom_tbl.geom.STIntersects(geometry::STGeomFromText('POLYGON((100 100, 200 100, 200 200, 100 200, 100 100))', 4326)) + 0) = 1;
SELECT @pa = COUNT(*) FROM si_geom_tbl
WHERE (si_geom_tbl.geom.STIntersects(geometry::STGeomFromText('POLYGON((100 100, 200 100, 200 200, 100 200, 100 100))', 4326))) = 1;
SELECT CASE WHEN @w = @c AND @w = @i AND @w = @s AND @w = @co AND @w = @is AND @w = @nu AND @w = @ar AND @w = @pa THEN 'PASS' ELSE 'FAIL' END AS t49_case_equiv;
GO
