-- 48.3 T-SQL session global (@@ROWCOUNT) buried in arithmetic: prefilter must
-- NOT be injected. @@ROWCOUNT has no parens and is not a subquery, so it bypasses
-- those checks and is caught by the dedicated @@-global guard. SELECT TOP 0 first
-- pins @@ROWCOUNT = 0 so the threshold is a deterministic 100 (count == < 100).
SELECT TOP 0 id FROM si_geom_tbl;
SELECT COUNT(*) AS t48_global FROM si_geom_tbl
WHERE si_geom_tbl.geom.STDistance(geometry::STGeomFromText('POINT(500 500)', 4326)) < 100 + @@ROWCOUNT;
GO
