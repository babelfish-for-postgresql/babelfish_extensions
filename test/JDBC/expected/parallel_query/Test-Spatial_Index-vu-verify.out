-- psql
-- Refresh planner statistics so plan shape (Workers Planned, Index Scan vs
-- Parallel Bitmap Heap Scan, per-worker row counts) is deterministic across
-- runners with different CPU counts. Required for parallel-query mode.
ANALYZE master_dbo.si_geom_tbl;
ANALYZE master_dbo.si_geog_tbl;
ANALYZE master_dbo.si_multi_tbl;
ANALYZE master_dbo.si_view_tbl;
GO

-- tsql

-- ============================================================
-- SECTION 1: DDL ERROR CASES
-- ============================================================
-- 1.1 CREATE on non-spatial column (should error)
CREATE SPATIAL INDEX si_bad ON si_ddl_tbl(name);
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: data type "varchar" has no default operator class for access method "gist")~~


-- 1.2 Duplicate index name
CREATE SPATIAL INDEX si_dup ON si_ddl_tbl(geom);
GO
CREATE SPATIAL INDEX si_dup ON si_ddl_tbl(geom);
GO
~~ERROR (Code: 2714)~~

~~ERROR (Message: relation "si_dupsi_ddl_tblefc70e6ee50389004ff8215c689e5467" already exists)~~


-- 1.3 DROP and recreate
DROP INDEX si_dup ON si_ddl_tbl;
GO
CREATE SPATIAL INDEX si_dup ON si_ddl_tbl(geom);
GO
DROP INDEX si_dup ON si_ddl_tbl;
GO

-- 1.4 DROP non-existent (should error)
DROP INDEX si_fake ON si_ddl_tbl;
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: index "si_fakesi_ddl_tbl94fe14b60d353fa399b536a197c4650c" does not exist)~~


-- 1.5 Strict escape hatch blocks options
EXEC sp_babelfish_configure 'babelfishpg_tsql.escape_hatch_spatial_index', 'strict';
GO
CREATE SPATIAL INDEX si_strict ON si_ddl_tbl(geom)
USING GEOMETRY_GRID WITH (BOUNDING_BOX = (0, 0, 100, 100));
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: CREATE SPATIAL INDEX USING/WITH options are not supported in Babelfish. Set 'babelfishpg_tsql.escape_hatch_spatial_index' to 'ignore' to discard these options.)~~


-- 1.6 Bare works with strict
CREATE SPATIAL INDEX si_bare ON si_ddl_tbl(geom);
GO
DROP INDEX si_bare ON si_ddl_tbl;
GO

EXEC sp_babelfish_configure 'babelfishpg_tsql.escape_hatch_spatial_index', 'ignore';
GO


