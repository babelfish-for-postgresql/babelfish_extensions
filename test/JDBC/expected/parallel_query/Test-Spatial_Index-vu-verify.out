-- 13.6 Bare NOT on STDistance prefilter: NOT col.STDistance(pt) < 100
-- Same guard for the ST_Expand distance prefilter under bare NOT.
DECLARE @ndist INT, @gedist INT;
SELECT @ndist = COUNT(*) FROM si_geom_tbl
WHERE NOT si_geom_tbl.geom.STDistance(geometry::STGeomFromText('POINT(500 500)', 4326)) < 100
  AND si_geom_tbl.geom IS NOT NULL;
