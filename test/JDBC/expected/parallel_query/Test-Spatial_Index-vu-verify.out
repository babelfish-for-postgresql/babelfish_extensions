GO

SELECT name AS t47_idx_in_b
FROM sys.spatial_indexes
WHERE name LIKE 'sidx_multi%'
ORDER BY name;
GO
~~START~~
varchar
sidx_multi_b_
~~END~~


-- 47.4 From si_multidb_b_ : sidx_multi_a_ must NOT be visible
SELECT COUNT(*) AS t47_a_leak_from_b
FROM sys.spatial_indexes
WHERE name = 'sidx_multi_a_';
GO
~~START~~
int
0
~~END~~


-- 47.5 From master : neither cross-db spatial index is visible here
USE master;
GO

SELECT COUNT(*) AS t47_master_leak
FROM sys.spatial_indexes
WHERE name IN ('sidx_multi_a_', 'sidx_multi_b_');
GO
~~START~~
int
0
~~END~~


-- ============================================================
-- SECTION 48: NON-DETERMINISTIC THRESHOLD GUARD (STDistance prefilter)
-- A volatile threshold (function call / subquery) is textually duplicated into
-- both the ST_Expand prefilter and the STDistance recheck; if the two copies
-- could diverge per row, matching rows are silently dropped. The injector must
-- therefore SKIP the prefilter for such thresholds and fall back to the plain
-- predicate. RAND() cannot be asserted on count, so these cases use deterministic
-- thresholds that still take the rejection path (subquery / bare function call):
-- the captured plan must show NO sys.&& / sys.ST_Expand, and the counts must
-- match the literal-equivalent predicate.
-- ============================================================
-- Re-disable cost/timing in the plan output: SECTION 44's sp_reset_connection
-- reverts these GUCs to their defaults, and cost/timing values are not
-- deterministic across runs.
SELECT set_config('babelfishpg_tsql.explain_costs',   'off', false)
SELECT set_config('babelfishpg_tsql.explain_timing',  'off', false)
SELECT set_config('babelfishpg_tsql.explain_summary', 'off', false)
SELECT set_config('babelfishpg_tsql.explain_buffers', 'off', false)
SELECT set_config('enable_seqscan', 'off', false)
GO
