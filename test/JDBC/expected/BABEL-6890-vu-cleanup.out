-- Drop test stored procedure first (references tables)
DROP PROCEDURE IF EXISTS dbo.cache_test_proc;
GO

-- Drop test tables
DROP TABLE IF EXISTS dbo.cache_orders;
GO
DROP TABLE IF EXISTS dbo.cache_customers;
GO
DROP TABLE IF EXISTS dbo.cache_drop_test;
GO

-- Drop test user from permission tests
DROP USER IF EXISTS babel_6890_testuser;
GO
IF EXISTS (SELECT * FROM sys.server_principals WHERE name = 'babel_6890_testuser')
BEGIN
    DROP LOGIN babel_6890_testuser;
END
GO

PRINT 'BABEL-6890 cleanup completed';
