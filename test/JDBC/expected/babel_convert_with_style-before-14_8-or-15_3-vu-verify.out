-- Test procedures with UDT
DECLARE @money_ranges MoneyRange;
INSERT INTO @money_ranges VALUES 
(0.00, 1000.00, 0),
(-1000.00, 0.00, 1),
(1000.00, 2000.00, 2);
EXEC convert_money_range @money_ranges;
GO
