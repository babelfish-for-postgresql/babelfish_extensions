/********** CREATE NEW OBJECTS IN ALL THE SCHEMAS **********/
create table object_ownership_s1.new_t(a int, b int);
go
create view object_ownership_s1.new_v as select 1;
go
create proc object_ownership_s1.new_p as select 2;
go
create function object_ownership_s1.new_f() returns int begin declare @a int; set @a = 1; return @a; END
go
create sequence object_ownership_s1.new_sq start with 1 increment by 1 ;
go

create table object_ownership_s2.new_t(a int, b int);
go
create view object_ownership_s2.new_v as select 1;
go
create proc object_ownership_s2.new_p as select 2;
go
create function object_ownership_s2.new_f() returns int begin declare @a int; set @a = 1; return @a; END
go
create sequence object_ownership_s2.new_sq start with 1 increment by 1 ;
go

create table object_ownership_s3.new_t(a int, b int);
go
create view object_ownership_s3.new_v as select 1;
go
create proc object_ownership_s3.new_p as select 2;
go
create function object_ownership_s3.new_f() returns int begin declare @a int; set @a = 1; return @a; END
go
create sequence object_ownership_s3.new_sq start with 1 increment by 1 ;
go
create index new_idx on object_ownership_s3.new_t(a);
go
create trigger object_ownership_s3.new_tr on object_ownership_s3.new_t after insert as select 1;
go
create function object_ownership_s3.new_tvf() returns table as return (select '1' as col);
go
create function object_ownership_s3.new_mtvf()
returns @result table([Id] int) AS
begin
    insert into @result values (1) return 
end
go
create type object_ownership_s3.new_type from sys.varchar(10)
go
create type object_ownership_s3.new_ttype as table (id int)
go

