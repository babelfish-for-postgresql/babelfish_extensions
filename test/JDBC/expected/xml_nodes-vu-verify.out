-- index in .nodes() query
DECLARE @xml XML = '<Root><row><name>James</name></row><row><name>Megan</name></row></Root>'
SELECT T.C.value('.', 'varchar(20)') AS id
FROM @xml.nodes('(/Root/row/name)[1]') AS T(C)
ORDER BY 1
go
~~START~~
varchar
James
~~END~~


