-- Drop Fulltext index
DROP FULLTEXT INDEX ON ArticleSentences
GO

-- Drop tables
DROP TABLE IF EXISTS ArticleSentences
GO

-- disable FULLTEXT
SELECT set_config('babelfishpg_tsql.escape_hatch_fulltext', 'strict', 'false')
GO
