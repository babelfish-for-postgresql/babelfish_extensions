SELECT a = 10.12345678, b = 10.0/3.0, c = cast(10.2345 as decimal(38,6)) 
 , d = (cast(32 as decimal(38,6)) / cast(3 as decimal(38,6))), e = avg(10.0/3.0) 
 , f = avg(cast(10.2345 as decimal(38,6))) 
 into babel_5467_t1
go

