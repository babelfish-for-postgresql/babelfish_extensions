<row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><emp_name>Alice</emp_name><dept_name>Finance</dept_name><project_name>Budget Analysis</project_name><budget xsi:nil="true"/></row><row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><emp_name>Bob</emp_name><dept_name>IT</dept_name><project_name>Mobile App</project_name><budget>75000.00</budget></row><row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><emp_name>Bob</emp_name><dept_name>IT</dept_name><project_name>Website Redesign</project_name><budget>50000.00</budget></row><row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><emp_name>Charlie</emp_name><dept_name xsi:nil="true"/><project_name xsi:nil="true"/><budget xsi:nil="true"/></row><row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><emp_name>Diana</emp_name><dept_name>IT</dept_name><project_name xsi:nil="true"/><budget xsi:nil="true"/></row><row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><emp_name>Jane</emp_name><dept_name>HR</dept_name><project_name>HR System</project_name><budget>30000.00</budget></row><row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><emp_name>John</emp_name><dept_name>IT</dept_name><project_name>Mobile App</project_name><budget>75000.00</budget></row><row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><emp_name>John</emp_name><dept_name>IT</dept_name><project_name>Website Redesign</project_name><budget>50000.00</budget></row>
~~END~~


-- JOIN with WHERE clause
SELECT e.emp_name, d.dept_name, e.salary
FROM forxml_raw_elements_employees e
INNER JOIN forxml_raw_elements_departments d ON e.dept_id = d.dept_id
WHERE e.salary > 50000
ORDER BY e.emp_name
FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><emp_name>Alice</emp_name><dept_name>Finance</dept_name><salary>70000</salary></row><row><emp_name>Bob</emp_name><dept_name>IT</dept_name><salary>55000</salary></row><row><emp_name>Jane</emp_name><dept_name>HR</dept_name><salary>60000</salary></row>
~~END~~


-- JOIN with ORDER BY
SELECT e.emp_name, d.dept_name, e.salary
FROM forxml_raw_elements_employees e
INNER JOIN forxml_raw_elements_departments d ON e.dept_id = d.dept_id
ORDER BY e.salary DESC
FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><emp_name>Alice</emp_name><dept_name>Finance</dept_name><salary>70000</salary></row><row><emp_name>Jane</emp_name><dept_name>HR</dept_name><salary>60000</salary></row><row><emp_name>Bob</emp_name><dept_name>IT</dept_name><salary>55000</salary></row><row><emp_name>John</emp_name><dept_name>IT</dept_name><salary>50000</salary></row><row><emp_name>Diana</emp_name><dept_name>IT</dept_name></row>
~~END~~


-- JOIN with GROUP BY and aggregation
SELECT d.dept_name, COUNT(e.emp_id) AS emp_count, SUM(e.salary) AS total_salary
FROM forxml_raw_elements_departments d
LEFT JOIN forxml_raw_elements_employees e ON d.dept_id = e.dept_id
GROUP BY d.dept_name
ORDER BY d.dept_name
FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><dept_name>Finance</dept_name><emp_count>1</emp_count><total_salary>70000</total_salary></row><row><dept_name>HR</dept_name><emp_count>1</emp_count><total_salary>60000</total_salary></row><row><dept_name>IT</dept_name><emp_count>3</emp_count><total_salary>105000</total_salary></row><row><dept_name>Marketing</dept_name><emp_count>0</emp_count></row>
~~END~~


-- JOIN with GROUP BY and ELEMENTS XSINIL
SELECT d.dept_name, COUNT(e.emp_id) AS emp_count, AVG(e.salary) AS avg_salary
FROM forxml_raw_elements_departments d
LEFT JOIN forxml_raw_elements_employees e ON d.dept_id = e.dept_id
GROUP BY d.dept_name
ORDER BY d.dept_name
FOR XML RAW, ELEMENTS XSINIL;
GO
~~START~~
ntext
<row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><dept_name>Finance</dept_name><emp_count>1</emp_count><avg_salary>70000</avg_salary></row><row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><dept_name>HR</dept_name><emp_count>1</emp_count><avg_salary>60000</avg_salary></row><row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><dept_name>IT</dept_name><emp_count>3</emp_count><avg_salary>52500</avg_salary></row><row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><dept_name>Marketing</dept_name><emp_count>0</emp_count><avg_salary xsi:nil="true"/></row>
~~END~~


-- JOIN with TOP
SELECT TOP 3 e.emp_name, d.dept_name, e.salary
FROM forxml_raw_elements_employees e
INNER JOIN forxml_raw_elements_departments d ON e.dept_id = d.dept_id
ORDER BY e.salary DESC
FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><emp_name>Alice</emp_name><dept_name>Finance</dept_name><salary>70000</salary></row><row><emp_name>Jane</emp_name><dept_name>HR</dept_name><salary>60000</salary></row><row><emp_name>Bob</emp_name><dept_name>IT</dept_name><salary>55000</salary></row>
