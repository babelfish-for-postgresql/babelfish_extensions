<row><id>4</id><value>say "hello"</value></row>
~~END~~


SELECT * FROM forxml_raw_elements_t3 WHERE id = 5 FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><id>5</id><value>it's working</value></row>
~~END~~


SELECT * FROM forxml_raw_elements_t3 WHERE id = 6 FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><id>6</id><value>&lt;tag&gt;value&lt;/tag&gt;</value></row>
~~END~~


SELECT * FROM forxml_raw_elements_t3 WHERE id = 7 FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><id>7</id><value>   spaces   </value></row>
~~END~~


SELECT * FROM forxml_raw_elements_t3 WHERE id = 8 FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><id>8</id><value></value></row>
~~END~~


SELECT * FROM forxml_raw_elements_t3 FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><id>1</id><value>a &amp; b</value></row><row><id>2</id><value>a &lt; b</value></row><row><id>3</id><value>a &gt; b</value></row><row><id>4</id><value>say "hello"</value></row><row><id>5</id><value>it's working</value></row><row><id>6</id><value>&lt;tag&gt;value&lt;/tag&gt;</value></row><row><id>7</id><value>   spaces   </value></row><row><id>8</id><value></value></row>
~~END~~


SELECT * FROM forxml_raw_elements_t3 FOR XML RAW('SpecialChars'), ELEMENTS, ROOT('Data');
GO
~~START~~
ntext
<Data><SpecialChars><id>1</id><value>a &amp; b</value></SpecialChars><SpecialChars><id>2</id><value>a &lt; b</value></SpecialChars><SpecialChars><id>3</id><value>a &gt; b</value></SpecialChars><SpecialChars><id>4</id><value>say "hello"</value></SpecialChars><SpecialChars><id>5</id><value>it's working</value></SpecialChars><SpecialChars><id>6</id><value>&lt;tag&gt;value&lt;/tag&gt;</value></SpecialChars><SpecialChars><id>7</id><value>   spaces   </value></SpecialChars><SpecialChars><id>8</id><value></value></SpecialChars></Data>
~~END~~


-- Special character values directly
SELECT 'a & b' AS val FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><val>a &amp; b</val></row>
~~END~~


SELECT 'a < b' AS val FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><val>a &lt; b</val></row>
~~END~~


SELECT 'a > b' AS val FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><val>a &gt; b</val></row>
~~END~~



