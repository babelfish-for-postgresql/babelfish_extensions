
-- ============================================
-- SECTION 1: Basic ELEMENTS directive
-- ============================================
-- Basic ELEMENTS with two columns
SELECT 1 AS a, 2 AS b FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><a>1</a><b>2</b></row>
~~END~~


-- Regression: Without ELEMENTS (attribute format)
SELECT 1 AS a, 2 AS b FOR XML RAW;
GO
~~START~~
ntext
<row a="1" b="2"/>
~~END~~


-- ELEMENTS with three columns
SELECT 1 AS a, 2 AS b, 3 AS c FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><a>1</a><b>2</b><c>3</c></row>
~~END~~


-- ELEMENTS with single column
SELECT 1 AS a FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><a>1</a></row>
~~END~~


-- ELEMENTS with five columns
SELECT 1 AS a, 2 AS b, 3 AS c, 4 AS d, 5 AS e FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><a>1</a><b>2</b><c>3</c><d>4</d><e>5</e></row>
~~END~~


-- ELEMENTS with ten columns
SELECT 1 AS a, 2 AS b, 3 AS c, 4 AS d, 5 AS e, 6 AS f, 7 AS g, 8 AS h, 9 AS i, 10 AS j FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><a>1</a><b>2</b><c>3</c><d>4</d><e>5</e><f>6</f><g>7</g><h>8</h><i>9</i><j>10</j></row>
~~END~~



-- ============================================
-- SECTION 2: Custom element names
-- ============================================
SELECT 1 AS a, 2 AS b FOR XML RAW('item'), ELEMENTS;
GO
~~START~~
ntext
<item><a>1</a><b>2</b></item>
~~END~~


SELECT 1 AS a, 2 AS b FOR XML RAW('Employee'), ELEMENTS;
GO
~~START~~
ntext
<Employee><a>1</a><b>2</b></Employee>
~~END~~


SELECT 1 AS a, 2 AS b FOR XML RAW('my_element'), ELEMENTS;
GO
~~START~~
ntext
<my_element><a>1</a><b>2</b></my_element>
~~END~~


SELECT 1 AS a, 2 AS b FOR XML RAW('x'), ELEMENTS;
GO
~~START~~
ntext
<x><a>1</a><b>2</b></x>
~~END~~


SELECT 1 AS a, 2 AS b FOR XML RAW('element123'), ELEMENTS;
GO
~~START~~
ntext
<element123><a>1</a><b>2</b></element123>
~~END~~


SELECT 1 AS a, 2 AS b FOR XML RAW('UPPERCASE'), ELEMENTS;
GO
~~START~~
ntext
<UPPERCASE><a>1</a><b>2</b></UPPERCASE>
~~END~~


SELECT 1 AS a, 2 AS b FOR XML RAW('MixedCase'), ELEMENTS;
GO
~~START~~
ntext
<MixedCase><a>1</a><b>2</b></MixedCase>
~~END~~



-- ============================================
-- SECTION 3: NULL handling with ELEMENTS
-- ============================================
-- NULL in second column
SELECT 1 AS a, NULL AS b FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><a>1</a></row>
~~END~~


-- NULL in first column
SELECT NULL AS a, 2 AS b FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><b>2</b></row>
~~END~~


-- All NULL columns
SELECT NULL AS a, NULL AS b FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row/>
~~END~~


-- NULL in middle column
SELECT 1 AS a, NULL AS b, 3 AS c FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><a>1</a><c>3</c></row>
~~END~~


-- Multiple NULLs
SELECT NULL AS a, 2 AS b, NULL AS c FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><b>2</b></row>
~~END~~


-- All NULLs with four columns
SELECT NULL AS a, NULL AS b, NULL AS c, NULL AS d FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row/>
~~END~~



-- ============================================
-- SECTION 4: ELEMENTS ABSENT (default behavior)
-- ============================================
SELECT 1 AS a, NULL AS b FOR XML RAW, ELEMENTS ABSENT;
GO
~~START~~
ntext
<row><a>1</a></row>
~~END~~


SELECT NULL AS a, 2 AS b FOR XML RAW, ELEMENTS ABSENT;
GO
~~START~~
ntext
<row><b>2</b></row>
~~END~~


SELECT NULL AS a, NULL AS b FOR XML RAW, ELEMENTS ABSENT;
GO
~~START~~
ntext
<row/>
~~END~~


SELECT 1 AS a, NULL AS b, 3 AS c FOR XML RAW, ELEMENTS ABSENT;
GO
~~START~~
ntext
<row><a>1</a><c>3</c></row>
~~END~~



-- ============================================
-- SECTION 5: ELEMENTS XSINIL
-- ============================================
SELECT 1 AS a, NULL AS b FOR XML RAW, ELEMENTS XSINIL;
GO
~~START~~
ntext
<row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><a>1</a><b xsi:nil="true"/></row>
~~END~~


SELECT NULL AS a, 2 AS b FOR XML RAW, ELEMENTS XSINIL;
GO
~~START~~
ntext
<row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><a xsi:nil="true"/><b>2</b></row>
~~END~~


SELECT NULL AS a, NULL AS b FOR XML RAW, ELEMENTS XSINIL;
GO
~~START~~
ntext
<row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><a xsi:nil="true"/><b xsi:nil="true"/></row>
~~END~~


SELECT 1 AS a, NULL AS b, 3 AS c FOR XML RAW, ELEMENTS XSINIL;
GO
~~START~~
ntext
<row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><a>1</a><b xsi:nil="true"/><c>3</c></row>
~~END~~


SELECT NULL AS a, 2 AS b, NULL AS c FOR XML RAW, ELEMENTS XSINIL;
GO
~~START~~
ntext
<row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><a xsi:nil="true"/><b>2</b><c xsi:nil="true"/></row>
~~END~~


SELECT NULL AS a, NULL AS b, NULL AS c, NULL AS d FOR XML RAW, ELEMENTS XSINIL;
GO
~~START~~
ntext
<row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><a xsi:nil="true"/><b xsi:nil="true"/><c xsi:nil="true"/><d xsi:nil="true"/></row>
~~END~~



-- ============================================
-- SECTION 6: ELEMENTS with ROOT directive
-- ============================================
SELECT 1 AS a, 2 AS b FOR XML RAW, ELEMENTS, ROOT('data');
GO
~~START~~
ntext
<data><row><a>1</a><b>2</b></row></data>
~~END~~


SELECT 1 AS a, 2 AS b FOR XML RAW, ROOT('data'), ELEMENTS;
GO
~~START~~
ntext
<data><row><a>1</a><b>2</b></row></data>
~~END~~


SELECT 1 AS a, 2 AS b FOR XML RAW('item'), ELEMENTS, ROOT('items');
GO
~~START~~
ntext
<items><item><a>1</a><b>2</b></item></items>
~~END~~


SELECT 1 AS a, 2 AS b FOR XML RAW('item'), ROOT('items'), ELEMENTS;
GO
~~START~~
ntext
<items><item><a>1</a><b>2</b></item></items>
~~END~~


SELECT 1 AS a, NULL AS b FOR XML RAW, ELEMENTS XSINIL, ROOT('data');
GO
~~START~~
ntext
<data><row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><a>1</a><b xsi:nil="true"/></row></data>
~~END~~


SELECT 1 AS a, NULL AS b FOR XML RAW, ROOT('data'), ELEMENTS XSINIL;
GO
~~START~~
ntext
<data><row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><a>1</a><b xsi:nil="true"/></row></data>
~~END~~


SELECT 1 AS a, 2 AS b FOR XML RAW, ELEMENTS, ROOT('MyRoot');
GO
~~START~~
ntext
<MyRoot><row><a>1</a><b>2</b></row></MyRoot>
~~END~~


SELECT 1 AS a, 2 AS b FOR XML RAW, ELEMENTS, ROOT('root123');
GO
~~START~~
ntext
<root123><row><a>1</a><b>2</b></row></root123>
~~END~~



-- ============================================
-- SECTION 7: ELEMENTS with TYPE directive
-- ============================================
SELECT 1 AS a, 2 AS b FOR XML RAW, ELEMENTS, TYPE;
GO
~~START~~
xml
<row><a>1</a><b>2</b></row>
~~END~~


SELECT 1 AS a, 2 AS b FOR XML RAW, TYPE, ELEMENTS;
GO
~~START~~
xml
<row><a>1</a><b>2</b></row>
~~END~~


SELECT 1 AS a, 2 AS b FOR XML RAW('item'), ELEMENTS, TYPE;
GO
~~START~~
xml
<item><a>1</a><b>2</b></item>
~~END~~


SELECT 1 AS a, NULL AS b FOR XML RAW, ELEMENTS XSINIL, TYPE;
GO
~~START~~
xml
<row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><a>1</a><b xsi:nil="true"/></row>
~~END~~


SELECT 1 AS a, 2 AS b FOR XML RAW, ELEMENTS, ROOT('data'), TYPE;
GO
~~START~~
xml
<data><row><a>1</a><b>2</b></row></data>
~~END~~


SELECT 1 AS a, 2 AS b FOR XML RAW, TYPE, ROOT('data'), ELEMENTS;
GO
~~START~~
xml
<data><row><a>1</a><b>2</b></row></data>
~~END~~


SELECT 1 AS a, 2 AS b FOR XML RAW, ROOT('data'), TYPE, ELEMENTS;
GO
~~START~~
xml
<data><row><a>1</a><b>2</b></row></data>
~~END~~


SELECT 1 AS a, 2 AS b FOR XML RAW('item'), ROOT('items'), ELEMENTS, TYPE;
GO
~~START~~
xml
<items><item><a>1</a><b>2</b></item></items>
~~END~~



-- ============================================
-- SECTION 8: Table data with ELEMENTS
-- ============================================
SELECT * FROM forxml_raw_elements_t1 WHERE id = 1 FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><id>1</id><name>John</name><salary>50000</salary><department>IT</department></row>
~~END~~


SELECT * FROM forxml_raw_elements_t1 WHERE id <= 2 FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><id>1</id><name>John</name><salary>50000</salary><department>IT</department></row><row><id>2</id><name>Jane</name><salary>60000</salary><department>HR</department></row>
~~END~~


SELECT * FROM forxml_raw_elements_t1 FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><id>1</id><name>John</name><salary>50000</salary><department>IT</department></row><row><id>2</id><name>Jane</name><salary>60000</salary><department>HR</department></row><row><id>3</id><name>Bob</name><department>Finance</department></row><row><id>4</id><name>Alice</name><salary>70000</salary></row><row><id>5</id></row>
~~END~~


SELECT * FROM forxml_raw_elements_t1 WHERE id = 3 FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><id>3</id><name>Bob</name><department>Finance</department></row>
~~END~~


SELECT * FROM forxml_raw_elements_t1 WHERE id = 3 FOR XML RAW, ELEMENTS XSINIL;
GO
~~START~~
ntext
<row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><id>3</id><name>Bob</name><salary xsi:nil="true"/><department>Finance</department></row>
~~END~~


SELECT * FROM forxml_raw_elements_t1 WHERE id = 4 FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><id>4</id><name>Alice</name><salary>70000</salary></row>
~~END~~


SELECT * FROM forxml_raw_elements_t1 WHERE id = 4 FOR XML RAW, ELEMENTS XSINIL;
GO
~~START~~
ntext
<row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><id>4</id><name>Alice</name><salary>70000</salary><department xsi:nil="true"/></row>
~~END~~


SELECT * FROM forxml_raw_elements_t1 WHERE id = 5 FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><id>5</id></row>
~~END~~


SELECT * FROM forxml_raw_elements_t1 WHERE id = 5 FOR XML RAW, ELEMENTS XSINIL;
GO
~~START~~
ntext
<row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><id>5</id><name xsi:nil="true"/><salary xsi:nil="true"/><department xsi:nil="true"/></row>
~~END~~


SELECT * FROM forxml_raw_elements_t1 FOR XML RAW('Employee'), ELEMENTS;
GO
~~START~~
ntext
<Employee><id>1</id><name>John</name><salary>50000</salary><department>IT</department></Employee><Employee><id>2</id><name>Jane</name><salary>60000</salary><department>HR</department></Employee><Employee><id>3</id><name>Bob</name><department>Finance</department></Employee><Employee><id>4</id><name>Alice</name><salary>70000</salary></Employee><Employee><id>5</id></Employee>
~~END~~


SELECT * FROM forxml_raw_elements_t1 FOR XML RAW('Employee'), ELEMENTS, ROOT('Employees');
GO
~~START~~
ntext
<Employees><Employee><id>1</id><name>John</name><salary>50000</salary><department>IT</department></Employee><Employee><id>2</id><name>Jane</name><salary>60000</salary><department>HR</department></Employee><Employee><id>3</id><name>Bob</name><department>Finance</department></Employee><Employee><id>4</id><name>Alice</name><salary>70000</salary></Employee><Employee><id>5</id></Employee></Employees>
~~END~~


SELECT * FROM forxml_raw_elements_t1 FOR XML RAW('Employee'), ELEMENTS XSINIL, ROOT('Employees');
GO
~~START~~
ntext
<Employees><Employee xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><id>1</id><name>John</name><salary>50000</salary><department>IT</department></Employee><Employee xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><id>2</id><name>Jane</name><salary>60000</salary><department>HR</department></Employee><Employee xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><id>3</id><name>Bob</name><salary xsi:nil="true"/><department>Finance</department></Employee><Employee xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><id>4</id><name>Alice</name><salary>70000</salary><department xsi:nil="true"/></Employee><Employee xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><id>5</id><name xsi:nil="true"/><salary xsi:nil="true"/><department xsi:nil="true"/></Employee></Employees>
~~END~~


SELECT id, name FROM forxml_raw_elements_t1 FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><id>1</id><name>John</name></row><row><id>2</id><name>Jane</name></row><row><id>3</id><name>Bob</name></row><row><id>4</id><name>Alice</name></row><row><id>5</id></row>
~~END~~


SELECT name, salary FROM forxml_raw_elements_t1 FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><name>John</name><salary>50000</salary></row><row><name>Jane</name><salary>60000</salary></row><row><name>Bob</name></row><row><name>Alice</name><salary>70000</salary></row><row/>
~~END~~


SELECT id, salary FROM forxml_raw_elements_t1 WHERE salary IS NOT NULL FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><id>1</id><salary>50000</salary></row><row><id>2</id><salary>60000</salary></row><row><id>4</id><salary>70000</salary></row>
~~END~~



-- ============================================
-- SECTION 9: Multiple data types
-- ============================================
SELECT * FROM forxml_raw_elements_t2 WHERE col1 = 1 FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><col1>1</col1><col2>test</col2><col3>123.45</col3><col4>2024-01-15</col4><col5>1</col5></row>
~~END~~


SELECT * FROM forxml_raw_elements_t2 WHERE col1 = 2 FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><col1>2</col1></row>
~~END~~


SELECT * FROM forxml_raw_elements_t2 WHERE col1 = 2 FOR XML RAW, ELEMENTS XSINIL;
GO
~~START~~
ntext
<row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><col1>2</col1><col2 xsi:nil="true"/><col3 xsi:nil="true"/><col4 xsi:nil="true"/><col5 xsi:nil="true"/></row>
~~END~~


SELECT col1, col3 FROM forxml_raw_elements_t2 FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><col1>1</col1><col3>123.45</col3></row><row><col1>2</col1></row>
~~END~~


SELECT col1, col4 FROM forxml_raw_elements_t2 FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><col1>1</col1><col4>2024-01-15</col4></row><row><col1>2</col1></row>
~~END~~


SELECT col1, col5 FROM forxml_raw_elements_t2 FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><col1>1</col1><col5>1</col5></row><row><col1>2</col1></row>
~~END~~


SELECT 123 AS num FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><num>123</num></row>
~~END~~


SELECT 123.456 AS decimal_num FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><decimal_num>123.456</decimal_num></row>
~~END~~


SELECT 'hello' AS str FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><str>hello</str></row>
~~END~~


SELECT CAST('2024-01-15' AS DATE) AS date_val FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><date_val>2024-01-15</date_val></row>
~~END~~


SELECT CAST('2024-01-15 10:30:00' AS DATETIME) AS datetime_val FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><datetime_val>2024-01-15T10:30:00</datetime_val></row>
~~END~~


SELECT CAST(1 AS BIT) AS bit_val FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><bit_val>1</bit_val></row>
~~END~~


SELECT CAST(0 AS BIT) AS bit_val FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><bit_val>0</bit_val></row>
~~END~~


SELECT CAST(12345.67 AS MONEY) AS money_val FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><money_val>12345.6700</money_val></row>
~~END~~


SELECT CAST(123 AS BIGINT) AS bigint_val FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><bigint_val>123</bigint_val></row>
~~END~~


SELECT CAST(123 AS SMALLINT) AS smallint_val FOR XML RAW, ELEMENTS;
GO
~~START~~
ntext
<row><smallint_val>123</smallint_val></row>
~~END~~



