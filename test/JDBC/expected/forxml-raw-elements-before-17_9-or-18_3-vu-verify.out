-- INNER JOIN - basic
SELECT e.emp_id, e.emp_name, d.dept_name
FROM forxml_raw_elements_employees e
INNER JOIN forxml_raw_elements_departments d ON e.dept_id = d.dept_id
FOR XML RAW, ELEMENTS;
GO
