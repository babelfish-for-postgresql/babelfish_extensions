master#!#dbo#!#Very_Long_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_VU_TVC#!#short_col#!#12#!#varchar#!#50#!#50#!#<NULL>#!#<NULL>#!#1#!#<NULL>#!#<NULL>#!#12#!#<NULL>#!#50#!#2#!#YES#!#39
~~END~~

