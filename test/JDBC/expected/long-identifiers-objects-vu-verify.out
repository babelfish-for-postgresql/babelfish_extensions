-- BABEL-7239: sp_cursor_list and sp_describe_cursor report and find a cursor with a long name.
-- sp_cursor_list, long name
DECLARE @ref sysname, @cn sysname, @sc smallint, @st smallint, @mo smallint, @co smallint, @sl smallint, @os smallint, @cr numeric(10,0), @fs smallint, @cc smallint, @rc numeric(10,0), @lo smallint, @ch int;
DECLARE @r CURSOR;
DECLARE Very_Long_Catalog_Cursor_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_VU CURSOR LOCAL FOR SELECT 1 AS a;
OPEN Very_Long_Catalog_Cursor_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_VU;
EXEC sp_cursor_list @r OUTPUT, 3;
FETCH NEXT FROM @r INTO @ref, @cn, @sc, @st, @mo, @co, @sl, @os, @cr, @fs, @cc, @rc, @lo, @ch;
SELECT @ref, @cn;
CLOSE Very_Long_Catalog_Cursor_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_VU;
DEALLOCATE Very_Long_Catalog_Cursor_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_VU;
GO
~~START~~
varchar#!#varchar
very_long_catalog_cursor_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_vu#!#very_long_catalog_cursor_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_vu
~~END~~

-- sp_describe_cursor, long name (any case)
DECLARE @ref sysname, @cn sysname, @sc smallint, @st smallint, @mo smallint, @co smallint, @sl smallint, @os smallint, @cr numeric(10,0), @fs smallint, @cc smallint, @rc numeric(10,0), @lo smallint, @ch int;
DECLARE @r CURSOR;
DECLARE Very_Long_Catalog_Cursor_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_VU CURSOR LOCAL FOR SELECT 1 AS a;
OPEN Very_Long_Catalog_Cursor_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_VU;
EXEC sp_describe_cursor @r OUTPUT, N'local', N'VERY_LONG_CATALOG_CURSOR_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX_VU';
FETCH NEXT FROM @r INTO @ref, @cn, @sc, @st, @mo, @co, @sl, @os, @cr, @fs, @cc, @rc, @lo, @ch;
SELECT @ref, @cn;
CLOSE Very_Long_Catalog_Cursor_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_VU;
DEALLOCATE Very_Long_Catalog_Cursor_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_VU;
GO
~~START~~
varchar#!#varchar
very_long_catalog_cursor_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_vu#!#very_long_catalog_cursor_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_vu
~~END~~


