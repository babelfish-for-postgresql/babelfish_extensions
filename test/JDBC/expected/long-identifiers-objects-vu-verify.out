-- ===========================================
-- BABEL-5975: OBJECT_NAME() must return the resolved long identifier in its
-- physical (lowercased) form for tables, views, and indexes. OBJECT_ID()
-- accepts the original name; OBJECT_NAME() reports the downcased name.
-- ===========================================
-- OBJECT_NAME() for a long table name
SELECT OBJECT_NAME(OBJECT_ID('Very_Long_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_VU_TVC'));
GO
~~START~~
varchar
very_long_table_name_that_exceeds_postgresql_limit_of_sixty_three_characters_vu_tvc
~~END~~


-- OBJECT_NAME() for a long view name
SELECT OBJECT_NAME(OBJECT_ID('Very_Long_View_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_VU_TVC'));
GO
~~START~~
varchar
very_long_view_name_that_exceeds_postgresql_limit_of_sixty_three_characters_vu_tvc
~~END~~




-- Note: OBJECT_NAME() for a long INDEX name shares the same RELKIND_INDEX /
-- get_original_relname downcasing path as the table/view cases above; the
-- displayed (lowercased) index name is already covered by the sys.indexes
-- query earlier in this file. OBJECT_ID() does not resolve index names and the
-- T-SQL parser rejects pg_class alias subqueries, so no separate OBJECT_NAME
-- index case is added here.
-- ===========================================
-- Catalog sweep: tables/constraints/columns with long (>=64 byte) names must
-- show the original name, not the truncated+md5 hashed physical name, across
-- sys.indexes, COL_NAME, sys.computed_columns, INFORMATION_SCHEMA.TABLE_CONSTRAINTS/
-- KEY_COLUMN_USAGE/CONSTRAINT_COLUMN_USAGE, sp_pkeys_view, sp_fkeys_view,
-- sp_sproc_columns_view, and INFORMATION_SCHEMA.COLUMNS/COLUMN_DOMAIN_USAGE.DOMAIN_NAME.
-- ===========================================
-- Verify the backing index of an inline long-named PK shows the original
-- constraint name in sys.indexes, not the truncated+hashed physical name.
SELECT name FROM sys.indexes WHERE object_id = OBJECT_ID('Very_Long_Catalog_Parent_Table_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Chars_VU_TVC') AND name IS NOT NULL;
GO
~~START~~
varchar
Very_Long_Catalog_Parent_Pk_Constraint_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Chars_VU_TVC
~~END~~


-- Verify COL_NAME returns the original column name, not the hashed one.
SELECT COL_NAME(OBJECT_ID('Very_Long_Catalog_Column_Table_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Chars_VU_TVC'), 1);
GO
~~START~~
varchar
very_long_catalog_column_name_that_exceeds_postgresql_limit_of_sixty_three_chars_vu_tvc
~~END~~


-- Verify sys.computed_columns.definition deparses the original column name.
SELECT definition FROM sys.computed_columns WHERE object_id = OBJECT_ID('Very_Long_Catalog_Computed_Table_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Chars_VU_TVC');
GO
~~START~~
nvarchar
("Very_Long_Catalog_Base_Column_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_VU_TVC" * 2)
~~END~~


-- Verify INFORMATION_SCHEMA.TABLE_CONSTRAINTS.TABLE_NAME shows the original name.
SELECT CONSTRAINT_NAME, TABLE_NAME FROM INFORMATION_SCHEMA.TABLE_CONSTRAINTS WHERE TABLE_NAME = 'Very_Long_Catalog_Parent_Table_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Chars_VU_TVC';
GO
~~START~~
varchar#!#varchar
very_long_catalog_parent_pk_constraint_that_exceeds_postgresql_limit_of_sixty_chars_vu_tvc#!#very_long_catalog_parent_table_that_exceeds_postgresql_limit_of_sixty_chars_vu_tvc
~~END~~


-- Verify INFORMATION_SCHEMA.KEY_COLUMN_USAGE.TABLE_NAME shows the original name.
SELECT TABLE_NAME, COLUMN_NAME, CONSTRAINT_NAME FROM INFORMATION_SCHEMA.KEY_COLUMN_USAGE WHERE TABLE_NAME = 'Very_Long_Catalog_Parent_Table_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Chars_VU_TVC';
GO
~~START~~
nvarchar#!#nvarchar#!#nvarchar
very_long_catalog_parent_table_that_exceeds_postgresql_limit_of_sixty_chars_vu_tvc#!#id#!#very_long_catalog_parent_pk_constraint_that_exceeds_postgresql_limit_of_sixty_chars_vu_tvc
~~END~~


-- Verify INFORMATION_SCHEMA.CONSTRAINT_COLUMN_USAGE shows original names for all three columns.
SELECT CONSTRAINT_NAME, TABLE_NAME, COLUMN_NAME FROM INFORMATION_SCHEMA.CONSTRAINT_COLUMN_USAGE WHERE TABLE_NAME = 'Very_Long_Catalog_Parent_Table_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Chars_VU_TVC';
GO
~~START~~
