Positive#!#5#!#0.0000#!#922337203685477.5807#!#1.8446744073718022E14
Negative#!#2#!#-922337203685477.5808#!#-100.0000#!#-4.611686018427888E14
~~END~~


-- HAVING clause tests
SELECT MoneyVal, COUNT(*) as Count 
FROM MoneyComparisonTest 
GROUP BY MoneyVal
HAVING MoneyVal > 0;
