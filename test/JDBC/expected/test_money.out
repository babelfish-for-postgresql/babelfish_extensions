-- GROUP BY with aggregates
SELECT 
    CASE 
        WHEN MoneyVal >= 0 THEN 'Positive'
        ELSE 'Negative'
    END AS ValueType,
    COUNT(*) as Count,
    MIN(MoneyVal) as MinValue,
    MAX(MoneyVal) as MaxValue,
    AVG(CAST(MoneyVal AS FLOAT)) as AvgValue
FROM MoneyComparisonTest 
GROUP BY CASE 
    WHEN MoneyVal >= 0 THEN 'Positive'
    ELSE 'Negative'
END;
GO
~~START~~
