2#!#200.0000#!#200.00#!#Positive Decimal
3#!#-100.0000#!#-100.00#!#Negative Decimal
4#!#922337203685477.5807#!#922337203685477.58#!#Positive Decimal
5#!#-922337203685477.5808#!#-922337203685477.58#!#Negative Decimal
6#!#0.0000#!#0.00#!#Positive Decimal
7#!#123.4500#!#123.45#!#Positive Decimal
~~END~~


-- Rounding comparison tests
SELECT 
    ID,
    MoneyVal,
    ROUND(MoneyVal, 0) AS RoundedToInteger,
    CASE 
        WHEN MoneyVal = ROUND(MoneyVal, 0) THEN 'Whole Number'
        ELSE 'Decimal Number'
    END AS NumberType
FROM MoneyComparisonTest;
GO
