-- Drop computed column table first (depends on xml_query_wrapper function)
DROP TABLE IF EXISTS xml_query_computed_t1;
GO

-- Drop functions
DROP FUNCTION IF EXISTS xml_query_func1;
GO
DROP FUNCTION IF EXISTS xml_query_func2;
GO
DROP FUNCTION IF EXISTS xml_query_itvf_func;
GO
DROP FUNCTION IF EXISTS xml_query_wrapper;
