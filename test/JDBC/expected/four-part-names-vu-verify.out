SET
Table_A.a = Table_B.a + 100,
Table_A.b = Table_B.b + CAST(Table_B.a AS varchar(5))
FROM
fpn_table_insert_into AS Table_A
INNER JOIN bbf_fpn_server.master.dbo.fpn_table AS Table_B
ON Table_A.a = Table_B.a
WHERE
Table_A.a < 3
