CREATE TABLE TV1 (a int, b int);
GO

CREATE TABLE TV2 (id int, id1 int);
GO

INSERT INTO TV1 VALUES (1, 2), (3, 4);
GO
~~ROW COUNT: 2~~


INSERT INTO TV2 VALUES (1, 10), (3, 20);
GO
~~ROW COUNT: 2~~


CREATE VIEW V1 AS SELECT a FROM TV1;
GO

CREATE VIEW V2 AS SELECT * FROM V1;
GO

CREATE VIEW V3 AS SELECT a FROM TV1 JOIN TV2 ON TV1.a = TV2.id;
GO
