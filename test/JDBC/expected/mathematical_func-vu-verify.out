-- Test DEGREES function with MONEY/SMALLMONEY
SELECT DEGREES(CAST(PI()/2 AS MONEY)) AS result1, DEGREES(CAST(PI()/2 AS SMALLMONEY)) AS result2;
GO
~~START~~
money#!#money
90.0002#!#90.0002
~~END~~


SELECT DEGREES(CAST(PI() AS MONEY)) AS result1, DEGREES(CAST(PI() AS SMALLMONEY)) AS result2;
GO
~~START~~
money#!#money
180.0004#!#180.0004
~~END~~


SELECT DEGREES(CAST(1.0 AS MONEY)) AS result1, DEGREES(CAST(1.0 AS SMALLMONEY)) AS result2;
GO
~~START~~
money#!#money
57.2958#!#57.2958
~~END~~


SELECT DEGREES(CAST(0.0 AS MONEY)) AS result1, DEGREES(CAST(0.0 AS SMALLMONEY)) AS result2;
GO
~~START~~
money#!#money
0.0000#!#0.0000
~~END~~


SELECT DEGREES(CAST(PI()/2.0 AS MONEY)) AS result1, DEGREES(CAST(PI()/2.0 AS SMALLMONEY)) AS result2;
GO
~~START~~
money#!#money
90.0002#!#90.0002
~~END~~


SELECT DEGREES(CAST(-PI()/2 AS MONEY)) AS result1, DEGREES(CAST(-PI()/2 AS SMALLMONEY)) AS result2;
GO
~~START~~
money#!#money
-90.0002#!#-90.0002
~~END~~


SELECT DEGREES(CAST(-PI() AS MONEY)) AS result1, DEGREES(CAST(-PI() AS SMALLMONEY)) AS result2;
GO
~~START~~
money#!#money
-180.0004#!#-180.0004
~~END~~


SELECT DEGREES(CAST(0 AS MONEY)) AS result1, DEGREES(CAST(0 AS SMALLMONEY)) AS result2;
GO
~~START~~
money#!#money
0.0000#!#0.0000
~~END~~


SELECT DEGREES(CAST(16097821017949.1657 AS MONEY)) AS 'Max_Money';
GO
~~START~~
money
922337203685477.5766
~~END~~


SELECT DEGREES(CAST(16097821017949.1658 AS MONEY)) AS 'overflow';
GO
~~START~~
money
