-- Test Case 2.1.3: Deep nesting (3+ levels)
USE db_nested_ref_v2;
GO
CREATE FUNCTION schema_nest1_v2.level1_func()
RETURNS INT
AS
BEGIN
    RETURN 1;
END;
GO

CREATE FUNCTION schema_nest1_v2.level2_func()
RETURNS INT
AS
BEGIN
    RETURN schema_nest1_v2.level1_func() + 1;
END;
GO

CREATE FUNCTION schema_nest1_v2.level3_func()
RETURNS INT
AS
BEGIN
    RETURN schema_nest1_v2.level2_func() + 1;
END;
