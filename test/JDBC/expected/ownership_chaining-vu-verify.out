---------------------------------------------------------
-- Testing Dynamic SQL (LIMITATIONS IDENTIFIED)
---------------------------------------------------------
-- Test Case: Simple dynamic SQL in stored procedure
USE db_missing_tests_v2;
GO
CREATE PROCEDURE schema_test_a_v2.dynamic_select_proc(@table_name NVARCHAR(50))
AS
BEGIN
    DECLARE @sql NVARCHAR(MAX);
    SET @sql = N'SELECT COUNT(*) FROM schema_test_a_v2.' + @table_name;
    EXEC sp_executesql @sql;
END;
GO

-- Grant execute permission
GRANT EXECUTE ON schema_test_a_v2.dynamic_select_proc TO user_test_b_v2;
GO
-- terminate-tsql-conn user=login_test_a_v2 password=[REDACTED:PASSWORD]

-- tsql user=login_test_b_v2 password=[REDACTED:PASSWORD]
-- Test as user_test_b_v2
USE db_missing_tests_v2;
GO
-- NOTE: This may fail because dynamic SQL might not follow ownership chaining rules
EXEC schema_test_a_v2.dynamic_select_proc 'products';
GO
