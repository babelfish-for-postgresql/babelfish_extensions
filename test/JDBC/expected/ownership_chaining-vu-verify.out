---------------------------------------------------------
-- SECTION 2: NESTED OBJECT REFERENCES (CORRECTED)
---------------------------------------------------------
CREATE DATABASE db_nested_ref_v2;
GO
USE db_nested_ref_v2;
GO

-- Create test logins and users
CREATE LOGIN login_nest1_v2 WITH PASSWORD = '[REDACTED:PASSWORD]';
CREATE LOGIN login_nest2_v2 WITH PASSWORD = '[REDACTED:PASSWORD]';
CREATE LOGIN login_nest3_v2 WITH PASSWORD = '[REDACTED:PASSWORD]';
GO

CREATE USER user_nest1_v2 FOR LOGIN login_nest1_v2;
CREATE USER user_nest2_v2 FOR LOGIN login_nest2_v2;
CREATE USER user_nest3_v2 FOR LOGIN login_nest3_v2;
GO

-- Grant database access
GRANT CONNECT TO user_nest1_v2;
GRANT CONNECT TO user_nest2_v2;
GRANT CONNECT TO user_nest3_v2;
GO

-- Create schemas
CREATE SCHEMA schema_nest1_v2 AUTHORIZATION user_nest1_v2;
CREATE SCHEMA schema_nest2_v2 AUTHORIZATION user_nest2_v2;
go
-- terminate-tsql-conn


-- tsql user=login_nest1_v2 password=[REDACTED:PASSWORD]
---------------------------------------------------------
-- 2.1 Function Nesting
---------------------------------------------------------
-- Test Case 2.1.1: Function calling another function (same owner)
USE db_nested_ref_v2;
GO

CREATE FUNCTION schema_nest1_v2.inner_func1()
RETURNS INT
AS
BEGIN
    RETURN 42;
END;
GO

CREATE FUNCTION schema_nest1_v2.outer_func1()
RETURNS INT
AS
BEGIN
    RETURN schema_nest1_v2.inner_func1() + 10;
END;
GO

-- Grant EXECUTE permission on outer function only
-- Do NOT grant permission on inner_func1 to test ownership chaining
GRANT EXECUTE ON schema_nest1_v2.outer_func1 TO user_nest2_v2;
GO
-- terminate-tsql-conn user=login_nest1_v2 password=[REDACTED:PASSWORD]

-- tsql user=login_nest2_v2 password=[REDACTED:PASSWORD]
-- Test as user_nest2_v2
USE db_nested_ref_v2;
GO
SELECT schema_nest1_v2.outer_func1();  -- Should succeed through ownership chain
GO
~~START~~
int
52
~~END~~

SELECT schema_nest1_v2.inner_func1();  -- Should fail (no direct permission)
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: permission denied for function inner_func1)~~

-- terminate-tsql-conn user=login_nest2_v2 password=[REDACTED:PASSWORD]

-- tsql user=login_nest2_v2 password=[REDACTED:PASSWORD]
-- Test Case 2.1.2: Function calling multiple functions (mixed ownership)
USE db_nested_ref_v2;
GO
CREATE FUNCTION schema_nest2_v2.func_nest2()
RETURNS INT
AS
BEGIN
    RETURN 20;
END;
GO
-- terminate-tsql-conn user=login_nest2_v2 password=[REDACTED:PASSWORD]

-- tsql user=login_nest1_v2 password=[REDACTED:PASSWORD]
USE db_nested_ref_v2;
GO
CREATE FUNCTION schema_nest1_v2.mixed_func()
RETURNS INT
AS
BEGIN
    RETURN schema_nest1_v2.inner_func1() + schema_nest2_v2.func_nest2();  -- Mixed ownership
END;
GO

-- Test
SELECT schema_nest1_v2.mixed_func();  -- Should fail due to broken ownership chain
GO
~~START~~
int
~~ERROR (Code: 33557097)~~

~~ERROR (Message: permission denied for function func_nest2)~~

