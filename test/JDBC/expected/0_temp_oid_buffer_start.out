-- tsql
-- create a temp view for easier access to pg_db_role_setting
CREATE VIEW db_role_settings_view
AS
SELECT setdatabase AS db, setrole AS role, unnest(setconfig) AS setting
FROM pg_db_role_setting
ORDER BY db;
GO

CREATE VIEW unnested_db_role_settings_view
AS
SELECT db, role, 
substring(setting, 1, charindex('=',setting)-1) as setting, 
substring(setting, charindex('=',setting)+1) as value
FROM db_role_settings_view
ORDER BY db;
GO

SELECT * FROM unnested_db_role_settings_view;
GO
