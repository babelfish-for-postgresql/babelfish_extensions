-- tsql
-- create a temp view for easier access to pg_db_role_setting
CREATE VIEW db_role_settings_view
AS
SELECT unnest(setconfig) AS setting
FROM pg_db_role_setting;
GO

CREATE VIEW unnested_db_role_settings_view
AS
SELECT
substring(setting, 1, charindex('=',setting)-1) as setting, 
substring(setting, charindex('=',setting)+1) as value
FROM db_role_settings_view
ORDER BY setting;
GO

SELECT * FROM unnested_db_role_settings_view;
GO
~~START~~
varchar#!#text
TimeZone#!#utc
auto_explain.log_min_duration#!#-1
auto_explain.log_min_duration#!#-1
babelfishpg_tsql.enable_ownership_structure#!#true
default_tablespace#!#
event_triggers#!#on
exit_on_error#!#0
idle_session_timeout#!#0
log_min_error_statement#!#debug5
log_min_messages#!#panic
log_min_messages#!#panic
log_statement#!#all
role#!#rdsadmin
search_path#!#pg_catalog, public
statement_timeout#!#0
stats_fetch_consistency#!#snapshot
synchronous_commit#!#on
temp_file_limit#!#-1
~~END~~



-- set all escape hatches to ignore to populate db_role_settings
-- do this within a transaction to simply rollback at end of test
BEGIN TRAN
GO

SP_BABELFISH_CONFIGURE '%', 'ignore', 'server'
GO

-- check all escape hatches
SELECT setting,
CASE setting
	WHEN 'babelfishpg_tsql.temp_oid_buffer_start' 
		THEN CASE value WHEN '-2147483648' THEN 'n' ELSE 'y' END
	ELSE value
END AS value
FROM unnested_db_role_settings_view
GO
