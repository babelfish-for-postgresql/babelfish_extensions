-- check that the temp_oid_buffer_start should now be set
SELECT db,role,setting,
CASE setting
	WHEN 'babelfishpg_tsql.temp_oid_buffer_start' 
		THEN CASE value WHEN '-2147483648' THEN 'n' ELSE 'y' END
	ELSE value
END AS value
FROM unnested_db_role_settings_view
WHERE setting = 'babelfishpg_tsql.temp_oid_buffer_start';
GO
~~START~~
int#!#int#!#varchar#!#text
16406#!#0#!#babelfishpg_tsql.temp_oid_buffer_start#!#y
~~END~~


ROLLBACK TRAN
GO

-- check that the temp_oid_buffer_start should not be set anymore
SELECT db,role,setting,
CASE setting
	WHEN 'babelfishpg_tsql.temp_oid_buffer_start' 
		THEN CASE value WHEN '-2147483648' THEN 'n' ELSE 'y' END
	ELSE value
END AS value
FROM unnested_db_role_settings_view
WHERE setting = 'babelfishpg_tsql.temp_oid_buffer_start';
GO
~~START~~
int#!#int#!#varchar#!#text
~~END~~


DROP VIEW unnested_db_role_settings_view;
GO

DROP VIEW db_role_settings_view;
GO

CREATE LOGIN testlogin WITH PASSWORD='12345678';
GO

-- tsql user=testlogin password=12345678
BEGIN TRAN
GO

SELECT SUSER_NAME();
GO
~~START~~
nvarchar
testlogin
~~END~~

CREATE TABLE #temp_table(a INT)
GO
SELECT SUSER_NAME();
GO
~~START~~
nvarchar
testlogin
~~END~~


ROLLBACK TRAN
GO

-- terminate-tsql-conn user=testlogin password=12345678
-- tsql
DROP LOGIN testlogin;
GO
