create type bbf_tvp_reuse_type as table (id int, v varchar(50))
create table bbf_tvp_reuse_target (id int, v varchar(50))
create procedure bbf_tvp_reuse_insert @t bbf_tvp_reuse_type readonly as begin insert into bbf_tvp_reuse_target select id, v from @t end

