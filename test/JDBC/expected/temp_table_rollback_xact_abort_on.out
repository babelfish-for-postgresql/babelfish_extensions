int#!#int
~~END~~

~~START~~
int
~~END~~


CREATE TRIGGER basetrig_rollback ON basetab
    FOR INSERT, UPDATE, DELETE
AS
    INSERT INTO #t1 VALUES (2)
    ROLLBACK
GO

INSERT INTO basetab VALUES (3, 4)
GO
~~ROW COUNT: 1~~

~~ROW COUNT: 1~~

