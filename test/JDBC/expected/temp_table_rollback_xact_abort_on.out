#idx2_intermediate#t_intermedia4737c0efb12593904c8c76e1baf5043f
#t
#t1
#t2
#t_intermediate
#t_intermediate_pkey
~~END~~


-- Drop user-created index
DROP INDEX #idx1_intermediate ON #t_intermediate;
go

-- Insert should work
INSERT INTO #t_intermediate VALUES (1, 2, 3);
go
