---------------------------------------------------------------------------
CREATE TABLE #t1(a int)
GO



BEGIN TRAN
INSERT INTO #t1 VALUES (1)
COMMIT
BEGIN TRAN
UPDATE #t1 SET a = 2 WHERE a = 1
COMMIT
BEGIN TRAN
DROP TABLE #t1
ROLLBACK
GO
