varchar
Match
~~END~~


SELECT 
CASE 
    WHEN OBJECT_ID('tempdb..unq_name_temp') = OBJECT_ID('tempdb..unq_name_temp', 'uq')
    THEN 'Match'
    ELSE 'No Match'
END AS Result;
GO
~~START~~
varchar
Match
~~END~~


SELECT 
CASE 
    WHEN OBJECT_ID('tempdb..#object_id_conflict_temp') = OBJECT_ID('tempdb..#object_id_conflict_temp', 'u')
    THEN 'Match'
    ELSE 'No Match'
END AS Result;
