-- Checking if there are any issues if the warning message buffer is of edge case lengths
-- Here we will execute a SQL Batch that will send a warning message of the format
-- "Wrong LockOwner for lock resource \'%s\', it is a Transaction lock."
-- To get above message of length 127, @Resource = 64 characters
BEGIN TRAN
SELECT sys.sp_getapplock_function('cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc', 'shared');
SELECT sys.sp_releaseapplock_function('cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc', 'SESSION');
COMMIT
GO
~~START~~
int
0
~~END~~

~~START~~
int
-999
~~END~~


-- To get above message of length 128, @Resource = 65 characters
BEGIN TRAN
SELECT sys.sp_getapplock_function('ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc', 'shared');
SELECT sys.sp_releaseapplock_function('ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc', 'SESSION');
COMMIT
GO
~~START~~
int
0
~~END~~

~~START~~
int
-999
~~END~~


