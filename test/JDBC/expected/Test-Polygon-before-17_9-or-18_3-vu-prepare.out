# Geometry Test Cases

CREATE TABLE GEOSPATIALPOLYGONGEOM_dt (location geometry)
ALTER TABLE GEOSPATIALPOLYGONGEOM_dt ADD id INT IDENTITY(1,1);

# Positive Test for STGeomFromText with SRID 4326
INSERT INTO GEOSPATIALPOLYGONGEOM_dt (location) VALUES (geometry::STGeomFromText('POLYGON((1 1, 1 2, 2 2, 1 1))', 4326));
~~ROW COUNT: 1~~

