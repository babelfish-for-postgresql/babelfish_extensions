CREATE VIEW DimOfGeographypolygon AS SELECT location.STAsText() AS geography, location.STDimension() AS dimension FROM GEOSPATIALPOLYGONGEOG_dt ORDER BY id;

CREATE VIEW AreaOfGeographypolygon AS SELECT location.STAsText() AS geography, location.STArea() AS area FROM GEOSPATIALPOLYGONGEOG_dt ORDER BY id;

CREATE VIEW TextFromGeographypolygon AS SELECT location.STAsText() AS text FROM GEOSPATIALPOLYGONGEOG_dt ORDER BY id;

CREATE VIEW BinaryFromGeographypolygon AS SELECT location.STAsText() AS geography, location.STAsBinary() AS binary FROM GEOSPATIALPOLYGONGEOG_dt ORDER BY id;

CREATE VIEW SridFromGeographypolygon AS SELECT location.STAsText() AS geography, location.STSrid AS srid FROM GEOSPATIALPOLYGONGEOG_dt ORDER BY id;

CREATE VIEW EmptyGeographypolygon AS SELECT location.STAsText() AS geography, location.STIsEmpty() AS isempty FROM GEOSPATIALPOLYGONGEOG_dt ORDER BY id;

CREATE VIEW ValidGeographypolygon AS SELECT location.STAsText() AS geography, location.STIsValid() AS isvalid FROM GEOSPATIALPOLYGONGEOG_dt ORDER BY id;

CREATE VIEW ClosedGeographypolygon AS SELECT location.STAsText() AS geography, location.STIsClosed() AS isclosed FROM GEOSPATIALPOLYGONGEOG_dt ORDER BY id;

CREATE VIEW DisjointTempGeogpolygon AS SELECT p1.location.STAsText() AS geography1, p2.location.STAsText() AS geography2, p1.location.STDisjoint(p2.location) AS disjoints FROM GEOSPATIALPOLYGONGEOG_dt p1 CROSS JOIN GEOSPATIALPOLYGONGEOG_dt p2 ORDER BY p1.id;

CREATE VIEW DistanceTempGeogpolygon AS SELECT p1.location.STAsText() AS geography1, p2.location.STAsText() AS geography2,  CAST(STDistance( p1.location, p2.location ) AS numeric(20, 6)) AS distance FROM GEOSPATIALPOLYGONGEOG_dt p1 CROSS JOIN GEOSPATIALPOLYGONGEOG_dt p2 ORDER BY p1.id;

CREATE VIEW IntersectsTempGeogpolygon AS SELECT p1.location.STAsText() AS geography1, p2.location.STAsText() AS geography2, p1.location.STIntersects(p2.location) AS interesecting FROM GEOSPATIALPOLYGONGEOG_dt p1 CROSS JOIN GEOSPATIALPOLYGONGEOG_dt p2 ORDER BY p1.id;

CREATE VIEW EqualsTempGeogpolygon AS SELECT p1.location.STAsText() AS geography1, p2.location.STAsText() AS geography2, p1.location.STEquals(p2.location) AS equals FROM GEOSPATIALPOLYGONGEOG_dt p1 CROSS JOIN GEOSPATIALPOLYGONGEOG_dt p2 ORDER BY p1.id;

CREATE VIEW ContainTempGeogpolygon AS SELECT p1.location.STAsText() AS geography1, p2.location.STAsText() AS geography2, p1.location.STContains(p2.location) AS contain FROM GEOSPATIALPOLYGONGEOG_dt p1 CROSS JOIN GEOSPATIALPOLYGONGEOG_dt p2 ORDER BY p1.id;

CREATE VIEW equals_opgeogpolygon AS SELECT p1.location AS point FROM GEOSPATIALPOLYGONGEOG_dt p1 CROSS JOIN GEOSPATIALPOLYGONGEOG_dt p2 WHERE p1.location = p2.location ORDER BY p1.id;

CREATE VIEW notequal_opgeogpolygon AS SELECT p1.location AS point FROM GEOSPATIALPOLYGONGEOG_dt p1 CROSS JOIN GEOSPATIALPOLYGONGEOG_dt p2 WHERE p1.location <> p2.location ORDER BY p1.id;


CREATE VIEW DisjointTempGeogpolysr AS SELECT p1.location.STAsText() AS geography1, p2.location.STAsText() AS geography2, p1.location.STDisjoint(p2.location) AS disjoints FROM GEOSPATIALPOLYGONGEOG_dt p1 CROSS JOIN geospatialpointxgeog_polysr p2 ORDER BY p1.id;

CREATE VIEW DistanceTempGeogpolysr AS SELECT p1.location.STAsText() AS geography1, p2.location.STAsText() AS geography2,  CAST(STDistance( p1.location, p2.location ) AS numeric(20, 6)) AS distance FROM GEOSPATIALPOLYGONGEOG_dt p1 CROSS JOIN geospatialpointxgeog_polysr p2 ORDER BY p1.id;

CREATE VIEW IntersectsTempGeogpolysr AS SELECT p1.location.STAsText() AS geography1, p2.location.STAsText() AS geography2, p1.location.STIntersects(p2.location) AS interesecting FROM GEOSPATIALPOLYGONGEOG_dt p1 CROSS JOIN geospatialpointxgeog_polysr p2 ORDER BY p1.id;

CREATE VIEW EqualsTempGeogpolysr AS SELECT p1.location.STAsText() AS geography1, p2.location.STAsText() AS geography2, p1.location.STEquals(p2.location) AS equals FROM GEOSPATIALPOLYGONGEOG_dt p1 CROSS JOIN geospatialpointxgeog_polysr p2 ORDER BY p1.id;

CREATE VIEW ContainTempGeogpolysr AS SELECT p1.location.STAsText() AS geography1, p2.location.STAsText() AS geography2, p1.location.STContains(p2.location) AS contain FROM GEOSPATIALPOLYGONGEOG_dt p1 CROSS JOIN geospatialpointxgeog_polysr p2 ORDER BY p1.id;

CREATE VIEW equals_opgeogpolysr AS SELECT p1.location AS point FROM GEOSPATIALPOLYGONGEOG_dt p1 CROSS JOIN geospatialpointxgeog_polysr p2 WHERE p1.location = p2.location ORDER BY p1.id;

CREATE VIEW notequal_opgeogpolysr AS SELECT p1.location AS point FROM GEOSPATIALPOLYGONGEOG_dt p1 CROSS JOIN geospatialpointxgeog_polysr p2 WHERE p1.location <> p2.location ORDER BY p1.id;

CREATE VIEW PolygonGeogFromText AS SELECT geography::STPolyFromText('POLYGON((3 5, 2 4, 3 5, 3 5))', 4326) AS geom1, geography::STPolyFromText('POLYGON((1 3, 5 7, 4 5, 1 3))', 4326) AS geom2;



