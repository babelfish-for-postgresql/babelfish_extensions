CREATE VIEW DimOfGeometrypolygon AS SELECT location.STAsText() AS geometry, location.STDimension() AS dimension FROM GEOSPATIALPOLYGONGEOM_dt ORDER BY id;

CREATE VIEW AreaOfGeometrypolygon AS SELECT location.STAsText() AS geometry, location.STArea() AS area FROM GEOSPATIALPOLYGONGEOM_dt ORDER BY id;

CREATE VIEW TextFromGeometrypolygon AS SELECT location.STAsText() AS text FROM GEOSPATIALPOLYGONGEOM_dt ORDER BY id;

CREATE VIEW BinaryFromGeometrypolygon AS SELECT location.STAsText() AS geometry, location.STAsBinary() AS binary FROM GEOSPATIALPOLYGONGEOM_dt ORDER BY id;

CREATE VIEW SridFromGeometrypolygon AS SELECT location.STAsText() AS geometry, location.STSrid AS srid FROM GEOSPATIALPOLYGONGEOM_dt ORDER BY id;

CREATE VIEW EmptyGeometrypolygon AS SELECT location.STAsText() AS geometry, location.STIsEmpty() AS isempty FROM GEOSPATIALPOLYGONGEOM_dt ORDER BY id;

CREATE VIEW ValidGeometrypolygon AS SELECT location.STAsText() AS geometry, location.STIsValid() AS isvalid FROM GEOSPATIALPOLYGONGEOM_dt ORDER BY id;

CREATE VIEW ClosedGeometrypolygon AS SELECT location.STAsText() AS geometry, location.STIsClosed() AS isclosed FROM GEOSPATIALPOLYGONGEOM_dt ORDER BY id;

CREATE VIEW DisjointTempGeompolygon AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STDisjoint(p2.location) AS disjoints FROM GEOSPATIALPOLYGONGEOM_dt p1 CROSS JOIN GEOSPATIALPOLYGONGEOM_dt p2 ORDER BY p1.id;

CREATE VIEW DistanceTempGeompolygon AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2,  CAST(STDistance( p1.location, p2.location ) AS numeric(20, 6)) AS distance FROM GEOSPATIALPOLYGONGEOM_dt p1 CROSS JOIN GEOSPATIALPOLYGONGEOM_dt p2 ORDER BY p1.id;

CREATE VIEW IntersectsTempGeompolygon AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STIntersects(p2.location) AS interesecting FROM GEOSPATIALPOLYGONGEOM_dt p1 CROSS JOIN GEOSPATIALPOLYGONGEOM_dt p2 ORDER BY p1.id;

CREATE VIEW EqualsTempGeompolygon AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STEquals(p2.location) AS equals FROM GEOSPATIALPOLYGONGEOM_dt p1 CROSS JOIN GEOSPATIALPOLYGONGEOM_dt p2 ORDER BY p1.id;

CREATE VIEW ContainTempGeompolygon AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STContains(p2.location) AS contain FROM GEOSPATIALPOLYGONGEOM_dt p1 CROSS JOIN GEOSPATIALPOLYGONGEOM_dt p2 ORDER BY p1.id;

CREATE VIEW equals_opgeompolygon AS SELECT p1.location AS point FROM GEOSPATIALPOLYGONGEOM_dt p1 CROSS JOIN GEOSPATIALPOLYGONGEOM_dt p2 WHERE p1.location = p2.location ORDER BY p1.id;

CREATE VIEW notequal_opgeompolygon AS SELECT p1.location AS point FROM GEOSPATIALPOLYGONGEOM_dt p1 CROSS JOIN GEOSPATIALPOLYGONGEOM_dt p2 WHERE p1.location <> p2.location ORDER BY p1.id;


CREATE VIEW DisjointTempGeompolysr AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STDisjoint(p2.location) AS disjoints FROM GEOSPATIALPOLYGONGEOM_dt p1 CROSS JOIN GEOSPATIALPOINTGEOM_polysr p2 ORDER BY p1.id;

CREATE VIEW DistanceTempGeompolysr AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2,  CAST(STDistance( p1.location, p2.location ) AS numeric(20, 6)) AS distance FROM GEOSPATIALPOLYGONGEOM_dt p1 CROSS JOIN GEOSPATIALPOINTGEOM_polysr p2 ORDER BY p1.id;

CREATE VIEW IntersectsTempGeompolysr AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STIntersects(p2.location) AS interesecting FROM GEOSPATIALPOLYGONGEOM_dt p1 CROSS JOIN GEOSPATIALPOINTGEOM_polysr p2 ORDER BY p1.id;

CREATE VIEW EqualsTempGeompolysr AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STEquals(p2.location) AS equals FROM GEOSPATIALPOLYGONGEOM_dt p1 CROSS JOIN GEOSPATIALPOINTGEOM_polysr p2 ORDER BY p1.id;

CREATE VIEW ContainTempGeompolysr AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STContains(p2.location) AS contain FROM GEOSPATIALPOLYGONGEOM_dt p1 CROSS JOIN GEOSPATIALPOINTGEOM_polysr p2 ORDER BY p1.id;

CREATE VIEW equals_opgeompolysr AS SELECT p1.location AS point FROM GEOSPATIALPOLYGONGEOM_dt p1 CROSS JOIN GEOSPATIALPOINTGEOM_polysr p2 WHERE p1.location = p2.location ORDER BY p1.id;

CREATE VIEW notequal_opgeompolysr AS SELECT p1.location AS point FROM GEOSPATIALPOLYGONGEOM_dt p1 CROSS JOIN GEOSPATIALPOINTGEOM_polysr p2 WHERE p1.location <> p2.location ORDER BY p1.id;

CREATE VIEW PolygonGeomFromText AS SELECT geometry::STPolyFromText('POLYGON((3 5, 2 4, 3 5, 3 5))', 4326) AS geom1, geometry::STPolyFromText('POLYGON((1 3, 5 7, 4 5, 1 3))', 4326) AS geom2;


CREATE TABLE geometryAsVarbinarypolygon ( ID INT IDENTITY(1,1) PRIMARY KEY, geometryData VARBINARY(2000) );

