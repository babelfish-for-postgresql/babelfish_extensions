# Negative Test when SRID is not valid
# SRID should be between 0 to 999999
INSERT INTO GEOSPATIALPOLYGONGEOM_dt (location) VALUES ( geometry::STGeomFromText('POLYGON((1 2, 3 7, 1 2, 1 2))') );
~~ERROR (Code: 8146)~~

~~ERROR (Message: function geometry__stgeomfromtext has no parameters and arguments were supplied.)~~

INSERT INTO GEOSPATIALPOLYGONGEOM_dt (location) VALUES ( geometry::STGeomFromText('POLYGON((5 3, 4.5 2, 3 1, 5 3))', 1000000000 ) );
~~ERROR (Code: 33557097)~~

~~ERROR (Message: SRID value should be between 0 and 999999)~~

INSERT INTO GEOSPATIALPOLYGONGEOM_dt (location) VALUES ( geometry::STGeomFromText('POLYGON((1 2, 3 5, 6 4, 1 2))', -1) );
~~ERROR (Code: 33557097)~~

~~ERROR (Message: SRID value should be between 0 and 999999)~~


# Negative Test for STGeomFromText when a coordinate is missing
INSERT INTO GEOSPATIALPOLYGONGEOM_dt (location) VALUES ( geometry::STGeomFromText('POLYGON((1 2, 3 5, 6, 1 2))', 4326) );
~~ERROR (Code: 33557097)~~

~~ERROR (Message: Invalid geometry)~~


#  Negative Test for STGeomFromText when Incorrect cast is provided
INSERT INTO GEOSPATIALPOLYGONGEOM_dt (location) VALUES ( geography::STGeomFromText('POLYGON((1 2, 3 5, 6 4, 1 2))', 4326) );
~~ERROR (Code: 33557097)~~

~~ERROR (Message: column "location" is of type geometry but expression is of type geography)~~


