-- 17. CAST and CONVERT Tests
SELECT 
    ASCII(CAST(65 AS CHAR)) AS CastIntToCharExpect65,
    ASCII(CAST(97.0 AS VARCHAR)) AS CastFloatToVarcharExpect57,
    ASCII(CAST('A' AS NCHAR)) AS CastCharToNCharExpect65,
    ASCII(CONVERT(VARCHAR, 65)) AS ConvertIntToVarcharExpect54,
    ASCII(CONVERT(CHAR, 65)) AS ConvertIntToChar,
    ASCII(CONVERT(NVARCHAR, 'A')) AS ConvertCharToNVarchar_Expect65;
GO
~~START~~
int#!#int#!#int#!#int#!#int#!#int
54#!#57#!#65#!#54#!#54#!#65
~~END~~


-- 19. Complex CAST and CONVERT Scenarios
SELECT
    ASCII(CAST(CAST(65 AS VARCHAR) AS CHAR)) AS Nested_Cast_Expect65,
    ASCII(CAST(65 AS CHAR) + CAST(66 AS CHAR)) AS Concat_Cast_Expect65,
    ASCII(CAST(NULL AS CHAR)) AS Null_Cast_ExpectNull,
    ASCII(CAST('ABC' AS CHAR(3))) AS Cast_Multiple_Chars_Expect65;
GO
~~START~~
int#!#int#!#int#!#int
54#!#54#!#<NULL>#!#65
~~END~~


-- 20. Binary Manipulation Tests -- here cast of substring fails, gives wrong output
DECLARE @BinaryVar BINARY(4) = 0x41424344;
SELECT
    ASCII(CAST(SUBSTRING(@BinaryVar, 1, 1) AS CHAR)) AS First_Byte,
    ASCII(CAST(SUBSTRING(@BinaryVar, 2, 1) AS CHAR)) AS Second_Byte,
    ASCII(CAST(@BinaryVar AS VARCHAR)) AS Full_Binary;
GO
~~START~~
int#!#int#!#int
48#!#48#!#65
~~END~~


-- 21. Type Conversion Edge Cases
SELECT
    ASCII(CAST(256 AS CHAR)) AS Large_Number_Cast,
    ASCII(CONVERT(CHAR, 65535)) AS Very_Large_Number_Convert,
    ASCII(CAST(65.5 AS CHAR)) AS Decimal_Cast,
    ASCII(CAST(-65 AS CHAR)) AS Negative_Number_Cast;
GO
~~START~~
int#!#int#!#int#!#int
50#!#54#!#54#!#45
~~END~~


-- 22. Binary Arithmetic Tests
SELECT
    ASCII(CHAR(65 & 127)) AS Bitwise_AND_Expect65,
    ASCII(CHAR(65 | 32)) AS Bitwise_OR_Expect97,
    ASCII(CHAR(65 ^ 32)) AS Bitwise_XOR_Expect97;
GO
~~START~~
int#!#int#!#int
65#!#97#!#97
~~END~~


-- 23. Dynamic SQL Tests with CAST/CONVERT
DECLARE @SqlCmd NVARCHAR(1000);
SET @SqlCmd = N'SELECT ASCII(CAST(@Param AS CHAR))';
EXEC sp_executesql @SqlCmd, N'@Param INT', @Param = 65;
GO
