EXEC babel_5809_ascii_sp_validateascii 'A', 97; -- should give as fail result  
EXEC babel_5809_ascii_sp_validateascii '1', 49;  
EXEC babel_5809_ascii_sp_validateascii ' ', 32;  
GO
