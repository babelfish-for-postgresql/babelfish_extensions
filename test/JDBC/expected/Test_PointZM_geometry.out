~~END~~


SELECT geometry::STGeomFromText('POINT(10 20 30 NULL)', 4326).STAsText();
GO
~~START~~
text
POINT Z (10 20 30)
~~END~~


SELECT geometry::STGeomFromText('POINT(10 20 NULL NULL)', 4326).STAsText();
GO
~~START~~
text
POINT(10 20)
~~END~~


SELECT geometry::STGeomFromText('POINT EMPTY', 4326).STAsText();
GO
~~START~~
text
POINT EMPTY
~~END~~


