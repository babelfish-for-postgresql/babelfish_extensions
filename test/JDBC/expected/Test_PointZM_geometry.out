~~END~~


SELECT geometry::STGeomFromText('POINT(10 20 NULL)', 4326).STAsText();
GO
~~START~~
text
POINT(10 20)
~~END~~


SELECT geometry::STGeomFromText('POINT(10 20 30 1)', 4326).STAsText();
GO
~~START~~
text
