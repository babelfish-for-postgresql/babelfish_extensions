CREATE PROCEDURE reset_t1
AS
BEGIN
    TRUNCATE TABLE t1;
    INSERT INTO t1 VALUES (1, 10, 'first');
    INSERT INTO t1 VALUES (2, 20, 'second');
    INSERT INTO t1 VALUES (3, 30, 'third');
    INSERT INTO t1 VALUES (4, 40, 'fourth');
END
GO

