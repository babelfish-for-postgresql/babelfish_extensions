-- Drop linked server (and login mappings) before dropping the FDW extension
EXEC sp_dropserver 'bbf_rpe_server', 'droplogins';
GO

-- psql
-- Drop the FDW extension; CASCADE in case anything else still depends on it.
-- Suppress warnings to keep test output deterministic.
SET client_min_messages TO 'error';
DROP EXTENSION IF EXISTS tds_fdw CASCADE;
SET client_min_messages TO 'notice';
GO
