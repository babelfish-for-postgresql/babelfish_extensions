-- tsql
-- Drop all test procedures
DROP PROCEDURE IF EXISTS sp_NoParams;
DROP PROCEDURE IF EXISTS sp_SingleInt;
DROP PROCEDURE IF EXISTS sp_TestIntegers;
DROP PROCEDURE IF EXISTS sp_TestFloat;
DROP PROCEDURE IF EXISTS sp_TestDecimal;
DROP PROCEDURE IF EXISTS sp_TestMoney;
DROP PROCEDURE IF EXISTS sp_TestVarchar;
DROP PROCEDURE IF EXISTS sp_TestNvarchar;
DROP PROCEDURE IF EXISTS sp_TestChar;
DROP PROCEDURE IF EXISTS sp_TestBit;
DROP PROCEDURE IF EXISTS sp_TestBinary;
DROP PROCEDURE IF EXISTS sp_TestUUID;
DROP PROCEDURE IF EXISTS sp_TestDate;
DROP PROCEDURE IF EXISTS sp_TestDateTime;
DROP PROCEDURE IF EXISTS sp_TestTime;
DROP PROCEDURE IF EXISTS sp_OutputSingle;
DROP PROCEDURE IF EXISTS sp_OutputMultiple;
DROP PROCEDURE IF EXISTS sp_OutputNoResult;
DROP PROCEDURE IF EXISTS sp_InOut;
DROP PROCEDURE IF EXISTS sp_MultiRow;
DROP PROCEDURE IF EXISTS sp_MixedTypes;
DROP PROCEDURE IF EXISTS sp_EmptyResult;
DROP PROCEDURE IF EXISTS sp_NullValues;
DROP PROCEDURE IF EXISTS sp_ConditionalLogic;
DROP PROCEDURE IF EXISTS sp_FilterByParam;
DROP PROCEDURE IF EXISTS sp_CombinedIO;
DROP PROCEDURE IF EXISTS sp_OnlySelect;
DROP PROCEDURE IF EXISTS sp_WithInsert;
DROP PROCEDURE IF EXISTS sp_WithUpdate;
DROP PROCEDURE IF EXISTS sp_WithDelete;
DROP PROCEDURE IF EXISTS sp_WithDynamicSQL;
DROP PROCEDURE IF EXISTS sp_NullableParam;
DROP PROCEDURE IF EXISTS sp_LargeString;
DROP PROCEDURE IF EXISTS sp_ReturnCode;
DROP PROCEDURE IF EXISTS sp_WithError;
GO

-- Drop linked server and login mapping
EXEC sp_dropserver 'bbf_rpe_server', 'droplogins';
GO

-- psql
-- Drop tds_fdw extension
DROP EXTENSION IF EXISTS tds_fdw CASCADE;
GO
