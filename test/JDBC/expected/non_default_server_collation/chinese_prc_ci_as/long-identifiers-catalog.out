-- ===========================================
-- QUOTED / DELIMITED IDENTIFIERS REQUIRING QUOTES
-- ===========================================
-- Long identifiers that CANNOT be written unquoted in T-SQL because they
-- contain spaces, punctuation, or reserved words. Each mapped object type
-- (constraint, sequence, type, parameter) is exercised with a name that must
-- be delimited with [] and/or "" so we confirm the original (untruncated)
-- delimited name round-trips through babelfish_identifier_mapping and the sys
-- views regardless of the delimiter used.
-- Double-quote delimited identifiers require QUOTED_IDENTIFIER ON.
SET QUOTED_IDENTIFIER ON;
GO

-- Bracket-delimited constraint whose long name contains reserved words and
-- punctuation (SELECT, FROM, commas, parentheses) so it must stay delimited.
CREATE TABLE babel5975_quote_test (
    id INT NOT NULL,
    CONSTRAINT [PK (SELECT * FROM sys.objects) constraint name well beyond the sixty three byte limit] PRIMARY KEY (id),
    CONSTRAINT [CK-with-dashes.and.dots-that-together-run-past-the-sixty-three-byte-identifier-limit] CHECK (id > 0)
);
GO

-- Double-quote delimited long constraint added via ALTER TABLE.
ALTER TABLE babel5975_quote_test ADD CONSTRAINT "UQ ""embedded quote"" and spaces constraint name exceeding sixty three bytes" UNIQUE (id);
GO

-- Bracket-delimited sequence and type with spaces/reserved words.
CREATE SEQUENCE [ORDER BY sequence name with spaces that is comfortably over the sixty three byte limit] AS INT START WITH 1;
GO
CREATE TYPE [my.dotted.and spaced type name that runs well past the sixty three byte identifier limit] FROM INT;
GO


-- Note: T-SQL parameter names cannot be delimited (@[...] / @"..." are not
-- valid), so a "quote-requiring" parameter name is not expressible; long plain
-- parameter names are already covered in the main section above.
-- Verify each delimited name is stored in babelfish_identifier_mapping.
SELECT original_identifier_name FROM sys.babelfish_identifier_mapping
WHERE original_identifier_name LIKE 'PK (SELECT%'
   OR original_identifier_name LIKE 'CK-with-dashes%'
   OR original_identifier_name LIKE 'UQ %embedded quote%'
   OR original_identifier_name LIKE 'ORDER BY sequence%'
   OR original_identifier_name LIKE 'my.dotted.and spaced type%'
ORDER BY original_identifier_name;
GO
~~START~~
nvarchar
CK-with-dashes.and.dots-that-together-run-past-the-sixty-three-byte-identifier-limit
my.dotted.and spaced type name that runs well past the sixty three byte identifier limit
ORDER BY sequence name with spaces that is comfortably over the sixty three byte limit
PK (SELECT * FROM sys.objects) constraint name well beyond the sixty three byte limit
UQ "embedded quote" and spaces constraint name exceeding sixty three bytes
~~END~~


-- Verify constraints resolve to their full delimited names in the sys views.
SELECT name FROM sys.key_constraints WHERE name = 'PK (SELECT * FROM sys.objects) constraint name well beyond the sixty three byte limit';
GO
~~START~~
varchar
PK (SELECT * FROM sys.objects) constraint name well beyond the sixty three byte limit
~~END~~

SELECT name FROM sys.check_constraints WHERE name = 'CK-with-dashes.and.dots-that-together-run-past-the-sixty-three-byte-identifier-limit';
GO
~~START~~
varchar
CK-with-dashes.and.dots-that-together-run-past-the-sixty-three-byte-identifier-limit
~~END~~

SELECT name FROM sys.key_constraints WHERE name LIKE 'UQ %embedded quote%';
GO
~~START~~
varchar
UQ "embedded quote" and spaces constraint name exceeding sixty three bytes
~~END~~


-- Verify sequence and type resolve to their full delimited names.
SELECT name FROM sys.objects WHERE name = 'ORDER BY sequence name with spaces that is comfortably over the sixty three byte limit';
GO
~~START~~
varchar
ORDER BY sequence name with spaces that is comfortably over the sixty three byte limit
~~END~~

SELECT name FROM sys.types WHERE name = 'my.dotted.and spaced type name that runs well past the sixty three byte identifier limit';
GO
~~START~~
varchar
my.dotted.and spaced type name that runs well past the sixty three byte identifier limit
~~END~~


-- Cleanup: drop each object using its delimited name (mix of [] and "").
DROP SEQUENCE [ORDER BY sequence name with spaces that is comfortably over the sixty three byte limit];
GO
DROP TYPE "my.dotted.and spaced type name that runs well past the sixty three byte identifier limit";
GO
DROP TABLE babel5975_quote_test;
GO

-- Confirm all delimited-name mapping rows are cleaned up after the drops.
SELECT COUNT(*) FROM sys.babelfish_identifier_mapping
WHERE original_identifier_name LIKE 'PK (SELECT%'
   OR original_identifier_name LIKE 'CK-with-dashes%'
   OR original_identifier_name LIKE 'UQ %embedded quote%'
   OR original_identifier_name LIKE 'ORDER BY sequence%'
   OR original_identifier_name LIKE 'my.dotted.and spaced type%';
GO
~~START~~
int
0
~~END~~



-- ===========================================
-- DROP DATABASE: mapping entries for the whole database are cleaned up
-- ===========================================
-- Create a database, populate it with long-named objects of each mapped type,
-- then drop the database and confirm no babelfish_identifier_mapping rows
-- survive for that database's physical schemas (nspname LIKE '<db>_%').
CREATE DATABASE babel5975_dropdb;
GO
USE babel5975_dropdb;
GO

CREATE TABLE babel5975_dropdb_tbl (
    id INT NOT NULL,
    val INT,
    CONSTRAINT Very_Long_DropDB_PK_Constraint_Name_That_Exceeds_PostgreSQL_Sixty_Three_Bytes PRIMARY KEY (id),
    CONSTRAINT Very_Long_DropDB_Check_Constraint_Name_That_Exceeds_PostgreSQL_Sixty_Three_By CHECK (val > 0)
);
GO
CREATE SEQUENCE Very_Long_DropDB_Sequence_Name_That_Exceeds_PostgreSQL_Sixty_Three_Byte_Limit AS INT START WITH 1;
GO
CREATE TYPE Very_Long_DropDB_Type_Name_That_Exceeds_PostgreSQL_Sixty_Three_Byte_Limit_Test FROM INT;
GO
CREATE PROCEDURE babel5975_dropdb_proc
    @Very_Long_DropDB_Parameter_Name_That_Exceeds_PostgreSQL_Sixty_Three_Byte_Limit INT
AS BEGIN SELECT @Very_Long_DropDB_Parameter_Name_That_Exceeds_PostgreSQL_Sixty_Three_Byte_Limit END;
GO

USE master;
GO

-- Before drop: the database's mapping rows exist (one per long-named object).
SELECT COUNT(*) FROM sys.babelfish_identifier_mapping WHERE original_identifier_name LIKE '%Very_Long_DropDB%';
GO
~~START~~
int
5
~~END~~


DROP DATABASE babel5975_dropdb;
GO

-- After drop: every mapping row for the dropped database is cleaned up (0).
SELECT COUNT(*) FROM sys.babelfish_identifier_mapping WHERE original_identifier_name LIKE '%Very_Long_DropDB%';
GO
~~START~~
int
0
~~END~~



-- ===========================================
-- Constraint-name collision across tables (BABEL-5975)
-- ===========================================
-- Two tables in the same schema may legitimately reuse the SAME long
-- constraint name (constraint names are table-scoped in T-SQL). Both truncate
-- to the same physical conname, producing two mapping rows that differ only by
-- parent_name. The constraint views must pass the parent table so each
-- constraint resolves to its OWN original name (deterministically), not
-- whichever mapping row LIMIT 1 happens to return.
CREATE TABLE babel5975_collide_a (
    id INT,
    CONSTRAINT Shared_Long_Constraint_Name_Reused_On_Two_Tables_Exceeding_Sixty_Three_Bytes CHECK (id > 0)
);
GO
CREATE TABLE babel5975_collide_b (
    id INT,
    CONSTRAINT Shared_Long_Constraint_Name_Reused_On_Two_Tables_Exceeding_Sixty_Three_Bytes CHECK (id > 0)
);
GO

-- Each check constraint must resolve to the shared original name for its own
-- table; both rows carry the same original name, so the key assertion is that
-- EACH table shows exactly one row with the full (non-truncated) name.
SELECT t.name AS table_name, c.name AS constraint_name
FROM sys.check_constraints c
JOIN sys.tables t ON t.object_id = c.parent_object_id
WHERE t.name IN ('babel5975_collide_a', 'babel5975_collide_b')
ORDER BY t.name;
GO
~~START~~
varchar#!#varchar
babel5975_collide_a#!#Shared_Long_Constraint_Name_Reused_On_Two_Tables_Exceeding_Sixty_Three_Bytes
babel5975_collide_b#!#Shared_Long_Constraint_Name_Reused_On_Two_Tables_Exceeding_Sixty_Three_Bytes
~~END~~


-- The full original name resolves (not the truncated hash form) for both.
SELECT COUNT(*) FROM sys.check_constraints
WHERE name = 'Shared_Long_Constraint_Name_Reused_On_Two_Tables_Exceeding_Sixty_Three_Bytes';
GO
~~START~~
int
2
~~END~~


DROP TABLE babel5975_collide_a;
GO
DROP TABLE babel5975_collide_b;
GO


-- psql
-- ===========================================
-- Stale-row overwrite (BABEL-5975)
-- ===========================================
-- A mapping row can only be left behind by a drop that bypasses the T-SQL DROP
-- cleanup -- an interoperability path such as a PG-dialect drop, a cascaded
-- drop, DROP OWNED BY / REASSIGN OWNED, or DROP EXTENSION (a pure T-SQL workload
-- always cleans the row on DROP, and the catalog is SELECT-only so no user can
-- inject a row). If such a stale row later collides on the same physical name
-- with a new object that has a DIFFERENT original name, the new object must NOT
-- display the old name: insert_bbf_ident_mapping overwrites a stale row whose
-- original name differs from the new one.
--
-- Simulate the stale row directly (as a bypassed drop would leave it, pointing
-- at a different old original name), then create a real long-named sequence
-- whose physical name matches. The CREATE must overwrite the stale row so the
-- sequence resolves to its OWN name.
INSERT INTO sys.babelfish_identifier_mapping (nspname, pg_catalog_type, truncated_identifier_name, original_identifier_name, parent_name)
VALUES ('master_dbo', 'pg_class'::regclass::oid,
        sys.babelfish_truncate_identifier(lower('babel5975_stale_seq_name_that_exceeds_postgresql_sixty_three_byte_limit_stale')),
        'STALE_ROW_FROM_A_BYPASSED_DROP', '');
GO
~~ROW COUNT: 1~~


-- tsql
CREATE SEQUENCE babel5975_stale_seq_name_that_exceeds_postgresql_sixty_three_byte_limit_stale AS INT START WITH 1;
GO

-- The mapping row must now hold the NEW sequence's own original name (the stale
-- value was overwritten by the CREATE), proving a stale row cannot mask a later
-- object's real name.
SELECT original_identifier_name FROM sys.babelfish_identifier_mapping WHERE truncated_identifier_name LIKE 'babel5975_stale_seq_name%';
GO
~~START~~
nvarchar
babel5975_stale_seq_name_that_exceeds_postgresql_sixty_three_byte_limit_stale
~~END~~


-- The stale value must be gone (overwritten).
SELECT original_identifier_name FROM sys.babelfish_identifier_mapping
WHERE original_identifier_name = 'STALE_ROW_FROM_A_BYPASSED_DROP';
GO
~~START~~
nvarchar
~~END~~


DROP SEQUENCE babel5975_stale_seq_name_that_exceeds_postgresql_sixty_three_byte_limit_stale;
GO
