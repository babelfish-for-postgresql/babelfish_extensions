-- VARCHAR Empty and NULL Tests
DECLARE @emptyVarchar VARCHAR(10) = ''
DECLARE @nullVarchar VARCHAR(10) = NULL
SELECT 
    '|' + ISNULL(@emptyVarchar, 'NULL') + '|' AS 'Empty',
    '|' + ISNULL(@nullVarchar, 'NULL') + '|' AS 'Null',
    DATALENGTH(@emptyVarchar) AS 'Empty DataLength',
    DATALENGTH(@nullVarchar) AS 'Null DataLength'
GO
