SELECT @mixedString AS 'Mixed String', LEN(@mixedString) AS 'Length'
GO
~~START~~
nchar#!#int
Hello 🙂🙂世界 مرحبا                      #!#16
~~END~~


-- Single emoji
DECLARE @singleEmoji NCHAR(10) = N'😀'
SELECT @singleEmoji , LEN(@singleEmoji) AS 'Length'
GO
