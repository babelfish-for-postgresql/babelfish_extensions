SELECT @textWithEmoji
GO
~~START~~
nchar
Hello 😀 World 🌍 Test 🎉                         
~~END~~


-- Complex emojis (skin tone modifiers)
DECLARE @complexEmoji NCHAR(30) = N'👋🏽👨‍💻👩‍🎨'
SELECT @complexEmoji, LEN(@complexEmoji) AS 'Length', DATALENGTH(@complexEmoji) AS 'Bytes'
GO
~~START~~
nchar#!#int#!#int
👋🏽👨‍💻👩‍🎨                #!#8#!#30
~~END~~


-- Emoji with multibyte text
DECLARE @emojiMultibyte NCHAR(40) = N'🎌こんにちは🌸世界🗾'
SELECT @emojiMultibyte , LEN(@emojiMultibyte) AS 'Length'
GO
~~START~~
nchar#!#int
🎌こんにちは🌸世界🗾                           #!#10
~~END~~


-- String with line breaks and tabs
DECLARE @specialChars NCHAR(30) = N'Line1' + CHAR(13) + CHAR(10) + N'Line2' + CHAR(9) + N'Tab'
SELECT @specialChars , LEN(@specialChars) AS 'Length'
GO
~~START~~
nchar#!#int
Line1<newline>Line2	Tab              #!#16
~~END~~


-- String with quotes
