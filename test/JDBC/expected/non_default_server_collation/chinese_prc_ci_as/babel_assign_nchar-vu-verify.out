SELECT CAST(CAST(@mixed_string AS CHAR(50)) AS VARCHAR(50)) AS Result2;
SELECT CAST(CAST(@mixed_string AS CHAR(50)) AS NCHAR(50)) AS Result3;
SELECT CAST(CAST(@mixed_string AS CHAR(50)) AS NVARCHAR(50)) AS Result4;
SELECT CAST(CAST(@mixed_string AS CHAR(50)) AS TEXT) AS Result5;
