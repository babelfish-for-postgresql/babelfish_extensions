DECLARE @collation_test NVARCHAR(150) = N'Collation Test 你好 こんにちは àáâã ÀÁÂà Case Test';
SELECT CAST(CAST(@collation_test AS VARCHAR(150)) AS TEXT) COLLATE SQL_Latin1_General_CP1_CI_AS AS Result1;
SELECT CAST(CAST(@collation_test AS VARCHAR(150)) AS NTEXT) COLLATE SQL_Latin1_General_CP1_CS_AS AS Result2;
SELECT CAST(CAST(@collation_test AS NVARCHAR(150)) AS NTEXT) COLLATE Chinese_PRC_CI_AS AS Result3;
SELECT CAST(CAST(@collation_test AS NCHAR(150)) AS TEXT) COLLATE Japanese_CI_AS AS Result4;
GO
