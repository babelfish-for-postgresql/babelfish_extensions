SELECT 
    '|' + @mixedChar + '|' AS 'Mixed Content',
    DATALENGTH(@mixedChar) AS 'DataLength'
GO
~~START~~
varchar#!#int
|123 ABC 456    |#!#15
~~END~~


-- CHAR Truncation Test
DECLARE @truncChar CHAR(5) = 'Too Long String'  -- Will be truncated
SELECT @truncChar AS 'Truncated'
GO
~~START~~
char
Too L
~~END~~


-- CHAR with Different Collations
DECLARE @collateChar1 CHAR(10) = 'Test'
DECLARE @collateChar2 CHAR(10) = 'test'
SELECT 
    @collateChar1 COLLATE SQL_Latin1_General_CP1_CS_AS AS 'Case Sensitive',
    @collateChar2 COLLATE SQL_Latin1_General_CP1_CI_AS AS 'Case Insensitive',
    CASE 
        WHEN @collateChar1 = @collateChar2 COLLATE SQL_Latin1_General_CP1_CS_AS 
        THEN 'Equal' 
        ELSE 'Not Equal' 
    END AS 'Comparison'
GO
~~START~~
char#!#char#!#varchar
Test      #!#test      #!#Not Equal
~~END~~


