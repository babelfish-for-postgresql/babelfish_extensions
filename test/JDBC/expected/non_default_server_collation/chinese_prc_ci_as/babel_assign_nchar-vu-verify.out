--------------------
-- Set with cast
--------------------
-- Assignment casting with SET statments
DECLARE @char_var CHAR(50);
DECLARE @nchar_var NCHAR(50);
DECLARE @varchar_var VARCHAR(50);
DECLARE @nvarchar_var NVARCHAR(50);
-- Target: @char_var (CHAR)
SET @char_var = CAST(N'你好世界 Text 中文 😀😍🌟💖 こんにちは' AS NVARCHAR);
SELECT @char_var
SET @char_var  = CAST(N'你好世界 Text 中文 こんにちは' AS VARCHAR);
SELECT @char_var
SET @char_var = CAST(N'Text' AS CHAR);
SELECT @char_var
SET @char_var = CAST(N'你好世界 Text 中文 😀😍🌟💖 こんにちは' AS NCHAR);
SELECT @char_var
-- Target: @nchar_var (NCHAR)
SET @nchar_var = CAST(N'你好世界 Text 中文 😀😍🌟💖 こんにちは' AS NVARCHAR);
select @nchar_var
SET @nchar_var = CAST(N'你好世界 Text 中文 😀😍🌟💖 こんにちは' AS VARCHAR);
select @nchar_var
SET @nchar_var = CAST(N'你好世界 Text 中文 😀😍🌟💖 こんにちは' AS CHAR);
select @nchar_var
SET @nchar_var = CAST(N'你好世界 Text 中文 😀😍🌟💖 こんにちは' AS NCHAR);
select @nchar_var
-- Target: @varchar_var (VARCHAR)
SET @varchar_var = CAST(N'你好世界 Text 中文 😀😍🌟💖 こんにちは' AS NVARCHAR);
select @varchar_var
SET @varchar_var = CAST(N'你好世界 Text 中文 😀😍🌟💖 こんにちは' AS VARCHAR);
select @varchar_var
SET @varchar_var = CAST(N'你好世界 Text 中文 😀😍🌟💖 こんにちは' AS CHAR);
select @varchar_var
SET @varchar_var = CAST(N'你好世界 Text 中文 😀😍🌟💖 こんにちは' AS NCHAR);
select @varchar_var
-- Target: @nvarchar_var (NVARCHAR)
SET @nvarchar_var = CAST(N'你好世界 Text 中文 😀😍🌟💖 こんにちは' AS NVARCHAR);
SELECT @nvarchar_var
SET @nvarchar_var = CAST(N'你好世界 Text 中文 😀😍🌟💖 こんにちは' AS VARCHAR);
SELECT @nvarchar_var
SET @nvarchar_var = CAST(N'你好世界 Text 中文 😀😍🌟💖 こんにちは' AS CHAR);
SELECT @nvarchar_var
SET @nvarchar_var = CAST(N'你好世界 Text 中文 😀😍🌟💖 こんにちは' AS NCHAR);
SELECT @nvarchar_var
GO
