-- Test conversion between different UDT types
DECLARE @sourceString nchar_type = N'Test String 测试 🙂🌸🎌🗾';
SELECT
    -- Original Value
    @sourceString AS 'Original (NCHAR_type)',
    -- Convert to other Unicode types
    CAST(@sourceString AS nvarchar_type) AS 'To NVARCHAR_type',
    -- Convert to non-Unicode types
    CAST(@sourceString AS char_type) AS 'To CHAR_type',
    CAST(@sourceString AS varchar_type) AS 'To VARCHAR_type',
    -- Convert to binary types
    CAST(@sourceString AS binary_type) AS 'To BINARY_type',
    CAST(@sourceString AS varbinary_type) AS 'To VARBINARY_type',
    -- Convert back from binary to string types
    CAST(CAST(@sourceString AS binary_type) AS nchar_type) AS 'BINARY back to NCHAR_type',
    CAST(CAST(@sourceString AS varbinary_type) AS nvarchar_type) AS 'VARBINARY back to NVARCHAR_type',
    -- Length comparisons
    LEN(@sourceString) AS 'Original Length'
GO
~~START~~
nchar#!#nvarchar#!#char#!#varchar#!#binary#!#varbinary#!#nchar#!#nvarchar#!#int
Test String 测试 🙂🌸🎌🗾       #!#Test String 测试 🙂🌸🎌🗾       #!#Test String 测试 ????         #!#Test String 测试 ????         #!#5465737420537472696E#!#5465737420537472696E#!#0x5465737420537472696e        #!#敔瑳匠牴湩#!#19
~~END~~






-- Test: Basic SET and SELECT operations
DECLARE @varchar_var varchar_type;
DECLARE @nvarchar_var nvarchar_type;
DECLARE @char_var char_type;
DECLARE @nchar_var nchar_type;
-- SET operations
SET @varchar_var = 'Test VARCHAR';
SET @nvarchar_var = N'Test NVARCHAR 你好 😊';
SET @char_var = 'Test CHAR';
SET @nchar_var = N'Test NCHAR 世界 ☺️';
SELECT 
    @varchar_var AS VARCHAR_Value,
    @nvarchar_var AS NVARCHAR_Value,
    @char_var AS CHAR_Value,
    @nchar_var AS NCHAR_Value;
-- SELECT operations
SELECT @varchar_var = 'Test VARCHAR';
SELECT @nvarchar_var = N'Test NVARCHAR 你好 😊';
SELECT @char_var = 'Test CHAR';
SELECT @nchar_var = N'Test NCHAR 世界 ☺️';
GO
~~START~~
varchar#!#nvarchar#!#char#!#nchar
Test VARCHAR#!#Test NVARCHAR 你好 😊#!#Test CHAR                     #!#Test NCHAR 世界 ☺️              
~~END~~




---------------------------
-- implicite function calls
---------------------------
DECLARE @varchar_text VARCHAR(50) = 'VARCHAR Text';
DECLARE @nvarchar_text NVARCHAR(50) = N'NVARCHAR Text 你好 😌😌😌';
DECLARE @char_text CHAR(50) = 'CHAR Text';
DECLARE @nchar_text NCHAR(50) = N'NCHAR Text 世界 😌😌😌';
-- Test 1: Basic Type Casting
SELECT 'Test 1: Basic Variable Casting' AS TestCase;
SELECT 
    babel_4803_varchar_func(@varchar_text) AS From_VARCHAR,
    babel_4803_nvarchar_func(@nvarchar_text ) AS From_NVARCHAR,
    babel_4803_char_func(@char_text) AS From_CHAR,
    babel_4803_nchar_func(@nchar_text) AS From_NCHAR;
GO
~~START~~
varchar
Test 1: Basic Variable Casting
~~END~~

~~START~~
varchar#!#nvarchar#!#char#!#nchar
VARCHAR Text#!#NVARCHAR Text 你好 😌😌😌#!#CHAR Text                                         #!#NCHAR Text 世界 😌😌😌                              
~~END~~


-- Test 2: Cross-Type Casting
SELECT 'Test 2: Cross-Type Casting' AS TestCase;
SELECT 
    babel_4803_varchar_func(CAST(N'NVARCHAR to VARCHAR 你好' AS NVARCHAR(50))) AS NVARCHAR_to_VARCHAR,
    babel_4803_nvarchar_func(CAST('VARCHAR to NVARCHAR 你好 😁' AS VARCHAR(50))) AS VARCHAR_to_NVARCHAR,
    babel_4803_nvarchar_func(CAST('NCHAR to NVARCHAR 你好 😁' AS VARCHAR(50))) AS NCHAR_to_NVARCHAR,
    babel_4803_char_func(CAST(N'NCHAR to CHAR 你好 😁' AS NCHAR(50))) AS NCHAR_to_CHAR,
    babel_4803_nchar_func(CAST('CHAR to NCHAR 你好 😁' AS CHAR(50))) AS CHAR_to_NCHAR;
GO
~~START~~
varchar
Test 2: Cross-Type Casting
~~END~~

~~START~~
varchar#!#nvarchar#!#nvarchar#!#char#!#nchar
NVARCHAR to VARCHAR 你好#!#VARCHAR to NVARCHAR 你好 😁#!#NCHAR to NVARCHAR 你好 😁#!#NCHAR to CHAR 你好 ?                              #!#CHAR to NCHAR 你好 ?                                
~~END~~


