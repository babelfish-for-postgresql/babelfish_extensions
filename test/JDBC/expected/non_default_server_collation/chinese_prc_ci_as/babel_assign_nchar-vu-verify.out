-- Test Set for Different Collations across Character Types
-- Test : Japanese Text
DECLARE @jp_char CHAR(50) = N'こんにちは世界';
DECLARE @jp_varchar VARCHAR(50) = N'🎌こんにちは🌸世界🗾';
DECLARE @jp_nchar NCHAR(50) = N'こんにちは世界';
DECLARE @jp_nvarchar NVARCHAR(50) = N'🎌こんにちは🌸世界🗾';
SELECT 'Japanese Collation Tests' AS TestCase;
SELECT 
    @jp_char COLLATE Japanese_CI_AS AS CHAR_Japanese,
    @jp_varchar COLLATE Japanese_CI_AS AS VARCHAR_Japanese,
    @jp_nchar COLLATE Japanese_CI_AS AS NCHAR_Japanese,
    @jp_nvarchar COLLATE Japanese_CI_AS AS NVARCHAR_Japanese;
GO
~~START~~
varchar
Japanese Collation Tests
~~END~~

~~START~~
char#!#varchar#!#nchar#!#nvarchar
こんにちは世界                                    #!#?こんにちは?世界?#!#こんにちは世界                                           #!#🎌こんにちは🌸世界🗾
~~END~~




-- Test : Arabic Text
DECLARE @ar_char CHAR(30) = N'مرحبا بالعالم';
DECLARE @ar_varchar VARCHAR(30) = N'بطاقة التسجيل - قياسية';
DECLARE @ar_nchar NCHAR(30) = N'مرحبا بالعالم';
DECLARE @ar_nvarchar NVARCHAR(30) = N'بطاقة التسجيل - قياسية';
SELECT 'Arabic Collation Tests' AS TestCase;
SELECT 
    @ar_char COLLATE Arabic_CI_AS AS CHAR_Arabic,
    @ar_varchar COLLATE Arabic_CI_AS AS VARCHAR_Arabic,
    @ar_nchar COLLATE Arabic_CI_AS AS NCHAR_Arabic,
    @ar_nvarchar COLLATE Arabic_CI_AS AS NVARCHAR_Arabic;
-- Compare with other collations
SELECT 
    @ar_varchar COLLATE SQL_Latin1_General_CP1_CI_AS AS Latin1_Collation,
    @ar_varchar COLLATE Arabic_CI_AS AS Arabic_Collation;
GO
