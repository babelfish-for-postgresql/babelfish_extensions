SELECT CAST(CAST(@mixed_string AS VARCHAR(50)) AS NCHAR(50)) AS Result9;
SELECT CAST(CAST(@mixed_string AS VARCHAR(50)) AS NVARCHAR(50)) AS Result10;
SELECT CAST(CAST(@mixed_string AS VARCHAR(50)) AS TEXT) AS Result11;
SELECT CAST(CAST(@mixed_string AS VARCHAR(50)) AS NTEXT) AS Result12;
SELECT CAST(CAST(@mixed_string AS NCHAR(50)) AS CHAR(50)) AS Result13;
SELECT CAST(CAST(@mixed_string AS NCHAR(50)) AS VARCHAR(50)) AS Result14;
SELECT CAST(CAST(@mixed_string AS NCHAR(50)) AS NCHAR(50)) AS Result15;
SELECT CAST(CAST(@mixed_string AS NCHAR(50)) AS NVARCHAR(50)) AS Result16;
SELECT CAST(CAST(@mixed_string AS NCHAR(50)) AS TEXT) AS Result17;
SELECT CAST(CAST(@mixed_string AS NCHAR(50)) AS NTEXT) AS Result18;
SELECT CAST(CAST(@mixed_string AS NVARCHAR(50)) AS CHAR(50)) AS Result19;
SELECT CAST(CAST(@mixed_string AS NVARCHAR(50)) AS VARCHAR(50)) AS Result20;
SELECT CAST(CAST(@mixed_string AS NVARCHAR(50)) AS NCHAR(50)) AS Result21;
