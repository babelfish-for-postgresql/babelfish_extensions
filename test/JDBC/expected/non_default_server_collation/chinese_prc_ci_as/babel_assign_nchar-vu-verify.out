-------------------------
-- simple ascii string
-------------------------
DECLARE @ascii_string VARCHAR(50) = 'Hello World 123! ASCII Test àáâãäåæçèéêë ñóôõö';
-- ASCII: All combinations of nested CAST (including TEXT and NTEXT)
SELECT CAST(CAST(@ascii_string AS CHAR(50)) AS CHAR(50)) AS Result1;
SELECT CAST(CAST(@ascii_string AS CHAR(50)) AS VARCHAR(50)) AS Result2;
SELECT CAST(CAST(@ascii_string AS CHAR(50)) AS NCHAR(50)) AS Result3;
SELECT CAST(CAST(@ascii_string AS CHAR(50)) AS NVARCHAR(50)) AS Result4;
SELECT CAST(CAST(@ascii_string AS CHAR(50)) AS TEXT) AS Result5;
SELECT CAST(CAST(@ascii_string AS CHAR(50)) AS NTEXT) AS Result6;
SELECT CAST(CAST(@ascii_string AS VARCHAR(50)) AS CHAR(50)) AS Result7;
SELECT CAST(CAST(@ascii_string AS VARCHAR(50)) AS VARCHAR(50)) AS Result8;
SELECT CAST(CAST(@ascii_string AS VARCHAR(50)) AS NCHAR(50)) AS Result9;
SELECT CAST(CAST(@ascii_string AS VARCHAR(50)) AS NVARCHAR(50)) AS Result10;
SELECT CAST(CAST(@ascii_string AS VARCHAR(50)) AS TEXT) AS Result11;
SELECT CAST(CAST(@ascii_string AS VARCHAR(50)) AS NTEXT) AS Result12;
SELECT CAST(CAST(@ascii_string AS NCHAR(50)) AS CHAR(50)) AS Result13;
SELECT CAST(CAST(@ascii_string AS NCHAR(50)) AS VARCHAR(50)) AS Result14;
SELECT CAST(CAST(@ascii_string AS NCHAR(50)) AS NCHAR(50)) AS Result15;
SELECT CAST(CAST(@ascii_string AS NCHAR(50)) AS NVARCHAR(50)) AS Result16;
SELECT CAST(CAST(@ascii_string AS NCHAR(50)) AS TEXT) AS Result17;
SELECT CAST(CAST(@ascii_string AS NCHAR(50)) AS NTEXT) AS Result18;
SELECT CAST(CAST(@ascii_string AS NVARCHAR(50)) AS CHAR(50)) AS Result19;
SELECT CAST(CAST(@ascii_string AS NVARCHAR(50)) AS VARCHAR(50)) AS Result20;
SELECT CAST(CAST(@ascii_string AS NVARCHAR(50)) AS NCHAR(50)) AS Result21;
SELECT CAST(CAST(@ascii_string AS NVARCHAR(50)) AS NVARCHAR(50)) AS Result22;
SELECT CAST(CAST(@ascii_string AS NVARCHAR(50)) AS TEXT) AS Result23;
SELECT CAST(CAST(@ascii_string AS NVARCHAR(50)) AS NTEXT) AS Result24;
SELECT CAST(CAST(@ascii_string AS TEXT) AS CHAR(50)) AS Result25;
SELECT CAST(CAST(@ascii_string AS TEXT) AS VARCHAR(50)) AS Result26;
SELECT CAST(CAST(@ascii_string AS TEXT) AS NCHAR(50)) AS Result27;
SELECT CAST(CAST(@ascii_string AS TEXT) AS NVARCHAR(50)) AS Result28;
SELECT CAST(CAST(@ascii_string AS TEXT) AS TEXT) AS Result29;
SELECT CAST(CAST(@ascii_string AS TEXT) AS NTEXT) AS Result30;
SELECT CAST(CAST(@ascii_string AS NTEXT) AS CHAR(50)) AS Result31;
SELECT CAST(CAST(@ascii_string AS NTEXT) AS VARCHAR(50)) AS Result32;
SELECT CAST(CAST(@ascii_string AS NTEXT) AS NCHAR(50)) AS Result33;
SELECT CAST(CAST(@ascii_string AS NTEXT) AS NVARCHAR(50)) AS Result34;
SELECT CAST(CAST(@ascii_string AS NTEXT) AS TEXT) AS Result35;
SELECT CAST(CAST(@ascii_string AS NTEXT) AS NTEXT) AS Result36;
GO
