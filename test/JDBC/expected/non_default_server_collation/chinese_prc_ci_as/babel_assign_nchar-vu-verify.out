-------------
-- BINARY
-------------
-- Simple BINARY
DECLARE @simpleBinary BINARY(10) = 0x48656C6C6F
SELECT 
    @simpleBinary AS 'Binary Data',
    CAST(@simpleBinary AS VARCHAR(20)) AS 'Converted to String',
    DATALENGTH(@simpleBinary) AS 'Length'
GO
~~START~~
binary#!#varchar#!#int
48656C6C6F0000000000#!#Hello#!#10
~~END~~


-- BINARY with padding
DECLARE @paddedBinary BINARY(20) = 0x48656C6C6F
SELECT 
    @paddedBinary AS 'Padded Binary',
    LEN(@paddedBinary) AS 'Length'
GO
~~START~~
binary#!#int
48656C6C6F000000000000000000000000000000#!#20
~~END~~


-- BINARY comparison
DECLARE @binary1 BINARY(5) = 0x48656C6C6F
DECLARE @binary2 BINARY(5) = 0x48656C6C6F
SELECT 
    CASE WHEN @binary1 = @binary2 THEN 'Equal' ELSE 'Not Equal' END AS 'Comparison'
GO
~~START~~
varchar
Equal
~~END~~



-------------
-- VARBINARY
-------------
-- Simple VARBINARY
DECLARE @simpleVarBinary VARBINARY(50) = 0x48656C6C6F
SELECT 
    @simpleVarBinary AS 'VarBinary Data',
    CAST(@simpleVarBinary AS VARCHAR(20)) AS 'As String',
    DATALENGTH(@simpleVarBinary) AS 'Actual Length'
GO
~~START~~
varbinary#!#varchar#!#int
48656C6C6F#!#Hello#!#5
~~END~~


-- VARBINARY(MAX)
DECLARE @largeVarBinary VARBINARY(MAX) = 0x48656C6C6F
SELECT 
    @largeVarBinary AS 'Large VarBinary',
    DATALENGTH(@largeVarBinary) AS 'Length'
GO
~~START~~
varbinary#!#int
48656C6C6F#!#5
~~END~~


-- Converting string to VARBINARY
DECLARE @convertedVarBinary VARBINARY(50) = CAST('Hello World' AS VARBINARY)
SELECT 
    @convertedVarBinary AS 'Converted Data',
    CAST(@convertedVarBinary AS VARCHAR(20)) AS 'Back to String'
GO
~~START~~
varbinary#!#varchar
48656C6C6F20576F726C64#!#Hello World
~~END~~



-- Compare different types
DECLARE @testString NVARCHAR(50) = N'Hello 日本語 with emojis 😀'
DECLARE @testBinary VARBINARY(50) = CAST('Hello' AS VARBINARY)
SELECT 
    @testString AS 'NVARCHAR',
    @testBinary AS 'VARBINARY',
    CAST(CAST(N'Hello😀😀😀😀😀' as NTEXT) AS NVARCHAR(MAX)) AS 'NTEXT',
    LEN(@testString) AS 'NVARCHAR_Length',
    LEN(@testBinary) AS 'VARBINARY_Length'
GO
~~START~~
nvarchar#!#varbinary#!#nvarchar#!#int#!#int
Hello 日本語 with emojis 😀#!#48656C6C6F#!#Hello😀😀😀😀😀#!#23#!#5
~~END~~



-------------
-- CHAR
-------------
-- Basic CHAR Tests
DECLARE @basicChar CHAR(10) = 'Hello'
SELECT 
    @basicChar AS 'Basic',
    LEN(@basicChar) AS 'Length',
    DATALENGTH(@basicChar) AS 'DataLength',
    '|' + @basicChar + '|' AS 'With Delimiters'  -- Shows padding
GO
~~START~~
char#!#int#!#int#!#varchar
Hello     #!#5#!#10#!#|Hello     |
~~END~~


-- CHAR with Special Characters
