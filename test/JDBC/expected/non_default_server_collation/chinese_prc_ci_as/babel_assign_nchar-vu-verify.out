---------------------------------------
-- converting between different types
---------------------------------------
-- Converting between types
DECLARE @sourceString NVARCHAR(50) = N'Test String 测试 🙂🙂🙂🙂'
SELECT 
    -- To BINARY
    CAST(CAST(@sourceString AS VARBINARY) AS BINARY(50)) AS 'As BINARY',
    -- To VARBINARY
    CAST(@sourceString AS VARBINARY) AS 'As VARBINARY',
    -- To NTEXT
    CAST(@sourceString AS NTEXT) AS 'As NTEXT',
    -- Back to NVARCHAR
    CAST(CAST(@sourceString AS VARBINARY) AS NVARCHAR(50)) AS 'Back to NVARCHAR',
    -- To NCHAR
    CAST(@sourceString AS NCHAR) AS 'AS NCHAR',
    -- TO CHAR
    CAST(@sourceString AS CHAR) AS 'AS CHAR',
    -- TO VARCHAR
    CAST(@sourceString AS VARCHAR) AS 'AS VARCHAR'
GO
~~START~~
binary#!#varbinary#!#ntext#!#nvarchar#!#nchar#!#char#!#varchar
5400650073007400200053007400720069006E00670020004B6DD58B20000000000000000000000000000000000000000000#!#5400650073007400200053007400720069006E00670020004B6DD58B2000#!#Test String 测试 🙂🙂🙂🙂#!#Test String 测试 #!#Test String 测试 🙂🙂🙂🙂       #!#Test String 测试 ????         #!#Test String 测试 ????
~~END~~


DECLARE @sourceString NCHAR(50) = N'Test String 测试 🙂🙂🙂🙂';
SELECT 
    -- To BINARY
    CAST(CAST(@sourceString AS VARBINARY(20)) AS BINARY(20)) AS 'As_BINARY',
    -- To VARBINARY
    CAST(@sourceString AS VARBINARY(20)) AS 'As_VARBINARY',
    -- To NTEXT
    CAST(@sourceString AS NTEXT) AS 'As_NTEXT',
    -- To NVARCHAR
    CAST(@sourceString AS NVARCHAR(50)) AS 'Back_to_NVARCHAR',
    -- To NCHAR
    CAST(@sourceString AS NCHAR(50)) AS 'AS_NCHAR',
    -- TO CHAR
    CAST(@sourceString AS CHAR(50)) AS 'AS_CHAR',
    -- TO VARCHAR
    CAST(@sourceString AS VARCHAR(50)) AS 'AS_VARCHAR';
GO
~~START~~
binary#!#varbinary#!#ntext#!#nvarchar#!#nchar#!#char#!#varchar
5465737420537472696E6720E6B58BE8AF9520F0#!#5465737420537472696E6720E6B58BE8AF9520F0#!#Test String 测试 🙂🙂🙂🙂                               #!#Test String 测试 🙂🙂🙂🙂                           #!#Test String 测试 🙂🙂🙂🙂                           #!#Test String 测试 ????                             #!#Test String 测试 ????                             
~~END~~




















--------------------------------------------
-- testing with set and select statements
--------------------------------------------
DECLARE @varchar_text VARCHAR(50) = 'Special: àáâãäçèéêë ñóôõö ¡¢£¤¥¦§ 123!';
DECLARE @nvarchar_text NVARCHAR(50) = N'你好世界 Testing Text 中文 😀😍🌟💖 こんにちは カタカナ 漢字 àáâã';
DECLARE @char_text CHAR(50) = 'Special: àáâãäçèéêë ñóôõö ¡¢£¤¥¦§ 123!';
DECLARE @nchar_text NCHAR(50) = N'你好世界 Testing Text 中文 😀😍🌟💖 こんにちは カタカナ 漢字 àáâã';
-- Assignment casting with SET
DECLARE @char_var CHAR(50);
DECLARE @nchar_var NCHAR(50);
DECLARE @varchar_var VARCHAR(50);
DECLARE @nvarchar_var NVARCHAR(50);
-- From VARCHAR to all target types
SET @char_var = @varchar_text;
SET @nchar_var = @varchar_text;
SET @varchar_var = @varchar_text;
SET @nvarchar_var = @varchar_text;
SELECT 'VARCHAR_SOURCE' as SourceType,
    @varchar_text as Original,
    @char_var as to_CHAR,
    @nchar_var as to_NCHAR,
    @varchar_var as to_VARCHAR,
    @nvarchar_var as to_NVARCHAR;
-- From NVARCHAR to all target types
SET @char_var = @nvarchar_text;        
SET @nchar_var = @nvarchar_text;
SET @varchar_var = @nvarchar_text;    
SET @nvarchar_var = @nvarchar_text;
SELECT 'NVARCHAR_SOURCE' as SourceType,
    @nvarchar_text as Original,
    @char_var as to_CHAR,
    @nchar_var as to_NCHAR,
    @varchar_var as to_VARCHAR,
    @nvarchar_var as to_NVARCHAR;
-- From CHAR to all target types
SET @char_var = @char_text;
SET @nchar_var = @char_text;
SET @varchar_var = @char_text;
SET @nvarchar_var = @char_text;
SELECT 'CHAR_SOURCE' as SourceType,
    @char_text as Original,
    @char_var as to_CHAR,
    @nchar_var as to_NCHAR,
    @varchar_var as to_VARCHAR,
    @nvarchar_var as to_NVARCHAR;
-- From NCHAR to all target types
SET @char_var = @nchar_text;         
SET @nchar_var = @nchar_text;
SET @varchar_var = @nchar_text;       
SET @nvarchar_var = @nchar_text;
SELECT 'NCHAR_SOURCE' as SourceType,
    @nchar_text as Original,
    @char_var as to_CHAR,
    @nchar_var as to_NCHAR,
    @varchar_var as to_VARCHAR,
    @nvarchar_var as to_NVARCHAR;
-- Using SELECT for assignment (same combinations)
-- From VARCHAR using SELECT
SELECT @char_var = @varchar_text;
SELECT @nchar_var = @varchar_text;
SELECT @varchar_var = @varchar_text;
SELECT @nvarchar_var = @varchar_text;
SELECT 'VARCHAR_SELECT_ASSIGN' as AssignmentType,
    @varchar_text as Original,
    @char_var as to_CHAR,
    @nchar_var as to_NCHAR,
    @varchar_var as to_VARCHAR,
    @nvarchar_var as to_NVARCHAR;
-- From NVARCHAR using SELECT
SELECT @char_var = @nvarchar_text;       
SELECT @nchar_var = @nvarchar_text;
SELECT @varchar_var = @nvarchar_text;    
SELECT @nvarchar_var = @nvarchar_text;
SELECT 'NVARCHAR_SELECT_ASSIGN' as AssignmentType,
    @nvarchar_text as Original,
    @char_var as to_CHAR,
    @nchar_var as to_NCHAR,
    @varchar_var as to_VARCHAR,
    @nvarchar_var as to_NVARCHAR;
-- From CHAR using SELECT
SELECT @char_var = @char_text;
SELECT @nchar_var = @char_text;
SELECT @varchar_var = @char_text;
SELECT @nvarchar_var = @char_text;
SELECT 'CHAR_SELECT_ASSIGN' as AssignmentType,
    @char_text as Original,
    @char_var as to_CHAR,
    @nchar_var as to_NCHAR,
    @varchar_var as to_VARCHAR,
    @nvarchar_var as to_NVARCHAR;
-- From NCHAR using SELECT
SELECT @char_var = @nchar_text;          
SELECT @nchar_var = @nchar_text;
SELECT @varchar_var = @nchar_text;      
SELECT @nvarchar_var = @nchar_text;
SELECT 'NCHAR_SELECT_ASSIGN' as AssignmentType,
    @nchar_text as Original,
    @char_var as to_CHAR,
    @nchar_var as to_NCHAR,
    @varchar_var as to_VARCHAR,
    @nvarchar_var as to_NVARCHAR;
GO
~~START~~
varchar#!#varchar#!#char#!#nchar#!#varchar#!#nvarchar
VARCHAR_SOURCE#!#Special: àá????èéê? ?ó??? ???¤??§ 123!#!#Special: àá????èéê? ?ó??? ???¤??§ 123!    #!#Special: àáâãäçèéêë ñóôõö ¡¢£¤¥¦§ 123!            #!#Special: àá????èéê? ?ó??? ???¤??§ 123!#!#Special: àáâãäçèéêë ñóôõö ¡¢£¤¥¦§ 123!
