-------------
-- NCHAR
-------------
-- JIRA query
DECLARE @inputString NCHAR(50) = N'  abc🙂defghi🙂🙂    '
SELECT @inputString
GO
~~START~~
nchar
  abc🙂defghi🙂🙂                                 
~~END~~


-- Simple ASCII string
DECLARE @simpleString NCHAR(20) = N'Hello World'
SELECT @simpleString
GO
~~START~~
nchar
Hello World         
~~END~~


-- Empty string
DECLARE @emptyString NCHAR(10) = N''
SELECT @emptyString, LEN(@emptyString) as length
GO
~~START~~
nchar#!#int
          #!#0
~~END~~


-- String with numbers and symbols
DECLARE @alphaNumeric NCHAR(30) = N'Test123!@#$%'
SELECT @alphaNumeric
GO
~~START~~
nchar
Test123!@#$%                  
~~END~~


-- Chinese characters
DECLARE @chineseString NCHAR(20) = N'你好世界'
SELECT @chineseString , LEN(@chineseString) AS Length
GO
~~START~~
nchar#!#int
你好世界                #!#4
~~END~~


-- Japanese characters
DECLARE @japaneseString NCHAR(25) = N'こんにちは'
SELECT @japaneseString , LEN(@japaneseString) AS Length
GO
~~START~~
nchar#!#int
こんにちは                    #!#5
~~END~~


-- Arabic characters (right-to-left)
DECLARE @arabicString NCHAR(30) = N'مرحبا بالعالم'
SELECT @arabicString AS 'Arabic String'
GO
~~START~~
nchar
مرحبا بالعالم                 
~~END~~


-- Mixed multibyte and ASCII
