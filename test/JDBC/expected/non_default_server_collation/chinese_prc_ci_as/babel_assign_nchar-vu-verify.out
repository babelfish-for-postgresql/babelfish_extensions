SELECT @quotedString
GO
~~START~~
nchar
He said "Hello World"         
~~END~~


-- String with backslashes
DECLARE @backslashString NCHAR(30) = N'C:\Temp\File.txt'
SELECT @backslashString
GO
~~START~~
nchar
C:\Temp\File.txt              
~~END~~


-- Very long string (testing padding)
DECLARE @longString NCHAR(50) = N'Short'
SELECT @longString, LEN(@longString) AS 'Actual Length'
GO
~~START~~
nchar#!#int
Short                                             #!#5
~~END~~


-- CHAR vs NCHAR
DECLARE @charString CHAR(20) = 'Hello World🙂🙂'
DECLARE @ncharString NCHAR(20) = N'Hello World🙂🙂'
SELECT 
    @charString , LEN(@charString) as length1,
    @ncharString , LEN(@ncharString) as length2
GO
~~START~~
char#!#int#!#nchar#!#int
Hello World??       #!#13#!#Hello World🙂🙂     #!#13
~~END~~


-- CHAR vs NCHAR with multibyte (CHAR will have issues with multibyte)
DECLARE @charMultibyte CHAR(20) = '你好🙂' 
DECLARE @ncharMultibyte NCHAR(20) = N'你好🙂'
SELECT  @charMultibyte, @ncharMultibyte
GO
~~START~~
char#!#nchar
你好?               #!#你好🙂                
~~END~~




