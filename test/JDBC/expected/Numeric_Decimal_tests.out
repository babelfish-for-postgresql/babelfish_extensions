---- 6.2 Conversion using CONVERT()
------------------------------------------------------------------------
-- BIT -> NUMERIC using CONVERT
SELECT CONVERT(NUMERIC(3,1), 0), CONVERT(NUMERIC(3,1), 1);
GO
~~START~~
numeric#!#numeric
