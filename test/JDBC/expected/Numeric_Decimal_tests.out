    MIN(POWER(numeric_small, 2)) AS min_numeric_squared,
    MIN(CASE WHEN category = 'A' THEN numeric_small ELSE 999 END) AS min_category_a
FROM #numeric_aggregate_test
WHERE numeric_small IS NOT NULL;
