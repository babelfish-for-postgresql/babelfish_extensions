~~END~~


-- Edge case: precision - scale = 1 (one digit before decimal)
SELECT CAST(9.12345 AS NUMERIC(6,5)), CAST(9.12345 AS DECIMAL(6,5));
GO
~~START~~
numeric#!#numeric
9.12345#!#9.12345
~~END~~


