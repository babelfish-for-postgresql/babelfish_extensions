12345#!#12345
~~END~~


-- Edge case: minimum precision (1)
SELECT CAST(1 AS NUMERIC(1,0)), CAST(1 AS DECIMAL(1,0));
GO
~~START~~
numeric#!#numeric
1#!#1
~~END~~


-- Edge case: maximum precision (38)
