CREATE VIEW TestSpatialFunc3_GeomMetrics_MakeValid_View AS SELECT ID, GeomID, MetricValue, GeomData.STIsValid() AS IsValidBefore,  (GeomData.MakeValid()).STIsValid() AS IsValidAfter, GeomData.MakeValid() AS TypeAfter FROM TestSpatialFunc3_GeomMetrics;

CREATE VIEW TestSpatialFunc3_GeogMetrics_MakeValid_View AS SELECT ID, GeogID, MetricValue, (GeogData.MakeValid()).STIsValid() AS IsValidAfter, GeogData.MakeValid() AS TypeAfter FROM TestSpatialFunc3_GeogMetrics;

CREATE VIEW TestSpatialFunc3_GeomMetrics_Area_View AS SELECT ID, GeomID, MetricValue, ValidGeom.STArea() AS AreaAfter, ValidGeom AS LengthAfter FROM (SELECT ID, GeomID, MetricValue, GeomData.MakeValid() AS ValidGeom FROM TestSpatialFunc3_GeomMetrics) AS t;

CREATE VIEW TestSpatialFunc3_GeogMetrics_Area_View AS SELECT ID, GeogID, MetricValue, ValidGeog.STArea() AS AreaAfter, ValidGeog AS LengthAfter FROM (SELECT ID, GeogID, MetricValue, GeogData.MakeValid() AS ValidGeog FROM TestSpatialFunc3_GeogMetrics) AS t;

