CREATE VIEW TestSpatialFunc3_MakeValidGeomView1 AS SELECT ID, Description, GeomColumn.MakeValid().STAsText() AS MadeValid, GeomColumn.MakeValid().STIsValid() AS IsValid FROM TestSpatialFunc3_MakeValidGeomTemp;

CREATE VIEW TestSpatialFunc3_MakeValidGeomView2 AS SELECT ID, Description, GeomColumn.STIsValid() AS BeforeValid, GeomColumn.MakeValid().STIsValid() AS AfterValid FROM TestSpatialFunc3_MakeValidGeomTemp;

CREATE VIEW TestSpatialFunc3_MakeValidGeomView3 AS SELECT ID, Description, GeomColumn.MakeValid().STArea() AS Area FROM TestSpatialFunc3_MakeValidGeomTemp;

CREATE VIEW TestSpatialFunc3_MakeValidGeomView4 AS SELECT ID, Description,  GeomColumn.MakeValid() AS type FROM TestSpatialFunc3_MakeValidGeomTemp;

CREATE VIEW TestSpatialFunc3_MakeValidGeomView5 AS SELECT ID, Description, GeomColumn.STSrid AS BeforeSRID, GeomColumn.MakeValid().STSrid AS AfterSRID FROM TestSpatialFunc3_MakeValidGeomTemp;

CREATE VIEW TestSpatialFunc3_MakeValidGeogView1 AS SELECT ID, Description, GeogColumn.MakeValid().STAsText() AS MadeValid, GeogColumn.MakeValid().STIsValid() AS IsValid FROM TestSpatialFunc3_MakeValidGeogTemp;

CREATE VIEW TestSpatialFunc3_MakeValidGeogView2 AS SELECT ID, Description, GeogColumn.STIsValid() AS BeforeValid, GeogColumn.MakeValid().STIsValid() AS AfterValid FROM TestSpatialFunc3_MakeValidGeogTemp;

CREATE VIEW TestSpatialFunc3_MakeValidGeogView3 AS SELECT ID, Description, GeogColumn.MakeValid().STArea() AS Area FROM TestSpatialFunc3_MakeValidGeogTemp;
