CREATE DATABASE TestSTNumPoints_DB;

USE TestSTNumPoints_DB;

USE MASTER

CREATE TABLE STNumPoints_geom_test ( ID INT PRIMARY KEY, geom_type VARCHAR(50), geom geometry );

