~~END~~


-- Verify final table state
SELECT * FROM OutputTest ORDER BY ID;
GO
~~START~~
int#!#nvarchar#!#int#!#nvarchar
1#!#Test1#!#300#!#Active
3#!#Test3#!#600#!#Updated
4#!#NewTest#!#800#!#Active
6#!#Computed#!#250#!#Active
7#!#ViewTest#!#999#!#Active
