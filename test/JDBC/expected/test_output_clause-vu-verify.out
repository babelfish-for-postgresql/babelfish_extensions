SET Value = 999
OUTPUT deleted.Name, deleted.Value as OldValue, inserted.Value as NewValue
WHERE Name = 'ViewTest' AND Status = 'Active';
GO
~~START~~
nvarchar#!#int#!#int
ViewTest#!#600#!#999
~~END~~


