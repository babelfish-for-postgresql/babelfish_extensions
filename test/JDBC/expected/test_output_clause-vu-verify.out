OUTPUT inserted.ID, inserted.Name, 'TRIGGER_TEST' as TestType
VALUES (8, 'TriggerTest1', 700);
GO
~~START~~
int#!#nvarchar#!#varchar
8#!#TriggerTest1#!#TRIGGER_TEST
