1#!#Row1#!#999#!#201#!#PostTrigger
2#!#Row2#!#200#!#2#!#Active
3#!#Row3#!#300#!#3#!#Active
~~END~~

~~START~~
int#!#int#!#int#!#int#!#nvarchar
1#!#1#!#500#!#999#!#Logged
~~END~~

delete from EPQOutputLog;
GO
~~ROW COUNT: 1~~



