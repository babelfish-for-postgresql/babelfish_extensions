-- Text Nodes (nodetype = 3)
DECLARE @xml nvarchar(1000) = '<root>This is text content</root>'
DECLARE @handle INT
EXEC sp_xml_preparedocument @handle OUTPUT, @xml
SELECT * FROM OPENXML(@handle, '/') WHERE nodetype = 3 ORDER BY id;
