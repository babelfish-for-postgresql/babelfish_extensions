-- Extreme Values and Edge Cases
DECLARE @xml nvarchar(1000) = '<root 
    veryLongAttributeName="VeryLongAttributeValueThatExceedsNormalLengthExpectations"
    emptyAttr=""
    numericAttr="12345.67"
    booleanAttr="true"
    dateAttr="2024-01-01T10:30:00Z">
    <emptyElement></emptyElement>
    <whitespaceElement>   </whitespaceElement>
    <numberElement>42</numberElement>
    <decimalElement>3.14159</decimalElement>
    <specialChars>&lt;&gt;&amp;&quot;&apos;</specialChars>
</root>'
DECLARE @handle INT
EXEC sp_xml_preparedocument @handle OUTPUT, @xml
SELECT 
    localname,
    nodetype,
    LEN(CAST(text as NVARCHAR(MAX))) as TextLength,
    CAST(text as NVARCHAR(MAX)) as TextContent
FROM OPENXML(@handle, '/')
WHERE nodetype IN (1, 2, 3)
ORDER BY id
EXEC sp_xml_removedocument @handle
GO
~~START~~
nvarchar#!#int#!#int#!#nvarchar
root#!#1#!#<NULL>#!#<NULL>
veryLongAttributeName#!#2#!#<NULL>#!#<NULL>
#text#!#3#!#57#!#VeryLongAttributeValueThatExceedsNormalLengthExpectations
emptyAttr#!#2#!#<NULL>#!#<NULL>
numericAttr#!#2#!#<NULL>#!#<NULL>
#text#!#3#!#8#!#12345.67
booleanAttr#!#2#!#<NULL>#!#<NULL>
#text#!#3#!#4#!#true
dateAttr#!#2#!#<NULL>#!#<NULL>
#text#!#3#!#20#!#2024-01-01T10:30:00Z
emptyElement#!#1#!#<NULL>#!#<NULL>
whitespaceElement#!#1#!#<NULL>#!#<NULL>
numberElement#!#1#!#<NULL>#!#<NULL>
#text#!#3#!#2#!#42
decimalElement#!#1#!#<NULL>#!#<NULL>
#text#!#3#!#7#!#3.14159
specialChars#!#1#!#<NULL>#!#<NULL>
#text#!#3#!#5#!#<>&"'
~~END~~



