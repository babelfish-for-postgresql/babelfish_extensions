-- Special Node Selection Tests
DECLARE @xml nvarchar(1000) = '<?xml version="1.0"?>
<!-- Root comment -->
<root xmlns="http://default.ns" xmlns:prefix="http://prefix.ns" attr="rootattr">
    Text content
    <element prefix:attr="prefixedattr">Element text</element>
    <!-- Element comment -->
    <![CDATA[CDATA section content]]>
    <?processing-instruction data?>
    <selfclosing/>
</root>' 
DECLARE @handle INT 
EXEC sp_xml_preparedocument @handle OUTPUT, @xml 
SELECT * FROM OPENXML(@handle, '//comment() | //processing-instruction()')  ORDER BY id;
EXEC sp_xml_removedocument @handle
GO
~~START~~
bigint#!#bigint#!#int#!#nvarchar#!#nvarchar#!#nvarchar#!#nvarchar#!#bigint#!#ntext
1#!#<NULL>#!#8#!##comment#!#<NULL>#!#<NULL>#!#<NULL>#!#<NULL>#!#Root comment
14#!#0#!#8#!##comment#!#<NULL>#!#<NULL>#!#<NULL>#!#10#!#Element comment
16#!#0#!#7#!#processing-instruction#!#<NULL>#!#<NULL>#!#<NULL>#!#15#!#data
~~END~~



