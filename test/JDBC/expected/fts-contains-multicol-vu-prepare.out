CREATE UNIQUE INDEX uid ON test_tb(id)
GO

CREATE FULLTEXT INDEX ON test_tb(txt1, txt2) KEY INDEX uid
GO

SELECT * FROM test_tb WHERE contains((txt1, txt2), '"The human genome"' )
GO
