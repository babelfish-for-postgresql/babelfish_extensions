---------------------------------------------------------
-- Testing Triggers
---------------------------------------------------------
-- Test Case: AFTER INSERT Trigger
USE db_missing_tests_v2;
GO
CREATE TABLE schema_test_a_v2.orders (id INT, product_id INT, quantity INT);
CREATE TABLE schema_test_a_v2.audit_log (log_id INT IDENTITY(1,1), action VARCHAR(50), table_name VARCHAR(50));
GO

CREATE TRIGGER schema_test_a_v2.trg_orders_audit
ON schema_test_a_v2.orders
AFTER INSERT
AS
BEGIN
    INSERT INTO schema_test_a_v2.audit_log (action, table_name)
    SELECT 'INSERT', 'orders' FROM inserted;
END;
GO

-- Grant INSERT permission on orders table
GRANT INSERT ON schema_test_a_v2.orders TO user_test_b_v2;
GO
-- terminate-tsql-conn user=login_test_a_v2 password=123

-- tsql user=login_test_b_v2 password=123
-- Test as user_test_b_v2
USE db_missing_tests_v2;
GO
INSERT INTO schema_test_a_v2.orders VALUES (1, 1, 5);  -- Should succeed, trigger works through ownership chain
GO
