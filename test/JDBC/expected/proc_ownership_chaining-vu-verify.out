-- 4.2 Complex DML
---------------------------------------------------------
-- Test Case 4.2.1: Multi-table operations
USE db_dml_test_v4;
GO
CREATE TABLE schema_dml1_v4.source_table (id INT, val VARCHAR(50));
CREATE TABLE schema_dml1_v4.target_table (id INT, val VARCHAR(50));
INSERT INTO schema_dml1_v4.source_table VALUES (1, 'source1'), (2, 'source2');
GO
~~ROW COUNT: 2~~


CREATE PROCEDURE schema_dml1_v4.multi_table_proc
AS
BEGIN
    INSERT INTO schema_dml1_v4.target_table
    SELECT * FROM schema_dml1_v4.source_table;
    
    UPDATE t SET val = s.val + '_updated'
    FROM schema_dml1_v4.target_table t
    JOIN schema_dml1_v4.source_table s ON t.id = s.id;
END;
GO

-- Grant execute permission
GRANT EXECUTE ON schema_dml1_v4.multi_table_proc TO user_dml2_v4;
