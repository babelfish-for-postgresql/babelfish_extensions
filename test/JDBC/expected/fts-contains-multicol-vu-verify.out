-- enable FULLTEXT
-- tsql user=jdbc_user password=12345678
SELECT set_config('babelfishpg_tsql.escape_hatch_fulltext', 'ignore', 'false')
GO
~~START~~
text
ignore
~~END~~


-- Basic Multiple Column Tests
SELECT sys.replace_special_chars_fts('one`two', 'three@four', 'five#six');
GO
~~START~~
text
onespecialCharscat2e09616b53f5138735a7d0a79e78e804etwo||' '||three specialCharscat1e09616b53f5138735a7d0a79e78e804e four||' '||five specialCharscat1e09616b53f5138735a7d0a79e78e804e six
~~END~~


-- Mixed Single and Multiple Column Tests
SELECT sys.replace_special_chars_fts('"one @ @ @ @ two"');
GO
~~START~~
text
"one @ @ @ @ two"
~~END~~


-- Quoted String Multiple Column Tests
SELECT sys.replace_special_chars_fts('"one @ two"', '"three $ four"', '"five # six"');
GO
~~START~~
text
"one specialCharscat1e09616b53f5138735a7d0a79e78e804e two"||' '||"three specialCharscat1e09616b53f5138735a7d0a79e78e804e four"||' '||"five specialCharscat1e09616b53f5138735a7d0a79e78e804e six"
~~END~~


-- Apostrophe Multiple Column Tests
SELECT sys.replace_special_chars_fts('Arts '' opening', 'Bob''s place', 'Smith''s store');
GO
~~START~~
text
Arts specialCharscat3e09616b53f5138735a7d0a79e78e804e opening||' '||BobspecialCharscat3e09616b53f5138735a7d0a79e78e804es place||' '||SmithspecialCharscat3e09616b53f5138735a7d0a79e78e804es store
~~END~~


-- Empty and NULL Multiple Column Tests
SELECT sys.replace_special_chars_fts('', NULL, 'three');
GO
~~START~~
text
||' '||three
~~END~~


-- Mixed Content Type Tests
SELECT sys.replace_special_chars_fts('normal text', '"quoted text"', 'special@text');
GO
~~START~~
text
normal text||' '||"quoted text"||' '||special specialCharscat1e09616b53f5138735a7d0a79e78e804e text
~~END~~




