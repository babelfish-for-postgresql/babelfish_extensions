-- tsql
UPDATE datetime_test SET date_time1 = cast(date_time1 as datetime), date_time2 = cast(date_time2 as datetime);
GO
~~ROW COUNT: 4~~


-- psql
select date_time1, date_time2 FROM master_dbo.datetime_test;
GO
