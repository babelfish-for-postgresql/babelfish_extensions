DECLARE @dt1 DATETIME = '2024-03-12 12:00:34.466';
DECLARE @dt2 DATETIME = '2024-03-12 12:00:34.465';
SELECT 
    'Addition' as operation,
    @dt1 + @dt2 as result,
    CAST(@dt1 + @dt2 AS VARCHAR(30)) as result_string;
SELECT 
    'Subtraction' as operation,
    @dt1 - @dt2 as result,
    CAST(@dt1 - @dt2 AS VARCHAR(30)) as result_string;
GO
