-- Test View with datetime to binary conversion
CREATE VIEW vw_datetime_binary AS
SELECT 
    id,
    dt_col,
    CAST(dt_col AS BINARY(8)) AS dt_as_binary,
    CONVERT(BINARY(4), dt_col) AS dt_as_binary4
FROM test_datetime_binary
WHERE dt_col IS NOT NULL;
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: cannot cast type datetime to "binary")~~


-- Test User-Defined Function with datetime to binary
CREATE FUNCTION fn_datetime_to_binary(@input_dt DATETIME)
RETURNS BINARY(8)
AS
BEGIN
    RETURN CAST(@input_dt AS BINARY(8));
END;
GO

-- Test Table-Valued Function
CREATE FUNCTION fn_get_datetime_binary_range(@start_dt DATETIME, @end_dt DATETIME)
RETURNS TABLE
AS
RETURN
(
    SELECT 
        dt_col,
        CAST(dt_col AS BINARY(8)) AS dt_binary
    FROM test_datetime_binary
    WHERE dt_col BETWEEN @start_dt AND @end_dt
);
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: cannot cast type datetime to "binary")~~


-- Test Stored Procedure with datetime to binary conversion
CREATE PROCEDURE sp_convert_datetime_binary
    @input_dt DATETIME,
    @output_bin BINARY(8) OUTPUT
AS
BEGIN
    SET @output_bin = CAST(@input_dt AS BINARY(8));

    -- Also insert a test record
    INSERT INTO test_datetime_binary (id, dt_col, bin_col)
    VALUES (999, @input_dt, @output_bin);
END;
GO

-- Test Computed Column with datetime to binary
CREATE TABLE test_computed_binary (
    id INT,
    dt_col DATETIME,
    computed_binary AS CAST(dt_col AS BINARY(8)) PERSISTED
);
GO
