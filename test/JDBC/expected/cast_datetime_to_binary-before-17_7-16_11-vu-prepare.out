-- Test Default Constraint with datetime to binary
CREATE TABLE test_default_binary (
    id INT,
    dt_col DATETIME DEFAULT '2023-01-01 00:00:00.000',
    bin_col BINARY(8) DEFAULT CAST('2023-01-01 00:00:00.000' AS BINARY(8))
);
GO
