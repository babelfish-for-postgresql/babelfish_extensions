-- Test Trigger with datetime to binary conversion
CREATE TRIGGER tr_datetime_binary_audit
ON test_datetime_binary
AFTER INSERT, UPDATE
AS
BEGIN
    INSERT INTO test_computed_binary (dt_col)
    SELECT CAST(dt_col AS DATETIME)
    FROM inserted
    WHERE dt_col IS NOT NULL;
END;
GO

-- Test Check Constraint using datetime to binary
CREATE TABLE test_constraint_binary (
    id INT,
    dt_col DATETIME,
    CONSTRAINT CK_datetime_binary CHECK (CAST(dt_col AS BINARY(8)) IS NOT NULL OR dt_col IS NULL)
);
GO
