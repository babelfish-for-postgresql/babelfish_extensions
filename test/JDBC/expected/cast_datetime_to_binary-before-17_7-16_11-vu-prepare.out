
-- Test datetime to binary cast function
CREATE TABLE test_datetime_binary (
    id INT,
    dt_col DATETIME,
    bin_col BINARY(8)
);
INSERT INTO test_datetime_binary VALUES 
(1, '2023-01-01 12:30:45.123', NULL),
(2, '1900-01-01 00:00:00.000', NULL),
(3, '2099-12-31 23:59:59.997', NULL),
(4, NULL, NULL);
GO
~~ROW COUNT: 4~~



/*
