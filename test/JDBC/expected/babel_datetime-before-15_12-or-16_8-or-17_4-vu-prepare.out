-- Procedure for datetime to varbinary conversion
CREATE PROCEDURE babel_datetime_varbinary_vu_procedure
AS
BEGIN
	select cast(cast('2023-06-15 14:30:45.123' as datetime) as varbinary)
	select cast(cast('2000-02-29 12:30:45.000' as datetime) as varbinary)
	select cast(cast('1999-12-31 23:59:59.997' as datetime) as varbinary)
END;
GO

-- Function that takes datetime and returns varbinary
CREATE FUNCTION babel_datetime_varbinary_vu_function1 (@inputdate VARBINARY)
RETURNS VARBINARY
AS
BEGIN
	RETURN @inputdate
END
