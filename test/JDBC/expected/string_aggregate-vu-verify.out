-- Test with having clause 
SELECT 
    category,
    MIN(col_nchar) AS min_nchar,
    MAX(col_nchar) AS max_nchar,
    COUNT(*) AS cnt
FROM babel_5688_all_types
GROUP BY category
HAVING MIN(col_nchar) IS NOT NULL AND MAX(col_nchar) IS NOT NULL;
GO
