-- Test CTEs
WITH MinMaxCTE AS (
    SELECT 
        category,
        MIN(col_nchar) AS min_nchar,
        MAX(col_nchar) AS max_nchar,
        MIN(col_char) AS min_char,
        MAX(col_char) AS max_char
    FROM babel_5688_all_types
    GROUP BY category
)
SELECT * FROM MinMaxCTE WHERE min_nchar IS NOT NULL ORDER BY category;
GO
