PRINT 'exec 1: proc_param_unsupported';
GO
EXEC dbo.proc_param_unsupported @max = 3;
GO
~~START~~
int
3
~~END~~

-- Second call (uses in-memory hash table cache)
PRINT 'exec 2: proc_param_unsupported';
GO
EXEC dbo.proc_param_unsupported @max = 5;
GO
~~START~~
int
5
~~END~~


