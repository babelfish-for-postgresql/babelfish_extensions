-- === Test 9: ALTER with GUC off — hash table reuse, no persistent cache activity ===
-- ALTER populates hash table via validator. Execs reuse it. Cache only populated in new session.
PRINT '=== Test 9: ALTER with GUC off, EXEC with GUC on ===';
GO

-- Stats for Test 9: Begin
SELECT * FROM sys.antlr_parse_cache_stats();
GO
~~START~~
int#!#int#!#int#!#int#!#int
18#!#1#!#4#!#2#!#0
~~END~~


-- alter_guc_proc was created with GUC off in prepare (no cache populated)
SELECT set_config('babelfishpg_tsql.enable_antlr_parse_cache', 'off', false);
GO
~~START~~
text
off
~~END~~


-- ALTER with GUC off: validator compiles via ANTLR, inserts into hash table,
-- but pltsql_fill_cache_columns skips cache write (GUC off + antlr_parse_cache_enabled=NULL)
PRINT 'alter: alter_guc_proc (GUC off)';
GO
ALTER PROCEDURE dbo.alter_guc_proc
    @val INT
AS
BEGIN
    SELECT @val + 100 AS big_increment;
END;
GO

-- Turn GUC on and execute: hash table already has the function from ALTER,
-- so pltsql_compile reuses it (function_valid=true). do_compile does NOT run.
-- No persistent cache miss, hit, or write — the hash table entry is from ANTLR, not cache.
-- Cache would only be populated in a NEW session (hash table empty → do_compile → write).
SELECT set_config('babelfishpg_tsql.enable_antlr_parse_cache', 'on', false);
GO
~~START~~
text
on
~~END~~


PRINT 'exec 1: alter_guc_proc (hash table reuse from ALTER, no cache activity)';
GO
EXEC dbo.alter_guc_proc @val = 5;
GO
~~START~~
int
105
~~END~~


-- Second exec: same hash table reuse, still no cache activity
PRINT 'exec 2: alter_guc_proc';
GO
EXEC dbo.alter_guc_proc @val = 10;
GO
~~START~~
int
110
~~END~~


