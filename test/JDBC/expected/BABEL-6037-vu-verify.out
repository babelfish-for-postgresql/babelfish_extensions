-- Test 31: Procedure with geometry parameter and text parameter
CREATE PROCEDURE test_geometry_cache
    @geom geometry,
    @label VARCHAR(50)
AS
BEGIN
    DECLARE @point1 geometry = geometry::Point(1.0, 2.0, 4326);
    DECLARE @point2 geometry = @geom;
    -- Test geometry operations
    SELECT @label AS test_label, @point1.STX AS point1_x, @point1.STY AS point1_y;
    SELECT @label AS test_label, @point2.STX AS point2_x, @point2.STY AS point2_y;
    SELECT @label AS test_label, CAST(@point1.STDistance(@point2) AS numeric(20, 6)) AS distance;
END;
GO

-- Check stats after CREATE (should have cache_writes = 1)
SELECT cache_writes FROM sys.antlr_parse_cache_stats();
GO
~~START~~
int
3
~~END~~


-- Verify cache was populated
SELECT funcname,
    CASE WHEN antlr_parse_cache_tree IS NOT NULL THEN 'cached' ELSE 'not cached' END AS cache_status
FROM sys.babelfish_function_ext
WHERE funcname = 'test_geometry_cache' AND nspname = 'master_dbo';
GO
~~START~~
varchar#!#varchar
test_geometry_cache#!#cached
~~END~~


-- First execution (hash table miss, restore ext cached result)
PRINT 'exec 1: test_geometry_cache';
GO
DECLARE @g geometry = geometry::Point(3.0, 4.0, 4326);
EXEC test_geometry_cache @geom = @g, @label = 'exec1';
GO
~~START~~
varchar#!#float#!#float
exec1#!#1.0#!#2.0
~~END~~

~~START~~
varchar#!#float#!#float
exec1#!#3.0#!#4.0
~~END~~

~~START~~
varchar#!#numeric
exec1#!#2.828427
~~END~~


-- Second execution (hash table hit, test zero distance)
PRINT 'exec 2: test_geometry_cache';
GO
DECLARE @g geometry = geometry::Point(1.0, 2.0, 4326);
EXEC test_geometry_cache @geom = @g, @label = 'exec2';
GO
~~START~~
