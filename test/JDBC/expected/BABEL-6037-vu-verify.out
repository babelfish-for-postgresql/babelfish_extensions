-- tsql


-- BABEL-6037 POC Test - Verify
-- Tests procedure execution with parse tree caching
-- Runs in a new session (.mix) so the PLtsql hash table is empty and
-- do_compile is called for each function, exercising the cache read/write paths.
--
-- Cache layers (see BABEL-6037 design):
--   CREATE/ALTER: compiles the procedure, serializes parse tree to babelfish_func_ext (persistent cache)
--   1st exec in session: pltsql hash table miss -> deserializes from babelfish_func_ext, populates hash table
--   2nd exec in session: pltsql hash table hit
-- SET BABELFISH_STATISTICS PROFILE ON;
-- GO
SELECT set_config('babelfishpg_tsql.enable_antlr_parse_cache', 'on', false);
GO
~~START~~
text
on
~~END~~


-- Baseline cache stats (new session, all zeros)
SELECT * FROM sys.antlr_parse_cache_stats();
GO
~~START~~
int#!#int#!#int#!#int#!#int
0#!#0#!#0#!#0#!#0
~~END~~


PRINT '=== Test 1: Simple procedure without arguments ===';
GO
-- First call (deserializes ANTLR parse tree cached at CREATE time)
PRINT 'exec 1: small_proc';
GO
EXEC dbo.small_proc;
GO
~~START~~
int
1
~~END~~

-- Second call (uses in-memory hash table cache)
PRINT 'exec 2: small_proc';
GO
EXEC dbo.small_proc;
GO
~~START~~
int
1
~~END~~


-- Stats after Test 1: 2 execs
-- expect hits=2 (1 cache restore from bbf_ext + 1 hash table from_cache hit)
SELECT * FROM sys.antlr_parse_cache_stats();
GO
~~START~~
