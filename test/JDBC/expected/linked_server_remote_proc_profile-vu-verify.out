-- tsql
USE master;
GO

SELECT name, data_source FROM sys.servers WHERE name = 'ls_svr';
GO
~~START~~
varchar#!#nvarchar
ls_svr#!#localhost
~~END~~



DECLARE @i int = 0;
DECLARE @out int = 0;
EXEC ls_svr.master.dbo.rp_profile_out @x=@i, @rows=4096, @y=@out OUTPUT;
SELECT 1 AS iterations,
       4096 AS total_rows,
       @i AS first_value,
       @i + 4095 AS last_value,
       48 AS payload_width,
       @out AS last_output;
GO
~~START~~
