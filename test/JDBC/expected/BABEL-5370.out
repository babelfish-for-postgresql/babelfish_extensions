--Test case 2: Find specific time zone
SELECT * FROM sys.time_zone_info 
WHERE name = 'Eastern Standard Time';
GO
~~START~~
text#!#varchar#!#bit
Eastern Standard Time#!#-04:00#!#1
~~END~~

