-- Test case 5: Time zones with unusual offsets (not full hours)
SELECT name, current_utc_offset
FROM sys.time_zone_info
WHERE current_utc_offset LIKE '%:30' 
   OR current_utc_offset LIKE '%:45'
ORDER BY current_utc_offset;
GO
~~START~~
