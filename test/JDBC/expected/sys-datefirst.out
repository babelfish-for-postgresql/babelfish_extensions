-- Integral Value
-- inbound value (1-7)
SET datefirst 2
GO
SELECT @@datefirst
GO
~~START~~
int
2
~~END~~


SET DATEFIRST 3
GO
SELECT @@DATEFIRST
GO
~~START~~
int
3
~~END~~


SET DATEFIRST 4
GO
SELECT @@datefirst
GO
~~START~~
int
4
~~END~~


DECLARE @i INT = 5
SET DATEFIRST @i
GO
SELECT @@DATEFIRST
GO
~~START~~
int
5
~~END~~


SET DATEFIRST 6
GO
SELECT @@DATEFIRST
GO
~~START~~
int
6
~~END~~


-- edge point values 
declare @i int = 1
SET datefirst @i
GO
SELECT @@datefirst
GO
~~START~~
int
1
~~END~~


SET datefirst 7
GO
SELECT @@DATEFIRST
GO
~~START~~
int
7
~~END~~


