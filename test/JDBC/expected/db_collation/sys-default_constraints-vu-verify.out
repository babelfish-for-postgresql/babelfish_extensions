0
~~END~~


-- temp tables keep no DEFAULT name (they go away without a T-SQL DROP), so
-- unlike SQL Server their defaults cannot be dropped by the user-given name
CREATE TABLE #babel_6221_tmp (a INT CONSTRAINT babel_6221_df_tmp DEFAULT 5);
GO

ALTER TABLE #babel_6221_tmp DROP CONSTRAINT babel_6221_df_tmp;
GO
~~ERROR (Code: 3728)~~

~~ERROR (Message: constraint "babel_6221_df_tmp" of relation "#babel_6221_tmp" does not exist)~~


-- a named DEFAULT on a temp table gets the same checks as an unnamed one
CREATE FUNCTION babel_6221_f() RETURNS INT AS BEGIN RETURN 1 END;
GO

ALTER TABLE #babel_6221_tmp ADD DEFAULT babel_6221_f() FOR a;
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: User-defined functions, partition functions, and column references are not allowed in expressions in this context.)~~


ALTER TABLE #babel_6221_tmp ADD CONSTRAINT babel_6221_df_tmp2 DEFAULT babel_6221_f() FOR a;
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: User-defined functions, partition functions, and column references are not allowed in expressions in this context.)~~


DROP TABLE #babel_6221_tmp;
GO

