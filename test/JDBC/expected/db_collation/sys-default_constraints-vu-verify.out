-- a name given twice in one ALTER TABLE, at least once to a DEFAULT, is a duplicate too
-- (Babelfish accepts only one ADD item per ALTER TABLE, so this is the reachable case)
CREATE TABLE babel_6221_t22 (a INT, b INT);
GO

ALTER TABLE babel_6221_t22 ADD c INT CONSTRAINT babel_6221_df_t22 DEFAULT 1 CONSTRAINT babel_6221_df_t22 CHECK (c > 0);
