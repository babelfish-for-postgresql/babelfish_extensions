-- the name follows a column rename and then a table rename
CREATE TABLE babel_6221_t5 (a INT, b INT);
GO

ALTER TABLE babel_6221_t5 ADD CONSTRAINT babel_6221_df_t5 DEFAULT 7 FOR b;
GO

EXEC sp_rename 'babel_6221_t5.b', 'b_renamed', 'COLUMN';
GO

EXEC sp_rename 'babel_6221_t5', 'babel_6221_t5_renamed', 'OBJECT';
GO

ALTER TABLE babel_6221_t5_renamed DROP CONSTRAINT babel_6221_df_t5;
GO

INSERT INTO babel_6221_t5_renamed (a) VALUES (1);
GO
~~ROW COUNT: 1~~


SELECT a, b_renamed FROM babel_6221_t5_renamed;
GO
~~START~~
int#!#int
1#!#<NULL>
~~END~~


-- DEFAULT names are unique within a schema, as in SQL Server (Msg 2714)
CREATE TABLE babel_6221_t6 (a INT CONSTRAINT babel_6221_df_t6 DEFAULT 1, b INT, CONSTRAINT babel_6221_chk_t6 CHECK (a > 0));
GO

-- ... against another DEFAULT of the same table
ALTER TABLE babel_6221_t6 ADD CONSTRAINT babel_6221_df_t6 DEFAULT 2 FOR b;
GO
~~ERROR (Code: 2714)~~

~~ERROR (Message: There is already an object named 'babel_6221_df_t6' in the database.)~~


-- ... against a CHECK constraint of the same table
ALTER TABLE babel_6221_t6 ADD CONSTRAINT babel_6221_chk_t6 DEFAULT 2 FOR b;
GO
~~ERROR (Code: 2714)~~

~~ERROR (Message: There is already an object named 'babel_6221_chk_t6' in the database.)~~


-- ... against a DEFAULT of another table of the schema
CREATE TABLE babel_6221_t7 (x INT CONSTRAINT babel_6221_df_t6 DEFAULT 1);
GO
~~ERROR (Code: 2714)~~

~~ERROR (Message: There is already an object named 'babel_6221_df_t6' in the database.)~~


-- ... within one CREATE TABLE
CREATE TABLE babel_6221_t7 (x INT CONSTRAINT babel_6221_df_t7 DEFAULT 1, y INT CONSTRAINT babel_6221_df_t7 DEFAULT 2);
GO
~~ERROR (Code: 2714)~~

~~ERROR (Message: There is already an object named 'babel_6221_df_t7' in the database.)~~


-- the failed statements left the existing default and its name in place
INSERT INTO babel_6221_t6 (b) VALUES (1);
GO
~~ROW COUNT: 1~~


ALTER TABLE babel_6221_t6 DROP CONSTRAINT babel_6221_df_t6;
GO

SELECT COUNT(*) FROM sys.default_constraints WHERE parent_object_id = OBJECT_ID('babel_6221_t6');
GO
~~START~~
int
0
~~END~~


-- other constraint types are dropped by name as before
ALTER TABLE babel_6221_t6 DROP CONSTRAINT babel_6221_chk_t6;
GO

ALTER TABLE babel_6221_t6 DROP CONSTRAINT babel_6221_no_such_constraint;
GO
~~ERROR (Code: 3728)~~

~~ERROR (Message: constraint "babel_6221_no_such_constraint" of relation "babel_6221_t6" does not exist)~~


-- a failed ALTER inside a transaction does not record the name
BEGIN TRAN;
GO

ALTER TABLE babel_6221_t6 ADD CONSTRAINT babel_6221_df_bad DEFAULT 1 FOR no_such_column;
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: column "no_such_column" of relation "babel_6221_t6" does not exist)~~


IF @@TRANCOUNT > 0 COMMIT;
GO

SELECT COUNT(*) FROM sys.babelfish_identifier_mapping WHERE original_identifier_name = 'babel_6221_df_bad';
GO
~~START~~
int
0
~~END~~


