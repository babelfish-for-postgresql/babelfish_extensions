-- inside a procedure, executed twice (cached plan)
CREATE TABLE babel_6221_t15 (a INT);
GO

CREATE PROCEDURE babel_6221_p AS
BEGIN
	ALTER TABLE babel_6221_t15 ADD CONSTRAINT babel_6221_df_t15 DEFAULT 5 FOR a
	INSERT INTO babel_6221_t15 DEFAULT VALUES
	ALTER TABLE babel_6221_t15 DROP CONSTRAINT babel_6221_df_t15
	INSERT INTO babel_6221_t15 DEFAULT VALUES
	SELECT COUNT(*), COUNT(a) FROM babel_6221_t15
END
GO

EXEC babel_6221_p;
GO
~~ROW COUNT: 1~~

~~ROW COUNT: 1~~

~~START~~
int#!#int
2#!#1
~~END~~


EXEC babel_6221_p;
GO
~~ROW COUNT: 1~~

~~ROW COUNT: 1~~

~~START~~
int#!#int
4#!#2
~~END~~


