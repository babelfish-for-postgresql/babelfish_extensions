GO
~~ERROR (Code: 3728)~~

~~ERROR (Message: constraint "babel_6221_df_t11a" of relation "babel_6221_t11" does not exist)~~


ALTER TABLE babel_6221_t11 ADD DEFAULT 3 FOR c;
GO

ALTER TABLE babel_6221_t11 DROP CONSTRAINT babel_6221_df_t11c;
GO
~~ERROR (Code: 3728)~~

~~ERROR (Message: constraint "babel_6221_df_t11c" of relation "babel_6221_t11" does not exist)~~


ALTER TABLE babel_6221_t11 DROP CONSTRAINT babel_6221_df_t11b;
GO

INSERT INTO babel_6221_t11 (a) VALUES (1);
