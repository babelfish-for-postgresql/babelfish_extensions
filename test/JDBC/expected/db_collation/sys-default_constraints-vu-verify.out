-- BABEL-6221 / BABEL-6256: ALTER TABLE ... DROP CONSTRAINT <name> of a DEFAULT constraint
-- A DEFAULT named in -vu-prepare may come from a version before the fix, which
-- kept no name; it can always be dropped by the name sys.default_constraints shows
DECLARE @n sys.sysname = (SELECT name FROM sys.default_constraints WHERE parent_object_id = OBJECT_ID('sys_default_constraints_vu_prepare_t1'))
EXEC('ALTER TABLE sys_default_constraints_vu_prepare_t1 DROP CONSTRAINT ' + @n)
GO

SELECT COUNT(*) FROM sys.default_constraints WHERE parent_object_id = OBJECT_ID('sys_default_constraints_vu_prepare_t1');
GO
~~START~~
int
0
~~END~~


-- BABEL-6221 repro: ALTER TABLE ... ADD CONSTRAINT <name> DEFAULT ... FOR, dropped by name
CREATE TABLE babel_6221_mytab (a INT PRIMARY KEY, b INT);
GO

ALTER TABLE babel_6221_mytab ADD CONSTRAINT DF_babel_6221_mytab DEFAULT (0) FOR b;
GO

INSERT INTO babel_6221_mytab (a) VALUES (1);
GO
~~ROW COUNT: 1~~


ALTER TABLE babel_6221_mytab DROP CONSTRAINT DF_babel_6221_mytab;
GO

INSERT INTO babel_6221_mytab (a) VALUES (2);
GO
~~ROW COUNT: 1~~


SELECT a, b FROM babel_6221_mytab ORDER BY a;
GO
~~START~~
int#!#int
1#!#0
2#!#<NULL>
~~END~~


-- a second drop fails as in SQL Server; IF EXISTS does not
ALTER TABLE babel_6221_mytab DROP CONSTRAINT DF_babel_6221_mytab;
GO
~~ERROR (Code: 3728)~~

~~ERROR (Message: constraint "df_babel_6221_mytab" of relation "babel_6221_mytab" does not exist)~~


ALTER TABLE babel_6221_mytab DROP CONSTRAINT IF EXISTS DF_babel_6221_mytab;
GO

-- BABEL-6256 repro: column-level CONSTRAINT <name> DEFAULT in CREATE TABLE
CREATE TABLE babel_6221_t1 (col1 INT CONSTRAINT babel_6221_c DEFAULT 0, col2 INT);
GO

ALTER TABLE babel_6221_t1 DROP CONSTRAINT babel_6221_c;
GO

INSERT INTO babel_6221_t1 (col2) VALUES (1);
GO
~~ROW COUNT: 1~~


SELECT col1, col2 FROM babel_6221_t1;
GO
~~START~~
int#!#int
<NULL>#!#1
~~END~~


