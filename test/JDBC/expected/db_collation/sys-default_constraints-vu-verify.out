DECLARE @n sys.sysname = (SELECT conname FROM pg_catalog.pg_constraint WHERE conrelid = OBJECT_ID('babel_6221_t23') AND contype = 'n')
BEGIN TRY
	EXEC('ALTER TABLE babel_6221_t23 ADD CONSTRAINT ' + @n + ' DEFAULT 1 FOR b')
END TRY
BEGIN CATCH
	SELECT ERROR_NUMBER()
END CATCH
GO
