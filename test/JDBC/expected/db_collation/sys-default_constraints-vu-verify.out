int
2714
~~END~~


-- constraints of a table type are not schema objects and may reuse a DEFAULT's name
CREATE TABLE babel_6221_t24 (a INT CONSTRAINT babel_6221_df_t24 DEFAULT 1);
GO

CREATE TYPE babel_6221_tt3 AS TABLE (a INT CONSTRAINT babel_6221_df_t24 CHECK (a > 0));
GO

DROP TYPE babel_6221_tt3;
GO
