(one | ('one specialCharscat1e09616b53f5138735a7d0a79e78e804e '))
~~END~~

~~START~~
text
(one | ('one specialCharscat1e09616b53f5138735a7d0a79e78e804e '))
~~END~~

~~START~~
text
(one | (' specialCharscat1e09616b53f5138735a7d0a79e78e804e one'))
~~END~~

~~START~~
text
(one<-> | ('one specialCharscat1e09616b53f5138735a7d0a79e78e804e '))
~~END~~

~~START~~
text
(one<-> | ('one specialCharscat1e09616b53f5138735a7d0a79e78e804e '))
~~END~~

~~START~~
text
(one | (' specialCharscat1e09616b53f5138735a7d0a79e78e804e one'))
~~END~~

~~START~~
text
(one | (' specialCharscat1e09616b53f5138735a7d0a79e78e804e one'))
~~END~~

~~START~~
text
(much<->of<->the | ('much specialCharscat1e09616b53f5138735a7d0a79e78e804e of specialCharscat1e09616b53f5138735a7d0a79e78e804e the'))
~~END~~


select sys.replace_special_chars_fts('one`two');
go
~~START~~
text
onespecialCharscat2e09616b53f5138735a7d0a79e78e804etwo
~~END~~


-- 1. Search for Japanese content
SELECT * FROM fts_table WHERE CONTAINS((
    nvarchar_column, 
    ntext_column, 
    nchar_column), N'"日本語"')
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: Full-text search conditions with languages other than English are not currently supported in Babelfish)~~


-- 2. Search for English phrase with special characters
SELECT * FROM fts_table WHERE CONTAINS((
    text_column, 
    varchar_column, 
    ntext_column), '"Special Ch@r∆cters"')
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: Full-text search conditions with languages other than English are not currently supported in Babelfish)~~


-- 3. Search for French text with diacritics
SELECT * FROM fts_table WHERE CONTAINS((
    nvarchar_column, 
    ntext_column), '"Café très élégant"')
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: Full-text search conditions with languages other than English are not currently supported in Babelfish)~~


