-- 10. Search for Japanese anime related content
SELECT * FROM fts_table WHERE CONTAINS((
    nvarchar_column, 
    ntext_column), N'"アニメ*"')
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: Full-text search conditions with languages other than English are not currently supported in Babelfish)~~


-- 11. Search for multiple language combinations
SELECT * FROM fts_table WHERE CONTAINS((
    varchar_column, 
    ntext_column), '"English" AND "Fran*"')
GO
