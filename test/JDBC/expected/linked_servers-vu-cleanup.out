-- tsql
USE master;
GO

IF OBJECT_ID('dbo.sys_linked_servers_vu_prepare__sys_servers_func', 'IF') IS NOT NULL
        DROP FUNCTION dbo.sys_linked_servers_vu_prepare__sys_servers_func
GO

IF OBJECT_ID('dbo.sys_linked_servers_vu_prepare__sys_servers_view', 'V') IS NOT NULL
        DROP VIEW dbo.sys_linked_servers_vu_prepare__sys_servers_view
GO

IF OBJECT_ID('dbo.sys_linked_servers_vu_prepare__sys_linked_logins_view', 'V') IS NOT NULL
        DROP VIEW dbo.sys_linked_servers_vu_prepare__sys_linked_logins_view
GO

IF EXISTS (SELECT 1 FROM sys.servers WHERE name = 'mssql_server')
        EXEC sp_dropserver @server = 'mssql_server', @droplogins = 'droplogins'
GO

IF EXISTS (SELECT 1 FROM sys.servers WHERE name = 'mssql_server1')
        EXEC sp_dropserver @server = 'mssql_server1', @droplogins = 'droplogins'
GO

IF EXISTS (SELECT 1 FROM sys.servers WHERE name = 'hello.world.com')
        EXEC sp_dropserver @server = 'hello.world.com', @droplogins = 'droplogins'
GO

IF EXISTS (SELECT 1 FROM sys.servers WHERE name = 'mssql_server2')
        EXEC sp_dropserver @server = 'mssql_server2', @droplogins = 'droplogins'
GO

IF EXISTS (SELECT 1 FROM sys.servers WHERE name = 'mssql_server3')
        EXEC sp_dropserver @server = 'mssql_server3', @droplogins = 'droplogins'
GO

IF EXISTS (SELECT 1 FROM sys.servers WHERE name = 'mssql_server4')
        EXEC sp_dropserver @server = 'mssql_server4', @droplogins = 'droplogins'
GO

IF EXISTS (SELECT 1 FROM sys.servers WHERE name = 'mssql_server5')
        EXEC sp_dropserver @server = 'mssql_server5', @droplogins = 'droplogins'
GO

IF EXISTS (SELECT 1 FROM sys.servers WHERE name = 'mssql_server6')
        EXEC sp_dropserver @server = 'mssql_server6', @droplogins = 'droplogins'
GO

IF EXISTS (SELECT 1 FROM sys.server_principals WHERE name = 'linked_server_login_861')
        DROP LOGIN linked_server_login_861
GO

-- psql
-- Drop extension only if not user mapping exists for bbf_server
-- Needed so that same test can be reused in upgrade in conjunction
-- with tests for OPENQUERY
DO
$$
BEGIN
IF NOT EXISTS (SELECT * FROM pg_user_mappings WHERE srvname = 'bbf_server' OR srvname = 'server_4229') THEN
        SET client_min_messages = 'error';
        DROP EXTENSION tds_fdw CASCADE;
END IF;
END
$$
GO
