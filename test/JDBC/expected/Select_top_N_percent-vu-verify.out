SELECT COUNT(*) FROM (
    SELECT TOP 40 PERCENT student_name, score FROM jira_babel_1358.test_percent_scores WHERE score > 80
    UNION
    SELECT TOP 60 PERCENT student_name, score FROM jira_babel_1358.test_percent_scores WHERE score < 90
) AS t35;
GO
~~START~~
int
