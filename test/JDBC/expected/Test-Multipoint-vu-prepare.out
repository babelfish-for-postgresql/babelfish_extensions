# ============================================================================
# Multipoint Geography Test Cases
# ============================================================================

CREATE TABLE GEOSPATIALMULTIPOINTGEOG_dt (location geography)
ALTER TABLE GEOSPATIALMULTIPOINTGEOG_dt ADD id INT IDENTITY(1,1);

# Positive Test for geography multipoint
