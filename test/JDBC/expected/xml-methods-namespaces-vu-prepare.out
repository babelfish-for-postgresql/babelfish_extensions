

-- ============================================
-- Tests for XML data type methods (.query, .value, .exist)
-- combined with WITH XMLNAMESPACES.
--
-- WITH XMLNAMESPACES provides namespace bindings for XPath evaluation.
-- The bindings are passed to PG's xpath() function as a text[][] array.
-- This lets prefixed XPath like /ns1:item resolve correctly when the
-- target XML uses xmlns:ns1.
-- ============================================
-- ============================================
-- SECTION: Base Tables
-- ============================================
CREATE TABLE xmlns_methods_t1 (id INT, data XML);
GO

INSERT INTO xmlns_methods_t1 VALUES (1, '<root xmlns:ns1="http://example.com/ns1"><ns1:item>val1</ns1:item><ns1:item>val2</ns1:item></root>');
INSERT INTO xmlns_methods_t1 VALUES (2, '<root xmlns:ns1="http://example.com/ns1" xmlns:ns2="http://example.com/ns2"><ns1:a>10</ns1:a><ns2:b>20</ns2:b></root>');
INSERT INTO xmlns_methods_t1 VALUES (3, '<root xmlns:ns1="http://example.com/ns1"><item ns1:attr="value"/></root>');
INSERT INTO xmlns_methods_t1 VALUES (4, NULL);
INSERT INTO xmlns_methods_t1 VALUES (5, '<root xmlns:ns1="http://example.com/ns1"><ns1:item>42</ns1:item></root>');
GO
