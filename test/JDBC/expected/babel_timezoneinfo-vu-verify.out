-- Test to check the UTC/GMT zones
SELECT * FROM dbo.ZeroOffsetZones;
GO
~~START~~
text#!#nvarchar#!#bit
Azores Standard Time#!#+00:00#!#1
Greenwich Standard Time#!#+00:00#!#0
Sao Tome Standard Time#!#+00:00#!#0
Utc#!#+00:00#!#0
~~END~~

-- Test zones with numbers in names
SELECT * FROM dbo.NumericNameZones ORDER BY name;
GO
~~START~~
text#!#nvarchar#!#bit
Russia Time Zone 10#!#+11:00#!#0
Russia Time Zone 3#!#+04:00#!#0
~~END~~

-- Test palindromic offset 
SELECT * FROM dbo.PalindromicOffsets;
GO
~~START~~
text#!#nvarchar#!#varchar
Azores Standard Time#!#+00:00#!#Palindromic
Greenwich Standard Time#!#+00:00#!#Palindromic
Iran Standard Time#!#+03:30#!#Palindromic
Sao Tome Standard Time#!#+00:00#!#Palindromic
Utc#!#+00:00#!#Palindromic
~~END~~

--Test case: Edge case for testing duplicate enteries (should not exist)
SELECT 
    name,
    current_utc_offset,
    is_currently_dst,
    COUNT(*) AS duplicate_count
FROM sys.time_zone_info
GROUP BY name, current_utc_offset, is_currently_dst
HAVING COUNT(*) > 1;
GO
~~START~~
text#!#nvarchar#!#bit#!#int
~~END~~

-- Test case: Subquery to find "Lonely DST zone"
SELECT name, current_utc_offset
FROM sys.time_zone_info t1
WHERE EXISTS (
    SELECT 1 
    FROM sys.time_zone_info t2
    WHERE t2.current_utc_offset = '+05:45'
    AND t1.name = t2.name
);
GO
~~START~~
text#!#nvarchar
Nepal Standard Time#!#+05:45
~~END~~

--Test cases to check valid/invalid                 
EXEC ValidateTimeZone 'Pacific Standard Time', '-07:00';
EXEC ValidateTimeZone 'UTC', '-08:00';   
EXEC ValidateTimeZone 'India Standard Time', '-05:00';
GO
~~START~~
varchar#!#nvarchar
pass#!#Testing Pacific Standard Time for offset -07:00
~~END~~

~~START~~
varchar#!#nvarchar
fail#!#Testing UTC for offset -08:00
~~END~~

~~START~~
varchar#!#nvarchar
fail#!#Testing India Standard Time for offset -05:00
~~END~~

-- Test case:  CTE for DST zones with specific offset
WITH DSTZones AS (
    SELECT name, current_utc_offset
    FROM sys.time_zone_info
    WHERE is_currently_dst = 1
    AND current_utc_offset IN ('-07:00', '-08:00', '-06:00')
)
SELECT * FROM DSTZones;
GO
~~START~~
text#!#nvarchar
Alaskan Standard Time#!#-08:00
Mountain Standard Time#!#-06:00
Pacific Standard Time#!#-07:00
Pacific Standard Time (Mexico)#!#-07:00
~~END~~

--Trigger to test valid/invalid time zones
EXEC sp_ValidateTimeZoneData 'India Standard Time';
EXEC sp_ValidateTimeZoneData 'Title Zone';
GO
~~START~~
varchar#!#nvarchar
Valid#!#India Standard Time
~~END~~

~~START~~
varchar#!#nvarchar
Invalid#!#Title Zone
~~END~~

--Verify the null case
SELECT sys.timezone_mapping_pg_to_windows(' ');
GO
~~START~~
text
<NULL>
~~END~~

