-- Test Case 1: Basic query to verify time zone information
SELECT TOP 5 name, current_utc_offset, is_currently_dst
FROM sys.time_zone_info
WHERE current_utc_offset = '-04:00'
ORDER BY name;
GO
~~START~~
text#!#nvarchar#!#bit
Central Brazilian Standard Time#!#-04:00#!#0
Cuba Standard Time#!#-04:00#!#1
Eastern Standard Time#!#-04:00#!#1
Haiti Standard Time#!#-04:00#!#1
Sa Western Standard Time#!#-04:00#!#0
~~END~~

--Test case 2: Find specific time zone
SELECT * FROM sys.time_zone_info 
WHERE name = 'Eastern Standard Time';
GO
~~START~~
text#!#nvarchar#!#bit
Eastern Standard Time#!#-04:00#!#1
~~END~~

-- Test Case 3: Find all time zones with specific UTC offset
SELECT name, current_utc_offset
FROM sys.time_zone_info
WHERE current_utc_offset = '-05:00';
GO
~~START~~
text#!#nvarchar
Central Standard Time#!#-05:00
Easter Island Standard Time#!#-05:00
Eastern Standard Time (Mexico)#!#-05:00
Sa Pacific Standard Time#!#-05:00
~~END~~

-- Test Case 4: Check Daylight Saving Time zones
SELECT TOP 3 name, current_utc_offset, is_currently_dst
FROM sys.time_zone_info
WHERE is_currently_dst = 1
ORDER BY name;
GO
~~START~~
text#!#nvarchar#!#bit
Alaskan Standard Time#!#-08:00#!#1
Aleutian Standard Time#!#-09:00#!#1
Atlantic Standard Time#!#-03:00#!#1
~~END~~

-- Test case 5: Time zones with unusual offsets (not full hours)
SELECT name, current_utc_offset
FROM sys.time_zone_info
WHERE current_utc_offset LIKE '%:30' 
ORDER BY name;
GO
~~START~~
text#!#nvarchar
Afghanistan Standard Time#!#+04:30
Aus Central Standard Time#!#+09:30
Cen. Australia Standard Time#!#+09:30
India Standard Time#!#+05:30
Iran Standard Time#!#+03:30
Lord Howe Standard Time#!#+10:30
Marquesas Standard Time#!#-09:30
Myanmar Standard Time#!#+06:30
Newfoundland Standard Time#!#-02:30
Sri Lanka Standard Time#!#+05:30
~~END~~

-- Test function to specific pattern
SELECT * FROM dbo.FindZonesByPattern('Pacific') ORDER BY name;
GO
~~START~~
text#!#nvarchar#!#bit#!#varchar
Central Pacific Standard Time#!#+11:00#!#0#!#STD
Pacific Sa Standard Time#!#-03:00#!#1#!#DST
Pacific Standard Time#!#-07:00#!#1#!#DST
Pacific Standard Time (Mexico)#!#-07:00#!#1#!#DST
Sa Pacific Standard Time#!#-05:00#!#0#!#STD
West Pacific Standard Time#!#+10:00#!#0#!#STD
~~END~~

