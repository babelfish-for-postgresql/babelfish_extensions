--Test case: Edge case for testing duplicate enteries (should not exist)
SELECT 
    name,
    current_utc_offset,
    is_currently_dst,
    COUNT(*) AS duplicate_count
FROM sys.time_zone_info
GROUP BY name, current_utc_offset, is_currently_dst
HAVING COUNT(*) > 1;
GO
~~START~~
text#!#varchar#!#bit#!#int
~~END~~


