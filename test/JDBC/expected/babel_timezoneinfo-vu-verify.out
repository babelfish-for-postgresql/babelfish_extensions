SELECT * FROM v_test;
GO
~~START~~
nvarchar
India Standard Time
~~END~~

--Test case 3: Check for any null values
SELECT COUNT(*) as null_value_count
FROM sys.time_zone_info
WHERE name IS NULL OR current_utc_offset IS NULL OR is_currently_dst IS NULL;
GO
~~START~~
int
0
~~END~~

--Test case 4: Count total number of timezones
SELECT * FROM dbo.vw_TimeZoneCount;
GO
~~START~~
int
140
~~END~~

--Test case 5: To print all the UTC timezones
SELECT name, current_utc_offset
FROM dbo.fn_GetUTCZonesWithOffset()
ORDER BY sort_order;
GO
~~START~~
nvarchar#!#nvarchar
Utc#!#+00:00
Utc+12#!#+12:00
Utc+13#!#+13:00
Utc-02#!#-02:00
Utc-08#!#-08:00
Utc-09#!#-09:00
Utc-11#!#-11:00
~~END~~

--Test case 6: To print duplicates
SELECT name, COUNT(*) as name_count
FROM sys.time_zone_info
GROUP BY name
HAVING COUNT(*) > 1;
GO
~~START~~
nvarchar#!#int
~~END~~

--Test case 7: To print all Timezone names
SELECT name
FROM sys.time_zone_info
ORDER BY 
    CASE 
        WHEN name = 'UTC' THEN 'UTC 0'
        WHEN name LIKE 'UTC+%' THEN 'UTC 1' + SUBSTRING(name, 4, 10)
        WHEN name LIKE 'UTC-%' THEN 'UTC 2' + SUBSTRING(name, 4, 10)
        ELSE name
    END;
GO
