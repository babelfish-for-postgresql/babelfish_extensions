-- ============================================
-- geometry::STMPointFromText — Error Cases
-- ============================================
-- NULL SRID
BEGIN TRY
    DECLARE @g geometry = geometry::STMPointFromText('MULTIPOINT((1 2), (3 4))', NULL);
END TRY
BEGIN CATCH
    SELECT ERROR_MESSAGE();
END CATCH
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: 'geometry::STMPointFromText' failed because parameter 2 is not allowed to be null.)~~


-- Wrong type: POINT
BEGIN TRY
    DECLARE @g geometry = geometry::STMPointFromText('POINT(1 2)', 0);
END TRY
BEGIN CATCH
    SELECT ERROR_MESSAGE();
END CATCH
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: Expected "MULTIPOINT" at Position 1. The input has POINT(1 2)s)~~


-- Wrong type: LINESTRING
BEGIN TRY
    DECLARE @g geometry = geometry::STMPointFromText('LINESTRING(0 0, 1 1)', 0);
END TRY
BEGIN CATCH
    SELECT ERROR_MESSAGE();
END CATCH
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: Expected "MULTIPOINT" at Position 1. The input has LINESTRING(0 0, 1 1)s)~~


