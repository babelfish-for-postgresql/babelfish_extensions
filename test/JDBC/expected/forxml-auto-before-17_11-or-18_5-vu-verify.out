-- ============================================
-- SECTION 14: SELECT INTO and INSERT
-- ============================================
-- 14.1 FOR XML AUTO inside INSERT
CREATE TABLE #XmlResults (ID INT IDENTITY(1,1) PRIMARY KEY, XmlData NVARCHAR(MAX));
INSERT INTO #XmlResults (XmlData)
VALUES (
    (SELECT c.CustomerID, c.CompanyName, o.OrderID
     FROM forxmlauto_t_customers c
     JOIN forxmlauto_t_orders o ON c.CustomerID = o.CustomerID
     WHERE c.CustomerID = 'ALFKI'
     ORDER BY c.CustomerID
     FOR XML AUTO, ROOT('Result'))
);
SELECT * FROM #XmlResults;
DROP TABLE #XmlResults;
GO
~~ROW COUNT: 1~~

~~START~~
int#!#nvarchar
1#!#<Result><c CustomerID="ALFKI" CompanyName="Alfreds Inc"><o OrderID="10248"/></c></Result>
~~END~~




-- 14.2 FOR XML AUTO result into variable
DECLARE @xml NVARCHAR(MAX);
SET @xml = (
    SELECT c.CustomerID, c.CompanyName
    FROM forxmlauto_t_customers c
    WHERE c.CustomerID = 'ALFKI'
    FOR XML AUTO
);
SELECT @xml;
GO
~~START~~
nvarchar
<c CustomerID="ALFKI" CompanyName="Alfreds Inc"/>
~~END~~




-- ============================================
-- SECTION 15: XML Methods on Result
-- ============================================
-- 15.1 .value() on FOR XML AUTO result
DECLARE @xml XML;
SET @xml = (
    SELECT c.CustomerID, c.CompanyName, o.OrderID
    FROM forxmlauto_t_customers c
    JOIN forxmlauto_t_orders o ON c.CustomerID = o.CustomerID
    WHERE c.CustomerID = 'ALFKI'
    ORDER BY c.CustomerID
    FOR XML AUTO, ROOT('Result')
);
SELECT @xml.value('(/Result/c/@CustomerID)[1]', 'NCHAR(5)') AS CustID;
GO
~~START~~
nchar
ALFKI
~~END~~



-- 15.2 ELEMENTS mode with .value()
DECLARE @xml XML;
SET @xml = (
    SELECT c.CustomerID, c.CompanyName
    FROM forxmlauto_t_customers c
    WHERE c.CustomerID = 'ALFKI'
    FOR XML AUTO, ROOT('Result'), ELEMENTS
);
SELECT @xml.value('(/Result/c/CustomerID)[1]', 'NCHAR(5)') AS CustID;
GO
~~START~~
nchar
ALFKI
~~END~~





-- ============================================
-- SECTION 16: Error Cases
-- ============================================
-- 16.1 FOR XML AUTO without any table
SELECT 1 AS ID, 'test' AS Name
FOR XML AUTO;
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: FOR XML AUTO requires at least one table for generating XML elements. Use FOR XML PATH or add a FROM clause with a table name.)~~




-- 16.2 FOR XML AUTO with only system function as source
SELECT s.value
FROM STRING_SPLIT('apple,banana,cherry', ',') AS s
FOR XML AUTO;
GO
~~ERROR (Code: 33557097)~~

~~ERROR (Message: FOR XML AUTO requires at least one table for generating XML elements. Use FOR XML PATH or add a FROM clause with a table name.)~~





-- ============================================
-- SECTION 17: Boundary Cases for Element Names
-- ============================================
-- 17.1 Single character alias
SELECT x.CustomerID, x.CompanyName
FROM forxmlauto_t_customers x
WHERE x.CustomerID = 'ALFKI'
FOR XML AUTO;
GO
~~START~~
ntext
<x CustomerID="ALFKI" CompanyName="Alfreds Inc"/>
~~END~~



-- 17.2 Very long alias
SELECT VeryLongAliasNameForCustomerTable.CustomerID,
       VeryLongAliasNameForCustomerTable.CompanyName
FROM forxmlauto_t_customers VeryLongAliasNameForCustomerTable
WHERE VeryLongAliasNameForCustomerTable.CustomerID = 'ALFKI'
FOR XML AUTO;
GO
~~START~~
ntext
<verylongaliasnameforcustomertable CustomerID="ALFKI" CompanyName="Alfreds Inc"/>
~~END~~



-- 17.3 Numeric-starting alias (quoted)
SELECT [1stTable].CustomerID, [1stTable].CompanyName
FROM forxmlauto_t_customers [1stTable]
WHERE [1stTable].CustomerID = 'ALFKI'
FOR XML AUTO;
GO
~~START~~
ntext
<_x0031_sttable CustomerID="ALFKI" CompanyName="Alfreds Inc"/>
~~END~~



-- 17.4 Alias with spaces (quoted)
SELECT [Customer Table].CustomerID, [Customer Table].CompanyName
FROM forxmlauto_t_customers [Customer Table]
WHERE [Customer Table].CustomerID = 'ALFKI'
FOR XML AUTO;
GO
~~START~~
ntext
<customer_x0020_table CustomerID="ALFKI" CompanyName="Alfreds Inc"/>
~~END~~



-- 17.5 Alias with special characters
SELECT [cust-data].CustomerID, [cust-data].CompanyName
FROM forxmlauto_t_customers [cust-data]
WHERE [cust-data].CustomerID = 'ALFKI'
FOR XML AUTO;
GO
~~START~~
ntext
<cust-data CustomerID="ALFKI" CompanyName="Alfreds Inc"/>
~~END~~



-- 17.6 Column alias that conflicts with table alias
SELECT c.CustomerID, c.CompanyName AS o, o.OrderID
FROM forxmlauto_t_customers c
JOIN forxmlauto_t_orders o ON c.CustomerID = o.CustomerID
WHERE c.CustomerID = 'ALFKI'
ORDER BY c.CustomerID
FOR XML AUTO;
GO
~~START~~
ntext
<c CustomerID="ALFKI" o="Alfreds Inc"><o OrderID="10248"/></c>
~~END~~



-- 17.7 SELECT * with AUTO
SELECT *
FROM forxmlauto_t_customers c
JOIN forxmlauto_t_orders o ON c.CustomerID = o.CustomerID
WHERE c.CustomerID = 'ALFKI'
ORDER BY c.CustomerID
FOR XML AUTO;
GO
