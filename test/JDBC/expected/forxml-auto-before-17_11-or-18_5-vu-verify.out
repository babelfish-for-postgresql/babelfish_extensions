-- 12.8 View vs CTE — same data, different behavior
-- CTE unwraps to base tables (two nesting levels)
;WITH customer_orders_cte AS (
    SELECT c.CompanyName, o.OrderID, o.TotalAmount
    FROM forxmlauto_t_customers c
    JOIN forxmlauto_t_orders o ON c.CustomerID = o.CustomerID
)
SELECT cte.CompanyName, cte.OrderID, cte.TotalAmount
FROM customer_orders_cte cte
WHERE cte.CompanyName = 'Alfreds Inc'
FOR XML AUTO;
GO
~~START~~
