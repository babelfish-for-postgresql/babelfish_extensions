~~END~~




-- ============================================
-- SECTION 18: Long Column and Alias Names (> 64 characters)
-- ============================================
-- 18.1 Long column name — single table
SELECT t.ThisIsAnExtremelyLongColumnNameThatGoesOnAndOnToTestTheLimitsOfNameLength,
       t.ShortCol
FROM forxmlauto_t_longnames t
FOR XML AUTO;
GO
~~START~~
ntext
<t ThisIsAnExtremelyLongColumnNameThatGoesOnAndOnToTestTheLimitsOfNameLength="1" ShortCol="100"/><t ThisIsAnExtremelyLongColumnNameThatGoesOnAndOnToTestTheLimitsOfNameLength="2" ShortCol="200"/>
~~END~~



-- 18.2 Long column name — ELEMENTS mode
SELECT t.ThisIsAnExtremelyLongColumnNameThatGoesOnAndOnToTestTheLimitsOfNameLength,
       t.ShortCol
FROM forxmlauto_t_longnames t
FOR XML AUTO, ELEMENTS;
GO
~~START~~
ntext
<t><ThisIsAnExtremelyLongColumnNameThatGoesOnAndOnToTestTheLimitsOfNameLength>1</ThisIsAnExtremelyLongColumnNameThatGoesOnAndOnToTestTheLimitsOfNameLength><ShortCol>100</ShortCol></t><t><ThisIsAnExtremelyLongColumnNameThatGoesOnAndOnToTestTheLimitsOfNameLength>2</ThisIsAnExtremelyLongColumnNameThatGoesOnAndOnToTestTheLimitsOfNameLength><ShortCol>200</ShortCol></t>
~~END~~



-- 18.3 Long column name — two tables
SELECT c.CustomerID, c.CompanyName,
       t.ThisIsAnExtremelyLongColumnNameThatGoesOnAndOnToTestTheLimitsOfNameLength,
       t.ShortCol
FROM forxmlauto_t_customers c
CROSS JOIN forxmlauto_t_longnames t
WHERE c.CustomerID = 'ALFKI' AND t.ShortCol = 100
FOR XML AUTO;
GO
~~START~~
ntext
<c CustomerID="ALFKI" CompanyName="Alfreds Inc"><t ThisIsAnExtremelyLongColumnNameThatGoesOnAndOnToTestTheLimitsOfNameLength="1" ShortCol="100"/></c>
~~END~~



-- 18.4 Long column alias
SELECT c.CustomerID,
       o.OrderID AS ThisIsAVeryLongColumnAliasThatMightExceedSixtyThreeCharacterLimit
FROM forxmlauto_t_customers c
JOIN forxmlauto_t_orders o ON c.CustomerID = o.CustomerID
WHERE c.CustomerID = 'ALFKI'
FOR XML AUTO;
GO
~~START~~
ntext
<c CustomerID="ALFKI"><o ThisIsAVeryLongColumnAliasThatMe112b864c5987f288f7a6d00d553a231="10248"/></c>
~~END~~



-- 18.5 Long table alias
SELECT VeryLongTableAliasNameThatExceedsSixtyThreeCharacters.CustomerID,
       VeryLongTableAliasNameThatExceedsSixtyThreeCharacters.CompanyName
FROM forxmlauto_t_customers VeryLongTableAliasNameThatExceedsSixtyThreeCharacters
WHERE VeryLongTableAliasNameThatExceedsSixtyThreeCharacters.CustomerID = 'ALFKI'
FOR XML AUTO;
GO
~~START~~
ntext
<verylongtablealiasnamethatexceedssixtythreecharacters CustomerID="ALFKI" CompanyName="Alfreds Inc"/>
~~END~~



-- 18.6 Long table alias on child table
SELECT c.CustomerID,
       VeryLongOrderAliasNameThatMightCauseTruncation.OrderID,
       VeryLongOrderAliasNameThatMightCauseTruncation.TotalAmount
FROM forxmlauto_t_customers c
JOIN forxmlauto_t_orders VeryLongOrderAliasNameThatMightCauseTruncation
  ON c.CustomerID = VeryLongOrderAliasNameThatMightCauseTruncation.CustomerID
WHERE c.CustomerID = 'ALFKI'
FOR XML AUTO;
GO
~~START~~
ntext
<c CustomerID="ALFKI"><verylongorderaliasnamethatmightcausetruncation OrderID="10248" TotalAmount="440.0000"/></c>
~~END~~



-- 18.7 Long table alias + long column alias combined
SELECT c.CustomerID,
       ThisIsAThirtyCharacterAliasNam.OrderID AS ThisIsAlsoAThirtyCharColumnName
FROM forxmlauto_t_customers c
JOIN forxmlauto_t_orders ThisIsAThirtyCharacterAliasNam
  ON c.CustomerID = ThisIsAThirtyCharacterAliasNam.CustomerID
WHERE c.CustomerID = 'ALFKI'
FOR XML AUTO;
GO
~~START~~
ntext
<c CustomerID="ALFKI"><thisisathirtycharacteraliasnam ThisIsAlsoAThirtyCharColumnName="10248"/></c>
~~END~~



-- 18.8 Multiple long column names from different tables
SELECT c.CustomerID,
       t.ThisIsAnExtremelyLongColumnNameThatGoesOnAndOnToTestTheLimitsOfNameLength,
       t.AnotherVeryLongColumnNameThatExceedsSixtyThreeCharactersForTesting
FROM forxmlauto_t_customers c
CROSS JOIN forxmlauto_t_longnames t
WHERE c.CustomerID = 'ALFKI' AND t.ShortCol = 100
FOR XML AUTO;
GO
~~START~~
ntext
<c CustomerID="ALFKI"><t ThisIsAnExtremelyLongColumnNameThatGoesOnAndOnToTestTheLimitsOfNameLength="1" AnotherVeryLongColumnNameThatExceedsSixtyThreeCharactersForTesting="Hello"/></c>
~~END~~



-- 18.9 Long column name with ELEMENTS XSINIL
SELECT t.ThisIsAnExtremelyLongColumnNameThatGoesOnAndOnToTestTheLimitsOfNameLength,
       t.ShortCol
FROM forxmlauto_t_longnames t
FOR XML AUTO, ELEMENTS XSINIL;
GO
~~START~~
ntext
<t xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><ThisIsAnExtremelyLongColumnNameThatGoesOnAndOnToTestTheLimitsOfNameLength>1</ThisIsAnExtremelyLongColumnNameThatGoesOnAndOnToTestTheLimitsOfNameLength><ShortCol>100</ShortCol></t><t xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><ThisIsAnExtremelyLongColumnNameThatGoesOnAndOnToTestTheLimitsOfNameLength>2</ThisIsAnExtremelyLongColumnNameThatGoesOnAndOnToTestTheLimitsOfNameLength><ShortCol>200</ShortCol></t>
~~END~~




