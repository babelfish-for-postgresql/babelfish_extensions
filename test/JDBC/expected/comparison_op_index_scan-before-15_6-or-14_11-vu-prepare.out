    SELECT COUNT(*) as lt_count FROM BABEL_6098_varbinary_test WHERE varbinary_col < @value;
    SELECT COUNT(*) as lte_count FROM BABEL_6098_varbinary_test WHERE varbinary_col <= @value;
END;
GO

