UNION ALL
SELECT binary_col FROM BABEL_6098_binary_test WHERE NOT (binary_col <> CAST(0x05 AS BINARY(10)))
UNION ALL
SELECT binary_col FROM BABEL_6098_binary_test WHERE NOT (binary_col < CAST(0x05 AS BINARY(10)))
UNION ALL
SELECT binary_col FROM BABEL_6098_binary_test WHERE NOT (binary_col <= CAST(0x05 AS BINARY(10)))
UNION ALL
SELECT binary_col FROM BABEL_6098_binary_test WHERE NOT (binary_col > CAST(0x05 AS BINARY(10)))
UNION ALL
SELECT binary_col FROM BABEL_6098_binary_test WHERE NOT (binary_col >= CAST(0x05 AS BINARY(10)));
GO


