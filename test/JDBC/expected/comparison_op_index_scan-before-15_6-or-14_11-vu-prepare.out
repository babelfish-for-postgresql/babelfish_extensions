-- Create test table for BINARY type
CREATE TABLE BABEL_6098_binary_test (
    id INT IDENTITY(1,1) PRIMARY KEY,
    binary_col BINARY(10)
);
GO

-- Create test table for VARBINARY type
CREATE TABLE BABEL_6098_varbinary_test (
    id INT IDENTITY(1,1) PRIMARY KEY,
    varbinary_col VARBINARY(10)
);
GO

-- Create table for cross-type testing
CREATE TABLE BABEL_6098_mixed_test (
    id INT IDENTITY(1,1) PRIMARY KEY,
    binary_col BINARY(10),
    varbinary_col VARBINARY(10)
);
GO

INSERT INTO BABEL_6098_binary_test (binary_col) 
    SELECT CAST(0x01 AS BINARY(10)) FROM generate_series(1, 3);
