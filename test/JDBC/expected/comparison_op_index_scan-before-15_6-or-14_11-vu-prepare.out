GO


-- PROCEDURES: SAME-TYPE BINARY OPERATORS
-- Highly selective operations
CREATE PROCEDURE BABEL_6098_binary_selective_proc
    @value BINARY(10)
AS
BEGIN
    SELECT COUNT(*) as equal_count FROM BABEL_6098_binary_test WHERE binary_col = @value;
    SELECT COUNT(*) as not_equal_count FROM BABEL_6098_binary_test WHERE binary_col <> @value AND binary_col = CAST(0x02 AS BINARY(10));
    SELECT COUNT(*) as lt_count FROM BABEL_6098_binary_test WHERE binary_col < @value;
    SELECT COUNT(*) as lte_count FROM BABEL_6098_binary_test WHERE binary_col <= @value;
END;
GO

-- Non-selective operations
CREATE PROCEDURE BABEL_6098_binary_non_selective_proc
    @value BINARY(10)
AS
BEGIN
    SELECT COUNT(*) as equal_count FROM BABEL_6098_binary_test WHERE binary_col = @value OR binary_col >= CAST(0x01 AS BINARY(10));
    SELECT COUNT(*) as not_equal_count FROM BABEL_6098_binary_test WHERE binary_col <> @value;
    SELECT COUNT(*) as lt_count FROM BABEL_6098_binary_test WHERE binary_col < CAST(0x0A AS BINARY(10));
    SELECT COUNT(*) as lte_count FROM BABEL_6098_binary_test WHERE binary_col <= CAST(0x09 AS BINARY(10));
    SELECT COUNT(*) as gt_count FROM BABEL_6098_binary_test WHERE binary_col > CAST(0x00 AS BINARY(10));
    SELECT COUNT(*) as gte_count FROM BABEL_6098_binary_test WHERE binary_col >= @value;
END;
GO


