-- VIEWS: JOIN OPERATIONS
-- Selective join with all operators
CREATE VIEW BABEL_6098_join_selective_view AS
SELECT t1.binary_col, t2.varbinary_col FROM BABEL_6098_binary_test t1
INNER JOIN BABEL_6098_varbinary_test t2 ON t1.binary_col = t2.varbinary_col
WHERE t1.binary_col = CAST(0x01 AS BINARY(10))
UNION ALL
SELECT t1.binary_col, t2.varbinary_col FROM BABEL_6098_binary_test t1
INNER JOIN BABEL_6098_varbinary_test t2 ON t1.binary_col <> t2.varbinary_col
WHERE t1.binary_col = CAST(0x01 AS BINARY(10)) AND t2.varbinary_col = CAST(0x02 AS VARBINARY(10))
UNION ALL
SELECT t1.binary_col, t2.varbinary_col FROM BABEL_6098_binary_test t1
INNER JOIN BABEL_6098_varbinary_test t2 ON t1.binary_col < t2.varbinary_col
WHERE t1.binary_col = CAST(0x01 AS BINARY(10))
UNION ALL
SELECT t1.binary_col, t2.varbinary_col FROM BABEL_6098_binary_test t1
INNER JOIN BABEL_6098_varbinary_test t2 ON t1.binary_col <= t2.varbinary_col
WHERE t1.binary_col = CAST(0x01 AS BINARY(10))
UNION ALL
SELECT t1.binary_col, t2.varbinary_col FROM BABEL_6098_binary_test t1
INNER JOIN BABEL_6098_varbinary_test t2 ON t1.binary_col > t2.varbinary_col
WHERE t1.binary_col = CAST(0x09 AS BINARY(10))
UNION ALL
SELECT t1.binary_col, t2.varbinary_col FROM BABEL_6098_binary_test t1
INNER JOIN BABEL_6098_varbinary_test t2 ON t1.binary_col >= t2.varbinary_col
WHERE t1.binary_col = CAST(0x09 AS BINARY(10));
GO


-- VIEWS: COLUMN-TO-COLUMN COMPARISONS
CREATE VIEW BABEL_6098_col_to_col_view AS
SELECT binary_col, varbinary_col FROM BABEL_6098_mixed_test WHERE binary_col = varbinary_col
UNION ALL
SELECT binary_col, varbinary_col FROM BABEL_6098_mixed_test WHERE binary_col <> varbinary_col
UNION ALL
SELECT binary_col, varbinary_col FROM BABEL_6098_mixed_test WHERE binary_col < varbinary_col
UNION ALL
SELECT binary_col, varbinary_col FROM BABEL_6098_mixed_test WHERE binary_col <= varbinary_col
UNION ALL
SELECT binary_col, varbinary_col FROM BABEL_6098_mixed_test WHERE binary_col > varbinary_col
UNION ALL
SELECT binary_col, varbinary_col FROM BABEL_6098_mixed_test WHERE binary_col >= varbinary_col;
GO


-- VIEWS: NEGATION OPERATORS
