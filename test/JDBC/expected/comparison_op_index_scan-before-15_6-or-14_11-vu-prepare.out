-- Create indexes
CREATE INDEX BABEL_6098_idx_binary ON BABEL_6098_binary_test(binary_col);
GO

CREATE INDEX BABEL_6098_idx_varbinary ON BABEL_6098_varbinary_test(varbinary_col);
GO

CREATE INDEX BABEL_6098_idx_mixed_binary ON BABEL_6098_mixed_test(binary_col);
CREATE INDEX BABEL_6098_idx_mixed_varbinary ON BABEL_6098_mixed_test(varbinary_col);
GO


-- VIEWS: SAME-TYPE BINARY OPERATORS
-- Highly selective queries
CREATE VIEW BABEL_6098_binary_selective_view AS
SELECT binary_col FROM BABEL_6098_binary_test WHERE binary_col = CAST(0x01 AS BINARY(10))
UNION ALL
SELECT binary_col FROM BABEL_6098_binary_test WHERE binary_col <> CAST(0x01 AS BINARY(10)) AND binary_col = CAST(0x02 AS BINARY(10))
UNION ALL
SELECT binary_col FROM BABEL_6098_binary_test WHERE binary_col < CAST(0x02 AS BINARY(10))
UNION ALL
SELECT binary_col FROM BABEL_6098_binary_test WHERE binary_col <= CAST(0x01 AS BINARY(10))
UNION ALL
SELECT binary_col FROM BABEL_6098_binary_test WHERE binary_col > CAST(0x08 AS BINARY(10))
UNION ALL
SELECT binary_col FROM BABEL_6098_binary_test WHERE binary_col >= CAST(0x09 AS BINARY(10));
GO

-- Non-selective queries
CREATE VIEW BABEL_6098_binary_non_selective_view AS
SELECT binary_col FROM BABEL_6098_binary_test WHERE binary_col >= CAST(0x01 AS BINARY(10))
UNION ALL
SELECT binary_col FROM BABEL_6098_binary_test WHERE binary_col <> CAST(0xFF AS BINARY(10))
UNION ALL
SELECT binary_col FROM BABEL_6098_binary_test WHERE binary_col < CAST(0x0A AS BINARY(10))
UNION ALL
SELECT binary_col FROM BABEL_6098_binary_test WHERE binary_col <= CAST(0x09 AS BINARY(10))
UNION ALL
SELECT binary_col FROM BABEL_6098_binary_test WHERE binary_col > CAST(0x00 AS BINARY(10))
UNION ALL
SELECT binary_col FROM BABEL_6098_binary_test WHERE binary_col = CAST(0x05 AS BINARY(10)) OR binary_col >= CAST(0x01 AS BINARY(10));
GO


