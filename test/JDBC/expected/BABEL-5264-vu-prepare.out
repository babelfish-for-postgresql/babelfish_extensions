-- tsql

-- BABEL-5264: Test setup for sp_tablecollations_100 with temp table support
-- Create UDTs for non-ENR temp table tests
CREATE TYPE dbo.TestVarcharType1 FROM varchar(100)
GO

CREATE TYPE dbo.TestVarcharType2 FROM varchar(50)
GO

CREATE TYPE dbo.TestIntType FROM int
GO

-- Create T-SQL proc to test temp table functions via procedure
CREATE PROCEDURE dbo.babel5264_test_proc @tablename varchar(256)
AS
BEGIN
    EXEC sp_tablecollations_100 @tablename
END
GO

-- Create T-SQL proc to test via view
CREATE PROCEDURE dbo.babel5264_test_view_proc @tablename varchar(256)
AS
BEGIN
    SELECT colid, name, collation_100 
    FROM sys.spt_tablecollations_view 
    WHERE object_id = OBJECT_ID(@tablename) 
    ORDER BY colid
END
GO

-- Create T-SQL proc to test the function
CREATE PROCEDURE dbo.babel5264_test_func_proc
AS
BEGIN
    SELECT attname, attnum 
    FROM sys.babelfish_get_enr_temp_table_attributes() 
    WHERE attnum > 0 
    ORDER BY attrelid, attnum
END
GO

-- psql
-- Create PL/pgSQL procedure that creates a temp table (non-ENR)
CREATE OR REPLACE PROCEDURE master_dbo.psql_temp_proc()
LANGUAGE plpgsql
AS $$
BEGIN
    CREATE TEMP TABLE IF NOT EXISTS "#temp1"(a int, b varchar(50), c text);
END;
$$;
GO

-- Create PL/pgSQL procedure that creates a regular table
CREATE OR REPLACE PROCEDURE master_dbo.psql_reg_proc()
LANGUAGE plpgsql
AS $$
BEGIN
    CREATE TABLE IF NOT EXISTS perm1 (a int, b varchar(50), c text);
END;
$$;
GO

-- Create PL/pgSQL procedure that creates a regular table with # in name
CREATE OR REPLACE PROCEDURE master_dbo.psql_hash_proc()
LANGUAGE plpgsql
AS $$
BEGIN
    CREATE TABLE IF NOT EXISTS "#table1"(a int, b varchar(50), c text);
END;
$$;
GO
