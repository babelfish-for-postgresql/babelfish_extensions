varchar#!#char#!#varchar
1#!#<NULL>#!#<NULL>
~~END~~


declare @v1 varchar(10) = '1',  @v2 char(10) = '2',   @v3 varchar(10);
select @v1 = @v1, @v2 = 0, @v3 = @v2;
select @v1, @v2, @v3;
go
