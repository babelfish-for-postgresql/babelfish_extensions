    BEGIN TRANSACTION;
    SELECT @@TRANCOUNT;
    BEGIN TRANSACTION;
    SELECT @@TRANCOUNT;
    COMMIT;
    SELECT @@TRANCOUNT;
    COMMIT;
    SELECT @@TRANCOUNT;
GO
INSERT INTO insert_exec_trancount4 EXEC insert_exec_ptrancount4;
GO
