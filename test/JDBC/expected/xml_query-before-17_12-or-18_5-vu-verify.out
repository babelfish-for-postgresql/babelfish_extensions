-- ============================================
-- SECTION 51: GROUP BY with .query()
-- ============================================
SELECT data.query('/root/name').value('(/name)[1]', 'VARCHAR(50)') AS name_val, COUNT(*) AS cnt
FROM xml_query_t1
WHERE data IS NOT NULL
GROUP BY data.query('/root/name').value('(/name)[1]', 'VARCHAR(50)')
ORDER BY name_val;
GO
~~START~~
varchar#!#int
Bob#!#1
Jane#!#1
John#!#1
~~END~~



