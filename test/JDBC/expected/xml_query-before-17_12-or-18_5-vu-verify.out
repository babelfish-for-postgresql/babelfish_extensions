DECLARE @x XML = NULL;
SELECT @x.query('/root');
GO
~~START~~
xml
<NULL>
~~END~~


-- NULL column
SELECT data.query('/root') FROM xml_query_t1 WHERE id = 4;
GO
~~START~~
xml
<NULL>
~~END~~


-- NULL in expression
SELECT data.query('/root/name') FROM xml_query_t2 WHERE id = 3;
GO
