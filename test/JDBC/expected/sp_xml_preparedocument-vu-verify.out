DECLARE @xml XML = '<root><child>value</child></root>';
EXEC sp_xml_preparedocument @hdoc OUTPUT, @xml;
SELECT @hdoc as handle;
EXEC sp_xml_removedocument @hdoc;
GO
~~START~~
int
5
~~END~~


