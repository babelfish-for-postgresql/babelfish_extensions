-- ===========================================
-- ===========================================
-- Cross-session FK constraint violation (hook resolves from catalog, not cache)
-- The FK is created in one connection, but the violation is triggered from a
-- DIFFERENT connection (-- tsql block). The new session has no cache entry for
-- the FK name, so the hook must resolve it from babelfish_identifier_mapping.
-- ===========================================
-- FK INSERT violation (referencing non-existent parent)
CREATE TABLE ErrTest_FK_Cross_Parent (id INT PRIMARY KEY);
GO
INSERT INTO ErrTest_FK_Cross_Parent VALUES (1);
GO
~~ROW COUNT: 1~~

CREATE TABLE ErrTest_FK_Cross_Child (
    id INT,
    parent_id INT,
    CONSTRAINT Very_Long_FK_Cross_Session_Constraint_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three FOREIGN KEY (parent_id) REFERENCES ErrTest_FK_Cross_Parent(id)
);
GO

-- tsql
-- NEW CONNECTION: FK name is NOT in this session's cache
-- Hook must resolve from babelfish_identifier_mapping catalog
INSERT INTO ErrTest_FK_Cross_Child VALUES (1, 999);
GO
~~ERROR (Code: 547)~~

~~ERROR (Message: insert or update on table "errtest_fk_cross_child" violates foreign key constraint "very_long_fk_cross_session_constraint_name_that_exceeds_postgresql_limit_of_sixty_three")~~


-- tsql
-- NEW CONNECTION: Test DELETE on parent violates FK (ON DELETE NO ACTION)
INSERT INTO ErrTest_FK_Cross_Child VALUES (2, 1);
GO
~~ROW COUNT: 1~~

DELETE FROM ErrTest_FK_Cross_Parent WHERE id = 1;
GO
~~ERROR (Code: 547)~~

~~ERROR (Message: update or delete on table "errtest_fk_cross_parent" violates foreign key constraint "very_long_fk_cross_session_constraint_name_that_exceeds_postgresql_limit_of_sixty_three" on table "errtest_fk_cross_child")~~


-- tsql
DROP TABLE ErrTest_FK_Cross_Child;
GO
DROP TABLE ErrTest_FK_Cross_Parent;
GO


