-- Selecting varchar and numeric, JIRA QUERY
SELECT
    cr1 AS description,
    ex + COL3_T2 AS sum_num
FROM (
    SELECT
        COL2_T2 AS ex,
        COL2_T1 AS cr1,
        COL2_T1,
        COL3_T2
    FROM BABEL_5454_T1
    INNER JOIN BABEL_5454_T2
        ON COL1_T2 = COL1_T1
    UNION ALL
    SELECT
        1 AS aw,
        COL2_T1 AS cr,
        COL2_T1,
        COL3_T1 AS aw1
    FROM BABEL_5454_T1
) a
ORDER BY sum_num;
GO
