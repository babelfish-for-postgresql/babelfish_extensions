-- Test Case 4: UDT operations
SELECT 
    UDTCol + IntCol AS udt_int_sum,
    UDTCol * FloatCol AS udt_float_product,
    UDTCol / NULLIF(SmallIntCol, 0) AS udt_smallint_div
FROM TestTypes;
