-- DELETE in a loop
DECLARE @i INT;
DECLARE c CURSOR FOR SELECT id FROM where_current_of_t WHERE g = 2;
OPEN c;
FETCH c INTO @i;
WHILE @@FETCH_STATUS = 0
BEGIN
	DELETE where_current_of_t WHERE CURRENT OF c;
	FETCH c INTO @i;
END
CLOSE c;
DEALLOCATE c;
GO
