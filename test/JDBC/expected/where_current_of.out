-- errors
-- the row is gone after DELETE
DECLARE @i INT;
DECLARE c CURSOR FOR SELECT id FROM where_current_of_t WHERE id = 2;
OPEN c;
FETCH c INTO @i;
DELETE FROM where_current_of_t WHERE CURRENT OF c;
UPDATE where_current_of_t SET acc = 9 WHERE CURRENT OF c;
GO
