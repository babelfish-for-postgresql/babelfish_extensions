CREATE OR REPLACE FUNCTION f1()
RETURNS TABLE (id INT) AS 
$$ BEGIN
    RETURN QUERY (SELECT a FROM parallel_test);
END; $$
LANGUAGE plpgsql
PARALLEL SAFE;
GO

