int#!#int
~~END~~


SELECT * FROM V2;
GO
~~START~~
int
~~END~~


-- Turn off GUC for weak view binding
EXEC sp_babelfish_configure 'babelfishpg_tsql.weak_view_binding', 'off';
GO

CREATE VIEW V4 AS SELECT a, b FROM TV1;
GO

DROP TABLE TV1;
GO
