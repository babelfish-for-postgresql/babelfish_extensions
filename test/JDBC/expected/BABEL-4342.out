-- psql
CREATE PROCEDURE master_dbo.babel_4342_proc1()
LANGUAGE 'pltsql' AS $$
BEGIN 
DECLARE @objtype sys.VARCHAR(2)
SELECT @objtype = type COLLATE DATABASE_DEFAULT FROM sys.sysobjects WHERE id = 1 
END 
$$;
GO

