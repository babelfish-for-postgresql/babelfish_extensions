-- psql
-- BABEL-7195: tsql_openxml_get_xmldoc() must not return a pointer into a
-- buffer page that is unpinned before the xml value is sent to the client.
-- The document is small enough to be stored inline, and the scan of "big"
-- (larger than temp_buffers) recycles that page before printtup runs.
-- temp_buffers must be set before the session's first temp table access.
set temp_buffers = '1MB';
GO

begin;
GO

call sys.sp_xml_preparedocument(null,
  ('<root>' || repeat('<item id="1">abcdefghij</item>', 30) || '</root>')::xml, null);
GO
~~START~~
int4
1
~~END~~


create temp table big (g int, pad text);
GO

alter table big alter column pad set storage plain;
GO

insert into big select g, repeat('x', 8000) from generate_series(1, 500) g;
GO
~~ROW COUNT: 500~~


select sys.tsql_openxml_get_xmldoc(1), (select count(*) from big);
GO
