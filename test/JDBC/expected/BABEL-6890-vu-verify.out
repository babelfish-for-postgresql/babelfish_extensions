-- ============================================================================
-- Test 14: Bind parameter type change — single param, same query body
-- The parameter declaration (2nd arg to sp_prepexec) is part of the cache key,
-- because the ANTLR output depends on it. Same body 'SELECT @p1' with a
-- different param type = cache MISS and a separate entry.
-- ============================================================================
PRINT '=== Test 14: Single param type change — INT, BIGINT, VARCHAR ===';
GO

-- Already cached from Test 1 as @p1 INT
-- Now call with @p1 BIGINT — different signature = cache MISS
DECLARE @h INT
EXEC sp_prepexec @h OUTPUT, N'@p1 BIGINT', N'SELECT @p1', @p1=42
GO
~~START~~
bigint
42
~~END~~


-- Expect: hits=5, misses=8, writes=8, entries=8
SELECT * FROM sys.batch_antlr_parse_cache_stats();
GO
~~START~~
bigint#!#bigint#!#bigint#!#bigint#!#bigint#!#bigint
5#!#8#!#8#!#0#!#0#!#8
~~END~~


-- Now with @p1 VARCHAR — different signature = cache MISS
DECLARE @h INT
EXEC sp_prepexec @h OUTPUT, N'@p1 VARCHAR(10)', N'SELECT @p1', @p1=N'hello'
GO
~~START~~
varchar
hello
~~END~~


-- Expect: hits=5, misses=9, writes=9, entries=9
SELECT * FROM sys.batch_antlr_parse_cache_stats();
GO
~~START~~
bigint#!#bigint#!#bigint#!#bigint#!#bigint#!#bigint
5#!#9#!#9#!#0#!#0#!#9
~~END~~


-- Now with @p1 DECIMAL — different signature = cache MISS
DECLARE @h INT
EXEC sp_prepexec @h OUTPUT, N'@p1 DECIMAL(10,2)', N'SELECT @p1', @p1=3.14
GO
~~START~~
numeric
3.14000000
~~END~~


-- Expect: hits=5, misses=10, writes=10, entries=10
SELECT * FROM sys.batch_antlr_parse_cache_stats();
GO
~~START~~
bigint#!#bigint#!#bigint#!#bigint#!#bigint#!#bigint
5#!#10#!#10#!#0#!#0#!#10
~~END~~


-- ============================================================================
-- Test 15: Bind parameter type change — two params, types swapped
-- Query body: 'SELECT @p1, @p2' — each type declaration gets its own entry
-- ============================================================================
PRINT '=== Test 15: Two params, types swapped ===';
GO

-- First call: @p1 INT, @p2 VARCHAR — cache MISS (new query body)
DECLARE @h INT
EXEC sp_prepexec @h OUTPUT,
    N'@p1 INT, @p2 VARCHAR(50)',
    N'SELECT @p1 AS val1, @p2 AS val2',
    @p1=10, @p2=N'hello'
GO
~~START~~
int#!#varchar
10#!#hello
~~END~~


-- Expect: misses=11, writes=11, entries=11
SELECT * FROM sys.batch_antlr_parse_cache_stats();
GO
~~START~~
bigint#!#bigint#!#bigint#!#bigint#!#bigint#!#bigint
5#!#11#!#11#!#0#!#0#!#11
~~END~~


-- Second call: @p1 VARCHAR, @p2 INT — SWAPPED types, different signature = cache MISS
DECLARE @h INT
EXEC sp_prepexec @h OUTPUT,
    N'@p1 VARCHAR(50), @p2 INT',
    N'SELECT @p1 AS val1, @p2 AS val2',
    @p1=N'world', @p2=99
GO
~~START~~
varchar#!#int
world#!#99
~~END~~


-- Expect: hits=5, misses=12, writes=12, entries=12
SELECT * FROM sys.batch_antlr_parse_cache_stats();
GO
~~START~~
bigint#!#bigint#!#bigint#!#bigint#!#bigint#!#bigint
5#!#12#!#12#!#0#!#0#!#12
~~END~~


-- Third call: @p1 BIGINT, @p2 DECIMAL — different types again = cache MISS
DECLARE @h INT
EXEC sp_prepexec @h OUTPUT,
    N'@p1 BIGINT, @p2 DECIMAL(10,2)',
    N'SELECT @p1 AS val1, @p2 AS val2',
    @p1=9999999, @p2=1.23
GO
~~START~~
bigint#!#numeric
9999999#!#1.23000000
~~END~~


-- Expect: hits=5, misses=13, writes=13, entries=13
SELECT * FROM sys.batch_antlr_parse_cache_stats();
GO
~~START~~
bigint#!#bigint#!#bigint#!#bigint#!#bigint#!#bigint
5#!#13#!#13#!#0#!#0#!#13
~~END~~


-- ============================================================================
-- Test 16: Bind parameter count change — same start, extra params
-- 'SELECT @p1' vs 'SELECT @p1, @p2' = different query bodies = different entries
-- ============================================================================
