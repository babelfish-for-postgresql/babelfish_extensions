0#!#2#!#2#!#0#!#0#!#2
~~END~~


-- ============================================================================
-- Test 3: sp_prepexec with aggregation
-- ============================================================================
PRINT '=== Test 3: sp_prepexec aggregation ===';
GO
DECLARE @h INT
EXEC sp_prepexec @h OUTPUT,
    N'@p1 VARCHAR(50)',
    N'SELECT region, COUNT(*) AS cnt, SUM(quantity) AS total_qty, AVG(unit_price) AS avg_price FROM dbo.cache_orders WHERE region = @p1 GROUP BY region',
    @p1=N'US'
GO
~~START~~
varchar#!#int#!#int#!#numeric
US#!#3#!#31#!#79.990000
~~END~~


-- Expect: misses=3, writes=3, entries=3
SELECT * FROM sys.batch_antlr_parse_cache_stats();
GO
~~START~~
bigint#!#bigint#!#bigint#!#bigint#!#bigint#!#bigint
0#!#3#!#3#!#0#!#0#!#3
~~END~~


-- ============================================================================
-- Test 4: sp_prepexec with JOIN
-- ============================================================================
PRINT '=== Test 4: sp_prepexec with JOIN ===';
GO
