3#!#Widget C#!#Alice#!#Smith#!#gold
5#!#Widget E#!#Diana#!#Lee#!#gold
~~END~~


-- Expect: misses=4, writes=4, entries=4
SELECT * FROM sys.batch_antlr_parse_cache_stats();
GO
~~START~~
bigint#!#bigint#!#bigint#!#bigint#!#bigint#!#bigint
0#!#4#!#4#!#0#!#0#!#4
~~END~~


