CREATE FUNCTION test_str_bin_conversion.f_s2vb_nvarchar_emoji()
RETURNS @Result TABLE
(
    src_value      NVARCHAR(13)  NULL,
    vb_value       VARBINARY(20) NULL,
    src_char_len   INT           NULL,
    src_byte_len   INT           NULL,
    vb_byte_len    INT           NULL
)
AS
BEGIN
    DECLARE @s NVARCHAR(13) = N'😀';
    INSERT INTO @Result
    SELECT
        @s,
        CAST(@s AS VARBINARY(20)),
        LEN(@s),                 -- 1 character
        DATALENGTH(@s),          -- 4 bytes (surrogate pair)
        DATALENGTH(CAST(@s AS VARBINARY(20)));
    RETURN;
END;
GO



CREATE FUNCTION test_str_bin_conversion.f_s2vb_char13_spaces()
RETURNS @Result TABLE
(
    src_value      CHAR(13)      NULL,
    vb_value       VARBINARY(20) NULL,
    src_char_len   INT           NULL,
    src_byte_len   INT           NULL,
    vb_byte_len    INT           NULL
)
AS
BEGIN
    DECLARE @s CHAR(13) = REPLICATE(' ', 13);
    INSERT INTO @Result
    SELECT
        @s,
        CAST(@s AS VARBINARY(20)),
        LEN(@s),                 -- LEN ignores trailing spaces -> 0
        DATALENGTH(@s),          -- 13 bytes stored
        DATALENGTH(CAST(@s AS VARBINARY(20)));
    RETURN;
END;
GO



CREATE FUNCTION test_str_bin_conversion.f_s2bin_nchar13_bin32()
RETURNS @Result TABLE
(
    src_value      NCHAR(13)   NULL,
    bin_value      BINARY(32)  NULL,
    src_byte_len   INT         NULL,
    bin_byte_len   INT         NULL
)
AS
BEGIN
    DECLARE @s NCHAR(13) = N'Hello, World!';
    INSERT INTO @Result
    SELECT
        @s,
        CAST(@s AS BINARY(32)),
        DATALENGTH(@s),                 -- 13 bytes
        DATALENGTH(CAST(@s AS BINARY(32)));  -- expect 32
    RETURN;
END;
GO



CREATE FUNCTION test_str_bin_conversion.f_s2bin_varchar_overflow8()
RETURNS @Result TABLE
(
    src_value      VARCHAR(13) NULL,
    bin_value      BINARY(8)   NULL,
    src_byte_len   INT         NULL,
    bin_byte_len   INT         NULL
)
AS
BEGIN
    DECLARE @s VARCHAR(13) = '1234567890123';   -- 13 ASCII chars
    INSERT INTO @Result
    SELECT
        @s,
        CAST(@s AS BINARY(8)),                  -- truncates/pads to 8 bytes
        DATALENGTH(@s),                         -- 13 bytes
        DATALENGTH(CAST(@s AS BINARY(8)));      --  expect 8
    RETURN;
END;
GO



CREATE FUNCTION test_str_bin_conversion.f_s2bin_nvarchar_overflow3()
RETURNS @Result TABLE
(
    src_value      NVARCHAR(13) NULL,
    bin_value      BINARY(3)    NULL,
    src_byte_len   INT          NULL,
    bin_byte_len   INT          NULL
)
AS
BEGIN
    DECLARE @s NVARCHAR(13) = N'😀';        -- 4 bytes in NVARCHAR storage
    INSERT INTO @Result
    SELECT
        @s,
        CAST(@s AS BINARY(3)),              -- will truncate to 3 bytes
        DATALENGTH(@s),                     -- 4 bytes
        DATALENGTH(CAST(@s AS BINARY(3)));  -- expect 3
    RETURN;
END;
GO



CREATE FUNCTION test_str_bin_conversion.f_s2bin_try_compare()
RETURNS @Result TABLE
(
    src_value        NVARCHAR(13) NULL,
    try_cast_bin4    BINARY(4)    NULL,
    try_convert_bin4 BINARY(4)    NULL,
    cast_bytes       INT          NULL,
    tcast_bytes      INT          NULL,
    tconv_bytes      INT          NULL
)
AS
BEGIN
    DECLARE @s NVARCHAR(13) = N'中文';
    INSERT INTO @Result
    SELECT
        @s,
        TRY_CAST(@s AS BINARY(4)),
        TRY_CONVERT(BINARY(4), @s),
        DATALENGTH(CAST(@s AS VARBINARY(20))),  -- expect 4
        DATALENGTH(TRY_CAST(@s AS BINARY(4))),  -- expect 4
        DATALENGTH(TRY_CONVERT(BINARY(4), @s)); -- expect 4
    RETURN;
END;
GO
