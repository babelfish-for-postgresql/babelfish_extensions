CREATE VIEW DimOfGeometryline AS SELECT location.STAsText() AS geometry, location.STDimension() AS dimension FROM GEOSPATIALLINEGEOM_dt ORDER BY id;

CREATE VIEW AreaOfGeometryline AS SELECT location.STAsText() AS geometry, location.STArea() AS area FROM GEOSPATIALLINEGEOM_dt ORDER BY id;

CREATE VIEW TextFromGeometryline AS SELECT location.STAsText() AS text FROM GEOSPATIALLINEGEOM_dt ORDER BY id;

CREATE VIEW BinaryFromGeometryline AS SELECT location.STAsText() AS geometry, location.STAsBinary() AS binary FROM GEOSPATIALLINEGEOM_dt ORDER BY id;

CREATE VIEW SridFromGeometryline AS SELECT location.STAsText() AS geometry, location.STSrid AS srid FROM GEOSPATIALLINEGEOM_dt ORDER BY id;

CREATE VIEW EmptyGeometryline AS SELECT location.STAsText() AS geometry, location.STIsEmpty() AS isempty FROM GEOSPATIALLINEGEOM_dt ORDER BY id;

CREATE VIEW ValidGeometryline AS SELECT location.STAsText() AS geometry, location.STIsValid() AS isvalid FROM GEOSPATIALLINEGEOM_dt ORDER BY id;

CREATE VIEW ClosedGeometryline AS SELECT location.STAsText() AS geometry, location.STIsClosed() AS isclosed FROM GEOSPATIALLINEGEOM_dt ORDER BY id;

CREATE VIEW DisjointTempGeomline AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STDisjoint(p2.location) AS disjoints FROM GEOSPATIALLINEGEOM_dt p1 CROSS JOIN GEOSPATIALLINEGEOM_dt p2 ORDER BY p1.id;

CREATE VIEW DistanceTempGeomline AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2,  CAST(STDistance( p1.location, p2.location ) AS numeric(20, 6)) AS distance FROM GEOSPATIALLINEGEOM_dt p1 CROSS JOIN GEOSPATIALLINEGEOM_dt p2 ORDER BY p1.id;

CREATE VIEW IntersectsTempGeomline AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STIntersects(p2.location) AS interesecting FROM GEOSPATIALLINEGEOM_dt p1 CROSS JOIN GEOSPATIALLINEGEOM_dt p2 ORDER BY p1.id;

CREATE VIEW EqualsTempGeomline AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STEquals(p2.location) AS equals FROM GEOSPATIALLINEGEOM_dt p1 CROSS JOIN GEOSPATIALLINEGEOM_dt p2 ORDER BY p1.id;

CREATE VIEW ContainTempGeomline AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STContains(p2.location) AS contain FROM GEOSPATIALLINEGEOM_dt p1 CROSS JOIN GEOSPATIALLINEGEOM_dt p2 ORDER BY p1.id;

CREATE VIEW equals_opgeomline AS SELECT p1.location AS point FROM GEOSPATIALLINEGEOM_dt p1 CROSS JOIN GEOSPATIALLINEGEOM_dt p2 WHERE p1.location = p2.location ORDER BY p1.id;

CREATE VIEW notequal_opgeomline AS SELECT p1.location AS point FROM GEOSPATIALLINEGEOM_dt p1 CROSS JOIN GEOSPATIALLINEGEOM_dt p2 WHERE p1.location <> p2.location ORDER BY p1.id;


CREATE VIEW DisjointTempGeomlinesr AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STDisjoint(p2.location) AS disjoints FROM GEOSPATIALLINEGEOM_dt p1 CROSS JOIN GEOSPATIALPOINTGEOM_linesr p2 ORDER BY p1.id;

CREATE VIEW DistanceTempGeomlinesr AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2,  CAST(STDistance( p1.location, p2.location ) AS numeric(20, 6)) AS distance FROM GEOSPATIALLINEGEOM_dt p1 CROSS JOIN GEOSPATIALPOINTGEOM_linesr p2 ORDER BY p1.id;

CREATE VIEW IntersectsTempGeomlinesr AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STIntersects(p2.location) AS interesecting FROM GEOSPATIALLINEGEOM_dt p1 CROSS JOIN GEOSPATIALPOINTGEOM_linesr p2 ORDER BY p1.id;

CREATE VIEW EqualsTempGeomlinesr AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STEquals(p2.location) AS equals FROM GEOSPATIALLINEGEOM_dt p1 CROSS JOIN GEOSPATIALPOINTGEOM_linesr p2 ORDER BY p1.id;

CREATE VIEW ContainTempGeomlinesr AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STContains(p2.location) AS contain FROM GEOSPATIALLINEGEOM_dt p1 CROSS JOIN GEOSPATIALPOINTGEOM_linesr p2 ORDER BY p1.id;

CREATE VIEW equals_opgeomlinesr AS SELECT p1.location AS point FROM GEOSPATIALLINEGEOM_dt p1 CROSS JOIN GEOSPATIALPOINTGEOM_linesr p2 WHERE p1.location = p2.location ORDER BY p1.id;

CREATE VIEW notequal_opgeomlinesr AS SELECT p1.location AS point FROM GEOSPATIALLINEGEOM_dt p1 CROSS JOIN GEOSPATIALPOINTGEOM_linesr p2 WHERE p1.location <> p2.location ORDER BY p1.id;

CREATE VIEW LineGeomFromText AS SELECT geometry::STLineFromText('LINESTRING(3 5, 2 4)', 4326) AS geom1, geometry::STLineFromText('LINESTRING(1 3, 5 7, 4 5 NULL NULL)', 4326) AS geom2;


