# Geometry Test Cases

CREATE TABLE GEOSPATIALLINEGEOM_dt (location geometry)
ALTER TABLE GEOSPATIALLINEGEOM_dt ADD id INT IDENTITY(1,1);

# Positive Test for STGeomFromText with SRID 4326
INSERT INTO GEOSPATIALLINEGEOM_dt (location) VALUES (geometry::STGeomFromText('LINESTRING(3 5, 2 4)', 4326));
~~ROW COUNT: 1~~

