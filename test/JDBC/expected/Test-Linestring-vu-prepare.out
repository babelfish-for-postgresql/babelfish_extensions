CREATE VIEW DimOfgeographyline AS SELECT location.STAsText() AS geometry, location.STDimension() AS dimension FROM GEOSPATIALLINEGEOG_dt ORDER BY id;

CREATE VIEW AreaOfgeographyline AS SELECT location.STAsText() AS geometry, location.STArea() AS area FROM GEOSPATIALLINEGEOG_dt ORDER BY id;

CREATE VIEW TextFromgeographyline AS SELECT location.STAsText() AS text FROM GEOSPATIALLINEGEOG_dt ORDER BY id;

CREATE VIEW BinaryFromgeographyline AS SELECT location.STAsText() AS geometry, location.STAsBinary() AS binary FROM GEOSPATIALLINEGEOG_dt ORDER BY id;

CREATE VIEW SridFromgeographyline AS SELECT location.STAsText() AS geometry, location.STSrid AS srid FROM GEOSPATIALLINEGEOG_dt ORDER BY id;

CREATE VIEW Emptygeographyline AS SELECT location.STAsText() AS geometry, location.STIsEmpty() AS isempty FROM GEOSPATIALLINEGEOG_dt ORDER BY id;

CREATE VIEW Validgeographyline AS SELECT location.STAsText() AS geometry, location.STIsValid()  AS isvalid FROM GEOSPATIALLINEGEOG_dt ORDER BY id;

CREATE VIEW Closedgeographyline AS SELECT location.STAsText() AS geometry, location.STIsClosed() AS isclosed FROM GEOSPATIALLINEGEOG_dt ORDER BY id;

CREATE VIEW DisjointTempGeogline AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STDisjoint(p2.location) AS disjoints FROM GEOSPATIALLINEGEOG_dt p1 CROSS JOIN GEOSPATIALLINEGEOG_dt p2 ORDER BY p1.id;

CREATE VIEW DistanceTempGeogline AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, CAST(STDistance( p1.location, p2.location ) AS numeric(20, 6)) AS distance FROM GEOSPATIALLINEGEOG_dt p1 CROSS JOIN GEOSPATIALLINEGEOG_dt p2 ORDER BY p1.id;

CREATE VIEW IntersectsTempGeogline AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STIntersects(p2.location) AS interesecting FROM GEOSPATIALLINEGEOG_dt p1 CROSS JOIN GEOSPATIALLINEGEOG_dt p2 ORDER BY p1.id;

CREATE VIEW EqualsTempGeogline AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STEquals(p2.location) AS equals FROM GEOSPATIALLINEGEOG_dt p1 CROSS JOIN GEOSPATIALLINEGEOG_dt p2 ORDER BY p1.id;

CREATE VIEW ContainTempGeogline AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STContains(p2.location) AS contain FROM GEOSPATIALLINEGEOG_dt p1 CROSS JOIN GEOSPATIALLINEGEOG_dt p2 ORDER BY p1.id;

CREATE VIEW equals_opgeogline AS SELECT p1.location AS point FROM GEOSPATIALLINEGEOG_dt p1 CROSS JOIN GEOSPATIALLINEGEOG_dt p2 WHERE p1.location = p2.location ORDER BY p1.id;

CREATE VIEW notequal_opgeogline AS SELECT p1.location AS point FROM GEOSPATIALLINEGEOG_dt p1 CROSS JOIN GEOSPATIALLINEGEOG_dt p2 WHERE p1.location <> p2.location ORDER BY p1.id;


CREATE VIEW DisjointTempGeoglinesr AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STDisjoint(p2.location) AS disjoints FROM GEOSPATIALLINEGEOG_dt p1 CROSS JOIN GEOSPATIALPOINTGEOG_linesr p2 ORDER BY p1.id;

CREATE VIEW DistanceTempGeoglinesr AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2,  CAST(STDistance( p1.location, p2.location ) AS numeric(20, 6)) AS distance FROM GEOSPATIALLINEGEOG_dt p1 CROSS JOIN GEOSPATIALPOINTGEOG_linesr p2 ORDER BY p1.id;

CREATE VIEW IntersectsTempGeoglinesr AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STIntersects(p2.location) AS interesecting FROM GEOSPATIALLINEGEOG_dt p1 CROSS JOIN GEOSPATIALPOINTGEOG_linesr p2 ORDER BY p1.id;

CREATE VIEW EqualsTempGeoglinesr AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STEquals(p2.location) AS equals FROM GEOSPATIALLINEGEOG_dt p1 CROSS JOIN GEOSPATIALPOINTGEOG_linesr p2 ORDER BY p1.id;

CREATE VIEW ContainTempGeoglinesr AS SELECT p1.location.STAsText() AS geometry1, p2.location.STAsText() AS geometry2, p1.location.STContains(p2.location) AS contain FROM GEOSPATIALLINEGEOG_dt p1 CROSS JOIN GEOSPATIALPOINTGEOG_linesr p2 ORDER BY p1.id;

CREATE VIEW equals_opgeoglinesr AS SELECT p1.location AS point FROM GEOSPATIALLINEGEOG_dt p1 CROSS JOIN GEOSPATIALPOINTGEOG_linesr p2 WHERE p1.location = p2.location ORDER BY p1.id;

CREATE VIEW notequal_opgeoglinesr AS SELECT p1.location AS point FROM GEOSPATIALLINEGEOG_dt p1 CROSS JOIN GEOSPATIALPOINTGEOG_linesr p2 WHERE p1.location <> p2.location ORDER BY p1.id;

CREATE VIEW LineGeogFromText AS SELECT geography::STLineFromText('LINESTRING(3 5, 2 4)', 4326) AS geog1, geography::STLineFromText('LINESTRING(1 3, 5 7, 4 5 NULL NULL)', 4326) AS geog2;


