# Negative Test when SRID is not valid
# SRID should be between 0 to 999999
INSERT INTO GEOSPATIALLINEGEOM_dt (location) VALUES ( geometry::STGeomFromText('LINESTRING(1 2, 3 7)') );
~~ERROR (Code: 8146)~~

~~ERROR (Message: function geometry__stgeomfromtext has no parameters and arguments were supplied.)~~

INSERT INTO GEOSPATIALLINEGEOM_dt (location) VALUES ( geometry::STGeomFromText('LINESTRING(5 3, 4.5 2, 3 1)', 1000000000 ) );
~~ERROR (Code: 33557097)~~

~~ERROR (Message: SRID value should be between 0 and 999999)~~

INSERT INTO GEOSPATIALLINEGEOM_dt (location) VALUES ( geometry::STLineFromText('LINESTRING(1 2, 3 5, 6 4)', -1) );
~~ERROR (Code: 33557097)~~

~~ERROR (Message: SRID value should be between 0 and 999999)~~


# Negative Test for STLineFromText when a coordinate is missing
INSERT INTO GEOSPATIALLINEGEOM_dt (location) VALUES ( geometry::STLineFromText('LINESTRING(1 2, 3 5, 6 )', 4326) );
~~ERROR (Code: 33557097)~~

~~ERROR (Message: Invalid geometry)~~


#  Negative Test for STGeomFromText when Incorrect cast is provided
INSERT INTO GEOSPATIALLINEGEOM_dt (location) VALUES ( geography::STGeomFromText('LINESTRING(1 2, 3 5, 6 4)', 4326) );
~~ERROR (Code: 33557097)~~

~~ERROR (Message: column "location" is of type geometry but expression is of type geography)~~


CREATE TABLE GEOSPATIALPOINTGEOM_linesr (location geometry)
ALTER TABLE GEOSPATIALPOINTGEOM_linesr ADD id INT IDENTITY(1,1);

INSERT INTO GEOSPATIALPOINTGEOM_linesr (location) VALUES (geometry::STGeomFromText('LINESTRING EMPTY', 4326));
~~ROW COUNT: 1~~

