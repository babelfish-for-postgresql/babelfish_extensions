--Check psql syntax
-- Create test tables
CREATE TABLE psql_test_table1 (
    id INT,
    name VARCHAR(50),
    value DECIMAL(10,2)
);
CREATE TABLE psql_test_table2 (
    id INT,
    description TEXT,
    date_field TIMESTAMP
);
INSERT INTO psql_test_table1 VALUES 
    (1, 'Test1', 10.5),
    (2, 'Test2', 20.5);
INSERT INTO psql_test_table2 VALUES 
    (1, 'Desc1', '2024-03-18 10:00:00'),
    (2, 'Desc2', '2024-03-18 11:00:00');
GO
~~ROW COUNT: 2~~

~~ROW COUNT: 2~~


CREATE VIEW psql_view1 AS SELECT * FROM psql_test_table1;
GO

-- ALTER VIEW with column names
CREATE VIEW psql_view2 (col1, col2, col3) AS 
    SELECT id, name, value FROM psql_test_table1;
GO

ALTER VIEW psql_view2 RENAME col1 TO id_column;
GO

select * from psql_view2;
GO
~~START~~
int4#!#varchar#!#numeric
1#!#Test1#!#10.50
2#!#Test2#!#20.50
~~END~~


-- ALTER VIEW OWNER
CREATE ROLE test_role;
GO

ALTER VIEW psql_view2 OWNER TO test_role;
GO

SELECT pg_get_userbyid(relowner) AS view_owner
FROM pg_class
WHERE relname = 'psql_view2' AND relkind = 'v';
GO
~~START~~
name
test_role
~~END~~


-- ALTER VIEW SET SCHEMA
CREATE SCHEMA psql_test_schema;
GO

ALTER VIEW psql_view2 SET SCHEMA psql_test_schema;
GO

DROP VIEW IF EXISTS psql_view1;
GO
DROP VIEW IF EXISTS psql_test_schema.psql_view2;
GO
DROP SCHEMA IF EXISTS psql_test_schema;
GO
DROP ROLE IF EXISTS test_role;
GO
DROP TABLE IF EXISTS psql_test_table1;
GO
DROP TABLE IF EXISTS psql_test_table2;
GO

-- tsql
CREATE LOGIN view_owner_login WITH PASSWORD = '12345678';
CREATE LOGIN view_user_login WITH PASSWORD = '12345678';
GO

ALTER ROLE sysadmin ADD MEMBER view_owner_login;;
GO

-- tsql user=view_owner_login password=12345678
CREATE DATABASE view_perm_db;
GO

USE view_perm_db;
GO

CREATE USER view_user FOR LOGIN view_user_login;
GO

CREATE SCHEMA test_schema;
GO

CREATE TABLE test_schema.base_table (id INT PRIMARY KEY, name VARCHAR(50), email VARCHAR(100));
GO

CREATE TABLE test_schema.base_table1 ( id INT PRIMARY KEY, name VARCHAR(50), email VARCHAR(100), age INT, salary DECIMAL(10,2) );
GO

INSERT INTO test_schema.base_table VALUES (1, 'John', 'john@test.com'), (2, 'Jane', 'jane@test.com');
GO
~~ROW COUNT: 2~~


-- Create view as view_owner
CREATE VIEW test_schema.test_view as select * from test_schema.base_table
GO

CREATE VIEW test_schema.colacl_view1 as select 1 as a, 2 as b, 3 as c;
GO

-- Verify view_owner can select from view
SELECT * FROM test_schema.test_view;
GO
~~START~~
int#!#varchar#!#varchar
1#!#John#!#john@test.com
2#!#Jane#!#jane@test.com
~~END~~


SELECT * FROM test_schema.colacl_view1;
GO
~~START~~
int#!#int#!#int
1#!#2#!#3
~~END~~


-- Create view with 3 columns
CREATE VIEW test_schema.test_view1 AS 
SELECT id, name, email FROM test_schema.base_table1;
GO

-- Grant permissions
GRANT SELECT ON test_schema.test_view1(id, name) TO view_user;
GO

-- psql
-- Print initial permissions
SELECT
    TABLE_NAME, 
    COLUMN_NAME, 
    PRIVILEGE_TYPE
FROM 
    INFORMATION_SCHEMA.COLUMN_PRIVILEGES
WHERE 
    TABLE_NAME = 'test_view1' AND
    COLUMN_NAME IN ('id', 'name')
ORDER BY 
    COLUMN_NAME, PRIVILEGE_TYPE;
GO
~~START~~
name#!#name#!#varchar
test_view1#!#id#!#INSERT
test_view1#!#id#!#INSERT
test_view1#!#id#!#REFERENCES
test_view1#!#id#!#SELECT
test_view1#!#id#!#SELECT
test_view1#!#id#!#SELECT
test_view1#!#id#!#UPDATE
test_view1#!#id#!#UPDATE
test_view1#!#name#!#INSERT
test_view1#!#name#!#INSERT
test_view1#!#name#!#REFERENCES
test_view1#!#name#!#SELECT
test_view1#!#name#!#SELECT
test_view1#!#name#!#SELECT
test_view1#!#name#!#UPDATE
test_view1#!#name#!#UPDATE
~~END~~


-- tsql user=view_owner_login password=12345678
-- Alter view to have 4+ columns
ALTER VIEW test_schema.test_view1 AS
SELECT 
    id,
    name AS "NAME" , -- Same name as existing column, different case
    email,
    age,
    salary,
    UPPER(name) AS new_column
FROM 
    test_schema.base_table1;
GO

-- psql
-- Print permissions after alteration
SELECT
    TABLE_NAME, 
    COLUMN_NAME, 
    PRIVILEGE_TYPE
FROM 
    INFORMATION_SCHEMA.COLUMN_PRIVILEGES
WHERE 
    TABLE_NAME = 'test_view1' AND
    COLUMN_NAME IN ('id', 'NAME')
ORDER BY 
    COLUMN_NAME, PRIVILEGE_TYPE;
GO
