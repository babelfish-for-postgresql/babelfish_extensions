GO
~~START~~
money
0.0000
~~END~~

SELECT CAST(CHAR(163) AS MONEY);             -- Pound sign
GO
~~START~~
money
0.0000
~~END~~

SELECT CAST(CHAR(164) AS MONEY);             -- Currency sign
GO
~~START~~
money
0.0000
~~END~~

SELECT CAST(CHAR(165) AS MONEY);             -- Yen sign
GO
~~START~~
money
0.0000
~~END~~

SELECT CAST('\' AS money);
GO
~~START~~
money
0.0000
~~END~~

SELECT CAST('\ .6431,,7431,85,12,97                         ' AS MONEY);
GO
~~START~~
money
0.6432
~~END~~

SELECT CAST(NCHAR(160) + ' ' AS MONEY);
GO
~~START~~
money
0.0000
~~END~~

--Invalid cases
SELECT CAST(NCHAR(160) + '123.45' AS MONEY);
GO
~~START~~
money
~~ERROR (Code: 293)~~

~~ERROR (Message: invalid characters found: cannot cast value " 123.45" to money)~~

SELECT CAST(NCHAR(160) + NCHAR(160) + '99.99' AS MONEY);
GO
~~START~~
money
~~ERROR (Code: 293)~~

~~ERROR (Message: invalid characters found: cannot cast value "  99.99" to money)~~

