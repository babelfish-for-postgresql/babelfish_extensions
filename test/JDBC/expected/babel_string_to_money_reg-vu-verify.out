--Valid cases
SELECT CAST('\0' AS MONEY);
GO
~~START~~
money
0.0000
~~END~~

SELECT CAST('$,,100' AS MONEY);
GO
~~START~~
money
100.0000
~~END~~

SELECT ISNUMERIC(CHAR(9));
GO
~~START~~
int
1
~~END~~

SELECT ISNUMERIC(CHAR(13));
GO
~~START~~
int
1
~~END~~

SELECT isnumeric(CHAR(92));
GO
~~START~~
int
1
~~END~~

SELECT isnumeric(char(44));
GO
~~START~~
int
1
~~END~~

SELECT CAST(NCHAR(8364) AS money);           -- Euro sign
GO
~~START~~
money
0.0000
~~END~~

SELECT CAST(CHAR(11) AS MONEY);              --Vertical tab
GO
~~START~~
money
0.0000
~~END~~

SELECT CAST(CHAR(12) AS MONEY);              -- Form feed
GO
~~START~~
money
0.0000
~~END~~

