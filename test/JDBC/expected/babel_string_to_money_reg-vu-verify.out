GO
~~START~~
money
0.0000
~~END~~

SELECT CAST(CHAR(46) AS MONEY);              -- Dot
GO
~~START~~
money
0.0000
~~END~~

SELECT CAST(CHAR(48) AS MONEY);              -- Zero
GO
~~START~~
money
0.0000
~~END~~

