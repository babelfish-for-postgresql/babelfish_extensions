    Col VARCHAR(100) COLLATE SQL_Latin1_General_CP1_CI_AS
);
GO

CREATE TABLE BABEL_5966_TestLikeCollation_CS_AS (
    Id INT IDENTITY PRIMARY KEY,
    Col VARCHAR(100) COLLATE SQL_Latin1_General_CP1_CS_AS
