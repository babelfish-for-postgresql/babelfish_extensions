-- create a temp view for easier access to pg_db_role_setting
-- tsql
CREATE VIEW db_role_settings_view
AS
SELECT unnest(setconfig) AS setting
FROM pg_db_role_setting;
GO

CREATE VIEW unnested_db_role_settings_view
AS
SELECT
substring(setting, 1, charindex('=',setting)-1) as setting, 
substring(setting, charindex('=',setting)+1) as value
FROM db_role_settings_view
ORDER BY setting;
GO

SELECT * FROM unnested_db_role_settings_view;
GO

-- set all escape hatches to ignore to populate db_role_settings
-- do this within a transaction to simply rollback at end of test

BEGIN TRAN
GO

SP_BABELFISH_CONFIGURE '%', 'ignore', 'server'
GO

-- check all escape hatches
SELECT setting,
CASE setting
	WHEN 'babelfishpg_tsql.temp_oid_buffer_start' 
		THEN CASE value WHEN '-2147483648' THEN 'n' ELSE 'y' END
	ELSE value
END AS value
FROM unnested_db_role_settings_view
GO

-- check the current value of babelfishpg_tsql.temp_oid_buffer_start
SELECT * FROM unnested_db_role_settings_view
WHERE setting = 'babelfishpg_tsql.temp_oid_buffer_start';
GO

-- create the first temp table which does the temp_oid_buffer_start initialization
-- tsql
CREATE TABLE #dummy_table(a INT);
GO

-- check all escape hatches
SELECT setting,
CASE setting
	WHEN 'babelfishpg_tsql.temp_oid_buffer_start' 
		THEN CASE value WHEN '-2147483648' THEN 'n' ELSE 'y' END
	ELSE value
END AS value
FROM unnested_db_role_settings_view
GO

-- check that the temp_oid_buffer_start should now be set
SELECT setting,
CASE setting
	WHEN 'babelfishpg_tsql.temp_oid_buffer_start' 
		THEN CASE value WHEN '-2147483648' THEN 'n' ELSE 'y' END
	ELSE value
END AS value
FROM unnested_db_role_settings_view
WHERE setting = 'babelfishpg_tsql.temp_oid_buffer_start';
GO

ROLLBACK TRAN
GO

-- check that the temp_oid_buffer_start should not be set anymore
SELECT setting,
CASE setting
	WHEN 'babelfishpg_tsql.temp_oid_buffer_start' 
		THEN CASE value WHEN '-2147483648' THEN 'n' ELSE 'y' END
	ELSE value
END AS value
FROM unnested_db_role_settings_view
WHERE setting = 'babelfishpg_tsql.temp_oid_buffer_start';
GO

DROP VIEW unnested_db_role_settings_view;
GO

DROP VIEW db_role_settings_view;
GO

CREATE LOGIN testlogin WITH PASSWORD='12345678';
GO

-- tsql user=testlogin password=12345678
BEGIN TRAN
GO

SELECT SUSER_NAME();
GO
CREATE TABLE #temp_table(a INT)
GO
SELECT SUSER_NAME();
GO

ROLLBACK TRAN
GO

-- terminate-tsql-conn user=testlogin password=12345678
-- tsql
DROP LOGIN testlogin;
GO