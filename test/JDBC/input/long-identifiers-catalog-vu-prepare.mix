-- Long identifiers catalog vu-prepare: Create objects stored in babelfish_identifier_mapping

-- Table with long constraint names
CREATE TABLE babel5975_cat_vu_t1 (
    id INT NOT NULL,
    val INT,
    CONSTRAINT Very_Long_PK_Constraint_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_CatVU PRIMARY KEY (id),
    CONSTRAINT Very_Long_Check_Constraint_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_CatVU CHECK (val > 0)
);
GO

-- Unique constraint
CREATE TABLE babel5975_cat_vu_t2 (
    val INT,
    CONSTRAINT Very_Long_Unique_Constraint_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_CatVU UNIQUE (val)
);
GO

-- Sequence with long name
CREATE SEQUENCE Very_Long_Sequence_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_CatVU AS INT START WITH 1;
GO

-- Type with long name
CREATE TYPE Very_Long_Type_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_CatVU FROM INT;
GO

-- Procedure with long parameter
CREATE PROCEDURE babel5975_cat_vu_proc
    @Very_Long_Parameter_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_CatVU INT
AS BEGIN SELECT @Very_Long_Parameter_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_CatVU END;
GO

-- BABEL-5975: collision coverage. Two procedures whose long parameter names
-- share the same leading ~60 bytes but differ in suffix. Exercises the
-- parent/namespace disambiguation in sys.all_parameters so each parameter must
-- resolve to its OWN original name (not the other procedure's).
CREATE PROCEDURE babel5975_cat_vu_collide_one
    @Shared_Long_Parameter_Prefix_That_Exceeds_PostgreSQL_Limit_Sixty_Three_ProcOne INT
AS BEGIN SELECT @Shared_Long_Parameter_Prefix_That_Exceeds_PostgreSQL_Limit_Sixty_Three_ProcOne END;
GO
CREATE PROCEDURE babel5975_cat_vu_collide_two
    @Shared_Long_Parameter_Prefix_That_Exceeds_PostgreSQL_Limit_Sixty_Three_ProcTwo INT
AS BEGIN SELECT @Shared_Long_Parameter_Prefix_That_Exceeds_PostgreSQL_Limit_Sixty_Three_ProcTwo END;
GO

-- BABEL-5975: ALTER TABLE ADD CONSTRAINT coverage. These long constraint names
-- are stored via store_alter_table_constraint_original_names (the ALTER path),
-- as opposed to the CREATE TABLE path exercised above. After dump/restore they
-- must resolve to their original names and leave exactly one mapping row each --
-- restore replays FOREIGN KEY constraints as ALTER TABLE ADD CONSTRAINT, so the
-- ALTER path's dump/restore guard must prevent it from re-inserting rows the
-- data restore already brings back.
CREATE TABLE babel5975_cat_vu_alter_parent (id INT PRIMARY KEY);
GO
CREATE TABLE babel5975_cat_vu_alter_tbl (id INT, pid INT, val INT);
GO
ALTER TABLE babel5975_cat_vu_alter_tbl ADD CONSTRAINT Very_Long_Alter_Check_Constraint_Name_That_Exceeds_Sixty_Three_Bytes_CatVU CHECK (val > 0);
GO
ALTER TABLE babel5975_cat_vu_alter_tbl ADD CONSTRAINT Very_Long_Alter_Unique_Constraint_Name_That_Exceeds_Sixty_Three_Bytes_CatVU UNIQUE (id);
GO
ALTER TABLE babel5975_cat_vu_alter_tbl ADD CONSTRAINT Very_Long_Alter_Foreign_Key_Constraint_Name_Exceeds_Sixty_Three_Bytes_CatVU FOREIGN KEY (pid) REFERENCES babel5975_cat_vu_alter_parent (id);
GO


-- BABEL-5975: constraint-name collision coverage. Two tables
-- in the same schema reuse the SAME long constraint name (legal in T-SQL --
-- constraint names are table-scoped). Both truncate to the same physical
-- conname, producing two mapping rows that differ only by parent_name (the
-- table). The constraint views must pass the parent table so each constraint
-- resolves to its own name deterministically -- and must still do so after
-- dump/restore.
CREATE TABLE babel5975_cat_vu_collide_ta (
    id INT,
    CONSTRAINT Shared_Long_Check_Constraint_Reused_On_Two_Tables_Exceeding_Sixty_Three_CatVU CHECK (id > 0)
);
GO
CREATE TABLE babel5975_cat_vu_collide_tb (
    id INT,
    CONSTRAINT Shared_Long_Check_Constraint_Reused_On_Two_Tables_Exceeding_Sixty_Three_CatVU CHECK (id > 0)
);
GO

