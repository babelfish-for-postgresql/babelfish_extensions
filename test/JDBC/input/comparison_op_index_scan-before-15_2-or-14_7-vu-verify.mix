-- parallel_query_expected
-- tsql
SELECT set_config('enable_bitmapscan', 'off', false);
GO

SELECT set_config('babelfishpg_tsql.explain_costs', 'off', false);
GO

-- psql
ANALYZE master_dbo.BABEL_6098_binary_test;
GO
ANALYZE master_dbo.BABEL_6098_varbinary_test;
GO
ANALYZE master_dbo.BABEL_6098_mixed_test;
GO

-- tsql
-- FOR SAME-TYPE BINARY OPERATORS
-- Equality operator
SELECT COUNT(*) as result FROM BABEL_6098_binary_test 
WHERE binary_col = CAST(0x01 AS BINARY(10));
GO

-- Not equal operator
SELECT COUNT(*) as result FROM BABEL_6098_binary_test 
WHERE binary_col <> CAST(0x05 AS BINARY(10));
GO

-- Less than operator
SELECT COUNT(*) as result FROM BABEL_6098_binary_test 
WHERE binary_col < CAST(0x02 AS BINARY(10));
GO

-- Less than or equal operator
SELECT COUNT(*) as result FROM BABEL_6098_binary_test 
WHERE binary_col <= CAST(0x01 AS BINARY(10));
GO

-- Greater than operator
SELECT COUNT(*) as result FROM BABEL_6098_binary_test 
WHERE binary_col > CAST(0x08 AS BINARY(10));
GO

-- Greater than or equal operator
SELECT COUNT(*) as result FROM BABEL_6098_binary_test 
WHERE binary_col >= CAST(0x09 AS BINARY(10));
GO

-- BETWEEN operator
SELECT COUNT(*) as result FROM BABEL_6098_binary_test 
WHERE binary_col BETWEEN CAST(0x01 AS BINARY(10)) AND CAST(0x01 AS BINARY(10));
GO

-- Range query using AND
SELECT COUNT(*) as result FROM BABEL_6098_binary_test 
WHERE binary_col >= CAST(0x01 AS BINARY(10)) AND binary_col <= CAST(0x05 AS BINARY(10));
GO

-- EXECUTION PLAN VERIFICATION

SET BABELFISH_SHOWPLAN_ALL ON;
GO

-- Equality - highly selective 
SELECT binary_col FROM BABEL_6098_binary_test 
WHERE binary_col = CAST(0x01 AS BINARY(10));
GO

-- Less than - highly selective 
SELECT binary_col FROM BABEL_6098_binary_test 
WHERE binary_col < CAST(0x02 AS BINARY(10));
GO

-- Less than or equal - highly selective 
SELECT binary_col FROM BABEL_6098_binary_test 
WHERE binary_col <= CAST(0x01 AS BINARY(10));
GO

-- Greater than - highly selective 
SELECT binary_col FROM BABEL_6098_binary_test 
WHERE binary_col > CAST(0x08 AS BINARY(10));
GO

-- Greater than or equal - non-selective (10003/10006 = 99.97%)
SELECT binary_col FROM BABEL_6098_binary_test 
WHERE binary_col >= CAST(0x01 AS BINARY(10));
GO

-- BETWEEN - highly selective 
SELECT binary_col FROM BABEL_6098_binary_test 
WHERE binary_col BETWEEN CAST(0x01 AS BINARY(10)) AND CAST(0x01 AS BINARY(10));
GO

-- COUNT(*) with highly selective condition
SELECT COUNT(*) FROM BABEL_6098_binary_test 
WHERE binary_col <= CAST(0x01 AS BINARY(10));
GO

SET BABELFISH_SHOWPLAN_ALL OFF;
GO

