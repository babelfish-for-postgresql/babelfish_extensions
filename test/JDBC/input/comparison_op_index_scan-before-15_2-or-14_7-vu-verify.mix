SET BABELFISH_SHOWPLAN_ALL ON;
GO

-- Verifying NOT (=) transforms to <> (reverse cross-type)
SELECT varbinary_col FROM BABEL_6098_varbinary_test 
WHERE NOT (varbinary_col = CAST(0x05 AS BINARY(10)));
GO

SELECT varbinary_col FROM BABEL_6098_varbinary_test 
WHERE varbinary_col <> CAST(0x05 AS BINARY(10));
GO

-- Verifying NOT (<) transforms to >= (reverse cross-type)
SELECT varbinary_col FROM BABEL_6098_varbinary_test 
WHERE NOT (varbinary_col < CAST(0x05 AS BINARY(10)));
GO

SELECT varbinary_col FROM BABEL_6098_varbinary_test 
WHERE varbinary_col >= CAST(0x05 AS BINARY(10));
GO

-- Verifying NOT (>) transforms to <= (reverse cross-type)
SELECT varbinary_col FROM BABEL_6098_varbinary_test 
WHERE NOT (varbinary_col > CAST(0x05 AS BINARY(10)));
GO

SELECT varbinary_col FROM BABEL_6098_varbinary_test 
WHERE varbinary_col <= CAST(0x05 AS BINARY(10));
GO

SET BABELFISH_SHOWPLAN_ALL OFF;
GO

-- OTHER NEGATION TESTS

-- Multiple conditions with NOT
SELECT COUNT(*) as result FROM BABEL_6098_binary_test 
WHERE NOT (binary_col > CAST(0x03 AS BINARY(10)) OR binary_col < CAST(0x02 AS BINARY(10)));
GO

-- Equivalent to: binary_col <= 0x03 AND binary_col >= 0x02
SELECT COUNT(*) as result FROM BABEL_6098_binary_test 
WHERE binary_col <= CAST(0x03 AS BINARY(10)) AND binary_col >= CAST(0x02 AS BINARY(10));
GO

-- Cross-type negation with conditions
SELECT COUNT(*) as result FROM BABEL_6098_binary_test 
WHERE NOT (binary_col >= CAST(0x08 AS VARBINARY(10)) OR binary_col <= CAST(0x02 AS VARBINARY(10)));
GO

-- Equivalent to: binary_col < 0x08 AND binary_col > 0x02
SELECT COUNT(*) as result FROM BABEL_6098_binary_test 
WHERE binary_col < CAST(0x08 AS VARBINARY(10)) AND binary_col > CAST(0x02 AS VARBINARY(10));
GO

-- EXECUTION PLAN VERIFICATION
SET BABELFISH_SHOWPLAN_ALL ON;
GO

SELECT binary_col FROM BABEL_6098_binary_test 
WHERE NOT (binary_col > CAST(0x03 AS BINARY(10)) OR binary_col < CAST(0x02 AS BINARY(10)));
GO

SELECT binary_col FROM BABEL_6098_binary_test 
WHERE binary_col <= CAST(0x03 AS BINARY(10)) AND binary_col >= CAST(0x02 AS BINARY(10));
GO

SELECT binary_col FROM BABEL_6098_binary_test 
WHERE NOT (binary_col >= CAST(0x08 AS VARBINARY(10)) OR binary_col <= CAST(0x02 AS VARBINARY(10)));
GO

SELECT binary_col FROM BABEL_6098_binary_test 
WHERE binary_col < CAST(0x08 AS VARBINARY(10)) AND binary_col > CAST(0x02 AS VARBINARY(10));
GO

SET BABELFISH_SHOWPLAN_ALL OFF;
GO

