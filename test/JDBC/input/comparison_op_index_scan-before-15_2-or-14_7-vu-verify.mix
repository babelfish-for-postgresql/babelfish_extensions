-- FOR JOIN OPERATIONS AND MIXED TABLE TESTS

-- Cross-type join with range condition
SELECT COUNT(*) as result FROM BABEL_6098_binary_test t1 
INNER JOIN BABEL_6098_varbinary_test t2 ON t1.binary_col < t2.varbinary_col 
WHERE t1.binary_col = CAST(0x01 AS BINARY(10));
GO

-- Column-to-column equality: BINARY = VARBINARY
SELECT COUNT(*) as result FROM BABEL_6098_mixed_test 
WHERE binary_col = varbinary_col;
GO

-- Column-to-column less than: BINARY < VARBINARY
SELECT COUNT(*) as result FROM BABEL_6098_mixed_test 
WHERE binary_col < varbinary_col;
GO

-- Column-to-column greater than: BINARY > VARBINARY
SELECT COUNT(*) as result FROM BABEL_6098_mixed_test 
WHERE binary_col > varbinary_col;
GO

-- Column-to-column less than or equal: BINARY <= VARBINARY
SELECT COUNT(*) as result FROM BABEL_6098_mixed_test 
WHERE binary_col <= varbinary_col;
GO

-- Mixed table: BINARY column with BINARY literal
SELECT COUNT(*) as result FROM BABEL_6098_mixed_test
WHERE binary_col = CAST(0x01 AS BINARY(10));
GO

-- Mixed table: BINARY column with VARBINARY literal (cross-type)
SELECT COUNT(*) as result FROM BABEL_6098_mixed_test
WHERE binary_col = CAST(0x01 AS VARBINARY(10));
GO

-- Mixed table: VARBINARY column with VARBINARY literal
SELECT COUNT(*) as result FROM BABEL_6098_mixed_test
WHERE varbinary_col = CAST(0x01 AS VARBINARY(10));
GO

-- Mixed table: VARBINARY column with BINARY literal (cross-type)
SELECT COUNT(*) as result FROM BABEL_6098_mixed_test
WHERE varbinary_col = CAST(0x01 AS BINARY(10));
GO

-- Mixed table: Complex condition with both columns
SELECT COUNT(*) as result FROM BABEL_6098_mixed_test
WHERE binary_col = CAST(0x01 AS BINARY(10)) 
  AND varbinary_col = CAST(0x01 AS VARBINARY(10));
GO

-- EXECUTION PLAN VERIFICATION

SET BABELFISH_SHOWPLAN_ALL ON;
GO

-- Self join
SELECT t1.binary_col FROM BABEL_6098_binary_test t1 
INNER JOIN BABEL_6098_binary_test t2 ON t1.binary_col = t2.binary_col
WHERE t1.binary_col = CAST(0x01 AS BINARY(10));
GO

-- Cross-type join with equality 
SELECT t1.binary_col FROM BABEL_6098_binary_test t1 
INNER JOIN BABEL_6098_varbinary_test t2 ON t1.binary_col = t2.varbinary_col
WHERE t1.binary_col = CAST(0x01 AS BINARY(10));
GO

-- Cross-type join with range condition
SELECT t1.binary_col FROM BABEL_6098_binary_test t1 
INNER JOIN BABEL_6098_varbinary_test t2 ON t1.binary_col < t2.varbinary_col 
WHERE t1.binary_col = CAST(0x01 AS BINARY(10));
GO

-- Column-to-column equality in mixed table
SELECT binary_col, varbinary_col FROM BABEL_6098_mixed_test 
WHERE binary_col = varbinary_col;
GO

-- Column-to-column range comparison in mixed table
SELECT binary_col, varbinary_col FROM BABEL_6098_mixed_test 
WHERE binary_col < varbinary_col;
GO

-- Mixed table: BINARY column with VARBINARY literal (highly selective)
SELECT binary_col FROM BABEL_6098_mixed_test
WHERE binary_col = CAST(0x01 AS VARBINARY(10));
GO

-- Mixed table: VARBINARY column with BINARY literal (highly selective)
SELECT varbinary_col FROM BABEL_6098_mixed_test
WHERE varbinary_col = CAST(0x01 AS BINARY(10));
GO

-- Mixed table: Both columns with cross-type conditions
SELECT binary_col, varbinary_col FROM BABEL_6098_mixed_test
WHERE binary_col = CAST(0x01 AS BINARY(10)) 
  AND varbinary_col = CAST(0x01 AS VARBINARY(10));
GO

-- Mixed table: Column-to-column with additional filter (highly selective)
SELECT binary_col, varbinary_col FROM BABEL_6098_mixed_test
WHERE binary_col = varbinary_col
  AND binary_col = CAST(0x01 AS BINARY(10));
GO

SET BABELFISH_SHOWPLAN_ALL OFF;
GO

