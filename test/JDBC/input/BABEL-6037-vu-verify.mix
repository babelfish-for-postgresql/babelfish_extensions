-- Verify ext cache was updated with ANTLR parse tree result
SELECT
    CASE WHEN antlr_parse_tree_text IS NOT NULL THEN 'CACHED' ELSE 'NOT CACHED' END AS cache_status
FROM sys.babelfish_function_ext
WHERE funcname IN ('babel_6037_mstvf', 'babel_6037_itvf') AND nspname = 'master_dbo';
GO

-- === Test 14: Enable/disable cache with OID ===
PRINT '=== Test 14: Per-function cache with OID ===';
GO

-- Verify antlr_parse_cache_enabled defaults to NULL (follow session GUC)
SELECT antlr_parse_cache_enabled FROM sys.babelfish_function_ext
WHERE funcname = 'perfunc_cache_sig' AND nspname = 'master_dbo';
GO

-- Enable cache with OID
SELECT sys.enable_antlr_parse_cache(sys.object_id('dbo.perfunc_cache_sig'), true);
GO

-- Verify antlr_parse_cache_enabled is now true
SELECT antlr_parse_cache_enabled FROM sys.babelfish_function_ext
WHERE funcname = 'perfunc_cache_sig' AND nspname = 'master_dbo';
GO

-- Turn global GUC on and execute
SELECT set_config('babelfishpg_tsql.enable_antlr_parse_cache', 'on', false);
GO

-- Stats for Test 14: Enabled (per-func=true, GUC=on, but cache empty — created with GUC off)
SELECT * FROM sys.antlr_parse_cache_stats();
GO

EXEC dbo.perfunc_cache_sig @val = 4;
GO

-- Stats for Test 14: after exec
-- expects hits=+0, misses=+1 and writes=+1 (ANTLR parsed, cache populated at EXEC)
SELECT * FROM sys.antlr_parse_cache_stats();
GO

-- Disable cache with OID
SELECT sys.enable_antlr_parse_cache(sys.object_id('dbo.perfunc_cache_sig'), false);
GO

-- Stats for Test 14: after per-func set to false (kill switch)
-- expects: evictions=+1 (cache columns NULLed out by kill switch)
SELECT * FROM sys.antlr_parse_cache_stats();
GO

-- Verify antlr_parse_cache_enabled is now false
SELECT antlr_parse_cache_enabled FROM sys.babelfish_function_ext
WHERE funcname = 'perfunc_cache_sig' AND nspname = 'master_dbo';
GO

-- Verify cache columns are NULLed out (immediate invalidation)
SELECT
    CASE WHEN antlr_parse_tree_text IS NULL THEN 'NULL' ELSE 'NOT NULL' END AS tree_text,
    CASE WHEN antlr_parse_tree_bbf_version IS NULL THEN 'NULL' ELSE 'NOT NULL' END AS bbf_version
FROM sys.babelfish_function_ext
WHERE funcname = 'perfunc_cache_sig' AND nspname = 'master_dbo';
GO

SELECT set_config('babelfishpg_tsql.enable_antlr_parse_cache', 'off', false);
GO


-- === Test 15: Mid-session per-func toggle with hash table invalidation ===
PRINT '=== Test 15: Mid-session per-func toggle (true→false→true) ===';
GO

-- Start with per-func=true, GUC off
SELECT sys.enable_antlr_parse_cache(sys.object_id('dbo.perfunc_cache_name'), true);
GO

SELECT set_config('babelfishpg_tsql.enable_antlr_parse_cache', 'off', false);
GO

-- Exec 1: per-func=true overrides GUC off → ANTLR parses, populates cache, hash entry from_cache=false
EXEC dbo.perfunc_cache_name @val = 7;
GO

-- Verify cache is populated
SELECT
    CASE WHEN antlr_parse_tree_text IS NULL THEN 'NULL' ELSE 'NOT NULL' END AS tree_text,
    antlr_parse_cache_enabled
FROM sys.babelfish_function_ext
WHERE funcname = 'perfunc_cache_name' AND nspname = 'master_dbo';
GO

-- Exec 2: hash table hit, reuses compiled function
EXEC dbo.perfunc_cache_name @val = 8;
GO

-- Now set per-func=false (kill switch) — NULLs cache columns, changes bbf_ext xmin
SELECT sys.enable_antlr_parse_cache(sys.object_id('dbo.perfunc_cache_name'), false);
GO

-- Verify cache NULLed and flag is false
SELECT
    CASE WHEN antlr_parse_tree_text IS NULL THEN 'NULL' ELSE 'NOT NULL' END AS tree_text,
    antlr_parse_cache_enabled
FROM sys.babelfish_function_ext
WHERE funcname = 'perfunc_cache_name' AND nspname = 'master_dbo';
GO

-- Exec 3: pltsql_compile detects bbf_ext changed (from_cache invalidation path)
-- → invalidate hash entry → do_compile → ANTLR reparse → function still works
-- Cache should NOT be re-populated (kill switch blocks it)
EXEC dbo.perfunc_cache_name @val = 9;
GO

-- Verify cache stays NULL (kill switch prevents re-population)
SELECT
    CASE WHEN antlr_parse_tree_text IS NULL THEN 'NULL' ELSE 'NOT NULL' END AS tree_text,
    antlr_parse_cache_enabled
FROM sys.babelfish_function_ext
WHERE funcname = 'perfunc_cache_name' AND nspname = 'master_dbo';
GO

-- Re-enable per-func=true — but same session hash table still has the function,
-- so do_compile won't run and cache won't be re-populated yet.
-- Force a new session to verify cache gets populated on fresh compile.
SELECT sys.enable_antlr_parse_cache(sys.object_id('dbo.perfunc_cache_name'), true);
GO

-- terminate-tsql-conn

-- tsql
-- New session: hash table is empty, do_compile runs, ext cache gets populated
SELECT set_config('babelfishpg_tsql.enable_antlr_parse_cache', 'off', false);
GO

EXEC dbo.perfunc_cache_name @val = 10;
GO

-- Verify cache is populated again (fresh do_compile in new session)
SELECT
    CASE WHEN antlr_parse_tree_text IS NULL THEN 'NULL' ELSE 'NOT NULL' END AS tree_text,
    antlr_parse_cache_enabled
FROM sys.babelfish_function_ext
WHERE funcname = 'perfunc_cache_name' AND nspname = 'master_dbo';
GO

-- Clean up: reset to false
SELECT sys.enable_antlr_parse_cache(sys.object_id('dbo.perfunc_cache_name'), false);
GO

SELECT set_config('babelfishpg_tsql.enable_antlr_parse_cache', 'off', false);
GO


-- === Test 16: Default behavior (antlr_parse_cache_enabled = NULL, follows session GUC) ===
PRINT '=== Test 16: Default behavior (per-func NULL = follow session GUC) ===';
GO

-- Verify antlr_parse_cache_enabled defaults to NULL (follow session GUC)
SELECT antlr_parse_cache_enabled FROM sys.babelfish_function_ext
WHERE funcname = 'perfunc_default_test' AND nspname = 'master_dbo';
GO

-- With global GUC on, NULL per-func follows GUC → cache gets populated
SELECT set_config('babelfishpg_tsql.enable_antlr_parse_cache', 'on', false);
GO

EXEC dbo.perfunc_default_test @val = 1;
GO

-- Verify cache columns are populated (NULL follows GUC which is ON)
SELECT
    CASE WHEN antlr_parse_tree_text IS NULL THEN 'NULL' ELSE 'NOT NULL' END AS tree_text
FROM sys.babelfish_function_ext
WHERE funcname = 'perfunc_default_test' AND nspname = 'master_dbo';
GO

SELECT set_config('babelfishpg_tsql.enable_antlr_parse_cache', 'off', false);
GO

-- === Test 17: NULL reset — set per-func to NULL explicitly, verify it follows GUC ===
PRINT '=== Test 17: NULL reset (per-func NULL = follow GUC) ===';
GO

-- Set per-func flag to NULL explicitly (should already be NULL, but test the API)
SELECT sys.enable_antlr_parse_cache(sys.object_id('dbo.perfunc_default_test'), NULL);
GO

-- Verify antlr_parse_cache_enabled is NULL
SELECT antlr_parse_cache_enabled FROM sys.babelfish_function_ext
WHERE funcname = 'perfunc_default_test' AND nspname = 'master_dbo';
GO

-- GUC ON, per-func NULL — should follow GUC and populate cache
