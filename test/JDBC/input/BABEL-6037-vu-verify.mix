-- Verify cache columns were NULLed out by the kill switch
SELECT
    CASE WHEN antlr_parse_tree_text IS NULL THEN 'NULL' ELSE 'NOT NULL' END AS tree_text
FROM sys.babelfish_function_ext
WHERE funcname = 'perfunc_default_test' AND nspname = 'master_dbo';
GO

-- Turn GUC ON — per-func false should still block caching
SELECT set_config('babelfishpg_tsql.enable_antlr_parse_cache', 'on', false);
GO

EXEC dbo.perfunc_default_test @val = 4;
GO

-- Verify cache is still NOT populated (kill switch prevents re-population)
SELECT
    CASE WHEN antlr_parse_tree_text IS NULL THEN 'NULL' ELSE 'NOT NULL' END AS tree_text
FROM sys.babelfish_function_ext
WHERE funcname = 'perfunc_default_test' AND nspname = 'master_dbo';
GO

SELECT set_config('babelfishpg_tsql.enable_antlr_parse_cache', 'off', false);
GO


-- === Test 18: Invalid function identifier handling ===
