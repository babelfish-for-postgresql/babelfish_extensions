GO
SELECT * FROM dbo.babel_6037_mstvf(10);
GO
PRINT 'exec 2: babel_6037_mstvf';
GO
SELECT * FROM dbo.babel_6037_mstvf(20);
GO

PRINT '=== Test 13b: ITVF ===';
GO
PRINT 'exec 1: babel_6037_itvf';
GO
SELECT * FROM dbo.babel_6037_itvf(10);
GO
PRINT 'exec 2: babel_6037_itvf';
GO
