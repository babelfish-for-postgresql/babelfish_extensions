-- === Test 25: Nested EXEC — cached proc calling cached proc ===
PRINT '=== Test 25: Nested EXEC ===';
GO

SELECT set_config('babelfishpg_tsql.enable_antlr_parse_cache', 'on', false);
GO

-- Execute outer proc (which calls inner proc)
EXEC dbo.outer_cached_proc @y = 42;
GO

-- Verify both are cached
SELECT funcname,
    CASE WHEN antlr_parse_tree_text IS NOT NULL THEN 'CACHED' ELSE 'NOT CACHED' END AS cache_status
FROM sys.babelfish_function_ext
WHERE funcname IN ('inner_cached_proc', 'outer_cached_proc') AND nspname = 'master_dbo'
ORDER BY funcname;
GO

SELECT set_config('babelfishpg_tsql.enable_antlr_parse_cache', 'off', false);
GO


-- === Test 26: Altered/renamed dependency ===
PRINT '=== Test 26: Altered/renamed dependency ===';
GO

SELECT set_config('babelfishpg_tsql.enable_antlr_parse_cache', 'on', false);
GO

-- First exec: uses cached proc from CREATE time
EXEC dbo.dep_rename_proc;
GO

-- ALTER the dependency table (add new column)
ALTER TABLE dbo.dep_rename_table ADD description VARCHAR(100);
GO

-- Exec after ALTER: should still work (proc selects specific columns)
EXEC dbo.dep_rename_proc;
GO

-- RENAME column of dependency table (rename queried column)
EXEC sp_rename 'dep_rename_table.val', 'value', 'COLUMN';
GO

-- Exec after column rename: should fail (column "val" no longer exists)
EXEC dbo.dep_rename_proc;
GO

-- Rename the dependency table
EXEC sp_rename 'dep_rename_table', 'dep_renameD_table', 'OBJECT';
GO

-- Exec after table rename: should fail (table "dep_rename_table" no longer exists)
EXEC dbo.dep_rename_proc;
GO

-- Rename back
EXEC sp_rename 'dbo.dep_renameD_table', 'dep_rename_table', 'OBJECT';
GO
EXEC sp_rename 'dep_rename_table.value', 'val', 'COLUMN';
GO

SELECT
    CASE WHEN antlr_parse_tree_text IS NOT NULL THEN 'CACHED' ELSE 'NOT CACHED' END AS cache_status,
    antlr_parse_cache_enabled 
FROM sys.babelfish_function_ext
WHERE funcname = 'dep_rename_proc';
GO

-- Exec after rename back: should work again
EXEC dbo.dep_rename_proc;
GO

SELECT
    CASE WHEN antlr_parse_tree_text IS NOT NULL THEN 'CACHED' ELSE 'NOT CACHED' END AS cache_status,
    antlr_parse_cache_enabled 
FROM sys.babelfish_function_ext
WHERE funcname = 'dep_rename_proc';
GO

SELECT set_config('babelfishpg_tsql.enable_antlr_parse_cache', 'off', false);
GO

-- Test 27: Corrupt cache deserialization error handling
-- Corrupt the cached parse tree text by prepending invalid data,
-- then exec the function — should get an error (not silent failure)

-- psql
-- Corrupt the cache entry directly via psql (sysadmin has UPDATE permission) 
SET allow_system_table_mods = ON;
UPDATE sys.babelfish_function_ext SET antlr_parse_tree_text = '<>CORRUPTED'
WHERE funcname = 'corrupt_cache_test_func' AND nspname = 'master_dbo';
SET allow_system_table_mods = OFF;
GO

-- tsql
-- Enable cache and try to execute — deserialization should fail with error
SELECT set_config('babelfishpg_tsql.enable_antlr_parse_cache', 'on', false);
GO

-- Stats for Test 27: Before Deserialization error
SELECT cache_errors FROM sys.antlr_parse_cache_stats();
GO

-- This should error because the cached tree is corrupt
SELECT dbo.corrupt_cache_test_func(5);
GO

-- Stats for Test 27: After Deserialization error
-- expects: errors=+1
SELECT cache_errors FROM sys.antlr_parse_cache_stats();
GO

-- After disabling cache, function should work normally via ANTLR
SELECT set_config('babelfishpg_tsql.enable_antlr_parse_cache', 'off', false);
GO

SELECT dbo.corrupt_cache_test_func(5);
GO

-- === Test 28: Version mismatch — cached tree with higher bbf_version ===
PRINT '=== Test 28: Version mismatch (higher bbf_version) ===';
GO

-- Verify cache is populated
SELECT
    CASE WHEN antlr_parse_tree_text IS NOT NULL THEN 'CACHED' ELSE 'NOT CACHED' END AS cache_status
FROM sys.babelfish_function_ext
WHERE funcname = 'version_mismatch' AND nspname = 'master_dbo';
GO

-- psql
-- Update bbf_version to a higher version to simulate a version change
SET allow_system_table_mods = ON;
UPDATE sys.babelfish_function_ext SET antlr_parse_tree_bbf_version = '99.99.0'
WHERE funcname = 'version_mismatch' AND nspname = 'master_dbo';
SET allow_system_table_mods = OFF;
GO

-- tsql
-- terminate-tsql-conn

-- tsql
-- New session: hash table is empty, do_compile runs, reads cache entry,
-- detects version mismatch (99.99.0 != current), skips cache, ANTLR re-parses.
-- Procedure should still execute correctly.
SELECT set_config('babelfishpg_tsql.enable_antlr_parse_cache', 'on', false);
GO

EXEC dbo.version_mismatch @val = 42;
GO

-- Verify the cache was re-populated with the current bbf_version (not 99.99.0)
SELECT
    CASE WHEN antlr_parse_tree_text IS NOT NULL THEN 'CACHED' ELSE 'NOT CACHED' END AS cache_status,
    CASE WHEN antlr_parse_tree_bbf_version = '99.99.0' THEN 'STALE' ELSE 'CURRENT' END AS version_status
FROM sys.babelfish_function_ext
WHERE funcname = 'version_mismatch' AND nspname = 'master_dbo';
GO

SELECT set_config('babelfishpg_tsql.enable_antlr_parse_cache', 'off', false);
GO

-- === Test 29: DBCC CHECKIDENT procedure with cache on (unsupported node)===
PRINT '=== Test 29: DBCC CHECKIDENT with cache on ===';
GO

SELECT set_config('babelfishpg_tsql.enable_antlr_parse_cache', 'on', false);
GO

CREATE TABLE dbo.dbcc_test_table (id INT IDENTITY(1,1), val VARCHAR(50));
GO

-- Stats for Test 29: BEFORE create procedure with the only unsupported PLtsql node
SELECT cache_writes, cache_errors FROM sys.antlr_parse_cache_stats();
GO

CREATE PROCEDURE dbo.dbcc_checkident_proc
AS
    DBCC CHECKIDENT('dbo.dbcc_test_table', RESEED, 100);
GO

-- Stats for Test 29: AFTER create procedure with the only unsupported PLtsql node
-- expects only increment to cache_errors
SELECT cache_writes, cache_errors FROM sys.antlr_parse_cache_stats();
GO

SELECT set_config('babelfishpg_tsql.enable_antlr_parse_cache', 'off', false);
GO

PRINT '=== All verification tests completed ===';
GO
