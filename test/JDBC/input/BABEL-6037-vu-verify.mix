-- GUC OFF but per-func true — should still use/populate cache
EXEC dbo.perfunc_default_test @val = 3;
GO

-- Verify cache IS populated (per-func true overrides GUC off)
SELECT
    CASE WHEN antlr_parse_tree_text IS NULL THEN 'NULL' ELSE 'NOT NULL' END AS tree_text
FROM sys.babelfish_function_ext
WHERE funcname = 'perfunc_default_test' AND nspname = 'master_dbo';
GO

-- === Test 17c: Kill switch — per-func false blocks caching when GUC ON ===
PRINT '=== Test 17c: Kill switch (per-func false + GUC on = no cache) ===';
GO

-- Set per-func to false (kill switch) — also NULLs out cache columns
SELECT sys.enable_antlr_parse_cache(sys.object_id('dbo.perfunc_default_test'), false);
GO

-- Verify antlr_parse_cache_enabled is false
SELECT antlr_parse_cache_enabled FROM sys.babelfish_function_ext
WHERE funcname = 'perfunc_default_test' AND nspname = 'master_dbo';
