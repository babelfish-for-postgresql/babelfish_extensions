-- tsql
-- Same scenario over TDS: without the fix the doc column comes back empty.
SELECT set_config('temp_buffers', '1MB', 'false');
GO

DECLARE @h int;
DECLARE @doc nvarchar(max) = N'<root xmlns:ns="urn:t">' + REPLICATE(CAST(N'<ns:item id="1">abcdefghij</ns:item>' AS nvarchar(max)), 30) + N'</root>';
EXEC sp_xml_preparedocument @h OUTPUT, @doc, N'<root xmlns:ns="urn:t"/>';
CREATE TABLE #big (a int, b int, c int, d int);
INSERT INTO #big SELECT TOP 200000 1, 2, 3, 4 FROM sys.all_objects o1 CROSS JOIN sys.all_objects o2;
SELECT sys.tsql_openxml_get_xmldoc(@h) AS doc, (SELECT COUNT(*) FROM #big) AS big_rows;
SELECT COUNT(*) AS items, MIN(id) AS min_id, MAX(v) AS v
FROM OPENXML(@h, '/root/ns:item', 1) WITH (id int '@id', v varchar(20) 'text()');
EXEC sp_xml_removedocument @h;
DROP TABLE #big;
GO

-- psql
-- BABEL-7195: tsql_openxml_get_xmldoc() must not return a pointer into a
-- buffer page that is unpinned before the xml value is sent to the client.
-- The document is small enough to be stored inline, and the scan of "big"
-- (larger than temp_buffers) recycles that page before printtup runs.
-- temp_buffers must be set before the session's first temp table access.
set temp_buffers = '1MB';
GO

begin;
GO

call sys.sp_xml_preparedocument(null,
  ('<root>' || repeat('<item id="1">abcdefghij</item>', 30) || '</root>')::xml, null);
GO

create temp table big (g int, pad text);
GO

alter table big alter column pad set storage plain;
GO

insert into big select g, repeat('x', 8000) from generate_series(1, 500) g;
GO

select sys.tsql_openxml_get_xmldoc(1), (select count(*) from big);
GO

rollback;
GO
