-- psql
-- get total number of columns whose datatype is datetime
SELECT 
    n.nspname as schema_name,
    t.relname as table_name,
    a.attname as column_name
FROM pg_class t
JOIN pg_namespace n ON t.relnamespace = n.oid
JOIN pg_attribute a ON t.oid = a.attrelid
JOIN pg_type pt ON a.atttypid = pt.oid
WHERE pt.typname = 'datetime'
    AND (t.relkind = 'r' OR t.relkind = 'p')
    AND NOT a.attisdropped
    AND a.attnum > 0
    AND n.nspname <> 'sys'
ORDER BY n.nspname, t.relname, a.attname;
GO

-- get the columns whose datatype is datetime for a specific table
SELECT 
    n.nspname as schema_name,
    t.relname as table_name,
    a.attname as column_name
FROM pg_class t
JOIN pg_namespace n ON t.relnamespace = n.oid
JOIN pg_attribute a ON t.oid = a.attrelid
JOIN pg_type pt ON a.atttypid = pt.oid
WHERE pt.typname = 'datetime'
    AND (t.relkind = 'r' OR t.relkind = 'p')
    AND NOT a.attisdropped
    AND a.attnum > 0
    AND t.relname = 'datetime_test'  
    AND n.nspname = 'master_dbo'  
ORDER BY a.attname;
GO

-- get the number of rows which would be modified for a specific table
CREATE OR REPLACE FUNCTION check_datetime_rounding_for_table(
    p_schema_name text,
    p_table_name text
)
RETURNS TABLE (
    column_name text,
    total_rows bigint,
    affected_rows bigint,
    original_value sys.datetime,
    new_value sys.datetime
) AS $$
DECLARE
    v_sql text;
    v_column record;
BEGIN
    -- For each datetime column in the specified table
    FOR v_column IN
        SELECT a.attname
        FROM pg_class t
        JOIN pg_namespace n ON t.relnamespace = n.oid
        JOIN pg_attribute a ON t.oid = a.attrelid
        JOIN pg_type pt ON a.atttypid = pt.oid
        WHERE pt.typname = 'datetime'
            AND (t.relkind = 'r' OR t.relkind = 'p')
            AND NOT a.attisdropped
            AND a.attnum > 0
            AND t.relname = p_table_name
            AND n.nspname = p_schema_name
    LOOP
        -- First get the counts
        EXECUTE format(
            'SELECT 
                %L::text,
                COUNT(*)::bigint,
                COUNT(*) FILTER (WHERE %I <> CAST(CAST(%I AS sys.VARCHAR) AS sys.DATETIME))::bigint,
                NULL::sys.datetime,
                NULL::sys.datetime
            FROM %I.%I
            UNION ALL
            SELECT 
                %L::text,
                NULL::bigint,
                NULL::bigint,
                %I,
                CAST(CAST(%I AS sys.VARCHAR) AS sys.DATETIME)
            FROM %I.%I
            WHERE %I <> CAST(CAST(%I AS sys.VARCHAR) AS sys.DATETIME)',
            v_column.attname,
            v_column.attname, v_column.attname,
            p_schema_name, p_table_name,
            v_column.attname,
            v_column.attname,
            v_column.attname,
            p_schema_name, p_table_name,
            v_column.attname, v_column.attname
        ) INTO column_name, total_rows, affected_rows, original_value, new_value;
        
        RETURN NEXT;
    END LOOP;
END;
$$ LANGUAGE plpgsql;
GO

SELECT * FROM check_datetime_rounding_for_table('master_dbo', 'datetime_test');
GO

-- obtain statistics from all tables 
DO $$
DECLARE
    v_sql text := '';
    v_count_sql text := '';
    datetime_typoid oid;
    r record;
    affected_count bigint;
    total_count bigint;
    has_affected_rows boolean := false;
BEGIN
    -- Get the OID for datetime type
    SELECT oid INTO datetime_typoid 
    FROM pg_type 
    WHERE typname = 'datetime';

    -- Create the query for affected rows
    SELECT string_agg(
        format(
            'SELECT %L AS table_name, %L AS column_name, 
             COUNT(*) as total_rows,
             COUNT(*) FILTER (WHERE %I <> CAST(CAST(%I AS sys.VARCHAR) AS sys.DATETIME)) as affected_rows
             FROM %s.%I',
            t.relname,
            c.attname,
            c.attname,
            c.attname,
            t.relnamespace::regnamespace,
            t.relname
        ),
        ' UNION ALL '
    )
    INTO v_count_sql
    FROM pg_class t
    JOIN pg_namespace n ON t.relnamespace = n.oid
    JOIN pg_attribute c ON t.oid = c.attrelid
    WHERE c.atttypid = datetime_typoid
        AND (t.relkind = 'r' OR t.relkind = 'p')
        AND c.attnum > 0
        AND NOT c.attisdropped
        AND n.nspname <> 'sys';  -- Only master_dbo schema

    -- Create the query for affected values
    SELECT string_agg(
        format(
            'SELECT %L AS table_name, %L AS column_name, 
             %I AS original_value, 
             CAST(CAST(%I AS sys.VARCHAR) AS sys.DATETIME) as new_value 
             FROM %s.%I 
             WHERE %I <> CAST(CAST(%I AS sys.VARCHAR) AS sys.DATETIME)',
            t.relname,
            c.attname,
            c.attname,
            c.attname,
            t.relnamespace::regnamespace,
            t.relname,
            c.attname,
            c.attname
        ),
        ' UNION ALL '
    )
    INTO v_sql
    FROM pg_class t
    JOIN pg_namespace n ON t.relnamespace = n.oid
    JOIN pg_attribute c ON t.oid = c.attrelid
    WHERE c.atttypid = datetime_typoid
        AND (t.relkind = 'r' OR t.relkind = 'p')
        AND c.attnum > 0
        AND NOT c.attisdropped
        AND n.nspname <> 'sys';  -- Only master_dbo schema

    IF v_count_sql IS NULL THEN
        RAISE NOTICE 'No datetime columns found in the database.';
    ELSE
        -- Execute the count query
        FOR r IN EXECUTE v_count_sql
        LOOP
            IF r.affected_rows > 0 THEN  -- Only show if there are affected rows
                has_affected_rows := true;
                RAISE NOTICE 'Table: %, Column: %, Total Rows: %, Affected Rows: %',
                    r.table_name, r.column_name, r.total_rows, r.affected_rows;
            END IF;
        END LOOP;

        -- Execute the query for affected values
        IF NOT has_affected_rows THEN
            RAISE NOTICE 'No rows need to be modified.';
        ELSE
            IF v_sql IS NOT NULL THEN
                RAISE NOTICE '--- Detailed Changes ---';
                FOR r IN EXECUTE v_sql
                LOOP
                    RAISE NOTICE 'Table: %, Column: %, Original Value: %, New Value: %',
                        r.table_name, r.column_name, r.original_value, r.new_value;
                END LOOP;
            END IF;
        END IF;
    END IF;
END;
$$;
GO

-- procedure for all use case
CREATE OR REPLACE PROCEDURE datetime_rounding_handler(
    p_action text DEFAULT NULL,           -- 'list', 'check', 'update'
    p_schema_name text DEFAULT NULL,      -- schema name, NULL for all schemas
    p_table_name text DEFAULT NULL,       -- table name, NULL for all tables
    p_commit_after_table boolean DEFAULT true  -- commit after each table for updates
)
LANGUAGE plpgsql
AS $$
DECLARE
    v_sql text;
    v_datetime_typoid oid;
    r record;
    r2 record;  -- Added explicit declaration for second loop variable
    v_affected_count bigint;
    v_table_count int := 0;
BEGIN
    -- Get datetime type OID
    SELECT oid INTO v_datetime_typoid 
    FROM pg_type 
    WHERE typname = 'datetime';

    -- Show help if no action specified
    IF p_action IS NULL THEN
        RAISE NOTICE 'Usage: CALL datetime_rounding_handler(p_action, p_schema_name, p_table_name, p_commit_after_table)';
        RAISE NOTICE 'Actions:';
        RAISE NOTICE '  list   - List all tables and columns with datetime type';
        RAISE NOTICE '  check  - Check for values that need rounding';
        RAISE NOTICE '  update - Update affected values (requires schema and table names unless "all" specified)';
        RETURN;
    END IF;

    -- Validate action
    IF p_action NOT IN ('list', 'check', 'update') THEN
        RAISE EXCEPTION 'Invalid action. Valid actions are: list, check, update';
    END IF;

    -- For update action, validate parameters
    IF p_action = 'update' AND p_schema_name IS NULL AND p_table_name != 'all' THEN
        RAISE EXCEPTION 'Schema name is required for update action unless table_name is "all"';
    END IF;

    -- Create temporary table for datetime columns
    CREATE TEMP TABLE IF NOT EXISTS temp_datetime_columns (
        schema_name text,
        table_name text,
        column_name text
    );

    -- Populate temporary table
    INSERT INTO temp_datetime_columns
    SELECT 
        n.nspname as schema_name,
        t.relname as table_name,
        a.attname as column_name
    FROM pg_class t
    JOIN pg_namespace n ON t.relnamespace = n.oid
    JOIN pg_attribute a ON t.oid = a.attrelid
    WHERE a.atttypid = v_datetime_typoid
        AND t.relkind = 'r'
        AND NOT a.attisdropped
        AND a.attnum > 0
        AND (p_schema_name IS NULL OR n.nspname = p_schema_name)
        AND (p_table_name IS NULL OR p_table_name = 'all' OR t.relname = p_table_name)
        AND n.nspname NOT IN ('sys', 'information_schema', 'pg_catalog');

    IF NOT EXISTS (SELECT 1 FROM temp_datetime_columns) THEN
        RAISE NOTICE 'No datetime columns found matching the specified criteria.';
        DROP TABLE temp_datetime_columns;
        RETURN;
    END IF;

    -- LIST action
    IF p_action = 'list' THEN
        FOR r IN (
            SELECT 
                schema_name,
                table_name,
                string_agg(column_name, ', ') as datetime_columns
            FROM temp_datetime_columns
            GROUP BY schema_name, table_name
            ORDER BY schema_name, table_name
        )
        LOOP
            RAISE NOTICE 'Schema: %, Table: %, Datetime Columns: %',
                r.schema_name, r.table_name, r.datetime_columns;
        END LOOP;
        DROP TABLE temp_datetime_columns;
        RETURN;
    END IF;

    -- CHECK or UPDATE action
    FOR r IN (
        SELECT * FROM temp_datetime_columns ORDER BY schema_name, table_name, column_name
    )
    LOOP
        v_table_count := v_table_count + 1;

        IF p_action = 'check' THEN
            EXECUTE format(
                'SELECT COUNT(*) FROM %I.%I WHERE %I <> CAST(CAST(%I AS sys.VARCHAR) AS sys.DATETIME)',
                r.schema_name, r.table_name, r.column_name, r.column_name
            ) INTO v_affected_count;

            IF v_affected_count > 0 THEN
                RAISE NOTICE 'Schema: %, Table: %, Column: %, Affected Rows: %',
                    r.schema_name, r.table_name, r.column_name, v_affected_count;

                -- Show sample of affected values
                FOR r2 IN EXECUTE format(
                    'SELECT %I as original_value, 
                            CAST(CAST(%I AS sys.VARCHAR) AS sys.DATETIME) as new_value 
                     FROM %I.%I 
                     WHERE %I <> CAST(CAST(%I AS sys.VARCHAR) AS sys.DATETIME) 
                     LIMIT 5',
                    r.column_name, r.column_name,
                    r.schema_name, r.table_name,
                    r.column_name, r.column_name
                )
                LOOP
                    RAISE NOTICE 'Original: %, New: %', r2.original_value, r2.new_value;
                END LOOP;
            END IF;

        ELSIF p_action = 'update' THEN
            RAISE NOTICE 'Processing table: %.%', r.schema_name, r.table_name;
            
            EXECUTE format(
                'UPDATE %I.%I 
                 SET %I = CAST(CAST(%I AS sys.VARCHAR) AS sys.DATETIME)
                 WHERE %I <> CAST(CAST(%I AS sys.VARCHAR) AS sys.DATETIME)',
                r.schema_name, r.table_name,
                r.column_name, r.column_name,
                r.column_name, r.column_name
            );

            GET DIAGNOSTICS v_affected_count = ROW_COUNT;
            RAISE NOTICE 'Updated % rows in %.%.%',
                v_affected_count, r.schema_name, r.table_name, r.column_name;

            IF p_commit_after_table THEN
                COMMIT;
                RAISE NOTICE 'Committed changes for table %.%', r.schema_name, r.table_name;
            END IF;
        END IF;
    END LOOP;

    IF v_table_count = 0 THEN
        RAISE NOTICE 'No tables found matching the specified criteria.';
    ELSIF p_action = 'update' AND NOT p_commit_after_table THEN
        COMMIT;
        RAISE NOTICE 'Final commit performed.';
    END IF;

    DROP TABLE temp_datetime_columns;
END;
$$;
GO

-- Show help
CALL datetime_rounding_handler();

-- List all tables with datetime columns
CALL datetime_rounding_handler('list');

-- Check specific schema/table
CALL datetime_rounding_handler('check', 'master_dbo', 'datetime_test');

-- Check all tables
CALL datetime_rounding_handler('check', NULL, 'all');

-- Update specific table
CALL datetime_rounding_handler('update', 'master_dbo', 'datetime_test');

-- Update all tables (use with caution)
CALL datetime_rounding_handler('update', NULL, 'all');

-- tsql
DECLARE @sql NVARCHAR(MAX) = '';

SELECT @sql = @sql + 
    'SELECT ''' + t.TABLE_NAME + ''' as table_name, ''' + 
    c.COLUMN_NAME + ''' as column_name, ' + 
    c.COLUMN_NAME + ' as original_value, ' +
    'CAST(CAST(' + c.COLUMN_NAME + ' AS VARCHAR) AS DATETIME) as new_value ' +
    'FROM ' + t.TABLE_SCHEMA + '.' + t.TABLE_NAME + ' ' +
    'WHERE ' + c.COLUMN_NAME + ' <> CAST(CAST(' + c.COLUMN_NAME + ' AS VARCHAR) AS DATETIME) UNION ALL '
FROM 
    INFORMATION_SCHEMA.TABLES t
JOIN 
    INFORMATION_SCHEMA.COLUMNS c ON t.TABLE_SCHEMA = c.TABLE_SCHEMA 
    AND t.TABLE_NAME = c.TABLE_NAME
WHERE 
    c.DATA_TYPE = 'datetime'
    AND t.TABLE_TYPE = 'BASE TABLE';

-- Remove the last UNION ALL
SET @sql = LEFT(@sql, LEN(@sql) - 10);

EXEC sp_executesql @sql;
GO


