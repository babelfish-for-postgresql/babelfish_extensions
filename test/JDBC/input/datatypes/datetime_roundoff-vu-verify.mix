-- tsql
-- should be updated to rounded values (workaround for existing data)
UPDATE datetime_test SET date_time1 = cast(cast(date_time1 as varchar) as datetime), date_time2 = cast(cast(date_time2 as varchar) as datetime);
GO

-- psql
SELECT * FROM master_dbo.datetime_test;
GO

-- tsql
-- UNIQUE INDEX (using primary key)
UPDATE datetime_unique_index SET datetime_unique_index_col = cast(cast(datetime_unique_index_col as varchar) as datetime);
GO

INSERT INTO datetime_unique_index VALUES('2014-03-12 12:00:34.467');
GO

TRUNCATE TABLE datetime_unique_index;
GO

INSERT INTO datetime_unique_index VALUES('2014-03-12 12:00:34.467');
GO

SELECT * FROM datetime_unique_index WHERE datetime_unique_index_col = '2014-03-12 12:00:34.466'
GO
