-- Test queries that existing applications might use
SELECT 
    'Date equality' as test_type,
    COUNT(*) as matching_records
FROM datetime_storage_test 
WHERE dt_value = '2024-01-15 10:30:45.003';
GO

SELECT 
    'Date range' as test_type,
    COUNT(*) as records_in_range
FROM datetime_storage_test 
WHERE dt_value BETWEEN '2024-01-15 10:30:45.000' AND '2024-01-15 10:30:45.010';
GO

-- Test Case 12: Cast and conversion behavior
SELECT 'Test 12: Cast and conversion verification' as test_case;
GO

SELECT 
    'Direct cast' as conversion_type,
    CAST('2024-03-12 12:00:34.466' AS DATETIME) as casted_value,
    CAST(CAST('2024-03-12 12:00:34.466' AS DATETIME) AS VARCHAR(30)) as casted_string;
GO

-- Test Case 13: Arithmetic operations
SELECT 'Test 13: Arithmetic operations verification' as test_case;
GO

DECLARE @dt1 DATETIME = '2024-03-12 12:00:34.466';
DECLARE @dt2 DATETIME = '2024-03-12 12:00:34.465';

SELECT 
    'Addition' as operation,
    @dt1 + @dt2 as result,
    CAST(@dt1 + @dt2 AS VARCHAR(30)) as result_string;

SELECT 
    'Subtraction' as operation,
    @dt1 - @dt2 as result,
    CAST(@dt1 - @dt2 AS VARCHAR(30)) as result_string;
GO

-- Summary report
SELECT 'SUMMARY: Version upgrade impact assessment' as summary_section;
GO

SELECT 
    'Total test records' as metric,
    COUNT(*) as value
FROM datetime_storage_test;
GO

SELECT 
    'Records with .000 precision' as metric,
    COUNT(*) as value
FROM datetime_storage_test
WHERE CAST(dt_value AS VARCHAR(30)) LIKE '%.000';
GO

SELECT 
    'Records with .003 precision' as metric,
    COUNT(*) as value
FROM datetime_storage_test
WHERE CAST(dt_value AS VARCHAR(30)) LIKE '%.003';
GO

SELECT 
    'Records with .007 precision' as metric,
    COUNT(*) as value
FROM datetime_storage_test
WHERE CAST(dt_value AS VARCHAR(30)) LIKE '%.007';
GO

-- BASIC UPGRADE TESTING
select date_time1, date_time2 from datetime_test where date_time1 = '2014-03-12 12:00:34.467'
GO

select date_time1, date_time2 from datetime_test where date_time1 = '2014-03-12 12:00:34.466'
GO

select date_time1, date_time2 from datetime_test where date_time1 <= '2014-03-12 12:00:34.467'
GO

select date_time1, date_time2 from datetime_test where date_time1 <= '2014-03-12 12:00:34.466'
GO

select cast('2014-03-12 12:00:34.462' as datetime)
GO
select cast('2014-03-12 12:00:34.464' as datetime)
GO
select cast('2014-03-12 12:00:34.466' as datetime)
GO
select cast('2014-03-12 12:00:34.462' as datetime) - cast('2014-03-12 12:00:34.464' as datetime)
GO
select cast('2014-03-12 12:00:34.462' as datetime) + cast('2014-03-12 12:00:34.466' as datetime)
GO

