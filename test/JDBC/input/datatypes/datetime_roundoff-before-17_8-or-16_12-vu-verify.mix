-- parallel_query_expected
-- tsql
-- Verification tests for datetime storage rounding version upgrade impact
-- This verifies the behavior after implementing storage-level rounding

SELECT 'VERIFY PHASE - Testing datetime storage rounding behavior' as test_phase;
GO

-- Test Case 1: Verify basic rounding behavior
SELECT 'Test 1: Basic rounding verification' as test_case;
GO
SELECT 
    test_name,
    dt_value as stored_value,
    CAST(dt_value AS VARCHAR(30)) as stored_string,
    description,
    CASE 
        WHEN test_name = 'basic_000' AND CAST(dt_value AS VARCHAR(30)) LIKE '%.000' THEN 'PASS'
        WHEN test_name = 'basic_001' AND CAST(dt_value AS VARCHAR(30)) LIKE '%.000' THEN 'PASS'
        WHEN test_name = 'basic_002' AND CAST(dt_value AS VARCHAR(30)) LIKE '%.003' THEN 'PASS'
        WHEN test_name = 'basic_003' AND CAST(dt_value AS VARCHAR(30)) LIKE '%.003' THEN 'PASS'
        WHEN test_name = 'basic_004' AND CAST(dt_value AS VARCHAR(30)) LIKE '%.003' THEN 'PASS'
        WHEN test_name = 'basic_005' AND CAST(dt_value AS VARCHAR(30)) LIKE '%.007' THEN 'PASS'
        WHEN test_name = 'basic_006' AND CAST(dt_value AS VARCHAR(30)) LIKE '%.007' THEN 'PASS'
        WHEN test_name = 'basic_007' AND CAST(dt_value AS VARCHAR(30)) LIKE '%.007' THEN 'PASS'
        WHEN test_name = 'basic_008' AND CAST(dt_value AS VARCHAR(30)) LIKE '%.007' THEN 'PASS'
        WHEN test_name = 'basic_009' AND CAST(dt_value AS VARCHAR(30)) LIKE '%.010' THEN 'PASS'
    END as test_result
FROM datetime_storage_test 
WHERE test_name LIKE 'basic_%'
ORDER BY test_name;
GO

-- Test Case 2: Verify edge case rollover behavior
SELECT 'Test 2: Edge case rollover verification' as test_case;
GO
SELECT 
    test_name,
    dt_value as stored_value,
    CAST(dt_value AS VARCHAR(30)) as stored_string,
    description,
    CASE 
        WHEN test_name = 'edge_second_rollover' AND DATEPART(second, dt_value) = 0 AND DATEPART(millisecond, dt_value) = 0 THEN 'PASS'
        WHEN test_name = 'edge_minute_rollover' AND DATEPART(minute, dt_value) = 0 AND DATEPART(second, dt_value) = 0 THEN 'PASS'
        WHEN test_name = 'edge_hour_rollover' AND DATEPART(hour, dt_value) = 0 AND DATEPART(minute, dt_value) = 0 THEN 'PASS'
        WHEN test_name = 'edge_day_rollover' AND DATEPART(day, dt_value) = 1 AND DATEPART(hour, dt_value) = 0 THEN 'PASS'
        ELSE 'NEEDS_REVIEW'
    END as test_result
FROM datetime_storage_test 
WHERE test_name LIKE 'edge_%'
ORDER BY test_name;
GO

-- Test Case 3: Test new datetime insertions with rounding
SELECT 'Test 3: New insertions with rounding' as test_case;
GO

-- Insert new values to test current rounding behavior
INSERT INTO datetime_storage_test (test_name, dt_value, description) VALUES
('new_466', '2024-03-12 12:00:34.466', 'Should round to .467'),
('new_149', '2024-03-12 12:00:34.149', 'Should round to .150'),
('new_555', '2024-03-12 12:00:34.555', 'Should round to .557');
GO

SELECT 
    test_name,
    dt_value,
    CAST(dt_value AS VARCHAR(30)) as stored_string,
    description
FROM datetime_storage_test 
WHERE test_name LIKE 'new_%'
ORDER BY test_name;
GO

-- Test Case 4: Comparison behavior changes
SELECT 'Test 4: Comparison behavior verification' as test_case;
GO

-- Test if values that were different before are now equal
SELECT 
    'Equality test' as comparison_type,
    COUNT(*) as total_records,
    COUNT(DISTINCT event_time) as distinct_times,
    CASE 
        WHEN COUNT(*) > COUNT(DISTINCT event_time) THEN 'VALUES_NOW_EQUAL'
        ELSE 'VALUES_STILL_DISTINCT'
    END as comparison_result
FROM datetime_comparison_test;
GO

-- Show the actual values
SELECT 
    id,
    event_time,
    CAST(event_time AS VARCHAR(30)) as time_string,
    event_type
FROM datetime_comparison_test
ORDER BY event_time, id;
GO

-- Test Case 5: Aggregation impact
SELECT 'Test 5: Aggregation behavior verification' as test_case;
GO

SELECT 
    process_time,
    CAST(process_time AS VARCHAR(30)) as time_string,
    COUNT(*) as record_count,
    SUM(amount) as total_amount,
    AVG(amount) as avg_amount
FROM datetime_aggregation_test
GROUP BY process_time
ORDER BY process_time;
GO

-- Test Case 6: Index performance impact
SELECT 'Test 6: Index behavior verification' as test_case;
GO

-- psql
ANALYZE master_dbo.datetime_index_test;
GO

