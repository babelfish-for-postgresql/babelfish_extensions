-- tsql
-- Tests for T-SQL MERGE support behind babelfishpg_tsql.enable_tsql_merge (BABEL-2920, see also BABEL-1316)
CREATE TABLE babel_2920_t (id INT PRIMARY KEY, val VARCHAR(20), qty INT)
go
CREATE TABLE babel_2920_s (id INT PRIMARY KEY, val VARCHAR(20), qty INT)
go
INSERT INTO babel_2920_t VALUES (1,'one',10),(2,'two',20),(3,'three',30)
go
INSERT INTO babel_2920_s VALUES (2,'zwei',200),(3,'three',30),(4,'four',400)
go

-- MERGE is rejected while the GUC is off (default)
MERGE INTO babel_2920_t AS t
USING babel_2920_s AS s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET val = s.val;
go

-- psql
ALTER SYSTEM SET babelfishpg_tsql.enable_tsql_merge = 'on';
SELECT pg_reload_conf();
go

SELECT pg_sleep(1);
go

-- tsql
-- full three-way MERGE
MERGE INTO babel_2920_t AS t
USING babel_2920_s AS s ON t.id = s.id
WHEN MATCHED AND s.val <> t.val THEN UPDATE SET val = s.val, qty = s.qty
WHEN NOT MATCHED BY TARGET THEN INSERT (id, val, qty) VALUES (s.id, s.val, s.qty)
WHEN NOT MATCHED BY SOURCE THEN DELETE;
SELECT @@ROWCOUNT AS merge_rowcount
go

SELECT * FROM babel_2920_t ORDER BY id
go

-- INSERT DEFAULT VALUES action
CREATE TABLE babel_2920_d (id INT DEFAULT 7, val VARCHAR(20) DEFAULT 'dflt')
go
MERGE INTO babel_2920_d AS t USING (SELECT 1 AS x) AS s ON 1 = 0
WHEN NOT MATCHED THEN INSERT DEFAULT VALUES;
SELECT * FROM babel_2920_d
go

-- table variable as MERGE target
DECLARE @tv TABLE (id INT, val VARCHAR(20))
INSERT INTO @tv VALUES (1, 'a')
MERGE INTO @tv AS t USING (SELECT 1 AS id UNION ALL SELECT 2) AS s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET val = 'matched'
WHEN NOT MATCHED THEN INSERT (id, val) VALUES (s.id, 'new');
SELECT * FROM @tv ORDER BY id
go

-- updatable view as MERGE target
CREATE VIEW babel_2920_v AS SELECT id, val, qty FROM babel_2920_t
go
MERGE INTO babel_2920_v AS t USING (SELECT 2 AS id, 'via_view' AS val) AS s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET val = s.val;
SELECT id, val FROM babel_2920_t WHERE id = 2
go

-- view with a T-SQL INSTEAD OF trigger is rejected as MERGE target (trigger cannot be bypassed)
CREATE TABLE babel_2920_iot (id INT PRIMARY KEY, val VARCHAR(20))
go
INSERT INTO babel_2920_iot VALUES (1, 'orig')
go
CREATE VIEW babel_2920_iotv AS SELECT id, val FROM babel_2920_iot
go
CREATE TRIGGER babel_2920_iottr ON babel_2920_iotv INSTEAD OF UPDATE AS UPDATE babel_2920_iot SET val = 'fromtrigger'
go
MERGE INTO babel_2920_iotv AS t USING (SELECT 1 AS id) AS s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET val = 'direct';
go
SELECT val FROM babel_2920_iot
go

-- source and target remain usable as identifiers
CREATE TABLE babel_2920_kw (source INT, target INT)
go
INSERT INTO babel_2920_kw (source, target) VALUES (1, 2)
go
SELECT source, target FROM babel_2920_kw
go
SELECT k.source AS source, k.target AS target FROM babel_2920_kw AS k
go
DROP TABLE babel_2920_kw
go

-- schema-qualified target and source
MERGE INTO dbo.babel_2920_t AS t
USING dbo.babel_2920_s AS s ON t.id = s.id
WHEN MATCHED AND t.id = 3 THEN UPDATE SET val = 'dbo_q';
SELECT val FROM babel_2920_t WHERE id = 3
go

-- source joining the target table to itself
CREATE TABLE babel_2920_emp (id INT PRIMARY KEY, mgr INT, nm VARCHAR(20))
go
INSERT INTO babel_2920_emp VALUES (1, NULL, 'ceo'), (2, 1, 'dev'), (3, 1, 'ops')
go
MERGE INTO babel_2920_emp AS t
USING (SELECT a.id, b.nm AS mgrname FROM babel_2920_emp a JOIN babel_2920_emp b ON a.mgr = b.id) AS s
ON t.id = s.id
WHEN MATCHED THEN UPDATE SET nm = s.mgrname;
SELECT * FROM babel_2920_emp ORDER BY id
go

-- LEFT JOIN source with a window function
MERGE INTO babel_2920_emp AS t
USING (SELECT e.id, COUNT(*) OVER (PARTITION BY e.mgr) AS cnt
       FROM babel_2920_emp e LEFT JOIN babel_2920_emp m ON e.mgr = m.id) AS s
ON t.id = s.id
WHEN MATCHED AND s.cnt > 1 THEN UPDATE SET nm = 'peer';
SELECT * FROM babel_2920_emp ORDER BY id
go

-- CTE as source
WITH src AS (SELECT 9 AS id, 'cte' AS nm)
MERGE INTO babel_2920_emp AS t USING src AS s ON t.id = s.id
WHEN NOT MATCHED THEN INSERT (id, mgr, nm) VALUES (s.id, NULL, s.nm);
SELECT nm FROM babel_2920_emp WHERE id = 9
go

-- view as source
CREATE VIEW babel_2920_srcv AS SELECT id, val FROM babel_2920_s
go
MERGE INTO babel_2920_t AS t USING babel_2920_srcv AS s ON t.id = s.id
WHEN MATCHED AND t.id = 4 THEN UPDATE SET val = s.val;
SELECT val FROM babel_2920_t WHERE id = 4
go

-- sp_executesql with parameters
EXEC sp_executesql N'MERGE INTO babel_2920_t AS t USING (SELECT @p1 AS id, @p2 AS v) AS s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET val = s.v
WHEN NOT MATCHED THEN INSERT (id, val, qty) VALUES (s.id, s.v, 0);',
N'@p1 INT, @p2 VARCHAR(20)', @p1 = 300, @p2 = N'dynamic'
go
SELECT id, val FROM babel_2920_t WHERE id = 300
go

-- constraint violation rolls back the whole MERGE atomically (TRY/CATCH)
CREATE TABLE babel_2920_chk (id INT PRIMARY KEY, val INT CHECK (val > 0))
go
INSERT INTO babel_2920_chk VALUES (1, 10), (2, 20)
go
BEGIN TRY
    MERGE INTO babel_2920_chk AS t
    USING (SELECT 1 AS id, 99 AS val UNION ALL SELECT 3, -1) AS s ON t.id = s.id
    WHEN MATCHED THEN UPDATE SET val = s.val
    WHEN NOT MATCHED THEN INSERT (id, val) VALUES (s.id, s.val);
END TRY
BEGIN CATCH
    SELECT ERROR_NUMBER() AS caught
END CATCH
go
SELECT * FROM babel_2920_chk ORDER BY id
go

-- MERGE inside a stored procedure (upsert pattern)
CREATE PROCEDURE babel_2920_upsert @id INT, @val VARCHAR(20) AS
BEGIN
    MERGE INTO babel_2920_t AS t
    USING (SELECT @id AS id, @val AS val) AS s ON t.id = s.id
    WHEN MATCHED THEN UPDATE SET val = s.val
    WHEN NOT MATCHED THEN INSERT (id, val, qty) VALUES (s.id, s.val, 0);
    SELECT @@ROWCOUNT AS proc_rowcount
END
go
EXEC babel_2920_upsert 100, 'hundred'
go
EXEC babel_2920_upsert 100, 'HUNDRED!'
go
SELECT id, val FROM babel_2920_t WHERE id = 100
go

-- MERGE in a procedure captured via INSERT ... EXEC
CREATE TABLE babel_2920_cap (rc INT)
go
INSERT INTO babel_2920_cap EXEC babel_2920_upsert 200, 'twohundred'
go
SELECT * FROM babel_2920_cap
go
SELECT id, val FROM babel_2920_t WHERE id = 200
go
DROP TABLE babel_2920_cap
go

-- error: MERGE cannot update the same row twice
MERGE INTO babel_2920_t AS t
USING (SELECT 2 AS id UNION ALL SELECT 2) AS s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET qty = 0;
go

-- error: TOP is not supported yet
MERGE TOP (1) INTO babel_2920_t AS t USING babel_2920_s AS s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET qty = qty + 1;
go

-- error: OUTPUT is not supported yet
MERGE INTO babel_2920_t AS t USING (SELECT 3 AS id) AS s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET qty = qty
OUTPUT $action;
go

-- error: MERGE on a permanent table is not allowed inside a function
CREATE FUNCTION babel_2920_f() RETURNS INT AS
BEGIN
    MERGE INTO babel_2920_t AS t USING (SELECT 1 AS id) AS s ON t.id = s.id
    WHEN MATCHED THEN UPDATE SET qty = 0;
    RETURN 1
END
go

-- psql
ALTER SYSTEM RESET babelfishpg_tsql.enable_tsql_merge;
SELECT pg_reload_conf();
go

SELECT pg_sleep(1);
go

-- tsql
-- back to the unsupported error after turning the GUC off again
MERGE INTO babel_2920_t AS t
USING babel_2920_s AS s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET val = s.val;
go

DROP PROCEDURE babel_2920_upsert
go
DROP VIEW babel_2920_v
go
DROP VIEW babel_2920_iotv
go
DROP TABLE babel_2920_iot
go
DROP VIEW babel_2920_srcv
go
DROP TABLE babel_2920_emp
go
DROP TABLE babel_2920_chk
go
DROP TABLE babel_2920_t
go
DROP TABLE babel_2920_s
go
DROP TABLE babel_2920_d
go
