-- Multiple temp tables at once - procedure
CREATE TABLE #multiTest1(a varchar(50))
GO

CREATE TABLE #multiTest2(b nvarchar(100))
GO

EXEC sp_tablecollations_100 '#multiTest1'
GO

EXEC sp_tablecollations_100 '#multiTest2'
GO

EXEC tempdb.dbo.sp_tablecollations_100 '#multiTest1'
GO

EXEC tempdb.dbo.sp_tablecollations_100 '#multiTest2'
GO

DROP TABLE #multiTest1
GO

DROP TABLE #multiTest2
GO

-- Multiple temp tables at once - view
CREATE TABLE #viewMulti1(a varchar(50))
GO

CREATE TABLE #viewMulti2(b nvarchar(100))
GO

SELECT 'viewMulti1' as tablename, colid, name, collation_100 FROM sys.spt_tablecollations_view 
WHERE object_id = OBJECT_ID('#viewMulti1') ORDER BY colid
GO

SELECT 'viewMulti2' as tablename, colid, name, collation_100 FROM sys.spt_tablecollations_view 
WHERE object_id = OBJECT_ID('#viewMulti2') ORDER BY colid
GO

DROP TABLE #viewMulti1
GO

DROP TABLE #viewMulti2
GO

-- Non-existent temp table - procedure (should return empty)
EXEC sp_tablecollations_100 '#nonExistentTable'
GO

EXEC tempdb.dbo.sp_tablecollations_100 '#nonExistentTable'
GO

-- Non-existent temp table - view (should return empty)
SELECT colid, name, collation_100 FROM sys.spt_tablecollations_view 
WHERE object_id = OBJECT_ID('#nonExistentTable') ORDER BY colid
GO

-- Regular permanent table - procedure
CREATE TABLE babel5264_perm_table(id int, name varchar(50), description nvarchar(100))
GO

EXEC sp_tablecollations_100 'babel5264_perm_table'
GO

EXEC tempdb.dbo.sp_tablecollations_100 'dbo.babel5264_perm_table'
GO

DROP TABLE babel5264_perm_table
GO

-- Regular permanent table - view
CREATE TABLE babel5264_perm_view_test(id int, name varchar(50), description nvarchar(100))
GO

SELECT colid, name, collation_100 FROM sys.spt_tablecollations_view 
WHERE object_id = OBJECT_ID('babel5264_perm_view_test') ORDER BY colid
GO

DROP TABLE babel5264_perm_view_test
GO

-- Test babelfish_get_all_temp_table_attributes function directly
CREATE TABLE #attrTest(col1 int, col2 varchar(50), col3 nvarchar(100))
GO

SELECT attname, attnum FROM sys.babelfish_get_all_temp_table_attributes() 
WHERE attnum > 0 ORDER BY attrelid, attnum
GO

DROP TABLE #attrTest
GO

-- Test babelfish_get_all_temp_table_attributes with non-ENR temp table
CREATE TABLE #attrTestNonEnr(col1 int, col2 dbo.TestVarcharType1, col3 nvarchar(100))
GO

SELECT attname, attnum FROM sys.babelfish_get_all_temp_table_attributes() 
WHERE attnum > 0 ORDER BY attrelid, attnum
GO

DROP TABLE #attrTestNonEnr
GO

-- Test with mixed ENR and non-ENR temp tables
CREATE TABLE #mixedEnr(a varchar(50))
GO

CREATE TABLE #mixedNonEnr(b dbo.TestVarcharType1)
GO

EXEC sp_tablecollations_100 '#mixedEnr'
GO

EXEC sp_tablecollations_100 '#mixedNonEnr'
GO

SELECT colid, name, collation_100 FROM sys.spt_tablecollations_view 
WHERE object_id = OBJECT_ID('#mixedEnr') ORDER BY colid
GO

SELECT colid, name, collation_100 FROM sys.spt_tablecollations_view 
WHERE object_id = OBJECT_ID('#mixedNonEnr') ORDER BY colid
GO

DROP TABLE #mixedEnr
GO

DROP TABLE #mixedNonEnr
GO

-- View count check - should include temp tables
CREATE TABLE #countTest(a varchar(50))
GO

SELECT COUNT(*) as total_rows FROM sys.spt_tablecollations_view WHERE object_id = OBJECT_ID('#countTest')
GO

DROP TABLE #countTest
GO

-- psql
-- babelfish_get_all_temp_table_attributes on non-TDS connection (should return empty)
CREATE TEMP TABLE pg_temp_test(id int, name varchar(50), description text);
GO

SELECT COUNT(*) AS attr_count FROM sys.babelfish_get_all_temp_table_attributes();
GO

DROP TABLE pg_temp_test;
GO

-- psql
-- View query on non-TDS connection with PG temp table
CREATE TEMP TABLE pg_view_test(id int, name varchar(50));
GO

SELECT COUNT(*) AS view_count FROM sys.spt_tablecollations_view 
WHERE schema_id = pg_my_temp_schema();
GO

DROP TABLE pg_view_test;
GO

-- psql
-- PG temp table with # in name (should still return empty - not T-SQL temp table)
CREATE TEMP TABLE "#pg_hash_temp"(id int, name varchar(50));
GO

SELECT COUNT(*) AS attr_count FROM sys.babelfish_get_all_temp_table_attributes();
GO

DROP TABLE "#pg_hash_temp";
GO

-- tsql
-- Verify TDS connection returns results after psql tests
CREATE TABLE #tdsVerify(col1 varchar(50))
GO

EXEC sp_tablecollations_100 '#tdsVerify'
GO

SELECT COUNT(*) AS attr_count FROM sys.babelfish_get_all_temp_table_attributes() WHERE attnum > 0
GO

DROP TABLE #tdsVerify
GO

