-- NULL table name check
SELECT * FROM sys.sp_tablecollations_100_enr(NULL)
GO

SELECT COUNT(*) AS attr_count FROM sys.babelfish_get_temp_table_attributes(NULL)
GO

-- Empty string table name check
SELECT * FROM sys.sp_tablecollations_100_enr('')
GO

SELECT COUNT(*) AS attr_count FROM sys.babelfish_get_temp_table_attributes('')
GO

-- Non-existent temp table check
SELECT * FROM sys.sp_tablecollations_100_enr('#this_temp_table_does_not_exist')
GO

SELECT COUNT(*) AS attr_count FROM sys.babelfish_get_temp_table_attributes('#this_temp_table_does_not_exist')
GO

-- Whitespace-only table name check
SELECT * FROM sys.sp_tablecollations_100_enr('   ')
GO

SELECT COUNT(*) AS attr_count FROM sys.babelfish_get_temp_table_attributes('   ')
GO

-- Hash-only table name check
SELECT * FROM sys.sp_tablecollations_100_enr('#')
GO

SELECT COUNT(*) AS attr_count FROM sys.babelfish_get_temp_table_attributes('#')
GO

-- UDF calling temp table functions
CREATE FUNCTION dbo.babel5264_test_func(@tablename varchar(256))
RETURNS TABLE
AS
RETURN (SELECT * FROM sys.sp_tablecollations_100_enr(@tablename))
GO

CREATE TABLE #funcTest(col1 varchar(50) COLLATE SQL_Latin1_General_CP1_CI_AS)
GO

SELECT * FROM dbo.babel5264_test_func('#funcTest')
GO

DROP TABLE #funcTest
GO

DROP FUNCTION dbo.babel5264_test_func
GO

-- Insert into table from sp_tablecollations_100_enr
CREATE TABLE #insertTest(col1 varchar(50) COLLATE SQL_Latin1_General_CP1_CI_AS, col2 nvarchar(100) COLLATE SQL_Latin1_General_CP1_CI_AS)
GO

CREATE TABLE #collResult(colid int, name varchar(256), collation_name nvarchar(128))
GO

INSERT INTO #collResult SELECT * FROM sys.sp_tablecollations_100_enr('#insertTest')
GO

SELECT * FROM #collResult
GO

DROP TABLE #collResult
GO

DROP TABLE #insertTest
GO

-- T-SQL proc calling temp table functions
CREATE TABLE #procTest(col1 varchar(50) COLLATE SQL_Latin1_General_CP1_CI_AS, col2 nvarchar(100) COLLATE SQL_Latin1_General_CP1_CI_AS)
GO

EXEC dbo.babel5264_test_tsql_proc '#procTest'
GO

DROP TABLE #procTest
GO

-- psql
-- PG dialect on non-TDS connection (should return empty even with real PG temp table)
CREATE TEMP TABLE pg_temp_test(id int, name varchar(50), description text);
GO

INSERT INTO pg_temp_test VALUES (1, 'test', 'description');
GO

SELECT COUNT(*) AS attr_count FROM sys.babelfish_get_temp_table_attributes('pg_temp_test');
GO

SELECT * FROM sys.sp_tablecollations_100_enr('pg_temp_test');
GO

-- Insert specific columns from babelfish_get_temp_table_attributes (should insert 0 rows)
CREATE TEMP TABLE pg_attr_result(attrelid oid, attname name, attnum smallint, attcollation oid);
GO

INSERT INTO pg_attr_result SELECT attrelid, attname, attnum, attcollation FROM sys.babelfish_get_temp_table_attributes('pg_temp_test');
GO

SELECT COUNT(*) AS inserted_rows FROM pg_attr_result;
GO

DROP TABLE pg_attr_result;
GO

-- Insert from sp_tablecollations_100_enr (should insert 0 rows)
CREATE TEMP TABLE pg_coll_result(colid int, name varchar, collation_name varchar);
GO

INSERT INTO pg_coll_result SELECT * FROM sys.sp_tablecollations_100_enr('pg_temp_test');
GO

SELECT COUNT(*) AS inserted_rows FROM pg_coll_result;
GO

DROP TABLE pg_coll_result;
GO

DROP TABLE pg_temp_test;
GO

-- Test PG temp table with # in name
CREATE TEMP TABLE "#pg_hash_temp"(id int, name varchar(50));
GO

INSERT INTO "#pg_hash_temp" VALUES (1, 'test');
GO

SELECT COUNT(*) AS attr_count FROM sys.babelfish_get_temp_table_attributes('#pg_hash_temp');
GO

SELECT * FROM sys.sp_tablecollations_100_enr('#pg_hash_temp');
GO

DROP TABLE "#pg_hash_temp";
GO

-- Test PG regular table with # in name (should return empty - not a T-SQL temp table)
CREATE TABLE "#pg_hash_regular"(id int, name varchar(50));
GO

INSERT INTO "#pg_hash_regular" VALUES (1, 'test');
GO

SELECT COUNT(*) AS attr_count FROM sys.babelfish_get_temp_table_attributes('#pg_hash_regular');
GO

SELECT * FROM sys.sp_tablecollations_100_enr('#pg_hash_regular');
GO

DROP TABLE "#pg_hash_regular";
GO

-- Test via PL/pgSQL procedure (should return 0 for both functions)
CALL test_pg_temp_table_proc();
GO

SELECT * FROM sys.sp_tablecollations_100_enr('#nonexistent_temp');
GO

SELECT COUNT(*) AS attr_count FROM sys.babelfish_get_temp_table_attributes('#nonexistent_temp');
GO

SELECT * FROM sys.sp_tablecollations_100_enr(NULL);
GO

SELECT COUNT(*) AS attr_count FROM sys.babelfish_get_temp_table_attributes(NULL);
GO

-- tsql
-- PG dialect on TDS connection (should return results)
CREATE TABLE #pgDialectTdsTest(col1 varchar(50) COLLATE SQL_Latin1_General_CP1_CI_AS, col2 nvarchar(100) COLLATE SQL_Latin1_General_CP1_CI_AS)
GO

SELECT COUNT(*) AS tsql_result_count FROM sys.sp_tablecollations_100_enr('#pgDialectTdsTest')
GO

SELECT COUNT(*) AS tsql_attr_count FROM sys.babelfish_get_temp_table_attributes('#pgDialectTdsTest')
GO

SELECT set_config('babelfishpg_tsql.sql_dialect', 'postgres', false)
GO

SELECT COUNT(*) AS pg_dialect_tds_result_count FROM sys.sp_tablecollations_100_enr('#pgDialectTdsTest')
GO

SELECT COUNT(*) AS pg_dialect_tds_attr_count FROM sys.babelfish_get_temp_table_attributes('#pgDialectTdsTest')
GO

SELECT set_config('babelfishpg_tsql.sql_dialect', 'tsql', false)
GO

DROP TABLE #pgDialectTdsTest
GO
