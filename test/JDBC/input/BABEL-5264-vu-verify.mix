-- tsql
-- BABEL-5264: Tests for sp_tablecollations_100 with temp table support

-- Basic ENR temp table - procedure
CREATE TABLE #collTest1(id int, name varchar(50), description nvarchar(100))
GO

EXEC sp_tablecollations_100 '#collTest1'
GO

EXEC tempdb.dbo.sp_tablecollations_100 '#collTest1'
GO

DROP TABLE #collTest1
GO

-- Basic ENR temp table - view
CREATE TABLE #viewTest1(id int, name varchar(50), description nvarchar(100))
GO

SELECT colid, name, collation_100 FROM sys.spt_tablecollations_view 
WHERE object_id = OBJECT_ID('#viewTest1') ORDER BY colid
GO

DROP TABLE #viewTest1
GO

-- Temp table with various column types - procedure
CREATE TABLE #collTest2(
    a int,
    b varchar(100),
    c nvarchar(50),
    d char(5),
    e nchar(10),
    f binary(10),
    g varbinary(20)
)
GO

EXEC sp_tablecollations_100 '#collTest2'
GO

EXEC tempdb.dbo.sp_tablecollations_100 '#collTest2'
GO

DROP TABLE #collTest2
GO

-- Temp table with various column types - view
CREATE TABLE #viewTest2(
    a int,
    b varchar(100),
    c nvarchar(50),
    d char(5),
    e nchar(10),
    f binary(10),
    g varbinary(20)
)
GO

SELECT colid, name, collation_100 FROM sys.spt_tablecollations_view 
WHERE object_id = OBJECT_ID('#viewTest2') ORDER BY colid
GO

DROP TABLE #viewTest2
GO

