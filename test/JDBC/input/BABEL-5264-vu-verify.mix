EXEC sp_tablecollations_100 '#nonExistentTable'
GO

SELECT colid, name, collation_100 FROM sys.spt_tablecollations_view 
WHERE object_id = OBJECT_ID('#nonExistentTable') ORDER BY colid
GO

-- Regular permanent table
CREATE TABLE babel5264_perm_table(id int, name varchar(50) collate bbf_unicode_cp1_ci_as, description nvarchar(100) collate bbf_unicode_cp1_ci_ai)
GO

EXEC sp_tablecollations_100 'babel5264_perm_table'
GO

DROP TABLE babel5264_perm_table
GO

CREATE TABLE babel5264_perm_view_test(id int, name varchar(50) collate bbf_unicode_cp1_ci_ai, description nvarchar(100) collate bbf_unicode_cp1_ci_as)
GO

SELECT colid, name, collation_100 FROM sys.spt_tablecollations_view 
WHERE object_id = OBJECT_ID('babel5264_perm_view_test') ORDER BY colid
GO

DROP TABLE babel5264_perm_view_test
GO

-- Test babelfish_get_enr_temp_table_attributes function directly (ENR temp table)
CREATE TABLE #attrTest(col1 int, col2 varchar(50) collate bbf_unicode_cp1_ci_as, col3 nvarchar(100) collate bbf_unicode_cp1_ci_as)
GO

SELECT attname, attnum FROM sys.babelfish_get_enr_temp_table_attributes() 
WHERE attnum > 0 ORDER BY attrelid, attnum
GO

DROP TABLE #attrTest
GO

-- Test babelfish_get_enr_temp_table_attributes with non-ENR temp table
CREATE TABLE #attrTestNonEnr(col1 int, col2 dbo.TestVarcharType1 collate bbf_unicode_cp1_ci_ai, col3 nvarchar(100) collate bbf_unicode_cp1_ci_ai)
GO

SELECT attname, attnum FROM sys.babelfish_get_enr_temp_table_attributes() 
WHERE attnum > 0 ORDER BY attrelid, attnum
GO

DROP TABLE #attrTestNonEnr
GO

-- Test with mixed ENR and non-ENR temp tables
CREATE TABLE #mixedEnr(a varchar(50) collate bbf_unicode_cp1_ci_as)
GO

CREATE TABLE #mixedNonEnr(b dbo.TestVarcharType1 collate bbf_unicode_cp1_ci_ai)
GO

EXEC sp_tablecollations_100 '#mixedEnr'
GO

EXEC sp_tablecollations_100 '#mixedNonEnr'
GO

SELECT colid, name, collation_100 FROM sys.spt_tablecollations_view 
WHERE object_id = OBJECT_ID('#mixedEnr') ORDER BY colid
GO

SELECT colid, name, collation_100 FROM sys.spt_tablecollations_view 
WHERE object_id = OBJECT_ID('#mixedNonEnr') ORDER BY colid
GO

DROP TABLE #mixedEnr
GO

DROP TABLE #mixedNonEnr
GO

-- View count check - should include temp tables
CREATE TABLE #countTest(a varchar(50) collate bbf_unicode_cp1_ci_as)
GO

SELECT COUNT(*) as total_rows FROM sys.spt_tablecollations_view WHERE object_id = OBJECT_ID('#countTest')
GO

DROP TABLE #countTest
GO

-- psql
-- babelfish_get_enr_temp_table_attributes on non-TDS connection
CREATE TEMP TABLE pg_temp_test(id int, name varchar(50), description text);
GO

SELECT COUNT(*) AS attr_count FROM sys.babelfish_get_enr_temp_table_attributes();
GO

DROP TABLE pg_temp_test;
GO

-- psql
-- View query on non-TDS connection with PG temp table
CREATE TEMP TABLE pg_view_test(id int, name varchar(50));
GO

SELECT COUNT(*) AS view_count FROM sys.spt_tablecollations_view 
WHERE schema_id = pg_my_temp_schema();
GO

DROP TABLE pg_view_test;
GO

-- psql
-- PG temp table with # in name
CREATE TEMP TABLE "#pg_hash_temp"(id int, name varchar(50));
GO

SELECT COUNT(*) AS attr_count FROM sys.babelfish_get_enr_temp_table_attributes();
GO

DROP TABLE "#pg_hash_temp";
GO

-- tsql
-- Verify TDS connection returns results after psql tests
CREATE TABLE #tdsVerify(col1 varchar(50) collate bbf_unicode_cp1_ci_ai)
GO

EXEC sp_tablecollations_100 '#tdsVerify'
GO

SELECT COUNT(*) AS attr_count FROM sys.babelfish_get_enr_temp_table_attributes() WHERE attnum > 0
GO

DROP TABLE #tdsVerify
GO

