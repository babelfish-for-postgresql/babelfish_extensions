-- Multiple temp tables at once
CREATE TABLE #multiTest1(a varchar(50) collate bbf_unicode_cp1_ci_as)
GO

CREATE TABLE #multiTest2(b nvarchar(100) collate bbf_unicode_cp1_ci_ai)
GO

EXEC sp_tablecollations_100 '#multiTest1'
GO

EXEC sp_tablecollations_100 '#multiTest2'
GO

DROP TABLE #multiTest1
GO

DROP TABLE #multiTest2
GO

CREATE TABLE #viewMulti1(a varchar(50) collate bbf_unicode_cp1_ci_ai)
GO

CREATE TABLE #viewMulti2(b nvarchar(100) collate bbf_unicode_cp1_ci_as)
GO

SELECT 'viewMulti1' as tablename, colid, name, collation_100 FROM sys.spt_tablecollations_view 
WHERE object_id = OBJECT_ID('#viewMulti1') ORDER BY colid
GO

SELECT 'viewMulti2' as tablename, colid, name, collation_100 FROM sys.spt_tablecollations_view 
WHERE object_id = OBJECT_ID('#viewMulti2') ORDER BY colid
GO

DROP TABLE #viewMulti1
GO

DROP TABLE #viewMulti2
GO

