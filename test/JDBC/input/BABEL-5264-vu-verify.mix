-- tsql
-- BABEL-5264: Tests for sp_tablecollations_100 with temp table support

-- Basic ENR temp table
CREATE TABLE #collTest1(id int, name varchar(50) collate bbf_unicode_cp1_ci_as, description nvarchar(100) collate bbf_unicode_cp1_ci_ai)
GO

EXEC sp_tablecollations_100 '#collTest1'
GO

EXEC tempdb.dbo.sp_tablecollations_100 '#collTest1'
GO

SELECT attname, attnum, attlen from sys.enr_temp_table_attributes_view
GO

DROP TABLE #collTest1
GO

CREATE TABLE #viewTest1(id int, name varchar(50) collate bbf_unicode_cp1_ci_ai, description nvarchar(100) collate bbf_unicode_cp1_ci_as)
GO

SELECT colid, name, collation_100 FROM sys.spt_tablecollations_view 
WHERE object_id = OBJECT_ID('#viewTest1') ORDER BY colid
GO

EXEC tempdb.dbo.sp_tablecollations_100 '#viewTest1'
GO

DROP TABLE #viewTest1
GO

-- Temp table with various column types
CREATE TABLE #collTest2(
    a int,
    b varchar(100) collate bbf_unicode_cp1_ci_as,
    c nvarchar(50) collate bbf_unicode_cp1_ci_ai,
    d char(5) collate bbf_unicode_cp1_ci_as,
    e nchar(10) collate bbf_unicode_cp1_ci_ai,
    f binary(10),
    g varbinary(20)
)
GO

EXEC sp_tablecollations_100 '#collTest2'
GO

DROP TABLE #collTest2
GO

CREATE TABLE #viewTest2(
    a int,
    b varchar(100) collate bbf_unicode_cp1_ci_ai,
    c nvarchar(50) collate bbf_unicode_cp1_ci_as,
    d char(5) collate bbf_unicode_cp1_ci_ai,
    e nchar(10) collate bbf_unicode_cp1_ci_as,
    f binary(10),
    g varbinary(20)
)
GO

SELECT colid, name, collation_100 FROM sys.spt_tablecollations_view 
WHERE object_id = OBJECT_ID('#viewTest2') ORDER BY colid
GO

DROP TABLE #viewTest2
GO

-- Temp table with no character columns
CREATE TABLE #noCharCols(
    id int,
    amount bigint,
    price decimal(10,2),
    flag bit,
    data binary(8)
)
GO

EXEC sp_tablecollations_100 '#noCharCols'
GO

SELECT attname, attnum, attlen from sys.enr_temp_table_attributes_view
GO

DROP TABLE #noCharCols
GO

CREATE TABLE #viewNoChar(
    id int,
    amount bigint,
    price decimal(10,2)
)
GO

SELECT colid, name, collation_100 FROM sys.spt_tablecollations_view 
WHERE object_id = OBJECT_ID('#viewNoChar') ORDER BY colid
GO

DROP TABLE #viewNoChar
GO

