-- Test PL/pgSQL procedure that creates temp table (non-ENR)
EXEC dbo.psql_temp_proc
GO

SELECT colid, name, collation_100 FROM sys.spt_tablecollations_view 
WHERE object_id = OBJECT_ID('#temp1') ORDER BY colid
GO

EXEC sp_tablecollations_100 '#temp1'
GO

SELECT COUNT(*) AS enr_attr_count FROM sys.babelfish_get_enr_temp_table_attributes() WHERE attnum > 0
GO

DROP TABLE "#temp1"
GO

-- Test PL/pgSQL procedure that creates regular table
EXEC dbo.psql_reg_proc
GO

SELECT colid, name, collation_100 FROM sys.spt_tablecollations_view 
WHERE object_id = OBJECT_ID('perm1') ORDER BY colid
GO

EXEC sp_tablecollations_100 'perm1'
GO

DROP TABLE perm1
GO

-- Test PL/pgSQL procedure that creates regular table with # in name
EXEC dbo.psql_hash_proc
GO

SELECT colid, name, collation_100 FROM sys.spt_tablecollations_view 
WHERE object_id = OBJECT_ID('#table1') ORDER BY colid
GO

EXEC sp_tablecollations_100 '#table1'
GO

DROP TABLE "#table1"
GO

-- Test with multiple collations
CREATE TABLE #multiCollationTest(
    col1 varchar(50) collate "default",
    col2 varchar(50) collate Latin1_General_CI_AS,
    col3 nvarchar(50) collate Latin1_General_CS_AS,
    col4 char(20) collate bbf_unicode_cp1_ci_as,
    col5 nchar(20) collate bbf_unicode_cp1_ci_ai,
    col6 text collate bbf_unicode_cp1_cs_as,
    col7 ntext collate Polish_CI_AS,
    col8 varchar(max) collate Polish_CS_AS,
    col9 nvarchar(max) collate Modern_Spanish_CI_AS,
    col10 char(30) collate Modern_Spanish_CS_AS,
    col11 nchar(30) collate Traditional_Spanish_CI_AS,
    col12 text collate French_CI_AS,
    col13 ntext collate French_CS_AS,
    col14 varchar(100) collate Greek_CI_AS,
    col15 nvarchar(100) collate Cyrillic_General_CI_AS,
    col16 char(50) collate Hebrew_CI_AS,
    col17 nchar(50) collate Thai_CI_AS,
    col18 varchar(max) collate Japanese_CI_AS,
    col19 nvarchar(max) collate Korean_Wansung_CI_AS,
    col20 text collate Chinese_PRC_CI_AS,
    col21 ntext collate Vietnamese_CI_AS
)
GO

EXEC sp_tablecollations_100 '#multiCollationTest'
GO

SELECT colid, name, collation_100 FROM sys.spt_tablecollations_view 
WHERE object_id = OBJECT_ID('#multiCollationTest') ORDER BY colid
GO

DROP TABLE #multiCollationTest
GO
