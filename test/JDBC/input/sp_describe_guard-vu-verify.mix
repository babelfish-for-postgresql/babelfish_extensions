-- tsql
-- sp_describe_first_result_set with malformed/non-EXECSQL batches

-- Case 1: normal SELECT batch (positive path)
EXEC sp_describe_first_result_set N'SELECT 1 AS a, CAST(2 AS smallint) AS b, CAST(''hi'' AS varchar(10)) AS c'
GO

-- Case 2: empty batch
EXEC sp_describe_first_result_set N''
GO

-- Case 3: comment-only batch
EXEC sp_describe_first_result_set N'-- this is a comment only batch'
GO

-- Case 4: non-EXECSQL second statement (IF ... control-of-flow)
EXEC sp_describe_first_result_set N'IF 1=1 SELECT 1'
GO

-- Case 5: positive-path guard — confirm multi-column SELECT still returns metadata after condition tightening
EXEC sp_describe_first_result_set N'SELECT CAST(1 AS int) AS col_int, CAST(NULL AS varchar(50)) AS col_varchar'
GO
