-- tsql
CREATE DATABASE db
GO

USE db
GO

-- CS_AS
CREATE TABLE t1(a varchar(max) collate latin1_general_cs_as)

CREATE INDEX idx1 ON t1(a)

INSERT INTO t1 VALUES(CONCAT('cs', generate_series(1,10000)))
GO

-- psql
ANALYZE db_dbo.t1;
GO

-- tsql
SET BABELFISH_SHOWPLAN_ALL ON
GO

SELECT * FROM t1 WHERE a LIKE 'cs1'
GO

SELECT * FROM t1 WHERE a LIKE 'cs9999%'
GO

SET BABELFISH_SHOWPLAN_ALL OFF
GO

SELECT * FROM t1 WHERE a LIKE 'cs1'
GO

SELECT * FROM t1 WHERE a LIKE 'cs9999%'
GO

