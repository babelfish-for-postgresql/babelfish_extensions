-- psql
DROP EXTENSION IF EXISTS tds_fdw CASCADE;
GO

-- tsql
-- check if all the linked servers are dropped after dropping tds_fdw
SELECT name AS servername, query_timeout, connect_timeout FROM sys.servers WHERE name LIKE 'bbf_server%' ORDER BY name
GO

