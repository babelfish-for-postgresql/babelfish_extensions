-- tsql
-- sysdb_wd_v1 uses unqualified sysdatabases, which binds to the database's dbo.sysdatabases wrapper view
CREATE LOGIN sysdb_wd_login WITH PASSWORD = '12345678'
GO

CREATE LOGIN sysdb_wd_rlogin WITH PASSWORD = '12345678'
GO

CREATE DATABASE sysdb_wd_db
GO

USE sysdb_wd_db
GO

CREATE VIEW sysdb_wd_v1 AS SELECT name FROM sysdatabases WHERE name = 'sysdb_wd_db'
GO

CREATE VIEW sysdb_wd_v2 AS SELECT name FROM sysdb_wd_v1
GO

CREATE USER sysdb_wd_user FOR LOGIN sysdb_wd_login
GO

GRANT SELECT ON sysdb_wd_v1 TO sysdb_wd_user
GO

CREATE USER sysdb_wd_reader FOR LOGIN sysdb_wd_rlogin
GO

ALTER ROLE db_datareader ADD MEMBER sysdb_wd_reader
GO

USE master
GO
