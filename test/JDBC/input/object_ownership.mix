create function object_ownership_s3.tvf2() returns table as return (select '1' as col);
go
create function object_ownership_s3.mtvf2()
returns @result table([Id] int) AS
begin
    insert into @result values (1) return 
end
go
create type object_ownership_s3.type2 from sys.varchar(10)
go
create type object_ownership_s3.ttype2 as table (id int)
go

/***** SHOULD BE ABLE TO CREATE PARTITION TABLES **********/
create table object_ownership_s3.pt2
(
    saleid int identity(1,1),
    saledate datetime,
    amount decimal(10,2),
    customerid int,
    productid int
) on ps2(saledate);  -- specify the partitioning column
go

/*** USER SHOULD HAVE ACCESS TO THESE OBJECTS ***/
/*** SCHEMA OWNER IS A ROLE AND CURRENT USER IS A MEMBER OF THAT ROLE ***/
select * from object_ownership_s3.t;
go
select * from object_ownership_s3.v;
go
exec object_ownership_s3.p;
go
select object_ownership_s3.f();
go
insert into object_ownership_s3.t values (2, 3);
go
select next value for object_ownership_s3.sq;
go
select * from object_ownership_s3.tvf();
go
select * from object_ownership_s3.mtvf();
go
use master
go

