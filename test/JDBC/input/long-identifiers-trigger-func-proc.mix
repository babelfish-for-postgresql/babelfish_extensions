GO
DROP FUNCTION Very_Long_Function_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing;
GO
DROP FUNCTION babel5975_multi_param_func;
GO
DROP FUNCTION Very_Long_Inline_Table_Valued_Function_Name_Exceeding_Sixty_Three_Chars;
GO
DROP FUNCTION Very_Long_Multi_Statement_Table_Valued_Function_Name_Exceeding_63_Ch;
GO
DROP PROCEDURE Very_Long_Procedure_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing;
GO
