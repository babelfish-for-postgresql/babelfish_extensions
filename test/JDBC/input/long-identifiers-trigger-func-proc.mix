-- tsql
-- Setup: Create objects with long names for trigger/func/proc testing

CREATE TABLE babel5975_trigger_test_table (id INT NOT NULL, name NVARCHAR(100));
GO

CREATE FUNCTION Very_Long_Function_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing(@a INT)
RETURNS INT AS BEGIN RETURN @a + 1 END;
GO

CREATE PROCEDURE Very_Long_Procedure_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing
    @Very_Long_Parameter_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters INT
AS BEGIN SELECT @Very_Long_Parameter_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters END;
GO

CREATE TRIGGER Very_Long_Trigger_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing
ON babel5975_trigger_test_table
FOR INSERT AS BEGIN SELECT 1 END;
GO

CREATE FUNCTION babel5975_multi_param_func(
    @Very_Long_Parameter_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_P1 INT,
    @Very_Long_Parameter_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_P2 INT
) RETURNS INT AS BEGIN RETURN @Very_Long_Parameter_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_P1 + @Very_Long_Parameter_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_P2 END;
GO
-- tsql
-- Verify function name
SELECT name FROM sys.all_objects WHERE name LIKE 'Very_Long_Function_Name%' AND type = 'FN';
GO

-- Verify procedure name
SELECT name FROM sys.procedures WHERE name LIKE 'Very_Long_Procedure_Name%';
GO

-- Verify trigger name
SELECT name FROM sys.triggers WHERE name LIKE 'Very_Long_Trigger_Name%';
GO

-- Verify function execution
SELECT dbo.Very_Long_Function_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing(5);
GO

-- Verify procedure execution
EXEC Very_Long_Procedure_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing @Very_Long_Parameter_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters = 42;
GO

-- sp_rename FUNCTION
EXEC sp_rename 'Very_Long_Function_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing',
    'Very_Long_Renamed_Func_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters', 'OBJECT';
GO

-- Verify renamed function
SELECT name FROM sys.all_objects WHERE name LIKE 'Very_Long_Renamed_Func%' AND type = 'FN';
GO

-- Rename back
EXEC sp_rename 'Very_Long_Renamed_Func_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters',
    'Very_Long_Function_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing', 'OBJECT';
GO

-- Mixed case procedure
CREATE PROCEDURE MixedCase_Very_Long_Procedure_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars AS SELECT 1;
GO
SELECT name FROM sys.procedures WHERE name LIKE 'MixedCase_Very_Long_Proc%';
GO
DROP PROCEDURE MixedCase_Very_Long_Procedure_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars;
GO

-- Mixed case trigger
CREATE TABLE babel5975_trig_case_test (id INT);
GO
CREATE TRIGGER MixedCase_Very_Long_Trigger_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters
ON babel5975_trig_case_test FOR INSERT AS BEGIN SELECT 1 END;
GO
SELECT name FROM sys.triggers WHERE name LIKE 'MixedCase_Very_Long_Trig%';
GO
DROP TRIGGER MixedCase_Very_Long_Trigger_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters;
GO
DROP TABLE babel5975_trig_case_test;
GO

-- Multibyte procedure name
CREATE PROCEDURE プロシージャ_非常に長い名前_PostgreSQLの制限を超える場合のテスト AS SELECT 1;
GO
SELECT name FROM sys.procedures WHERE name LIKE 'プロシージャ%';
GO
DROP PROCEDURE プロシージャ_非常に長い名前_PostgreSQLの制限を超える場合のテスト;
GO

-- Multibyte trigger name
CREATE TABLE babel5975_trig_mb_test (id INT);
GO
CREATE TRIGGER トリガー_非常に長い名前_PostgreSQLの制限を超える場合のテスト_識別子処理
ON babel5975_trig_mb_test FOR INSERT AS BEGIN SELECT 1 END;
GO
SELECT name FROM sys.triggers WHERE name LIKE 'トリガー%';
GO
DROP TRIGGER トリガー_非常に長い名前_PostgreSQLの制限を超える場合のテスト_識別子処理;
GO
DROP TABLE babel5975_trig_mb_test;
GO

-- Bracket delimited function
CREATE FUNCTION [Very Long Function Name With Spaces That Exceeds PostgreSQL Limit Of Sixty Three Characters](@a INT)
RETURNS INT AS BEGIN RETURN @a END;
GO
SELECT orig_name FROM sys.babelfish_function_ext WHERE orig_name LIKE 'Very Long Function%';
GO
DROP FUNCTION [Very Long Function Name With Spaces That Exceeds PostgreSQL Limit Of Sixty Three Characters];
GO

-- sp_stored_procedures with long name
EXEC sp_stored_procedures @sp_name = 'Very_Long_Procedure_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing';
GO

-- BABEL-5321: sp_stored_procedures must also resolve the object when the caller
-- supplies the MD5-truncated physical name, and must return the full original
-- name in PROCEDURE_NAME. The truncated name is non-deterministic (contains an
-- MD5 hash), so compute it at runtime and assert on the returned PROCEDURE_NAME.
DECLARE @trunc_proc sys.sysname = sys.babelfish_truncate_identifier(LOWER('Very_Long_Procedure_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing'));
DECLARE @sp_res TABLE (a sys.sysname, b sys.sysname, procedure_name sys.nvarchar(134), d int, e int, f int, g sys.nvarchar(254), h smallint);
INSERT INTO @sp_res EXEC sys.sp_stored_procedures @sp_name = @trunc_proc;
SELECT procedure_name FROM @sp_res WHERE procedure_name LIKE 'Very_Long_Procedure_Name%';
GO

-- BABEL-5321 / BABEL-5975: sp_sproc_columns must display the full original
-- procedure name and match both the full and the truncated name.
-- (a) full name
SELECT DISTINCT PROCEDURE_NAME FROM sys.sp_sproc_columns_view WHERE original_procedure_name LIKE 'Very_Long_Procedure_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing';
GO
-- (b) truncated name resolves to the same (full) PROCEDURE_NAME
DECLARE @trunc_sc sys.sysname = sys.babelfish_truncate_identifier(LOWER('Very_Long_Procedure_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing'));
SELECT DISTINCT PROCEDURE_NAME FROM sys.sp_sproc_columns_view WHERE sys.babelfish_truncate_identifier(pg_catalog.lower(original_procedure_name)) = @trunc_sc AND PROCEDURE_NAME LIKE 'Very_Long_Procedure_Name%';
GO

-- BABEL-5321: sp_procedure_params_100_managed must resolve the procedure by both
-- its full and its MD5-truncated name. Use a short parameter name so the check
-- targets procedure-name matching (parameter-name display is a separate axis).
-- The truncated name is computed at runtime because it is non-deterministic.
CREATE PROCEDURE dbo.babel5975_pp_long_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars @p1 INT AS SELECT @p1;
GO
-- full name resolves via the managed proc
EXEC sys.sp_procedure_params_100_managed @procedure_name = 'babel5975_pp_long_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars', @parameter_name = '@p1';
GO
-- truncated name resolves to the same proc
DECLARE @trunc_pp sys.sysname = sys.babelfish_truncate_identifier(LOWER('babel5975_pp_long_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars'));
EXEC sys.sp_procedure_params_100_managed @procedure_name = @trunc_pp, @parameter_name = '@p1';
GO
DROP PROCEDURE dbo.babel5975_pp_long_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars;
GO

-- ALTER PROCEDURE with long name
ALTER PROCEDURE Very_Long_Procedure_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing
    @Very_Long_Parameter_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters INT
AS BEGIN SELECT @Very_Long_Parameter_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters * 2 END;
GO

-- Verify altered procedure
EXEC Very_Long_Procedure_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing @Very_Long_Parameter_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters = 10;
GO

-- sp_rename PROCEDURE
EXEC sp_rename 'Very_Long_Procedure_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing',
    'Very_Long_Renamed_Proc_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters', 'OBJECT';
GO

-- Verify renamed procedure
SELECT name FROM sys.procedures WHERE name LIKE 'Very_Long_Renamed_Proc%';
GO

-- Rename back
EXEC sp_rename 'Very_Long_Renamed_Proc_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters',
    'Very_Long_Procedure_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing', 'OBJECT';
GO

-- Verify all orig_names in babelfish_function_ext
SELECT orig_name FROM sys.babelfish_function_ext
WHERE orig_name LIKE 'Very_Long_Function%'
   OR orig_name LIKE 'Very_Long_Procedure%'
   OR orig_name LIKE 'Very_Long_Trigger%'
ORDER BY orig_name;
GO

-- ===========================================
-- Table-valued functions (long identifiers)
-- ===========================================

-- Inline table-valued function with a long name
CREATE FUNCTION Very_Long_Inline_Table_Valued_Function_Name_Exceeding_Sixty_Three_Chars()
RETURNS TABLE AS RETURN (SELECT 1 AS c);
GO

-- Multi-statement table-valued function with a long name
CREATE FUNCTION Very_Long_Multi_Statement_Table_Valued_Function_Name_Exceeding_63_Ch()
RETURNS @t TABLE (c INT) AS BEGIN INSERT INTO @t VALUES (1); RETURN; END;
GO

-- Verify inline TVF long name in sys.objects
SELECT name FROM sys.objects WHERE name LIKE 'Very_Long_Inline_Table%';
GO

-- Verify inline TVF long name in sys.all_objects
SELECT name FROM sys.all_objects WHERE name LIKE 'Very_Long_Inline_Table%';
GO

-- Verify multi-statement TVF long name in sys.objects
SELECT name FROM sys.objects WHERE name LIKE 'Very_Long_Multi_Statement_Table%';
GO

-- Select from the inline TVF
SELECT * FROM Very_Long_Inline_Table_Valued_Function_Name_Exceeding_Sixty_Three_Chars();
GO

-- ===========================================
-- BABEL-5975: TVF return columns with long (> NAMEDATALEN) names must display
-- the full original name.
--   * Inline TVF: return columns are OUT params in pg_proc.proargnames (a
--     text[], not NameData), populated from te->resorigname at CREATE time.
--   * Multi-statement TVF: return columns are a composite type whose
--     pg_attribute carries the bbf_original_name attoption.
-- ===========================================
CREATE TABLE babel5975_tvf_base (Very_Long_Column_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters int, b int);
GO
INSERT INTO babel5975_tvf_base VALUES (10, 20);
GO

-- Inline TVF selecting a long base column: metadata must show the full name
CREATE FUNCTION dbo.babel5975_tvf_inline() RETURNS TABLE AS RETURN (SELECT Very_Long_Column_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters, b FROM babel5975_tvf_base);
GO
SELECT name FROM sys.sp_describe_first_result_set_internal(N'SELECT * FROM dbo.babel5975_tvf_inline()', NULL, 0);
GO
SELECT * FROM dbo.babel5975_tvf_inline();
GO

-- Inline TVF with an explicit long alias
CREATE FUNCTION dbo.babel5975_tvf_inline_alias() RETURNS TABLE AS RETURN (SELECT 1 AS Very_Long_Inline_Alias_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_X);
GO
SELECT name FROM sys.sp_describe_first_result_set_internal(N'SELECT * FROM dbo.babel5975_tvf_inline_alias()', NULL, 0);
GO

-- Multi-statement TVF with a long return column (also displays full name)
CREATE FUNCTION dbo.babel5975_tvf_multi() RETURNS @t TABLE (Very_Long_Column_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters int, b int)
AS BEGIN INSERT INTO @t SELECT Very_Long_Column_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters, b FROM babel5975_tvf_base; RETURN; END;
GO
SELECT name FROM sys.sp_describe_first_result_set_internal(N'SELECT * FROM dbo.babel5975_tvf_multi()', NULL, 0);
GO

-- Duplicate long column names in an inline TVF are rejected, reporting the
-- full original name (not the MD5-truncated form).
CREATE FUNCTION dbo.babel5975_tvf_dup() RETURNS TABLE AS RETURN (SELECT 1 AS Very_Long_Duplicate_Alias_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Char, 2 AS Very_Long_Duplicate_Alias_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Char);
GO

DROP FUNCTION dbo.babel5975_tvf_inline;
GO
DROP FUNCTION dbo.babel5975_tvf_inline_alias;
GO
DROP FUNCTION dbo.babel5975_tvf_multi;
GO
DROP TABLE babel5975_tvf_base;
GO

-- ===========================================
-- information_schema.routines (long identifiers)
