-- psql
-- superuser enables the feature
ALTER SYSTEM SET babelfishpg_tsql.allow_batch_query_cache = on;
SELECT pg_reload_conf();
GO
SELECT pg_sleep(1)
GO

-- tsql
-- Flush the batch query parse cache
SELECT set_config('babelfishpg_tsql.enable_batch_query_cache', 'on', false);
GO

SELECT sys.flush_batch_antlr_parse_cache();
GO
SELECT set_config('babelfishpg_tsql.enable_batch_query_cache', 'off', false);
GO

-- Drop test stored procedure first (references tables)
DROP PROCEDURE IF EXISTS dbo.cache_test_proc;
GO

-- Drop test tables
DROP TABLE IF EXISTS dbo.cache_orders;
GO
DROP TABLE IF EXISTS dbo.cache_customers;
GO
DROP TABLE IF EXISTS dbo.cache_drop_test;
GO

-- Drop test user from permission tests
DROP USER IF EXISTS babel_6890_testuser;
GO
IF EXISTS (SELECT * FROM sys.server_principals WHERE name = 'babel_6890_testuser')
BEGIN
    DROP LOGIN babel_6890_testuser;
END
GO

-- psql
-- superuser enables the feature
ALTER SYSTEM SET babelfishpg_tsql.allow_batch_query_cache = off;
SELECT pg_reload_conf();
GO

-- tsql
PRINT 'BABEL-6890 cleanup completed';
GO
