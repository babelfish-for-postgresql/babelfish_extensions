-- CHAR(N) / NCHAR(N) Pattern Tests

-- CHAR pattern exact match — should NOT match (trailing spaces)
SELECT COUNT(*) AS char_20_exact FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE CAST('exact match' AS CHAR(20));
GO

-- CHAR pattern same length — should match (no padding)
SELECT COUNT(*) AS char_11_exact FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE CAST('exact match' AS CHAR(11));
GO

-- Compare: CHAR(11) should match, CHAR(20) should NOT
SELECT COUNT(*) AS char_11 FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE CAST('exact match' AS CHAR(11));
SELECT COUNT(*) AS char_20 FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE CAST('exact match' AS CHAR(20));
GO

-- CHAR pattern with wildcard at end — should still work
SELECT COUNT(*) AS char_prefix FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE CAST('prefix%' AS CHAR(20));
GO

-- CHAR pattern with large padding
SELECT COUNT(*) AS char_50_a FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE CAST('a' AS CHAR(50));
GO

-- CHAR(1) pattern
SELECT COUNT(*) AS char_1_a FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE CAST('a' AS CHAR(1));
GO

-- CHAR(10) with single char — padded with 9 spaces
SELECT COUNT(*) AS char_10_a FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE CAST('a' AS CHAR(10));
GO

-- CHAR(1) with wildcard
SELECT COUNT(*) AS char_1_pct FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE CAST('%' AS CHAR(1));
GO

-- CHAR(10) with wildcard — becomes '%         '
SELECT COUNT(*) AS char_10_pct FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE CAST('%' AS CHAR(10));
GO

-- NOT LIKE with CHAR pattern
SELECT COUNT(*) AS not_like_char FROM BABEL_5966_TestLikeIndex WHERE VarcharCol NOT LIKE CAST('exact match' AS CHAR(20));
GO

-- NVARCHAR column with CHAR pattern
SELECT COUNT(*) AS nvar_char_20 FROM BABEL_5966_TestLikeIndex WHERE NVarcharCol LIKE CAST('exact match' AS CHAR(20));
GO

-- CHAR column with CHAR pattern (same length as column)
SELECT COUNT(*) AS char_char_50 FROM BABEL_5966_TestLikeIndex WHERE CharCol LIKE CAST('exact match' AS CHAR(50));
GO

-- CHAR column with CHAR pattern (different length)
SELECT COUNT(*) AS char_char_20 FROM BABEL_5966_TestLikeIndex WHERE CharCol LIKE CAST('exact match' AS CHAR(20));
GO

-- CHAR pattern with leading wildcard
SELECT COUNT(*) AS char_leading FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE CAST('%match' AS CHAR(20));
GO

-- CHAR pattern with middle wildcard
SELECT COUNT(*) AS char_middle FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE CAST('pre%abc' AS CHAR(20));
GO

-- NCHAR patterns
