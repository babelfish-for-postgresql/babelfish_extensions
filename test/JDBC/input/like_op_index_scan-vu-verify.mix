-- LIKE in different query contexts

SELECT COUNT(*) 
FROM BABEL_5966_TestLikeIndex t1 
JOIN BABEL_5966_TestLikeIndex t2 ON t1.Id = t2.Id 
WHERE t1.VarcharCol LIKE N'prefix%';
GO

SELECT LEFT(VarcharCol, 3) AS prefix, COUNT(*) AS cnt
FROM BABEL_5966_TestLikeIndex
GROUP BY LEFT(VarcharCol, 3)
HAVING LEFT(VarcharCol, 3) LIKE N'pre%';
GO

SELECT COUNT(CASE WHEN VarcharCol LIKE N'prefix%' THEN 1 END) FROM BABEL_5966_TestLikeIndex;
GO

SELECT TOP 1 VarcharCol FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE N'prefix%';
GO

SELECT VarcharCol FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE N'prefix%' ORDER BY VarcharCol;
GO

SELECT COUNT(*) FROM BABEL_5966_TestLikeIndex WHERE Id IN (
    SELECT Id FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE N'prefix%'
);
GO

SELECT COUNT(*) FROM BABEL_5966_TestLikeIndex t1
WHERE EXISTS (
    SELECT 1 FROM BABEL_5966_TestLikeIndex t2 
    WHERE t2.VarcharCol LIKE N'prefix%' AND t2.Id = t1.Id
);
GO

SELECT COUNT(*) FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE (SELECT TOP 1 VarcharCol FROM BABEL_5966_TestLikeIndex WHERE Id = 1);
GO

