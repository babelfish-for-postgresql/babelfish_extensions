GO

SELECT COUNT(*) FROM BABEL_5966_TestLikeCollation_CI_AS WHERE RTRIM(Col) LIKE N'exact match';
GO

SELECT COUNT(*) FROM BABEL_5966_TestLikeCollation_CI_AS WHERE REPLACE(Col, ' ', '') LIKE N'exactmatch';
GO

