-- UPDATE / DELETE

UPDATE BABEL_5966_TestLikeIndex SET VarcharCol = VarcharCol WHERE VarcharCol LIKE N'prefix%';
SELECT @@ROWCOUNT AS update_prefix;
GO

UPDATE BABEL_5966_TestLikeIndex SET VarcharCol = VarcharCol WHERE VarcharCol NOT LIKE N'zzz%';
SELECT @@ROWCOUNT AS update_not_zzz;
GO

DELETE FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE N'nonexistent_xyz_abc%';
SELECT @@ROWCOUNT AS delete_none;
GO

exec sp_babelfish_configure 'explain_costs', 'off';
