-- LIKE in different query contexts

SELECT COUNT(*)
FROM BABEL_5966_TestLikeCollation_CI_AS t1
JOIN BABEL_5966_TestLikeCollation_CI_AS t2 ON t1.Id = t2.Id
WHERE t1.Col LIKE N'prefix%';
GO

SELECT LEFT(Col, 3) AS prefix, COUNT(*) AS cnt
FROM BABEL_5966_TestLikeCollation_CI_AS
GROUP BY LEFT(Col, 3)
HAVING LEFT(Col, 3) LIKE N'pre%';
GO

SELECT COUNT(CASE WHEN Col LIKE N'prefix%' THEN 1 END) FROM BABEL_5966_TestLikeCollation_CI_AS;
GO

SELECT TOP 1 Col FROM BABEL_5966_TestLikeCollation_CI_AS WHERE Col LIKE N'prefix%';
GO

SELECT Col FROM BABEL_5966_TestLikeCollation_CI_AS WHERE Col LIKE N'prefix%' ORDER BY Col;
GO

SELECT COUNT(*) FROM BABEL_5966_TestLikeCollation_CI_AS WHERE Id IN (
    SELECT Id FROM BABEL_5966_TestLikeCollation_CI_AS WHERE Col LIKE N'prefix%'
);
GO

SELECT COUNT(*) FROM BABEL_5966_TestLikeCollation_CI_AS t1
WHERE EXISTS (
    SELECT 1 FROM BABEL_5966_TestLikeCollation_CI_AS t2
    WHERE t2.Col LIKE N'prefix%' AND t2.Id = t1.Id
);
GO

