-- Safety tests for evaluate_expr

-- Column references inside CONVERT
SELECT COUNT(*) FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE CONVERT(VARCHAR(50), VarcharCol);
GO

SELECT COUNT(*) FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE CONVERT(VARCHAR(50), NVarcharCol);
GO

SELECT COUNT(*) FROM BABEL_5966_TestLikeIndex WHERE NVarcharCol LIKE CONVERT(VARCHAR(50), VarcharCol);
GO

SELECT COUNT(*) FROM BABEL_5966_TestLikeIndex WHERE CharCol LIKE CONVERT(VARCHAR(50), VarcharCol);
GO

-- Parameters inside CONVERT
DECLARE @p VARCHAR(50) = 'exact match';
SELECT COUNT(*) FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE CONVERT(VARCHAR(50), @p);
GO

DECLARE @p NVARCHAR(50) = N'prefix%';
SELECT COUNT(*) FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE CONVERT(VARCHAR(50), @p);
GO

DECLARE @p NVARCHAR(50) = N'exact match';
SELECT COUNT(*) FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE CAST(@p AS VARCHAR(50));
GO

DECLARE @p VARCHAR(50) = 'test';
SELECT COUNT(*) FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE @p + '%';
GO

-- Volatile functions
SELECT COUNT(*) FROM BABEL_5966_TestLikeIndex WHERE VarcharCol LIKE CONVERT(VARCHAR(50), NEWID());
GO

