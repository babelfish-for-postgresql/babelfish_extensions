-- tsql
use master
go
create login l1_owner with password = '123'
go
ALTER SERVER ROLE sysadmin ADD MEMBER l1_owner
go

-- tsql user=l1_owner password=123
create database l1_owner_db
go
-- terminate-tsql-conn user=l1_owner password=123

-- tsql
-- reset login password
ALTER LOGIN babel_5127_test_sysadmin WITH PASSWORD = 'abc';
GO

ALTER LOGIN babel_5127_test_securityadmin WITH PASSWORD = 'abc';
GO

ALTER LOGIN babel_5127_test_regularuser WITH PASSWORD = 'abc';
GO

-- 1. Test with master user, should still fail
DROP LOGIN [public];
GO

DROP USER [public];
GO

DROP ROLE [public];
GO

-- tsql user=babel_5127_test_sysadmin password=abc
-- 2. Test with sysadmin (should fail again, but due to inability to drop 'public', not privileges)
DROP LOGIN [public];
GO

DROP USER [public];
GO

DROP ROLE [public];
GO

-- tsql user=babel_5127_test_securityadmin password=abc
-- 3. Test with securityadmin, should fail again
DROP LOGIN [public];
GO

DROP USER [public];
GO

DROP ROLE [public];
GO

-- tsql user=babel_5127_test_regularuser password=abc
-- 4. Test with regular user, should fail again
DROP LOGIN [public];
GO

DROP USER [public];
GO

DROP ROLE [public];
GO

-- tsql
-- should throw error
use master
go
drop login l1_owner
go

-- tsql user=l1_owner password=123
drop database l1_owner_db
go
-- terminate-tsql-conn user=l1_owner password=123

-- tsql
drop login l1_owner
go

-- tsql
use master 
go
create login login_owner with password='123'
go
create database db_owner;
go
ALTER AUTHORIZATION on database::db_owner TO login_owner
go
-- should throw error
drop login login_owner
go
drop database db_owner
go
-- should drop successfully
drop login login_owner
go

CREATE LOGIN txn_login1 WITH PASSWORD = '123'
go
CREATE LOGIN txn_login2 WITH PASSWORD = '123'
go
ALTER SERVER ROLE sysadmin ADD MEMBER txn_login1
go
ALTER SERVER ROLE sysadmin ADD MEMBER txn_login2
go
CREATE DATABASE test_concurrent_db
go
create login txn_login with password='123';
go

-- tsql user=txn_login1 password=123
SELECT set_config('babelfishpg_tsql.isolation_level_repeatable_read','pg_isolation',false);
go

BEGIN TRAN
GO
set transaction isolation level repeatable read;
go
SELECT name, suser_sname(owner_sid) FROM sys.databases WHERE name = 'test_concurrent_db'

-- tsql user=txn_login2 password=123
ALTER AUTHORIZATION ON DATABASE::test_concurrent_db TO txn_login
go
-- terminate-tsql-conn user=txn_login2 password=123

-- tsql user=txn_login1 password=123
SELECT name, suser_sname(owner_sid) FROM sys.databases WHERE name = 'test_concurrent_db'
drop login txn_login;
commit;
go

-- terminate-tsql-conn user=txn_login1 password=123

-- psql
-- The txn_login1/txn_login2 TDS sessions were just closed client-side, but the
-- server backends tear down asynchronously. drop login uses is_active_login()
-- (CountUserBackends), so poll until those backends have fully exited; otherwise
-- the drop races teardown and fails with "Could not drop login '...' as the user
-- is currently logged in." Use a DO block (no result rows) so the wait stays
-- deterministic regardless of how many backends are still present.
DO
$$
DECLARE
    remaining int;
    attempts  int := 0;
BEGIN
    LOOP
        PERFORM pg_terminate_backend(pid)
        FROM pg_stat_get_activity(NULL)
        WHERE sys.suser_name(usesysid) IN ('txn_login1', 'txn_login2')
          AND backend_type = 'client backend'
          AND usesysid IS NOT NULL;

        SELECT count(*) INTO remaining
        FROM pg_stat_get_activity(NULL)
        WHERE sys.suser_name(usesysid) IN ('txn_login1', 'txn_login2')
          AND backend_type = 'client backend'
          AND usesysid IS NOT NULL;

        EXIT WHEN remaining = 0 OR attempts >= 50;
        attempts := attempts + 1;
        PERFORM pg_sleep(0.1);
    END LOOP;
END
$$
GO

-- tsql
drop login txn_login1;
go
drop login txn_login2;
go
drop database test_concurrent_db;
go

drop login txn_login;
go


-- psql
-- Need to terminate active session before cleaning up the login
SELECT pg_terminate_backend(pid) FROM pg_stat_get_activity(NULL)
WHERE sys.suser_name(usesysid) IN ('babel_5127_test_sysadmin', 'babel_5127_test_securityadmin', 'babel_5127_test_regularuser') AND backend_type = 'client backend' AND usesysid IS NOT NULL;
GO

-- Wait to sync with another session
SELECT pg_sleep(1);
GO