-- tsql
-- Without SET DATEFORMAT, the setting shows the order from DateStyle
SELECT current_setting('babelfishpg_tsql.dateformat') AS dateformat;
GO

-- Until SET DATEFORMAT is used, a change of DateStyle changes how cached plans
-- and new statements read date strings
CREATE PROCEDURE set_dateformat_guc_p AS
SELECT CAST('01/02/2026' AS DATE) AS cast_date, CONVERT(DATETIME, '01/02/2026') AS convert_datetime;
GO

EXEC set_dateformat_guc_p;
GO

DECLARE @x VARCHAR(30) = (SELECT set_config('datestyle', 'ISO, DMY', false));
GO

SELECT current_setting('babelfishpg_tsql.dateformat') AS dateformat;
EXEC set_dateformat_guc_p;
SELECT CAST('01/02/2026' AS DATE) AS cast_date;
GO

DECLARE @x VARCHAR(30) = (SELECT set_config('datestyle', 'ISO, MDY', false));
GO

SELECT current_setting('babelfishpg_tsql.dateformat') AS dateformat;
EXEC set_dateformat_guc_p;
SELECT CAST('01/02/2026' AS DATE) AS cast_date;
GO

DECLARE @i INT = 0, @x VARCHAR(30);
WHILE @i < 4
BEGIN
	SET @x = (SELECT set_config('datestyle', CASE WHEN @i % 2 = 0 THEN 'ISO, DMY' ELSE 'ISO, MDY' END, false));
	SELECT current_setting('babelfishpg_tsql.dateformat') AS dateformat, CAST('01/02/2026' AS DATE) AS cast_date;
	SET @i += 1;
END
GO

-- After SET DATEFORMAT, DateStyle no longer matters
SET DATEFORMAT dmy;
GO

DECLARE @x VARCHAR(30) = (SELECT set_config('datestyle', 'ISO, YMD', false));
GO

SELECT current_setting('babelfishpg_tsql.dateformat') AS dateformat;
EXEC set_dateformat_guc_p;
GO

DECLARE @x VARCHAR(30) = (SELECT set_config('datestyle', 'ISO, MDY', false));
GO

DROP PROCEDURE set_dateformat_guc_p;
GO

SELECT current_setting('datestyle') AS datestyle;
GO

CREATE TABLE set_dateformat_guc_t (id INT, s VARCHAR(30));
GO

INSERT INTO set_dateformat_guc_t VALUES (1, '01/02/2026'), (2, '13/02/2026');
GO

-- A configuration reload must not change the date order
SET DATEFORMAT dmy;
GO

-- psql
SELECT pg_reload_conf();
GO

SELECT pg_sleep(1);
GO

-- tsql
SELECT id, CAST(s AS DATE) AS cast_date, CONVERT(DATE, s) AS convert_date, current_setting('babelfishpg_tsql.dateformat') AS dateformat FROM set_dateformat_guc_t ORDER BY id;
GO

-- A parallel worker takes the date order of the leader, even if the escape
-- hatch has changed since an unsupported order was accepted
DECLARE @x VARCHAR(10) = (SELECT set_config('debug_parallel_query', 'on', false));
GO

EXEC sp_babelfish_configure 'escape_hatch_session_settings', 'ignore';
GO

SET DATEFORMAT dym;
GO

EXEC sp_babelfish_configure 'escape_hatch_session_settings', 'strict';
GO

SELECT count(*) FROM set_dateformat_guc_t;
GO

EXEC sp_babelfish_configure 'escape_hatch_session_settings', 'ignore';
GO

SET DATEFORMAT dmy;
GO

SELECT id, CAST(s AS DATE) AS cast_date FROM set_dateformat_guc_t ORDER BY id;
GO

-- Back to the server's setting of debug_parallel_query
DECLARE @v VARCHAR(20) = (SELECT reset_val FROM pg_settings WHERE name = 'debug_parallel_query');
DECLARE @x VARCHAR(20) = (SELECT set_config('debug_parallel_query', @v, false));
GO

SET DATEFORMAT mdy;
GO

DROP TABLE set_dateformat_guc_t;
GO

-- psql
-- DateStyle sets the order until SET DATEFORMAT is used
SET datestyle = 'ISO, DMY';
GO

SELECT current_setting('babelfishpg_tsql.dateformat') AS dateformat, '01/02/2026'::date AS date_value;
GO

-- Setting DateStyle again keeps the order from SET DATEFORMAT
SET babelfishpg_tsql.dateformat = 'mdy';
GO

SET datestyle = 'ISO, DMY';
GO

SELECT current_setting('babelfishpg_tsql.dateformat') AS dateformat, '01/02/2026'::date AS date_value;
GO

-- So does rolling back a change of DateStyle
BEGIN;
GO

SET datestyle = 'ISO, YMD';
GO

ROLLBACK;
GO

SELECT current_setting('babelfishpg_tsql.dateformat') AS dateformat, '01/02/2026'::date AS date_value;
GO

-- After RESET, the order from DateStyle applies again
RESET babelfishpg_tsql.dateformat;
GO

SELECT current_setting('babelfishpg_tsql.dateformat') AS dateformat, '01/02/2026'::date AS date_value;
GO

RESET datestyle;
GO

SELECT current_setting('babelfishpg_tsql.dateformat') AS dateformat, '01/02/2026'::date AS date_value;
GO
