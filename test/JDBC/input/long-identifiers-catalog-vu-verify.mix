-- Verify constraint names after upgrade
SELECT name FROM sys.key_constraints WHERE name LIKE 'Very_Long_PK%CatVU';
GO

SELECT name FROM sys.key_constraints WHERE name LIKE 'Very_Long_Unique%CatVU';
GO

SELECT name FROM sys.check_constraints WHERE name LIKE 'Very_Long_Check%CatVU';
GO

-- Verify sequence name after upgrade
SELECT name FROM sys.sequences WHERE name LIKE 'Very_Long_Sequence%CatVU';
GO

-- Verify type name after upgrade
SELECT name FROM sys.types WHERE name LIKE 'Very_Long_Type%CatVU';
GO

-- Verify parameter name after upgrade
SELECT name FROM sys.all_parameters WHERE name LIKE '%Very_Long_Parameter%CatVU';
GO

-- BABEL-5975: collision coverage. Each procedure's parameter shares the same
-- leading 75 bytes but must resolve to its own original name via the
-- parent/namespace disambiguation in sys.all_parameters.
SELECT name FROM sys.all_parameters WHERE name LIKE '%Sixty_Three_ProcOne';
GO
SELECT name FROM sys.all_parameters WHERE name LIKE '%Sixty_Three_ProcTwo';
GO

-- BABEL-5975: ALTER TABLE ADD CONSTRAINT coverage (store_alter_table_constraint_original_names).
-- After dump/restore the long constraint names added via ALTER TABLE (CHECK,
-- UNIQUE, FOREIGN KEY) must resolve to their original names in the sys views.
SELECT name FROM sys.check_constraints WHERE name LIKE 'Very_Long_Alter_Check%CatVU';
GO
SELECT name FROM sys.key_constraints WHERE name LIKE 'Very_Long_Alter_Unique%CatVU';
GO
SELECT name FROM sys.foreign_keys WHERE name LIKE 'Very_Long_Alter_Foreign_Key%CatVU';
GO

-- BABEL-5975 (dump/restore guard): this verify step runs after the pg_dump +
-- restore performed by the dump/restore test framework. The
-- babelfish_identifier_mapping rows for the objects created in vu-prepare are
-- restored directly (pg_extension_config_dump), while the same objects are also
-- recreated by replaying their DDL during restore. The object-creation hooks
-- must stand down while babelfish_dump_restore is set, otherwise the DDL replay
-- would re-insert rows that the data restore already brought back, causing a
-- duplicate-key error (restore failure) or duplicate/stale rows here. Assert the
-- catalog holds EXACTLY ONE row per prepared object after dump/restore -- this
-- fails if any store hook's dump_restore guard is missing or broken.
SELECT original_identifier_name, count(*) AS row_count
FROM sys.babelfish_identifier_mapping
WHERE original_identifier_name IN (
    'Very_Long_PK_Constraint_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_CatVU',
    'Very_Long_Check_Constraint_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_CatVU',
    'Very_Long_Unique_Constraint_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_CatVU',
    'Very_Long_Sequence_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_CatVU',
    'Very_Long_Type_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_CatVU',
    '@Very_Long_Parameter_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_CatVU',
    'Very_Long_Alter_Check_Constraint_Name_That_Exceeds_Sixty_Three_Bytes_CatVU',
    'Very_Long_Alter_Unique_Constraint_Name_That_Exceeds_Sixty_Three_Bytes_CatVU',
    'Very_Long_Alter_Foreign_Key_Constraint_Name_Exceeds_Sixty_Three_Bytes_CatVU')
GROUP BY original_identifier_name
ORDER BY original_identifier_name;
GO

-- No duplicate mapping rows for any prepared object after dump/restore (each
-- (truncated_identifier_name, nspname, pg_catalog_type, parent_name) key appears
-- at most once). Expect 0 rows.
SELECT truncated_identifier_name, nspname, pg_catalog_type, parent_name, count(*) AS dup_count
FROM sys.babelfish_identifier_mapping
GROUP BY truncated_identifier_name, nspname, pg_catalog_type, parent_name
HAVING count(*) > 1
ORDER BY truncated_identifier_name;
GO

-- BABEL-5975 (Issue 1): a constraint mapping row must be keyed on the PHYSICAL
-- parent table name so DROP TABLE cleans it up. For a table whose name exceeds
-- NAMEDATALEN (physical name is MD5-truncated and differs from the parse-tree
-- name), a mismatched key would leave a stale, still-readable row. Create such
-- a table with a long constraint, drop it, and assert no leftover row remains.
CREATE TABLE babel5975_cat_vu_LongTableNameThatExceedsThePostgreSQLNameDataLenLimitOfSixtyThree (
    id INT,
    CONSTRAINT babel5975_cat_vu_LongCheckConstraintNameThatExceedsTheSixtyThreeByteLimit CHECK (id > 0)
);
GO
DROP TABLE babel5975_cat_vu_LongTableNameThatExceedsThePostgreSQLNameDataLenLimitOfSixtyThree;
GO
-- Expect 0: no stale constraint mapping row after the drop.
SELECT count(*) FROM sys.babelfish_identifier_mapping WHERE original_identifier_name LIKE 'babel5975_cat_vu_LongCheckConstraint%';
GO

-- BABEL-5975 (Issue 1, rename variant): renaming a table changes its PHYSICAL
-- name, which is the key the constraint mapping is filed under. sp_rename must
-- re-point the constraint rows to the new physical name, else a later DROP
-- misses them (stale row leak). Create long table+constraint, rename the table,
-- drop it, and assert no leftover row remains.
CREATE TABLE babel5975_cat_vu_RenameSrcTableNameThatExceedsThePostgreSQLNameDataLenLimitAbc (
    id INT,
    CONSTRAINT babel5975_cat_vu_RenameCheckConstraintNameThatExceedsTheSixtyThreeByteLim CHECK (id > 0)
);
GO
EXEC sp_rename 'babel5975_cat_vu_RenameSrcTableNameThatExceedsThePostgreSQLNameDataLenLimitAbc', 'babel5975_cat_vu_RenameDstTableNameThatExceedsThePostgreSQLNameDataLenLimitXyz', 'OBJECT';
GO
DROP TABLE babel5975_cat_vu_RenameDstTableNameThatExceedsThePostgreSQLNameDataLenLimitXyz;
GO
-- Expect 0: constraint mapping row cleaned up after rename + drop.
SELECT count(*) FROM sys.babelfish_identifier_mapping WHERE original_identifier_name LIKE 'babel5975_cat_vu_RenameCheckConstraint%';
GO

-- BABEL-5975 (rename to a SHORT name): renaming a long-named table to a short
-- name re-keys the constraint mapping to the short physical name; drop must
-- still clean it up.
CREATE TABLE babel5975_cat_vu_RenameToShortSrcTableNameThatExceedsTheNameDataLenLimitHere (
    id INT,
    CONSTRAINT babel5975_cat_vu_RenameToShortCheckConstraintNameThatExceedsTheLimit CHECK (id > 0)
);
GO
EXEC sp_rename 'babel5975_cat_vu_RenameToShortSrcTableNameThatExceedsTheNameDataLenLimitHere', 'babel5975_shortname_tbl', 'OBJECT';
GO
DROP TABLE babel5975_shortname_tbl;
GO
-- Expect 0.
SELECT count(*) FROM sys.babelfish_identifier_mapping WHERE original_identifier_name LIKE 'babel5975_cat_vu_RenameToShortCheckConstraint%';
GO

-- BABEL-5975 (double rename chain): each rename must re-key the constraint
-- mapping so a final drop after two renames leaves no stale row.
CREATE TABLE babel5975_cat_vu_ChainRenameTableOneNameThatExceedsTheNameDataLenLimitHereAbc (
    id INT,
    CONSTRAINT babel5975_cat_vu_ChainRenameCheckConstraintNameExceedingTheByteLimit CHECK (id > 0)
);
GO
EXEC sp_rename 'babel5975_cat_vu_ChainRenameTableOneNameThatExceedsTheNameDataLenLimitHereAbc', 'babel5975_cat_vu_ChainRenameTableTwoNameThatExceedsTheNameDataLenLimitHereXyz', 'OBJECT';
GO
EXEC sp_rename 'babel5975_cat_vu_ChainRenameTableTwoNameThatExceedsTheNameDataLenLimitHereXyz', 'babel5975_cat_vu_ChainRenameTableThreeNameThatExceedsTheNameDataLenLimitDef', 'OBJECT';
GO
DROP TABLE babel5975_cat_vu_ChainRenameTableThreeNameThatExceedsTheNameDataLenLimitDef;
GO
-- Expect 0.
SELECT count(*) FROM sys.babelfish_identifier_mapping WHERE original_identifier_name LIKE 'babel5975_cat_vu_ChainRenameCheckConstraint%';
GO

-- BABEL-5975 (sequence rename): rename a long-named sequence, drop it, assert
-- the old mapping row is removed and no row leaks.
CREATE SEQUENCE babel5975_cat_vu_RenameSequenceSourceNameThatExceedsTheNameDataLenLimitHere START WITH 1;
GO
EXEC sp_rename 'babel5975_cat_vu_RenameSequenceSourceNameThatExceedsTheNameDataLenLimitHere', 'babel5975_cat_vu_RenameSequenceTargetNameThatExceedsTheNameDataLenLimitHere', 'OBJECT';
GO
DROP SEQUENCE babel5975_cat_vu_RenameSequenceTargetNameThatExceedsTheNameDataLenLimitHere;
GO
-- Expect 0.
SELECT count(*) FROM sys.babelfish_identifier_mapping WHERE original_identifier_name LIKE 'babel5975_cat_vu_RenameSequence%';
GO

-- BABEL-5975 (type rename): rename a long-named user-defined type, drop it,
-- assert no stale mapping row remains.
CREATE TYPE babel5975_cat_vu_RenameTypeSourceNameThatExceedsTheNameDataLenLimitOfSixty FROM INT;
GO
EXEC sp_rename 'babel5975_cat_vu_RenameTypeSourceNameThatExceedsTheNameDataLenLimitOfSixty', 'babel5975_cat_vu_RenameTypeTargetNameThatExceedsTheNameDataLenLimitOfSixty', 'USERDATATYPE';
GO
DROP TYPE babel5975_cat_vu_RenameTypeTargetNameThatExceedsTheNameDataLenLimitOfSixty;
GO
-- Expect 0.
SELECT count(*) FROM sys.babelfish_identifier_mapping WHERE original_identifier_name LIKE 'babel5975_cat_vu_RenameType%';
GO

-- BABEL-5975 (DEFAULT constraint): a long-named DEFAULT constraint is stored
-- and cleaned up on drop.
CREATE TABLE babel5975_cat_vu_default_tbl (
    id INT CONSTRAINT babel5975_cat_vu_LongDefaultConstraintNameThatExceedsTheSixtyThreeByteLim DEFAULT 5
);
GO
DROP TABLE babel5975_cat_vu_default_tbl;
GO
-- Expect 0.
SELECT count(*) FROM sys.babelfish_identifier_mapping WHERE original_identifier_name LIKE 'babel5975_cat_vu_LongDefaultConstraint%';
GO

-- BABEL-5975 (FK constraint): a long-named FOREIGN KEY resolves in
-- sys.foreign_keys after a table rename and is cleaned up on drop.
CREATE TABLE babel5975_cat_vu_fk_parent (id INT PRIMARY KEY);
GO
CREATE TABLE babel5975_cat_vu_fk_child (
    id INT,
    pid INT,
    CONSTRAINT babel5975_cat_vu_LongForeignKeyConstraintNameThatExceedsTheByteLim FOREIGN KEY (pid) REFERENCES babel5975_cat_vu_fk_parent (id)
);
GO
EXEC sp_rename 'babel5975_cat_vu_fk_child', 'babel5975_cat_vu_fk_child_renamed', 'OBJECT';
GO
-- Original FK name must still resolve after the table rename.
SELECT name FROM sys.foreign_keys WHERE name LIKE 'babel5975_cat_vu_LongForeignKey%';
GO
DROP TABLE babel5975_cat_vu_fk_child_renamed;
GO
DROP TABLE babel5975_cat_vu_fk_parent;
GO
-- Expect 0.
SELECT count(*) FROM sys.babelfish_identifier_mapping WHERE original_identifier_name LIKE 'babel5975_cat_vu_LongForeignKey%';
GO

-- BABEL-5975 (DROP SCHEMA path): a long-named constraint in a non-dbo schema is
-- cleaned up when its table (and schema) are dropped.
CREATE SCHEMA babel5975_cat_vu_sch;
GO
CREATE TABLE babel5975_cat_vu_sch.babel5975_cat_vu_SchemaScopedTableNameExceedingLimit (
    id INT,
    CONSTRAINT babel5975_cat_vu_SchemaScopedCheckConstraintNameExceedingTheByteLimit CHECK (id > 0)
);
GO
DROP TABLE babel5975_cat_vu_sch.babel5975_cat_vu_SchemaScopedTableNameExceedingLimit;
GO
DROP SCHEMA babel5975_cat_vu_sch;
GO
-- Expect 0.
SELECT count(*) FROM sys.babelfish_identifier_mapping WHERE original_identifier_name LIKE 'babel5975_cat_vu_SchemaScopedCheckConstraint%';
GO
