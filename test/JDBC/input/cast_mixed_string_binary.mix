-- tsql
-- Test Suite: Interleaved Testing of VARCHAR, NVARCHAR, CHAR, and NCHAR in Babelfish for PostgreSQL, using master_dbo schema
 
IF OBJECT_ID('string_types_table', 'U') IS NOT NULL DROP TABLE string_types_table;
go
IF OBJECT_ID('varbinary_table', 'U') IS NOT NULL DROP TABLE varbinary_table;
go
IF OBJECT_ID('mixed_types', 'U') IS NOT NULL DROP TABLE mixed_types;
go
 
CREATE TABLE string_types_table (
    id INT IDENTITY(1,1) PRIMARY KEY,
    v_val VARCHAR(10),
    nv_val NVARCHAR(10),
    nvc_max NVARCHAR(MAX),
    c_val CHAR(10),
    nc_val NCHAR(10),
    txt_val TEXT
);
go
 
INSERT INTO string_types_table (v_val, nv_val, nvc_max, c_val, nc_val, txt_val) VALUES
('abc', N'abc', N'longstring', 'charabc', N'charabc', 'textabc'),
('12345', N'12345', N'1234567890', 'char123', N'char123', 'text123'),
('', N'', N'', '', N'', '');
go
 
-- psql
SELECT * FROM master_dbo.string_types_table ORDER BY id;
go
 
-- tsql
INSERT INTO string_types_table (v_val, nv_val, nvc_max, c_val, nc_val) VALUES
(N'Ω≈ç√', N'Ω≈ç√', N'UnicodeTest', N'ΩΩΩΩ', N'ΩΩΩΩ');
go
 
-- psql
SELECT * FROM master_dbo.string_types_table ORDER BY id;
go
 
-- tsql
UPDATE string_types_table SET v_val = 'updated', nv_val = N'updated', nvc_max = N'updatedmax', c_val = 'updchar', nc_val = N'updchar' WHERE id = 1;
go
 
-- psql
SELECT * FROM master_dbo.string_types_table ORDER BY id;
go
 
-- tsql
CREATE TABLE varbinary_table (
    id INT IDENTITY(1,1) PRIMARY KEY,
    vb_val VARBINARY(20)
);
go
 
INSERT INTO varbinary_table (vb_val) VALUES
(CAST('abc' AS VARBINARY)), (CAST(N'Ω≈ç' AS VARBINARY));
go
 
select * from string_types_table;
go
 
SELECT
    v_val, CAST(v_val AS VARBINARY(20)) AS v_to_varb,
    nv_val, CAST(nv_val AS VARBINARY(20)) AS nv_to_varb,
    c_val, CAST(c_val AS VARBINARY(20)) AS c_to_varb,
    nc_val, CAST(nc_val AS VARBINARY(20)) AS nc_to_varb
FROM string_types_table;
go
 
-- psql
SELECT * FROM master_dbo.varbinary_table ORDER BY id;
go
 
-- tsql
SELECT
    CAST(vb_val AS VARCHAR(10)) AS varb_to_v,
    CAST(vb_val AS NVARCHAR(10)) AS varb_to_nv,
    CAST(vb_val AS CHAR(10)) AS varb_to_c,
    CAST(vb_val AS NCHAR(10)) AS varb_to_nc
FROM varbinary_table;
go
 
CREATE TABLE mixed_types (
    a VARCHAR(10),
    b NVARCHAR(10),
    c CHAR(10),
    d NCHAR(10),
    e TEXT
);
go
 
INSERT INTO mixed_types (a, b, c, d, e)
SELECT v_val, nv_val, c_val, nc_val, txt_val
FROM string_types_table;
go
 
SELECT * FROM mixed_types ORDER BY a;
go
 
-- psql
SELECT * FROM master_dbo.mixed_types ORDER BY a;
go
 
-- tsql
SELECT
    v_val + '_cat' AS v_cat,
    nv_val + N'_cat' AS nv_cat,
    c_val + '_cat' AS c_cat,
    nc_val + N'_cat' AS nc_cat
FROM string_types_table;
go
 
SELECT
    v_val + nv_val AS v_nv_cat,
    c_val + nc_val AS c_nc_cat
FROM string_types_table;
go
 
-- psql
SELECT * FROM master_dbo.string_types_table ORDER BY id;
go
 
-- tsql
SELECT
    v_val, CASE WHEN v_val = 'abc' THEN 1 ELSE 0 END AS v_eq_abc, 
           CASE WHEN v_val < 'zzz' THEN 1 ELSE 0 END AS v_lt_zzz,
    nv_val, CASE WHEN nv_val = N'abc' THEN 1 ELSE 0 END AS nv_eq_abc,
           CASE WHEN nv_val < N'zzz' THEN 1 ELSE 0 END AS nv_lt_zzz,
    c_val, CASE WHEN c_val = 'charabc' THEN 1 ELSE 0 END AS c_eq,
           CASE WHEN c_val < 'zzz' THEN 1 ELSE 0 END AS c_lt,
    nc_val, CASE WHEN nc_val = N'charabc' THEN 1 ELSE 0 END AS nc_eq,
           CASE WHEN nc_val < N'zzz' THEN 1 ELSE 0 END AS nc_lt
FROM string_types_table;
go
 
SELECT
    LEN(v_val) AS len_v,
    LEN(nv_val) AS len_nv,
    LEN(c_val) AS len_c,
    LEN(nc_val) AS len_nc,
    LEN(nvc_max) AS len_nvc_max,
    LEN(txt_val) AS len_txt
FROM string_types_table;
go
 
SELECT
    UPPER(v_val) AS up_v, UPPER(nv_val) AS up_nv, UPPER(c_val) AS up_c, UPPER(nc_val) AS up_nc
FROM string_types_table;
go
 
SELECT
    CHARINDEX('1', v_val) AS pos1_v, CHARINDEX(N'1', nv_val) AS pos1_nv
FROM string_types_table;
go
 
-- psql
SELECT * FROM master_dbo.string_types_table ORDER BY id;
go
 
-- tsql
INSERT INTO string_types_table (v_val, nv_val, nvc_max, c_val, nc_val) VALUES (NULL, NULL, NULL, NULL, NULL);
go
 
BEGIN TRY
    INSERT INTO string_types_table (v_val) VALUES ('12345678901'); -- 11 chars into VARCHAR(10)
END TRY BEGIN CATCH
    PRINT 'Expected overflow error for v_val (varchar): ' + ERROR_MESSAGE();
END CATCH;
go
BEGIN TRY
    INSERT INTO string_types_table (nv_val) VALUES (N'12345678901'); -- 11 chars into NVARCHAR(10)
END TRY BEGIN CATCH
    PRINT 'Expected overflow error for nv_val (nvarchar): ' + ERROR_MESSAGE();
END CATCH;
go
BEGIN TRY
    INSERT INTO string_types_table (c_val) VALUES ('12345678901'); -- 11 chars into CHAR(10)
END TRY BEGIN CATCH
    PRINT 'Expected overflow error for c_val (char): ' + ERROR_MESSAGE();
END CATCH;
go
BEGIN TRY
    INSERT INTO string_types_table (nc_val) VALUES (N'12345678901'); -- 11 chars into NCHAR(10)
END TRY BEGIN CATCH
    PRINT 'Expected overflow error for nc_val (nchar): ' + ERROR_MESSAGE();
END CATCH;
go
 
-- psql
SELECT * FROM master_dbo.string_types_table ORDER BY id;
go
 
-- tsql
SELECT
    CASE WHEN v_val = txt_val THEN 1 ELSE 0 END AS v_eq_txt,
    CASE WHEN nv_val = txt_val THEN 1 ELSE 0 END AS nv_eq_txt,
    CASE WHEN c_val = txt_val THEN 1 ELSE 0 END AS c_eq_txt,
    CASE WHEN nc_val = txt_val THEN 1 ELSE 0 END AS nc_eq_txt
FROM string_types_table;
go
 
SELECT
    CASE WHEN v_val = CAST(txt_val AS VARCHAR(10)) THEN 1 ELSE 0 END AS v_eq_cast_txt,
    CASE WHEN nv_val = CAST(txt_val AS NVARCHAR(10)) THEN 1 ELSE 0 END AS nv_eq_cast_txt,
    CASE WHEN c_val = CAST(txt_val AS CHAR(10)) THEN 1 ELSE 0 END AS c_eq_cast_txt,
    CASE WHEN nc_val = CAST(txt_val AS NCHAR(10)) THEN 1 ELSE 0 END AS nc_eq_cast_txt
FROM string_types_table;
go
 
-- psql
SELECT * FROM master_dbo.string_types_table ORDER BY id;
go
 
-- tsql
IF EXISTS (SELECT * FROM sys.indexes WHERE name = 'idx_unique_vval') DROP INDEX idx_unique_vval ON string_types_table;
go
IF EXISTS (SELECT * FROM sys.indexes WHERE name = 'idx_unique_nvval') DROP INDEX idx_unique_nvval ON string_types_table;
go
IF EXISTS (SELECT * FROM sys.indexes WHERE name = 'idx_unique_cval') DROP INDEX idx_unique_cval ON string_types_table;
go
IF EXISTS (SELECT * FROM sys.indexes WHERE name = 'idx_unique_ncval') DROP INDEX idx_unique_ncval ON string_types_table;
go
 
CREATE UNIQUE INDEX idx_unique_vval ON string_types_table (v_val);
go
CREATE UNIQUE INDEX idx_unique_nvval ON string_types_table (nv_val);
go
CREATE UNIQUE INDEX idx_unique_cval ON string_types_table (c_val);
go
CREATE UNIQUE INDEX idx_unique_ncval ON string_types_table (nc_val);
go
 
BEGIN TRY
    INSERT INTO string_types_table (v_val) VALUES ('abc');
END TRY BEGIN CATCH
    PRINT 'Expected unique violation for v_val=abc: ' + ERROR_MESSAGE();
END CATCH;
go
BEGIN TRY
    INSERT INTO string_types_table (nv_val) VALUES (N'abc');
END TRY BEGIN CATCH
    PRINT 'Expected unique violation for nv_val=abc: ' + ERROR_MESSAGE();
END CATCH;
go
BEGIN TRY
    INSERT INTO string_types_table (c_val) VALUES ('charabc');
END TRY BEGIN CATCH
    PRINT 'Expected unique violation for c_val=charabc: ' + ERROR_MESSAGE();
END CATCH;
go
BEGIN TRY
    INSERT INTO string_types_table (nc_val) VALUES (N'charabc');
END TRY BEGIN CATCH
    PRINT 'Expected unique violation for nc_val=charabc: ' + ERROR_MESSAGE();
END CATCH;
go
 
-- psql
SELECT * FROM master_dbo.string_types_table ORDER BY id;
go
 
-- tsql
IF OBJECT_ID('echo_all', 'P') IS NOT NULL DROP PROCEDURE echo_all;
go
 
CREATE PROCEDURE echo_all
    @p_v VARCHAR(10),
    @p_nv NVARCHAR(10),
    @p_c CHAR(10),
    @p_nc NCHAR(10)
AS
BEGIN
    SELECT @p_v AS v, @p_nv AS nv, @p_c AS c, @p_nc AS nc;
END
go
 
EXEC echo_all 'hello', N'hello', 'hello', N'hello';
go
 
-- psql
SELECT column_name, data_type, character_maximum_length
FROM information_schema.columns
WHERE table_schema = 'master_dbo' AND table_name = 'string_types_table'
ORDER BY ordinal_position;
go
 
-- tsql
IF OBJECT_ID('echo_all', 'P') IS NOT NULL DROP PROCEDURE echo_all;
go
IF OBJECT_ID('mixed_types', 'U') IS NOT NULL DROP TABLE mixed_types;
go
IF OBJECT_ID('varbinary_table', 'U') IS NOT NULL DROP TABLE varbinary_table;
go
IF OBJECT_ID('string_types_table', 'U') IS NOT NULL DROP TABLE string_types_table;
go
