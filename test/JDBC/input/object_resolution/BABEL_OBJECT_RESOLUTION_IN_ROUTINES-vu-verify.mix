USE babel_5448_db
GO

BEGIN TRY
    EXEC babel_5448_s1.babel_5448_p8
    SELECT 1/0;
END TRY
BEGIN CATCH
    SELECT * FROM babel_5448_t JOIN babel_5448_s2.babel_5448_v ON (1=1);
    USE msdb
    SELECT * FROM babel_5448_t JOIN babel_5448_s2.babel_5448_v ON (1=1);
END CATCH
GO

SELECT db_name()
GO

