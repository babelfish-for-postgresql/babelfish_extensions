-- Scenario 4: Boundary - authenticate with exactly 64 char login
-- This is the minimum length that triggers MD5 truncation (>= NAMEDATALEN)
-- tsql user=boundary_test_login_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa password=123
select suser_name();
go

-- terminate-tsql-conn user=boundary_test_login_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa password=123

