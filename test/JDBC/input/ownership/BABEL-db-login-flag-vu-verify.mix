-- single_db_mode_expected
-- tsql
-- Verify ALTER LOGIN works with long identifiers
ALTER LOGIN long_identifier_login_test_user_abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqr WITH PASSWORD = '1234';
GO

ALTER LOGIN Mixed_Case_Login_Test_XyZaBcDeFgHiJkLmNoPqRsTuVwXyZaBcDeFgHiJkLmNoPqRsTuVwXyZaBcDeFgHiJkLmNoPqRsTuVwXyZaBcDeFgHiJkLmNoPqRsTuVwXy WITH PASSWORD = '1234';
GO

-- Scenario 1: Authenticate with long login (128 chars, lowercase)
-- Verifies MD5 truncation in TdsProcessLogin produces correct role name
-- tsql user=long_identifier_login_test_user_abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqr password=1234
select suser_name();
go

-- Scenario 2: Authenticate with long login (128 chars, mixed case)
-- Verifies that mixed-case input is downcased before MD5 hash computation
-- tsql user=Mixed_Case_Login_Test_XyZaBcDeFgHiJkLmNoPqRsTuVwXyZaBcDeFgHiJkLmNoPqRsTuVwXyZaBcDeFgHiJkLmNoPqRsTuVwXyZaBcDeFgHiJkLmNoPqRsTuVwXy password=1234
select suser_name();
go

-- Scenario 3: Authenticate with long login (128 chars, multibyte)
-- Verifies pg_mbcliplen correctly handles multibyte character boundaries
-- tsql user=Lögïn_Tëst_Üsér_àáâãäåæçèéêëìíîïðñòóôõöøùúûüýþÿàáâãäåæçèéêëìíîïðñòóôõöøùúûüýþÿàáâãäåæçèéêëìíîïðñòóôõöøùúûüýþÿàáâãäåæçèéêëìíîïðñò password=123
select suser_name();
go

-- Scenario 4: Boundary - authenticate with exactly 64 char login
-- This is the minimum length that triggers MD5 truncation (>= NAMEDATALEN)
-- tsql user=boundary_test_login_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa password=123
select suser_name();
go

-- Scenario 5a: Case-insensitive auth - authenticate with all-lowercase
-- Login was created as "Case_Insensitive_Long_Login_Test_AaBb...", authenticating with lowercase
-- tsql user=case_insensitive_long_login_test_aabbccddeeffgghhiijjkkllmmnnooppqqrrssttuuvvwwxxyyzzaabbccddeeffgghhiijjkkllmmnn password=123
select suser_name();
go

-- Scenario 5b: Case-insensitive auth - authenticate with all-uppercase
-- Same login, authenticating with uppercase - should produce same MD5 hash
-- tsql user=CASE_INSENSITIVE_LONG_LOGIN_TEST_AABBCCDDEEFFGGHHIIJJKKLLMMNNOOPPQQRRSSTTUUVVWWXXYYZZAABBCCDDEEFFGGHHIIJJKKLLMMNN password=123
select suser_name();
go

-- Scenario 6: Authenticate with long database name (128 chars, lowercase)
-- Verifies truncate_identifier hook in TdsSetDbContext works correctly
-- tsql user=jdbc_user password=12345678 database=long_identifier_database_test_abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrst
select db_name();
go

-- Scenario 7: Authenticate with long database name (128 chars, mixed case)
-- Verifies case-insensitive database name lookup
-- tsql user=jdbc_user password=12345678 database=Mixed_Case_Database_Test_XyZaBcDeFgHiJkLmNoPqRsTuVwXyZaBcDeFgHiJkLmNoPqRsTuVwXyZaBcDeFgHiJkLmNoPqRsTuVwXyZaBcDeFgHiJkLmNoPqRsTuV
select db_name();
go

-- Scenario 8: Authenticate with long database name (128 chars, multibyte)
-- tsql user=jdbc_user password=12345678 database=Dätàbäsé_Tëst_àáâãäåæçèéêëìíîïðñòóôõöøùúûüýþÿàáâãäåæçèéêëìíîïðñòóôõöøùúûüýþÿàáâãäåæçèéêëìíîïðñòóôõöøùúûüýþÿàáâãäåæçèéêëìíîïðñòóô
select db_name();
go

-- Scenario 9: Combined - both long login AND long database
-- Verifies both truncations work together in a single connection
-- tsql user=long_identifier_login_test_user_abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqr password=1234 database=long_identifier_database_test_abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrst
select suser_name(), db_name();
go

-- Scenario 10: Combined - both long login AND long database with mixed case
-- tsql user=Mixed_Case_Login_Test_XyZaBcDeFgHiJkLmNoPqRsTuVwXyZaBcDeFgHiJkLmNoPqRsTuVwXyZaBcDeFgHiJkLmNoPqRsTuVwXyZaBcDeFgHiJkLmNoPqRsTuVwXy password=1234 database=Mixed_Case_Database_Test_XyZaBcDeFgHiJkLmNoPqRsTuVwXyZaBcDeFgHiJkLmNoPqRsTuVwXyZaBcDeFgHiJkLmNoPqRsTuVwXyZaBcDeFgHiJkLmNoPqRsTuV
select suser_name(), db_name();
go

-- Terminate test sessions before cleanup
-- psql
SELECT pg_terminate_backend(pid) FROM pg_stat_activity
WHERE usename LIKE 'long_identifier_login_test_user%'
   OR usename LIKE 'mixed_case_login_test_%'
   OR usename LIKE 'boundary_test_login_%'
   OR usename LIKE 'case_insensitive_long_login_%'
   OR usename LIKE '%tëst_%';
GO

SELECT pg_sleep(1);
GO
