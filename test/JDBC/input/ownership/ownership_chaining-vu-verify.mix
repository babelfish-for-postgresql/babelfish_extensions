-- CASE 1: Simple Table/View references inside views
-- CASE 1.1: View referring table (success: ownership chain dbo->dbo)
select * from v3014_1_1;
go

-- CASE 1.2: View referring multiple table joined (success: all tables owned by dbo)
select * from v3014_1_2;
go

-- CASE 1.3: Nesting case - one-level (success: view->view->table all dbo owned)
select * from v3014_1_3;
go

-- CASE 1.4: Nesting case - two-level (success: recursive view reference in same owner)
select * from v3014_1_4;
go

-- CASE 2: Subquery inside views
-- CASE 2.1: Subquery in SELECT clause (success: correlated subquery within same owner)
select * from v3014_2_1;
go

-- CASE 2.2: Subquery in WHERE clause (success: IN subquery within same owner)
select * from v3014_2_2;
go

-- CASE 2.3: Subquery in FROM clause (success: derived table with join in same owner)
select * from v3014_2_3;
go

-- CASE 2.4: Correlated subquery in WHERE (success: EXISTS subquery within same owner)
select * from v3014_2_4;
go

-- CASE 2.5: Multiple nested subqueries (success: nested IN clauses all within same owner)
select * from v3014_2_5;
go

-- CASE 2.6: Subquery with function (failure: function ownership chain not supported)
select * from v3014_2_6;
go

-- CASE 2.7: Subquery in HAVING clause (success: aggregate subquery within same owner)
select * from v3014_2_7;
go

-- CASE 2.8: Subquery with set operations (success: UNION and IN within same owner)
select * from v3014_2_8;
go

-- CASE 2.9: Simple CTE
SELECT * FROM v3014_2_9;
GO

-- CASE 2.10: CTE with JOIN
SELECT * FROM v3014_2_10;
GO

-- CASE 2.11: Nested CTEs
SELECT * FROM v3014_2_11;
GO

-- CASE 2.12: CTE with subquery
SELECT * FROM v3014_2_12;
GO

-- CASE 2.13: CASE expression with subquery (success: subquery in CASE expression within same owner)
SELECT * FROM v3014_2_13;
GO

-- CASE 2.14: EXISTS and NOT EXISTS subqueries in WHERE clause (success: EXISTS and NOT EXISTS subqueries within same owner)
SELECT * FROM v3014_2_14;
GO

-- CASE 3: Function/procedure references (negative tests)
-- CASE 3.1: Views with scalar function references
select * from v3014_3_1;
go

-- CASE 3.2: Views with table-valued function references
select * from v3014_3_2;
go

-- CASE 3.3: Views with multiple function references
select * from v3014_3_3;
go

-- CASE 3.4: Views with table-returning function
select * from v3014_3_4;
go

-- CASE 3.5: Views with nested function calls
select * from v3014_3_5;
go

-- CASE 3.6: Views with function accessing tables
select * from v3014_3_6;
go

-- CASE 4: Negative cases where owners are different
-- CASE 4.1: View in dbo schema referencing table in sch3014_b (failure: cross-owner direct reference)
select * from v3014_4_1;
go

-- CASE 4.2: View in sch3014_b referencing table in dbo schema (failure: cross-owner direct reference)
select * from sch3014_b.v3014_4_2;
go

-- CASE 4.3: View in dbo schema referencing view in sch3014_b (failure: cross-owner view reference)
select * from v3014_4_3;
go

-- CASE 4.4: View in sch3014_b referencing view in dbo schema (failure: cross-owner view reference)
select * from sch3014_b.v3014_4_4;
go

-- CASE 4.5: View in dbo schema with subquery referencing table in sch3014_b (failure: cross-owner subquery)
select * from v3014_4_5;
go

-- CASE 4.6: View in sch3014_b with subquery referencing table in dbo schema (failure: cross-owner subquery)
select * from sch3014_b.v3014_4_6;
go

-- CASE 4.7: View in dbo schema referencing tables from both dbo and sch3014_b (failure: mixed owner join)
select * from v3014_4_7;
go

-- CASE 4.8: View in sch3014_b referencing tables from both sch3014_b and sch3014_c (failure: mixed owner join)
select * from sch3014_b.v3014_4_8;
go

-- CASE 5: Multi-level ownership chaining scenarios
-- CASE 5.1: Three-level chaining, all dbo owned (success: complete ownership chain)
select * from v3014_5_1c;
go

-- CASE 5.2: Three-level mixed ownership dbo->sch3014_b->dbo (failure: broken ownership chain)
select * from v3014_5_2c;
go

-- CASE 5.3: Three-level mixed ownership with joins (failure: multiple broken chains)
select * from sch3014_c.v3014_5_3c;
go

-- CASE 5.4: Three-level with subqueries, all dbo owned (success: complete ownership chain with subqueries)
select * from v3014_5_4c;
go

-- CASE 5.5: Three-level mixed ownership with subqueries (failure: broken chains in subqueries)
select * from sch3014_c.v3014_5_5c;
go

-- CASE 6: Cross-database ownership chain should be disabled
-- CASE 6.1: View in current database referencing table in another database (failure: cross-db reference)
select * from v3014_6_1;
GO

-- CASE 6.2: View in another database referencing table in current database (failure: cross-db reference)
select * from db3014.dbo.v3014_6_2;
GO

-- CASE 6.3: View with subquery referencing cross-database table (failure: cross-db in subquery)
select * from v3014_6_3;
GO

-- CASE 6.4: View with join to cross-database table (failure: cross-db join)
select * from v3014_6_4;
GO

-- CASE 7: Prep-Exec, Parametrized Query, Dynamic SQL cases
-- CASE 7.1: Parametrized query with ownership chain
-- First execution creates plan
DECLARE @param int = 1;
SELECT * FROM v3014_7_1 WHERE a = @param;
GO
-- Second execution uses cached plan
DECLARE @param int = 2;
SELECT * FROM v3014_7_1 WHERE a = @param;
GO

-- CASE 7.2: Parametrized query with joins
-- First execution creates plan
DECLARE @param int = 1;
SELECT * FROM v3014_7_2 WHERE a = @param;
GO
-- Second execution uses cached plan
DECLARE @param int = 2;
SELECT * FROM v3014_7_2 WHERE a = @param;
GO

-- CASE 7.3: Prepare/Execute with ownership chain
-- Prepare statement
DECLARE @handle int;
DECLARE @stmt nvarchar(max) = N'SELECT * FROM v3014_7_3 WHERE a = @p1';
EXEC sp_prepare @handle OUTPUT, N'@p1 int', @stmt;
GO
-- Execute prepared statement multiple times
EXEC sp_execute 1, 1;
GO
EXEC sp_execute 1, 2;
GO
-- Deallocate prepared statement
EXEC sp_unprepare 1;
GO

-- CASE 7.4: Dynamic SQL with ownership chain
DECLARE @sql nvarchar(max);
SET @sql = N'SELECT * FROM v3014_7_4 WHERE a = @id';
EXEC sp_executesql @sql, N'@id int', 1;
GO

-- CASE 8: DML-only ownership chaining
-- CASE 8.1: View with SELECT, INSERT permissions
SELECT * FROM v3014_8_1;  -- Should succeed
GO
INSERT INTO v3014_8_1 VALUES (1);  -- Should succeed
GO
UPDATE v3014_8_1 SET a = 2 WHERE a = 1;  -- Should fail
GO
DELETE FROM v3014_8_1 WHERE a = 1;  -- Should fail
GO

-- CASE 8.2: View with SELECT, UPDATE permissions
SELECT * FROM v3014_8_2;  -- Should succeed
GO
INSERT INTO v3014_8_2 VALUES (2);  -- Should fail
GO
UPDATE v3014_8_2 SET a = 3 WHERE a = 2;  -- Should succeed
GO
DELETE FROM v3014_8_2 WHERE a = 2;  -- Should fail
GO

-- CASE 8.3: View with SELECT, DELETE permissions
SELECT * FROM v3014_8_3;  -- Should succeed
GO
INSERT INTO v3014_8_3 VALUES (3);  -- Should fail
GO
UPDATE v3014_8_3 SET a = 4 WHERE a = 3;  -- Should fail
GO
DELETE FROM v3014_8_3 WHERE a = 3;  -- Should succeed
GO

-- CASE 8.4: View with SELECT, INSERT, UPDATE permissions
SELECT * FROM v3014_8_4;  -- Should succeed
GO
INSERT INTO v3014_8_4 VALUES (4);  -- Should succeed
GO
UPDATE v3014_8_4 SET a = 5 WHERE a = 4;  -- Should succeed
GO
DELETE FROM v3014_8_4 WHERE a = 4;  -- Should fail
GO

-- CASE 9: Trigger ownership chaining scenarios
-- TODO: will be passing after procedure/function support
-- CASE 9.1: AFTER INSERT trigger with same owner
INSERT INTO v3014_9_1 VALUES (1);  -- Should succeed and trigger should fire
GO
SELECT * FROM v3014_9_1;  -- Should show inserted value
GO
SELECT * FROM t3014_9_2;  -- Should fail (no direct access)
GO

-- CASE 9.2: AFTER UPDATE trigger with different owner
INSERT INTO t3014_9_3 VALUES (1);  -- Setup data
GO
UPDATE v3014_9_2 SET a = 2 WHERE a = 1;  -- Should fail due to trigger permission
GO
SELECT * FROM v3014_9_2;  -- Should show original value
GO

-- CASE 9.3: INSTEAD OF trigger same owner
INSERT INTO v3014_9_3 VALUES (1);  -- Should succeed through INSTEAD OF trigger
GO
SELECT * FROM v3014_9_3;  -- Should show inserted value
GO
SELECT * FROM t3014_9_5;  -- Should fail (no direct access)
GO

-- CASE 9.4: Nested triggers same owner
INSERT INTO t3014_9_6 VALUES (1);  -- Setup data
GO
DELETE FROM v3014_9_4 WHERE a = 1;  -- Should succeed and both triggers should fire
GO
SELECT * FROM v3014_9_4;  -- Should show empty
GO
SELECT * FROM t3014_9_7;  -- Should fail (no direct access)
GO
SELECT * FROM t3014_9_8;  -- Should fail (no direct access)
GO
