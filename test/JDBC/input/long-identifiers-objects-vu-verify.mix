-- sla 500000
-- Verify table name after upgrade
SELECT name FROM sys.tables WHERE name LIKE 'Very_Long_Table%VU_TVC';
GO

-- Verify column name after upgrade
SELECT name FROM sys.columns WHERE object_id = OBJECT_ID('Very_Long_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_VU_TVC') AND name LIKE 'Very_Long_Column%';
GO

-- Verify view name after upgrade
SELECT name FROM sys.views WHERE name LIKE 'Very_Long_View%VU_TVC';
GO

-- Verify index name after upgrade
SELECT name FROM sys.indexes WHERE name LIKE 'Very_Long_Index%VU_TVC';
GO

-- Verify view column alias after upgrade
SELECT name FROM sys.columns WHERE object_id = OBJECT_ID('babel5975_tvc_vu_alias') AND name LIKE 'Very_Long_Alias%';
GO

-- Verify sys.all_views
SELECT name FROM sys.all_views WHERE name LIKE 'Very_Long_View%VU_TVC';
GO

-- Verify sys.all_objects (table)
SELECT name FROM sys.all_objects WHERE name LIKE 'Very_Long_Table%VU_TVC' AND type = 'U';
GO

-- Verify sys.all_objects (view)
SELECT name FROM sys.all_objects WHERE name LIKE 'Very_Long_View%VU_TVC' AND type = 'V';
GO

-- Verify sys.all_columns
SELECT name FROM sys.all_columns WHERE object_id = OBJECT_ID('Very_Long_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_VU_TVC') AND name LIKE 'Very_Long_Column%';
GO

-- Verify information_schema.views
SELECT TABLE_NAME FROM information_schema.views WHERE TABLE_NAME LIKE 'Very_Long_View%VU_TVC';
GO

-- Verify information_schema.columns
SELECT COLUMN_NAME FROM information_schema.columns WHERE TABLE_NAME LIKE 'Very_Long_Table%VU_TVC' AND COLUMN_NAME LIKE 'Very_Long%';
GO

-- Verify sp_tables
EXEC sp_tables @table_name = 'Very_Long_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_VU_TVC';
GO

-- Verify sp_columns
EXEC sp_columns @table_name = 'Very_Long_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_VU_TVC';
GO

-- Verify sp_statistics
EXEC sp_statistics @table_name = 'Very_Long_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_VU_TVC';
GO

-- Verify sys.all_sql_modules (view definition lookup)
SELECT CASE WHEN definition IS NOT NULL THEN 'HAS_DEFINITION' ELSE 'NO_DEFINITION' END FROM sys.all_sql_modules WHERE object_id = OBJECT_ID('Very_Long_View_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_VU_TVC');
GO

-- Verify sp_fkeys
EXEC sp_fkeys @pktable_name = 'Very_Long_PK_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_VU_TVC';
GO

-- Verify sp_special_columns
EXEC sp_special_columns @table_name = 'Very_Long_PK_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_VU_TVC';
GO

-- ===========================================
-- BABEL-5321: system procedures must resolve long identifiers passed either
-- as the original name or as the truncated (physical) name, and must display
-- the original (full) name.
-- ===========================================

-- Type-1 procs: calling with the TRUNCATED (physical) name must still return
-- rows (backward compatibility for tools that captured the physical name).
DECLARE @trunc_tbl sys.sysname = sys.babelfish_truncate_identifier(LOWER('Very_Long_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_VU_TVC'));
DECLARE @trunc_pk sys.sysname = sys.babelfish_truncate_identifier(LOWER('Very_Long_PK_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_VU_TVC'));

-- sp_tables with truncated name
EXEC sp_tables @table_name = @trunc_tbl;
GO
DECLARE @trunc_tbl sys.sysname = sys.babelfish_truncate_identifier(LOWER('Very_Long_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_VU_TVC'));
-- sp_columns with truncated name
EXEC sp_columns @table_name = @trunc_tbl;
GO
DECLARE @trunc_tbl sys.sysname = sys.babelfish_truncate_identifier(LOWER('Very_Long_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_VU_TVC'));
-- sp_statistics with truncated name
EXEC sp_statistics @table_name = @trunc_tbl;
GO
DECLARE @trunc_pk sys.sysname = sys.babelfish_truncate_identifier(LOWER('Very_Long_PK_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_VU_TVC'));
-- sp_pkeys with truncated name
EXEC sp_pkeys @table_name = @trunc_pk;
GO
DECLARE @trunc_pk sys.sysname = sys.babelfish_truncate_identifier(LOWER('Very_Long_PK_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_VU_TVC'));
-- sp_fkeys with truncated pktable name
EXEC sp_fkeys @pktable_name = @trunc_pk;
GO

-- Type-2 procs: calling with the ORIGINAL name must return rows and display
-- the full original TABLE_NAME (these previously matched only the physical name).
EXEC sp_table_privileges @table_name = 'Very_Long_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_VU_TVC';
GO
EXEC sp_column_privileges @table_name = 'Very_Long_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_VU_TVC';
GO

-- ===========================================
-- BABEL-5975: OBJECT_NAME() must return the resolved long identifier in its
-- physical (lowercased) form for tables, views, and indexes. OBJECT_ID()
-- accepts the original name; OBJECT_NAME() reports the downcased name.
-- ===========================================

-- OBJECT_NAME() for a long table name
SELECT OBJECT_NAME(OBJECT_ID('Very_Long_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_VU_TVC'));
GO

-- OBJECT_NAME() for a long view name
SELECT OBJECT_NAME(OBJECT_ID('Very_Long_View_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_VU_TVC'));
GO

-- Note: OBJECT_NAME() for a long INDEX name shares the same RELKIND_INDEX /
-- get_original_relname downcasing path as the table/view cases above; the
-- displayed (lowercased) index name is already covered by the sys.indexes
-- query earlier in this file. OBJECT_ID() does not resolve index names and the
-- T-SQL parser rejects pg_class alias subqueries, so no separate OBJECT_NAME
-- index case is added here.

-- ===========================================
-- Catalog sweep: tables/constraints/columns with long (>=64 byte) names must
-- show the original name, not the truncated+md5 hashed physical name, across
-- sys.indexes, COL_NAME, sys.computed_columns, INFORMATION_SCHEMA.TABLE_CONSTRAINTS/
-- KEY_COLUMN_USAGE/CONSTRAINT_COLUMN_USAGE, sp_pkeys_view, sp_fkeys_view,
-- sp_sproc_columns_view, and INFORMATION_SCHEMA.COLUMNS/COLUMN_DOMAIN_USAGE.DOMAIN_NAME.
-- ===========================================

-- Verify the backing index of an inline long-named PK shows the original
-- constraint name in sys.indexes, not the truncated+hashed physical name.
SELECT name FROM sys.indexes WHERE object_id = OBJECT_ID('Very_Long_Catalog_Parent_Table_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Chars_VU_TVC') AND name IS NOT NULL;
GO

-- Verify COL_NAME returns the original column name, not the hashed one.
SELECT COL_NAME(OBJECT_ID('Very_Long_Catalog_Column_Table_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Chars_VU_TVC'), 1);
GO

-- Verify sys.computed_columns.definition deparses the original column name.
SELECT definition FROM sys.computed_columns WHERE object_id = OBJECT_ID('Very_Long_Catalog_Computed_Table_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Chars_VU_TVC');
GO

-- Verify INFORMATION_SCHEMA.TABLE_CONSTRAINTS.TABLE_NAME shows the original name.
SELECT CONSTRAINT_NAME, TABLE_NAME FROM INFORMATION_SCHEMA.TABLE_CONSTRAINTS WHERE TABLE_NAME = 'Very_Long_Catalog_Parent_Table_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Chars_VU_TVC';
GO

-- Verify INFORMATION_SCHEMA.KEY_COLUMN_USAGE.TABLE_NAME shows the original name.
SELECT TABLE_NAME, COLUMN_NAME, CONSTRAINT_NAME FROM INFORMATION_SCHEMA.KEY_COLUMN_USAGE WHERE TABLE_NAME = 'Very_Long_Catalog_Parent_Table_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Chars_VU_TVC';
GO

-- Verify INFORMATION_SCHEMA.CONSTRAINT_COLUMN_USAGE shows original names for all three columns.
SELECT CONSTRAINT_NAME, TABLE_NAME, COLUMN_NAME FROM INFORMATION_SCHEMA.CONSTRAINT_COLUMN_USAGE WHERE TABLE_NAME = 'Very_Long_Catalog_Parent_Table_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Chars_VU_TVC';
GO

-- Verify sp_pkeys_view.pk_name shows the original constraint name.
SELECT pk_name FROM sys.sp_pkeys_view WHERE table_name = 'Very_Long_Catalog_Parent_Table_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Chars_VU_TVC';
GO

-- Verify sp_fkeys_view.fk_name/pk_name show the original constraint names.
SELECT fk_name, pk_name FROM sys.sp_fkeys_view WHERE fktable_name = 'very_long_catalog_child_table_that_exceeds_postgresql_limit_of_sixty_chars_vu_tvc';
GO

-- Verify sp_sproc_columns_view.column_name shows the original parameter name.
SELECT column_name FROM sys.sp_sproc_columns_view WHERE procedure_name LIKE 'Very_Long_Catalog_Procedure_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Chars_VU_TVC%' AND column_name LIKE '@Very_Long%';
GO

-- Verify INFORMATION_SCHEMA.COLUMNS.DOMAIN_NAME shows the original domain name.
SELECT DOMAIN_NAME FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = 'Very_Long_Catalog_Domain_Usage_Table_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Chars_VU_TVC';
GO

-- Verify INFORMATION_SCHEMA.COLUMN_DOMAIN_USAGE.DOMAIN_NAME shows the original domain name.
SELECT DOMAIN_NAME FROM INFORMATION_SCHEMA.COLUMN_DOMAIN_USAGE WHERE TABLE_NAME = 'Very_Long_Catalog_Domain_Usage_Table_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Chars_VU_TVC';
GO

