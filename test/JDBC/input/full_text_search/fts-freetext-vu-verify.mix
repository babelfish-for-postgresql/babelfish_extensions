-- Test cases for the relation new_schema_freetext.multicol_freetext_tb
SELECT * FROM new_schema_freetext.multicol_freetext_tb WHERE freetext((txt, val), 'Product-A123')
GO

-- should throw an error as the previous full text index is not dropped
CREATE FULLTEXT INDEX ON new_schema_freetext.multicol_freetext_tb(
        val, 
        chr) KEY INDEX usr
GO

DROP FULLTEXT INDEX ON new_schema_freetext.multicol_freetext_tb
GO

CREATE FULLTEXT INDEX ON new_schema_freetext.multicol_freetext_tb(
        txt, 
        val, 
        chr) KEY INDEX usr
GO

SELECT * FROM new_schema_freetext.multicol_freetext_tb WHERE freetext((
        multicol_freetext_tb.txt, 
        val), '"brown fox"')
GO

SELECT * FROM new_schema_freetext.multicol_freetext_tb WHERE freetext((
        multicol_freetext_tb.val, 
        multicol_freetext_tb.chr), 'TEST-999')
GO

SELECT * FROM new_schema_freetext.multicol_freetext_tb WHERE freetext((
        new_schema_freetext.multicol_freetext_tb.txt, 
        multicol_freetext_tb.chr), 'three')
GO

SELECT * FROM new_schema_freetext.multicol_freetext_tb WHERE freetext((
        new_schema_freetext.multicol_freetext_tb.txt, 
        new_schema_freetext.multicol_freetext_tb.val, 
        chr), 'Invoice/001')
GO

-- NULL test
SELECT * FROM new_schema_freetext.multicol_freetext_tb WHERE freetext((
        txt, 
        val, 
        chr), '')
GO

-- A stop word used as a predicate, should give warning that only a stop word is used in predicate, but does not give the warning
SELECT * FROM new_schema_freetext.multicol_freetext_tb WHERE freetext((
        txt, 
        val, 
        chr), 'The')
GO

-- Phrase made of only stop words is used as a predicate, should give warning and no result, but gives ambiguous result result
SELECT * FROM new_schema_freetext.multicol_freetext_tb WHERE freetext((
        txt,
        val, 
        chr), '"To be"')
GO

-- Throws error as the column name is not valid
SELECT * FROM new_schema_freetext.multicol_freetext_tb WHERE freetext(( 
        ,
        val, 
        chr), '"and no play"')
GO

-- Throws error as NULL is passed as a column
SELECT * FROM new_schema_freetext.multicol_freetext_tb WHERE freetext((
        txt, 
        NULL, 
        chr), 'Order_789')
GO

-- Test cases for content_tb
CREATE UNIQUE INDEX ucid ON content_tb(id)
GO

CREATE FULLTEXT INDEX ON content_tb(
        text_column,
        char_column,
        varchar_column,
        ntext_column,
        nchar_column) KEY INDEX ucid
GO

SELECT * FROM content_tb WHERE freetext((
        text_column, 
        char_column, 
        varchar_column), '"Planning phase"')
GO

-- Case sensitivity of column names
SELECT * FROM content_tb WHERE freetext((
        TEXT_COLUMN, 
        char_column, 
        Varchar_Column), '"Planning phase"')
GO

-- should throw error as 'nvarchar_column' is not fulltext index
SELECT * FROM content_tb WHERE freetext((
        text_column,
        char_column,
        varchar_column,
        nvarchar_column,
        ntext_column,
        nchar_column), 'documentation')
GO

-- disable FULLTEXT
SELECT set_config('babelfishpg_tsql.escape_hatch_fulltext', 'strict', 'false')
GO