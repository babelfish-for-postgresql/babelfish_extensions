-- Multiple column test cases for the relation fts_freetext_multicol_t
-- gives error as fulltext index is still not created
SELECT * FROM fts_freetext_multicol_t WHERE freetext(txt1, '"human quantum')
GO

CREATE FULLTEXT INDEX ON fts_freetext_multicol_t(
        txt1, 
        txt2, 
        txt3, 
        txt4) KEY INDEX uid
GO


SELECT * FROM fts_freetext_multicol_t WHERE freetext((txt1, txt2, txt4), '"Artificial Intelligence"' )
GO

DROP FULLTEXT INDEX ON fts_freetext_multicol_t
GO

CREATE FULLTEXT INDEX ON fts_freetext_multicol_t(
        txt1, 
        txt2) KEY INDEX uid
GO

SELECT * FROM fts_freetext_multicol_t WHERE freetext((txt1, txt2), '"The human genome"' )
GO

-- negative test
-- should throw an error as there exists no column with the name txt5
SELECT * FROM fts_freetext_multicol_t WHERE freetext((txt1, txt5), '"The Industrial Revolution"')
GO

-- NULL test
SELECT * FROM fts_freetext_multicol_t WHERE freetext((txt1, txt2), '')
GO

DROP FULLTEXT INDEX ON fts_freetext_multicol_t
GO

CREATE FULLTEXT INDEX ON fts_freetext_multicol_t(
        txt1, 
        txt2,
        txt3,
        txt4) KEY INDEX uid
GO

SELECT * FROM fts_freetext_multicol_t WHERE freetext((
        txt1, 
        txt2,
        txt3,
        txt4), 'genome DNA');
GO

SELECT * FROM fts_freetext_multicol_t WHERE freetext((
        txt1,
        txt2,
        txt3,
        txt4), 'Renaissance "Ancient Egyptian"');
GO

SELECT * FROM fts_freetext_multicol_t WHERE freetext((
        txt1, 
        txt2,
        txt3,
        txt4), '"Artificial Intelligence" AND technology OR computing');
GO

SELECT * FROM fts_freetext_multicol_t WHERE freetext((
        txt1, 
        txt2,
        txt3,
        txt4), 'art "artist" Picasso');
GO

SELECT * FROM fts_freetext_multicol_t WHERE freetext((
        txt1, 
        txt2,
        txt3,
        txt4), 'quantum physics computing "calculation" genome');
GO

SELECT * FROM fts_freetext_multicol_t WHERE freetext((
        txt1, 
        txt2,
        txt3,
        txt4), 'blockchain "cloud computing" technology genome DNA');
GO

SELECT * FROM fts_freetext_multicol_t WHERE freetext((
        txt1, 
        txt2,
        txt3,
        txt4), '"Starry Night" symphony Mozart "van Gogh" Shakespeare');
