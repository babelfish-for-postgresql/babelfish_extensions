-- Full syntax of freetext: https://github.com/MicrosoftDocs/sql-docs/blob/live/docs/t-sql/queries/freetext-transact-sql.md

-- Test basic freetext use: ... freetext({col_name | column_list}, <freetext_search_string>) ...


-- sys.babelfish_freetext_rewrite()
SELECT sys.babelfish_freetext_rewrite('"one two three four"');
GO

SELECT sys.babelfish_freetext_rewrite('"one   @ two    ^ three"');
GO

SELECT sys.babelfish_freetext_rewrite('"one @ two"');
GO

SELECT sys.babelfish_freetext_rewrite('one "two"')
GO

SELECT sys.babelfish_freetext_rewrite('one"')
GO

SELECT sys.babelfish_freetext_rewrite('one:  ')
GO

SELECT sys.babelfish_freetext_rewrite('  :one')
GO

SELECT sys.babelfish_freetext_rewrite('   "one    two"')
GO

SELECT sys.babelfish_freetext_rewrite('"one   two  "    ')
GO

SELECT sys.babelfish_freetext_rewrite('     "    one      two   "  three "    ')
GO

SELECT sys.babelfish_freetext_rewrite('"         one"')
GO

SELECT sys.babelfish_freetext_rewrite('"much of the"')
GO


-- tab character in search string
DECLARE @query VARCHAR(100)
SET @query = '"due' + char(9) + 'to"'
SELECT sys.babelfish_freetext_rewrite(@query)
GO

DECLARE @query VARCHAR(100)
SET @query = '"due' + char(9) + 'to"'
EXEC fts_freetext_vu_prepare_p1 @query
GO

-- line break
DECLARE @query VARCHAR(100)
SET @query = '"due' + char(10) + 'to"'
SELECT sys.babelfish_freetext_rewrite(@query)
GO

DECLARE @query VARCHAR(100)
SET @query = '"due' + char(10) + 'to"'
EXEC fts_freetext_vu_prepare_p1 @query
GO


-- no-break space character
declare @my_str varchar(50) = '"due'+char(160)+'to"';
EXEC fts_freetext_vu_prepare_p1 @my_str
GO


