-- Transactionality test
BEGIN TRANSACTION;
EXEC fts_freetext_vu_prepare_p1 '   "  daily news            " '
COMMIT TRANSACTION;
GO



-- combination of spaces, tabs and line break
DECLARE @a VARCHAR(100)
SET @a = 'beer'+ char(10) +'And' + char(10) + ' wine'
EXEC fts_freetext_vu_prepare_p1 @a
GO

DECLARE @a VARCHAR(100)
SET @a = '"french' + char(10) + 'tarts"' + char(9) + ' or ' + char(10) + 'pastry'
EXEC fts_freetext_vu_prepare_p1 @a
GO

DECLARE @a VARCHAR(100)
SET @a = 'wine And'+ char(9) + char(10) + ' nOt resveratrol'
EXEC fts_freetext_vu_prepare_p1 @a
GO

DECLARE @a VARCHAR(100)
SET @a = 'aircraft anD '+ char(9) + 'Not' + char(9) + '"helicopter"'
EXEC fts_freetext_vu_prepare_p1 @a
GO

DECLARE @a VARCHAR(100)
SET @a = 'aircraft' + char(9) + 'anD ' + char(10) + char(10) + ' NoT' + char(10) + '" helicopter"'
EXEC fts_freetext_vu_prepare_p1 @a
GO

DECLARE @a VARCHAR(100)
SET @a = 'Resveratrol' + char(9) + 'AND Rats or "hear" "loud' + char(9) + 'noises"'
EXEC fts_freetext_vu_prepare_p1 @a
GO


-- Common Table Expression
WITH fts_freetext_vu_cte1 AS (
    SELECT *
    FROM fts_freetext_vu_t
    WHERE freetext(txt, 'resveratrol grape and wine')
)
SELECT * FROM fts_freetext_vu_cte1
GO

WITH fts_freetext_vu_cte2 AS (
    SELECT *
    FROM fts_freetext_vu_t
)
SELECT *
FROM fts_freetext_vu_cte2
WHERE freetext(txt, 'resveratrol grape and wine')
GO

