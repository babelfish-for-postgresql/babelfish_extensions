-- TEST: PREPARATION - Create logins and setup

-- tsql
CREATE LOGIN alter_owner_login WITH PASSWORD = '12345678';
GO
CREATE LOGIN new_owner_login WITH PASSWORD = '12345678';
GO

ALTER SERVER ROLE sysadmin ADD MEMBER alter_owner_login;
GO
-- terminate-tsql-conn


-- TEST: Setup - Create database and objects

-- tsql user=alter_owner_login password=12345678
SELECT suser_name(), db_name();
GO

CREATE DATABASE alter_owner_test_db;
GO

USE alter_owner_test_db;
GO

CREATE SCHEMA test_schema;
GO

CREATE USER new_owner_login FOR LOGIN new_owner_login;
GO

CREATE TABLE test_schema.test_table (
    id INT PRIMARY KEY IDENTITY(1,1),
    name VARCHAR(100),
    value DECIMAL(10,2)
);
GO

CREATE TABLE test_schema.test_table_computed (
    id INT PRIMARY KEY IDENTITY(1,1),
    quantity INT,
    unit_price DECIMAL(10,2),
    discount_percent DECIMAL(5,2),
    total_price AS (quantity * unit_price),
    discount_amount AS (quantity * unit_price * discount_percent / 100),
    net_price AS (quantity * unit_price * (1 - discount_percent / 100))
);
GO

CREATE VIEW test_schema.test_view
AS
SELECT id, name FROM test_schema.test_table;
GO

CREATE VIEW test_schema.test_view_schemabinding
WITH SCHEMABINDING
AS
SELECT id, name FROM test_schema.test_table;
GO

CREATE FUNCTION test_schema.fn_scalar(@input INT)
RETURNS INT
AS
BEGIN
    RETURN @input * 2;
END;
GO

CREATE FUNCTION test_schema.fn_inline_tvf(@id INT)
RETURNS TABLE
AS
RETURN (
    SELECT id, name FROM test_schema.test_table WHERE id = @id
);
GO

CREATE FUNCTION test_schema.fn_multi_tvf(@id INT)
RETURNS @result TABLE (
    id INT,
    name VARCHAR(100)
)
AS
BEGIN
    INSERT INTO @result
    SELECT id, name FROM test_schema.test_table WHERE id = @id;
    RETURN;
END;
GO

CREATE PROCEDURE test_schema.sp_test
AS
BEGIN
    SELECT * FROM test_schema.test_table;
END;
GO

CREATE PROCEDURE test_schema.sp_test_params
    @id INT,
    @name VARCHAR(100) OUTPUT
AS
BEGIN
    SELECT @name = name FROM test_schema.test_table WHERE id = @id;
END;
GO

CREATE SEQUENCE test_schema.test_seq
START WITH 1
INCREMENT BY 1;
GO

CREATE SEQUENCE test_schema.test_seq_options
START WITH 100
INCREMENT BY 10
MINVALUE 100
MAXVALUE 10000
CYCLE
CACHE 5;
GO

CREATE TYPE test_schema.udt_phone FROM VARCHAR(15);
GO

CREATE TYPE test_schema.udt_money FROM DECIMAL(19,4);
GO

CREATE TYPE test_schema.udt_code FROM CHAR(10) NOT NULL;
GO

CREATE TYPE test_schema.udt_table_simple AS TABLE (
    id INT,
    name VARCHAR(100)
);
GO

CREATE TYPE test_schema.udt_table_complex AS TABLE (
    id INT PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    value DECIMAL(10,2) DEFAULT 0,
    created_date DATETIME DEFAULT GETDATE()
);
GO

CREATE TRIGGER test_schema.trg_test_insert
ON test_schema.test_table
AFTER INSERT
AS
BEGIN
    PRINT 'Record inserted';
END;
GO

CREATE TRIGGER test_schema.trg_test_update
ON test_schema.test_table
AFTER UPDATE
AS
BEGIN
    PRINT 'Record updated';
END;
GO

CREATE TABLE dbo.dbo_test_table (
    id INT PRIMARY KEY,
    data VARCHAR(100)
);
GO

CREATE VIEW dbo.dbo_test_view
AS
SELECT id, data FROM dbo.dbo_test_table;
GO

CREATE FUNCTION dbo.dbo_fn_test(@val INT)
RETURNS INT
AS
BEGIN
    RETURN @val;
END;
GO

CREATE PROCEDURE dbo.dbo_sp_test
AS
BEGIN
    SELECT 1;
END;
GO

CREATE SEQUENCE dbo.dbo_test_seq START WITH 1;
GO

CREATE TYPE dbo.dbo_udt_test FROM VARCHAR(50);
GO

USE master;
GO
