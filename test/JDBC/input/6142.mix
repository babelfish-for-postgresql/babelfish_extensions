-- TEST: Native PG objects should SUCCEED regardless of GUC settings

-- psql user=alter_owner_login password=12345678
SET babelfishpg_tsql.dump_restore = false;
GO
SET babelfishpg_tsql.enable_alter_owner_from_pg = false;
GO

CREATE SCHEMA pg_native_schema;
GO

CREATE TABLE pg_native_schema.pg_table (
    id INT,
    data TEXT
);
GO

CREATE VIEW pg_native_schema.pg_view AS
SELECT id, data FROM pg_native_schema.pg_table;
GO

CREATE FUNCTION pg_native_schema.pg_func(input_val INT)
RETURNS INT AS $$
SELECT input_val * 2;
$$ LANGUAGE SQL;
GO

CREATE PROCEDURE pg_native_schema.pg_proc()
AS $$
SELECT 1;
$$ LANGUAGE SQL;
GO

CREATE SEQUENCE pg_native_schema.pg_seq;
GO

CREATE TYPE pg_native_schema.pg_composite AS (
    field1 INT,
    field2 TEXT
);
GO

CREATE DOMAIN pg_native_schema.pg_domain AS VARCHAR(100);
GO

ALTER TABLE pg_native_schema.pg_table OWNER TO new_owner_login;
GO

ALTER VIEW pg_native_schema.pg_view OWNER TO new_owner_login;
GO

ALTER FUNCTION pg_native_schema.pg_func(INT) OWNER TO new_owner_login;
GO

ALTER PROCEDURE pg_native_schema.pg_proc() OWNER TO new_owner_login;
GO

ALTER SEQUENCE pg_native_schema.pg_seq OWNER TO new_owner_login;
GO

ALTER TYPE pg_native_schema.pg_composite OWNER TO new_owner_login;
GO

ALTER DOMAIN pg_native_schema.pg_domain OWNER TO new_owner_login;
GO

ALTER SCHEMA pg_native_schema OWNER TO new_owner_login;
GO

DROP SCHEMA pg_native_schema CASCADE;
GO
