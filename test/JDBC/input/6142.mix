-- TEST: EDGE CASE - Toggle GUC within transaction

-- psql user=alter_owner_login password=12345678
SET babelfishpg_tsql.dump_restore = true;
GO
ALTER TABLE alter_owner_test_db_test_schema.test_table OWNER TO alter_owner_login;
GO
SET babelfishpg_tsql.dump_restore = false;
GO

BEGIN;
GO

ALTER TABLE alter_owner_test_db_test_schema.test_table OWNER TO new_owner_login;
GO

SET babelfishpg_tsql.enable_alter_owner_from_pg = true;
GO

ALTER TABLE alter_owner_test_db_test_schema.test_table OWNER TO new_owner_login;
GO

COMMIT;
GO

SET babelfishpg_tsql.enable_alter_owner_from_pg = false;
GO
-- terminate-psql-conn user=alter_owner_login password=12345678


-- TEST: EDGE CASE - Transaction rollback with ownership change

-- psql user=alter_owner_login password=12345678
SET babelfishpg_tsql.dump_restore = true;
GO
ALTER TABLE alter_owner_test_db_test_schema.test_table OWNER TO alter_owner_login;
GO

SELECT tableowner FROM pg_tables 
WHERE schemaname = 'alter_owner_test_db_test_schema' AND tablename = 'test_table';
GO

BEGIN;
GO

ALTER TABLE alter_owner_test_db_test_schema.test_table OWNER TO new_owner_login;
GO

SELECT tableowner FROM pg_tables 
WHERE schemaname = 'alter_owner_test_db_test_schema' AND tablename = 'test_table';
GO

ROLLBACK;
GO

SELECT tableowner FROM pg_tables 
WHERE schemaname = 'alter_owner_test_db_test_schema' AND tablename = 'test_table';
GO

SET babelfishpg_tsql.dump_restore = false;
GO
-- terminate-psql-conn user=alter_owner_login password=12345678


-- TEST: EDGE CASE - GUC case sensitivity


-- psql user=alter_owner_login password=12345678
SET babelfishpg_tsql.dump_restore = TRUE;
GO
SHOW babelfishpg_tsql.dump_restore;
GO

ALTER TABLE alter_owner_test_db_test_schema.test_table OWNER TO new_owner_login;
GO

SET babelfishpg_tsql.dump_restore = 'true';
GO
ALTER TABLE alter_owner_test_db_test_schema.test_table OWNER TO alter_owner_login;
GO

SET babelfishpg_tsql.dump_restore = 'on';
GO
ALTER TABLE alter_owner_test_db_test_schema.test_table OWNER TO new_owner_login;
GO

SET babelfishpg_tsql.dump_restore = '1';
GO
ALTER TABLE alter_owner_test_db_test_schema.test_table OWNER TO alter_owner_login;
GO

SET babelfishpg_tsql.dump_restore = false;
GO
-- terminate-psql-conn user=alter_owner_login password=12345678


