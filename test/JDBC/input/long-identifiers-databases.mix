-- Test long identifier handling for database names (PR3 scope)
-- Tests: CREATE DATABASE with long name, orig_name storage, sys.databases/sysdatabases resolution,
-- DB_NAME() case preservation, sp_tables/information_schema in long-named DB

-- tsql

-- ===========================================
-- CREATE DATABASE with long name
-- ===========================================
CREATE DATABASE Very_Long_Database_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_Testing;
GO

-- Verify database original name stored in babelfish_sysdatabases.orig_name
SELECT orig_name FROM sys.babelfish_sysdatabases WHERE orig_name LIKE 'Very_Long_Database%';
GO

USE Very_Long_Database_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_Testing;
GO

-- Verify DB_NAME() returns case-preserved name
SELECT DB_NAME();
GO

-- sys.databases shows case-preserved database name
SELECT name FROM sys.databases WHERE name LIKE '%Long_Database%';
GO

USE master;
GO

DROP DATABASE Very_Long_Database_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_Testing;
GO

-- ===========================================
-- Second database test with sp_tables and information_schema
-- ===========================================
CREATE DATABASE Test_Long_DB_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters;
GO
USE Test_Long_DB_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters;
GO

-- sys.sysdatabases shows case-preserved name
SELECT name FROM sys.sysdatabases WHERE name LIKE '%Long_DB_Name%';
GO

-- DB_NAME() comparison with sys.sysdatabases works (CI collation)
SELECT name FROM sys.sysdatabases WHERE name = DB_NAME() collate database_default;
GO

-- sp_tables works in long-named database
EXEC sp_tables;
GO

-- information_schema.tables works in long-named database
SELECT TABLE_CATALOG FROM information_schema.tables WHERE TABLE_CATALOG LIKE '%Long_DB%';
GO

USE master;
GO
DROP DATABASE Test_Long_DB_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters;
GO

-- ===========================================
-- Mixed case database name preservation
-- ===========================================
CREATE DATABASE MixedCase_Long_DB_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters;
GO

-- Verify case-insensitive lookup works
SELECT name FROM sys.databases WHERE name = 'mixedcase_long_db_name_that_exceeds_postgresql_limit_of_sixty_three_characters';
GO

DROP DATABASE MixedCase_Long_DB_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters;
GO

-- ===========================================
-- Verify catalog entries removed after DROP DATABASE
-- ===========================================
CREATE DATABASE Very_Long_Database_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters;
GO
USE Very_Long_Database_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters;
GO
CREATE TABLE babel5975_db_drop_test (id INT);
GO
USE master;
GO
DROP DATABASE Very_Long_Database_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters;
GO

-- Verify database is gone from sys.databases
SELECT name FROM sys.databases WHERE name LIKE '%Very_Long_Database%';
GO

-- Verify orig_name removed from babelfish_sysdatabases
SELECT orig_name FROM sys.babelfish_sysdatabases WHERE orig_name LIKE 'Very_Long_Database%';
GO

-- ===========================================
-- DATABASEPROPERTYEX / HAS_DBACCESS / USE / sp_helpdb with a long name
-- (regression coverage for lookups that must normalize the original name
--  to the physical downcased/truncated key)
-- ===========================================
CREATE DATABASE My_Very_Long_Database_Name_That_Exceeds_The_PostgreSQL_NAMEDATALEN_Limit_Of_63;
GO

-- DATABASEPROPERTYEX must resolve the long original name (previously failed
-- with "Could not find database")
SELECT DATABASEPROPERTYEX('My_Very_Long_Database_Name_That_Exceeds_The_PostgreSQL_NAMEDATALEN_Limit_Of_63', 'Collation');
GO

-- HAS_DBACCESS must resolve the long original name (previously failed with
-- "database ... does not exist")
SELECT HAS_DBACCESS('My_Very_Long_Database_Name_That_Exceeds_The_PostgreSQL_NAMEDATALEN_Limit_Of_63');
GO

-- USE must report the original (case/length preserved) name, not the internal
-- truncated+hashed physical name
USE My_Very_Long_Database_Name_That_Exceeds_The_PostgreSQL_NAMEDATALEN_Limit_Of_63;
GO

-- sys.database_principals must resolve inside a long-named database. This view
-- filters on sys.bbf_cur_db(), so it exercises the current-database name
-- resolution for a long/truncated physical name.
SELECT name, type_desc FROM sys.database_principals WHERE name IN ('dbo','guest','db_owner') ORDER BY name;
GO

-- sp_helpdb (no arg) must list the long database using its original name and
-- must not crash on a NULL orig_name; project deterministic columns only
SELECT name, compatibility_level FROM sys.babelfish_helpdb() WHERE name LIKE 'My_Very_Long_Database%';
GO

USE master;
GO

-- sp_helpdb with the long original name argument exercises the scan-key
-- normalization and the NULL-handling read path in babelfish_helpdb()
SELECT name, compatibility_level FROM sys.babelfish_helpdb('My_Very_Long_Database_Name_That_Exceeds_The_PostgreSQL_NAMEDATALEN_Limit_Of_63');
GO

-- A login whose DEFAULT_DATABASE is the long-named database must expose the
-- full original name in sys.sql_logins and sys.server_principals, not the
-- physical truncated+hashed name.
CREATE LOGIN babel5975_longdb_login WITH PASSWORD = '12345678', DEFAULT_DATABASE = My_Very_Long_Database_Name_That_Exceeds_The_PostgreSQL_NAMEDATALEN_Limit_Of_63;
GO
SELECT default_database_name FROM sys.sql_logins WHERE name = 'babel5975_longdb_login';
GO
SELECT default_database_name FROM sys.server_principals WHERE name = 'babel5975_longdb_login';
GO

-- Create a table and a database user so sp_databases exposes the long-named
-- database.
USE My_Very_Long_Database_Name_That_Exceeds_The_PostgreSQL_NAMEDATALEN_Limit_Of_63;
GO
CREATE TABLE babel5975_dbtbl (id INT);
GO
CREATE USER babel5975_longdb_user FOR LOGIN babel5975_longdb_login;
GO
USE master;
GO

-- sp_databases must list the long-named database using its original name
EXEC sp_databases;
GO

-- The shared helper resolves the physical (truncated) key back to the original
-- name; this is the same mapping used by sp_helplogins/sp_helpuser DefDBName and
-- sp_helplogins DBName (those procs also return SID/UserID columns whose values
-- are OID-derived and therefore not asserted deterministically here).
SELECT sys.bbf_get_original_db_name(default_database_name) AS DefDBName
FROM sys.babelfish_authid_login_ext WHERE rolname = 'babel5975_longdb_login';
GO

DROP LOGIN babel5975_longdb_login;
GO

DROP DATABASE My_Very_Long_Database_Name_That_Exceeds_The_PostgreSQL_NAMEDATALEN_Limit_Of_63;
GO

-- ===========================================
-- sp_renamedb must preserve the original (case/length) name in orig_name,
-- DB_NAME() and sys.databases.name (previously overwritten with the physical
-- truncated+hashed name)
-- ===========================================
CREATE DATABASE My_Very_Long_Database_Name_That_Exceeds_The_PostgreSQL_NAMEDATALEN_Limit_Of_63;
GO

EXEC sp_renamedb 'My_Very_Long_Database_Name_That_Exceeds_The_PostgreSQL_NAMEDATALEN_Limit_Of_63',
                 'Renamed_Very_Long_Database_Name_That_Exceeds_The_PostgreSQL_NAMEDATALEN_Limit_63';
GO

-- orig_name should be the case-preserved renamed name
SELECT orig_name FROM sys.babelfish_sysdatabases WHERE orig_name LIKE 'Renamed%';
GO

-- sys.databases.name should be the case-preserved renamed name
SELECT name FROM sys.databases WHERE name LIKE 'Renamed%';
GO

-- DB_NAME() inside the renamed database should be case-preserved
USE Renamed_Very_Long_Database_Name_That_Exceeds_The_PostgreSQL_NAMEDATALEN_Limit_63;
GO
SELECT DB_NAME();
GO
USE master;
GO

DROP DATABASE Renamed_Very_Long_Database_Name_That_Exceeds_The_PostgreSQL_NAMEDATALEN_Limit_63;
GO

-- ===========================================
-- Short, all-lowercase database name: physical name == original, so
-- orig_name is left NULL and views fall back to the physical name;
-- sp_helpdb must still display it
-- ===========================================
CREATE DATABASE babel5975_shortdb;
GO
SELECT name FROM sys.databases WHERE name = 'babel5975_shortdb';
GO
SELECT name, compatibility_level FROM sys.babelfish_helpdb('babel5975_shortdb');
GO
DROP DATABASE babel5975_shortdb;
GO
