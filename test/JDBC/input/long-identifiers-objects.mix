-- (g) nested block comment containing commas / special chars before a LONG
-- alias: the commas inside the (nested) comment must not be treated as column
-- separators, and skip_collist_separators must not crash or misalign.
CREATE VIEW babel5975_cv_nestcomma (/* a, /* b,c */ d,e */ This_Is_A_Long_Nested_Comma_Comment_Alias_Exceeds_Sixty_Three, c2, c3) AS SELECT id, a, b FROM babel5975_cv_base;
GO
SELECT name FROM sys.columns WHERE object_id = OBJECT_ID('babel5975_cv_nestcomma') ORDER BY column_id;
GO
DROP VIEW babel5975_cv_nestcomma;
GO

-- (h) special characters and comment markers INSIDE a bracketed long alias are
-- literal identifier content (handled by extract_identifier, not the separator
-- scanner) - must be stored verbatim.
CREATE VIEW babel5975_cv_specialbr ([Long_Alias_With_Special_!@#$,;()_/*notcomment*/_Exceeds_Sixty_Three], c2, c3) AS SELECT id, a, b FROM babel5975_cv_base;
GO
SELECT name FROM sys.columns WHERE object_id = OBJECT_ID('babel5975_cv_specialbr') ORDER BY column_id;
GO
DROP VIEW babel5975_cv_specialbr;
GO

DROP TABLE babel5975_cv_base;
GO


