-- ===========================================
-- SELECT STATEMENTS: TDS column name display
-- ===========================================

-- SELECT with long column reference - verify via sp_describe_first_result_set_internal
SELECT name FROM sys.sp_describe_first_result_set_internal(N'SELECT Very_Long_Column_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_Col1 FROM babel5975_col_test', NULL, 0);
GO

-- SELECT * from table with long columns - verify column names in metadata
SELECT name FROM sys.sp_describe_first_result_set_internal(N'SELECT * FROM babel5975_col_test', NULL, 0) ORDER BY name;
GO

-- SELECT with subquery - nested resolution
SELECT name FROM sys.sp_describe_first_result_set_internal(N'SELECT * FROM (SELECT Very_Long_Column_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_Col1 FROM babel5975_col_test) sub1', NULL, 0);
GO

-- SELECT with bracket-delimited long alias
SELECT name FROM sys.sp_describe_first_result_set_internal(N'SELECT 1 AS [Very Long Bracket Alias Name That Exceeds PostgreSQL Limit Of Sixty Three Characters]', NULL, 0);
GO

