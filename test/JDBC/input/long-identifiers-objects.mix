-- Long Identifier Tests: Tables, Views, Columns, Indexes (reloptions storage)
-- Tests storage of original names in pg_class.reloptions and pg_attribute.attoptions

-- tsql
-- ===========================================
-- CREATION: Objects using reloptions/attoptions
-- ===========================================

-- 1. CREATE TABLE with long name
CREATE TABLE Very_Long_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing (id INT NOT NULL, name NVARCHAR(100));
GO

-- 2. CREATE TABLE with long column names
CREATE TABLE babel5975_col_test (
    Very_Long_Column_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_Col1 INT,
    Very_Long_Column_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_Col2 NVARCHAR(50)
);
GO

-- 3. CREATE VIEW with long name
CREATE VIEW Very_Long_View_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing
AS SELECT id, name FROM Very_Long_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing;
GO

-- 4. CREATE INDEX with long name
CREATE INDEX Very_Long_Index_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing
ON Very_Long_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing (id);
GO

-- 5. SELECT INTO with long table name
SELECT 1 AS col1 INTO Very_Long_Select_Into_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars;
GO

-- 6. ALTER TABLE ADD COLUMN with long name
ALTER TABLE babel5975_col_test ADD Very_Long_Added_Column_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters INT;
GO

-- ===========================================
-- VERIFICATION: System views show original names
-- ===========================================

-- Verify table name in sys.tables
SELECT name FROM sys.tables WHERE name LIKE 'Very_Long_Table_Name%';
GO

-- Verify view name in sys.views
SELECT name FROM sys.views WHERE name LIKE 'Very_Long_View_Name%';
GO

-- Verify index name in sys.indexes
SELECT name FROM sys.indexes WHERE name LIKE 'Very_Long_Index_Name%';
GO

-- Verify column names in sys.columns
SELECT name FROM sys.columns WHERE object_id = OBJECT_ID('babel5975_col_test') AND name LIKE 'Very_Long%' ORDER BY name;
GO

-- Verify SELECT INTO table name
SELECT name FROM sys.tables WHERE name LIKE 'Very_Long_Select_Into%';
GO

-- Verify sp_tables works with long table names
EXEC sp_tables @table_name = 'Very_Long_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing';
GO

-- Verify sp_columns works with long table names
EXEC sp_columns @table_name = 'Very_Long_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing';
GO

-- ===========================================
-- VERIFICATION: Check reloptions storage
-- ===========================================

-- psql
-- Verify table original name in pg_class.reloptions
SELECT opt FROM (SELECT unnest(reloptions) AS opt FROM pg_class WHERE relname LIKE 'very_long_table_name%' AND reloptions::text LIKE '%bbf_original_rel_name%') t WHERE opt LIKE 'bbf_original_rel_name%';
GO

-- psql
-- Verify view original name in pg_class.reloptions
SELECT opt FROM (SELECT unnest(reloptions) AS opt FROM pg_class WHERE relname LIKE 'very_long_view_name%' AND reloptions::text LIKE '%bbf_original_rel_name%') t WHERE opt LIKE 'bbf_original_rel_name%';
GO

-- psql
-- Verify index original name in pg_class.reloptions
SELECT opt FROM (SELECT unnest(reloptions) AS opt FROM pg_class WHERE relname LIKE 'very_long_index_name%' AND reloptions::text LIKE '%bbf_original_rel_name%') t WHERE opt LIKE 'bbf_original_rel_name%';
GO

-- ===========================================

-- ===========================================
-- ALIAS AND SELECT: Long column aliases
-- ===========================================
-- tsql

-- SELECT with long alias - verify full name in result metadata
SELECT name FROM sys.sp_describe_first_result_set_internal(N'SELECT 1 AS Very_Long_Alias_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_For_Testing', NULL, 0);
GO

-- ORDER BY with long alias
SELECT 1 AS Very_Long_Alias_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_For_Testing
ORDER BY Very_Long_Alias_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_For_Testing;
GO

-- View with long column alias
CREATE VIEW babel5975_view_alias AS
SELECT 1 AS Very_Long_View_Alias_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_For_Testing;
GO
SELECT name FROM sys.columns WHERE object_id = OBJECT_ID('babel5975_view_alias');
GO
DROP VIEW babel5975_view_alias;
GO

-- SP_RENAME: Tables and columns
-- ===========================================

-- tsql
-- Drop index before table rename (index internal name uses original table hash)
DROP INDEX Very_Long_Index_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing ON Very_Long_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing;
GO



-- Create tables with PK and FK for sp_special_columns and sp_fkeys testing
CREATE TABLE Very_Long_PK_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_Testing (
    id INT PRIMARY KEY,
    val NVARCHAR(50)
);
GO
CREATE TABLE Very_Long_FK_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_Testing (
    id INT,
    fk_id INT REFERENCES Very_Long_PK_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_Testing(id)
);
GO
-- ===========================================
-- VERIFY ALL MODIFIED SYSTEM VIEWS
-- ===========================================

-- sys.all_views
SELECT name FROM sys.all_views WHERE name LIKE 'Very_Long_View_Name%';
GO

-- sys.all_objects (table)
SELECT name FROM sys.all_objects WHERE name LIKE 'Very_Long_Table_Name%' AND type = 'U';
GO

-- sys.all_objects (view)
SELECT name FROM sys.all_objects WHERE name LIKE 'Very_Long_View_Name%' AND type = 'V';
GO

-- sys.all_columns
SELECT name FROM sys.all_columns WHERE object_id = OBJECT_ID('babel5975_col_test') AND name LIKE 'Very_Long%' ORDER BY name;
GO

-- sp_statistics
EXEC sp_statistics @table_name = 'Very_Long_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing';
GO

-- sp_fkeys
EXEC sp_fkeys @pktable_name = 'Very_Long_PK_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_Testing';
GO

-- sp_special_columns
EXEC sp_special_columns @table_name = 'Very_Long_PK_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_Testing';
GO

-- information_schema.views
SELECT TABLE_NAME FROM information_schema.views WHERE TABLE_NAME LIKE 'Very_Long_View_Name%';
GO

-- information_schema.columns
SELECT COLUMN_NAME FROM information_schema.columns WHERE TABLE_NAME = 'babel5975_col_test' AND COLUMN_NAME LIKE 'Very_Long%' ORDER BY COLUMN_NAME;
GO

-- sys.all_sql_modules (view definition lookup)
SELECT CASE WHEN definition IS NOT NULL THEN 'HAS_DEFINITION' ELSE 'NO_DEFINITION' END FROM sys.all_sql_modules WHERE object_id = OBJECT_ID('Very_Long_View_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing');
GO

-- sp_rename TABLE with long name
EXEC sp_rename 'Very_Long_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars_For_Testing',
    'Very_Long_Renamed_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters', 'OBJECT';
GO

-- Verify renamed table shows new full name in sys.tables
SELECT name FROM sys.tables WHERE name LIKE 'Very_Long_Renamed_Table%';
GO

-- sp_rename COLUMN with long name
EXEC sp_rename 'Very_Long_Renamed_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters.name',
    'Very_Long_Renamed_Column_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters', 'COLUMN';
GO

-- Verify renamed column shows new full name in sys.columns
SELECT name FROM sys.columns WHERE object_id = OBJECT_ID('Very_Long_Renamed_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters') AND name LIKE 'Very_Long_Renamed_Column%';
GO

-- ===========================================

-- ===========================================
-- SELECT INTO: Column name preservation
-- ===========================================

-- SELECT INTO preserves long column names
SELECT Very_Long_Column_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_Col1 INTO babel5975_select_into_col_test FROM babel5975_col_test;
GO
SELECT name FROM sys.columns WHERE object_id = OBJECT_ID('babel5975_select_into_col_test') AND name LIKE 'Very_Long_Column%';
GO
DROP TABLE IF EXISTS babel5975_select_into_col_test;
GO

-- ===========================================
-- BRACKET DELIMITERS: Tables, views, indexes
-- ===========================================

-- Bracket table with long name
CREATE TABLE [Very Long Table Name With Spaces That Exceeds PostgreSQL Limit Of Sixty Three Characters] (
    [Very Long Column Name With Spaces That Exceeds PostgreSQL Limit Of Sixty Three Characters] INT
);
GO

-- Bracket view with long name
CREATE VIEW [Very Long View Name With Spaces That Exceeds PostgreSQL Limit Of Sixty Three Characters]
AS SELECT [Very Long Column Name With Spaces That Exceeds PostgreSQL Limit Of Sixty Three Characters] FROM [Very Long Table Name With Spaces That Exceeds PostgreSQL Limit Of Sixty Three Characters];
GO

-- Bracket index with long name
CREATE INDEX [Very Long Index Name With Spaces That Exceeds PostgreSQL Limit Of Sixty Three Characters]
ON [Very Long Table Name With Spaces That Exceeds PostgreSQL Limit Of Sixty Three Characters] ([Very Long Column Name With Spaces That Exceeds PostgreSQL Limit Of Sixty Three Characters]);
GO

-- Bracket alias
SELECT 1 AS [Very Long Alias Name With Spaces That Exceeds PostgreSQL Limit Of Sixty Three Characters];
GO

-- Verify bracket table/view names
SELECT name FROM sys.tables WHERE name LIKE 'Very Long Table%';
GO
SELECT name FROM sys.views WHERE name LIKE 'Very Long View%';
GO

-- Cleanup bracket objects
DROP VIEW [Very Long View Name With Spaces That Exceeds PostgreSQL Limit Of Sixty Three Characters];
GO
DROP INDEX [Very Long Index Name With Spaces That Exceeds PostgreSQL Limit Of Sixty Three Characters] ON [Very Long Table Name With Spaces That Exceeds PostgreSQL Limit Of Sixty Three Characters];
GO
DROP TABLE [Very Long Table Name With Spaces That Exceeds PostgreSQL Limit Of Sixty Three Characters];
GO

-- ===========================================
-- DOUBLE-QUOTE DELIMITERS
-- ===========================================

SET QUOTED_IDENTIFIER ON;
GO
CREATE TABLE "Very_Long_Quoted_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_Test" (id INT);
GO
SELECT name FROM sys.tables WHERE name LIKE 'Very_Long_Quoted_Table%';
GO
DROP TABLE "Very_Long_Quoted_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_Test";
GO

-- ===========================================
-- CREATE OR ALTER VIEW: Long name preservation
-- ===========================================

CREATE OR ALTER VIEW Very_Long_CreateOrAlter_View_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars
AS SELECT 1 AS id;
GO
SELECT name FROM sys.views WHERE name LIKE 'Very_Long_CreateOrAlter%';
GO
DROP VIEW Very_Long_CreateOrAlter_View_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars;
GO

-- ===========================================
-- VIEW COLUMN DISPLAY TESTS
-- ===========================================

-- View with long alias shows full name
CREATE VIEW babel5975_view_long_col AS
SELECT 1 AS Very_Long_View_Column_Alias_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters;
GO
SELECT name FROM sys.columns WHERE object_id = OBJECT_ID('babel5975_view_long_col');
GO

-- CREATE OR ALTER VIEW preserves long alias
CREATE OR ALTER VIEW babel5975_view_long_col AS
SELECT 2 AS Very_Long_View_Column_Alias_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters;
GO
SELECT name FROM sys.columns WHERE object_id = OBJECT_ID('babel5975_view_long_col');
GO
DROP VIEW babel5975_view_long_col;
GO

-- View selecting long column from table
CREATE VIEW babel5975_view_from_tbl AS
SELECT Very_Long_Column_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_Col1 FROM babel5975_col_test;
GO
SELECT name FROM sys.columns WHERE object_id = OBJECT_ID('babel5975_view_from_tbl');
GO
DROP VIEW babel5975_view_from_tbl;
GO

-- ===========================================
-- MULTIPLE LONG ALIASES IN ONE SELECT
-- ===========================================

SELECT name FROM sys.sp_describe_first_result_set_internal(
    N'SELECT 1 AS Very_Long_First_Alias_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_Here, 2 AS Very_Long_Second_Alias_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_Here',
    NULL, 0);
GO

-- ===========================================
-- MIXED CASE TABLE: Case preservation
-- ===========================================

CREATE TABLE MixedCase_Very_Long_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_ABC (id INT);
GO
SELECT name FROM sys.tables WHERE name LIKE 'MixedCase_Very_Long%';
GO
-- Case-insensitive lookup should work
SELECT name FROM sys.tables WHERE name = 'mixedcase_very_long_table_name_that_exceeds_postgresql_limit_of_sixty_three_characters_abc';
GO
DROP TABLE MixedCase_Very_Long_Table_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_ABC;
GO

-- tsql
-- VIEW and SELECT INTO with long column names
-- ===========================================

-- Setup: table with multiple long columns
CREATE TABLE babel5975_multi_col (
    Very_Long_Column_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_AAA INT,
    Very_Long_Column_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters_BBB NVARCHAR(50)
);
GO

-- View with SELECT * from table with long columns
CREATE VIEW babel5975_view_star AS SELECT * FROM babel5975_multi_col;
GO
SELECT name FROM sys.columns WHERE object_id = OBJECT_ID('babel5975_view_star') ORDER BY column_id;
GO

-- View with explicit long alias
CREATE VIEW babel5975_view_explicit_alias AS SELECT 1 AS Very_Long_Explicit_Alias_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Chars;
GO
SELECT name FROM sys.columns WHERE object_id = OBJECT_ID('babel5975_view_explicit_alias');
GO

-- View with mixed: alias + * from table
CREATE VIEW babel5975_view_mixed AS SELECT 1 AS Very_Long_Mixed_View_Alias_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters, * FROM babel5975_multi_col;
GO
SELECT name FROM sys.columns WHERE object_id = OBJECT_ID('babel5975_view_mixed') ORDER BY column_id;
GO

-- SELECT INTO with * from table with long columns
SELECT * INTO babel5975_select_into_star FROM babel5975_multi_col;
GO
SELECT name FROM sys.columns WHERE object_id = OBJECT_ID('babel5975_select_into_star') ORDER BY column_id;
GO

-- SELECT INTO with mixed: alias + *
SELECT 1 AS Very_Long_SelectInto_Alias_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters, * INTO babel5975_select_into_mixed FROM babel5975_multi_col;
GO
SELECT name FROM sys.columns WHERE object_id = OBJECT_ID('babel5975_select_into_mixed') ORDER BY column_id;
GO

-- View with long table alias (bracket-delimited)
CREATE VIEW babel5975_view_long_alias AS SELECT * FROM babel5975_multi_col AS [Very_Long_Table_Alias_Name_That_Exceeds_PostgreSQL_Limit_Of_Sixty_Three_Characters];
GO
SELECT name FROM sys.columns WHERE object_id = OBJECT_ID('babel5975_view_long_alias') ORDER BY column_id;
GO

-- Cleanup view/select into tests
DROP VIEW babel5975_view_star;
GO
DROP VIEW babel5975_view_explicit_alias;
GO
DROP VIEW babel5975_view_mixed;
GO
DROP VIEW babel5975_view_long_alias;
GO
DROP TABLE babel5975_select_into_star;
GO
DROP TABLE babel5975_select_into_mixed;
GO
DROP TABLE babel5975_multi_col;
GO


