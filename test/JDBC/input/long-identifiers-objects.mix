-- ===========================================
-- BABEL-4557: long index name in a WITH (INDEX (...)) hint must not crash
-- the backend (previously caused a stack buffer overflow in
-- construct_unique_index_name). The hint index name here is 114 bytes and
-- contains special characters.
-- ===========================================

-- Table exists: the query should run and return rows (no crash).
CREATE TABLE babel4557_hint_tab (
    HandheldDeviceName varchar(50),
    ContainerTypeAssociationId int,
    RowVersion int,
    Updated bit
);
GO
CREATE INDEX [IX_ContainerTypeAssociationTransmissionLog(HandheldDeviceName,ContainerTypeAssociationId,RowVersion)_WHERE_UPDATED] ON babel4557_hint_tab (HandheldDeviceName, ContainerTypeAssociationId, RowVersion);
GO
INSERT INTO babel4557_hint_tab VALUES ('dev1', 100, 1, 1);
GO
SELECT * FROM babel4557_hint_tab WITH (INDEX ([IX_ContainerTypeAssociationTransmissionLog(HandheldDeviceName,ContainerTypeAssociationId,RowVersion)_WHERE_UPDATED]));
GO

-- Table does not exist: should raise a clean "does not exist" error, not crash.
SELECT * FROM babel4557_missing_tab WITH (INDEX ([IX_ContainerTypeAssociationTransmissionLog(HandheldDeviceName,ContainerTypeAssociationId,RowVersion)_WHERE_UPDATED]));
GO

DROP TABLE babel4557_hint_tab;
GO


-- ===========================================
-- BABEL-5052: after renaming a table with sp_rename, its indexes must remain
-- usable (DROP/ALTER) and sys.indexes must still show the original index name.
-- The physical index name embeds the table name, so the rename re-mangles
-- every dependent index to encode the new table name.
-- ===========================================
CREATE TABLE babel5052_tab (a int, b int, c int);
GO
CREATE INDEX babel5052_idx ON babel5052_tab (a);
GO
CREATE UNIQUE INDEX babel5052_uq_idx ON babel5052_tab (b);
GO
CREATE INDEX [IX_babel5052_A_Very_Long_Index_Name_Exceeding_Sixty_Three_Characters_For_Test] ON babel5052_tab (c);
GO
EXEC sp_rename 'babel5052_tab', 'babel5052_renamed', 'OBJECT';
GO
-- sys.indexes must show the ORIGINAL index names on the renamed table
SELECT name FROM sys.indexes WHERE object_id = OBJECT_ID('babel5052_renamed') AND name IS NOT NULL ORDER BY name;
GO
-- uniqueness must still be enforced after the rename
INSERT INTO babel5052_renamed (a, b, c) VALUES (1, 1, 1);
GO
INSERT INTO babel5052_renamed (a, b, c) VALUES (2, 1, 2);
GO
-- DROP INDEX by original name on the renamed table must succeed (the bug)
DROP INDEX babel5052_idx ON babel5052_renamed;
GO
DROP INDEX babel5052_uq_idx ON babel5052_renamed;
GO
DROP INDEX [IX_babel5052_A_Very_Long_Index_Name_Exceeding_Sixty_Three_Characters_For_Test] ON babel5052_renamed;
GO
SELECT COUNT(*) AS remaining_indexes FROM sys.indexes WHERE object_id = OBJECT_ID('babel5052_renamed') AND name IS NOT NULL;
GO
DROP TABLE babel5052_renamed;
GO

