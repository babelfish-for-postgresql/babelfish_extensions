-- ===========================================
-- VERIFY ATTOPTIONS STORAGE
-- ===========================================

-- psql
-- Verify column original names in pg_attribute.attoptions
SELECT unnest(attoptions) FROM pg_attribute WHERE attrelid = (SELECT oid FROM pg_class WHERE relname LIKE 'babel5975_col_test%' AND relnamespace = (SELECT oid FROM pg_namespace WHERE nspname = 'master_dbo')) AND attoptions IS NOT NULL;
GO


-- ===========================================
-- BLOCK ALTER: Prevent modification of bbf_original_rel_name/bbf_original_name
-- ===========================================

-- psql
-- Verify modification of bbf_original_rel_name is blocked
ALTER TABLE master_dbo.very_long_table_name_that_excee93167071de365a0cba68700e242774dd SET (bbf_original_rel_name='hacked');
GO

-- Verify modification of bbf_original_name (column) is blocked
ALTER TABLE master_dbo.babel5975_col_test ALTER COLUMN very_long_column_name_that_excee78cb009a0e5eb4aba1c0243be4884f78 SET (bbf_original_name='hacked');
GO

-- Verify RESET of bbf_original_rel_name (relation-level) is blocked
ALTER TABLE master_dbo.very_long_table_name_that_excee93167071de365a0cba68700e242774dd RESET (bbf_original_rel_name);
GO

-- Verify RESET of bbf_original_name (column-level) is blocked
ALTER TABLE master_dbo.babel5975_col_test ALTER COLUMN very_long_column_name_that_excee78cb009a0e5eb4aba1c0243be4884f78 RESET (bbf_original_name);
GO

-- The block must not be bypassable by enabling enable_create_alter_view_from_pg.
-- Re-run all four operations with the GUC turned on; each must still error.
SET babelfishpg_tsql.enable_create_alter_view_from_pg = true;
GO

-- Verify SET of bbf_original_rel_name is still blocked with GUC enabled
ALTER TABLE master_dbo.very_long_table_name_that_excee93167071de365a0cba68700e242774dd SET (bbf_original_rel_name='hacked');
GO

-- Verify RESET of bbf_original_rel_name is still blocked with GUC enabled
ALTER TABLE master_dbo.very_long_table_name_that_excee93167071de365a0cba68700e242774dd RESET (bbf_original_rel_name);
GO

-- Verify SET of bbf_original_name (column-level) is still blocked with GUC enabled
ALTER TABLE master_dbo.babel5975_col_test ALTER COLUMN very_long_column_name_that_excee78cb009a0e5eb4aba1c0243be4884f78 SET (bbf_original_name='hacked');
GO

-- Verify RESET of bbf_original_name (column-level) is still blocked with GUC enabled
ALTER TABLE master_dbo.babel5975_col_test ALTER COLUMN very_long_column_name_that_excee78cb009a0e5eb4aba1c0243be4884f78 RESET (bbf_original_name);
GO

SET babelfishpg_tsql.enable_create_alter_view_from_pg = false;
GO

-- ===========================================
-- BABEL-5975: the bbf_original_rel_name / bbf_original_name options are
-- reserved for Babelfish and may not be set from the PG endpoint on any
-- object (CREATE or ALTER path), matched case-insensitively.
-- ===========================================

-- psql
-- CREATE with the reserved option is blocked
CREATE TABLE bbf5975_reserved_ct (i int) WITH (bbf_original_rel_name = 'x');
GO

-- CREATE INDEX with the reserved option is blocked
CREATE TABLE bbf5975_reserved_ixbase (i int);
GO
CREATE INDEX bbf5975_reserved_ix ON bbf5975_reserved_ixbase(i) WITH (bbf_original_rel_name = 'x');
GO

-- CREATE INDEX with the internal tsql_original_name_location option is rejected.
-- This option is appended only by the grammar (with an internal marker,
-- DefElem location = -1) to carry the source-text offset of a long index name.
-- A user cannot inject it: on the T-SQL endpoint the grammar does not preserve
-- a user-supplied duplicate, and on the PG endpoint (below) it is rejected as
-- an unrecognized reloption. The C guard in extract_index_original_name also
-- rejects any user-supplied entry (location >= 0) as defense-in-depth.
CREATE INDEX bbf5975_reserved_ixloc ON bbf5975_reserved_ixbase(i) WITH (tsql_original_name_location = 5);
GO

-- A non-Integer user-supplied value must also be rejected (not silently
-- stripped or reinterpreted as a pointer offset).
CREATE INDEX bbf5975_reserved_ixloc_str ON bbf5975_reserved_ixbase(i) WITH (tsql_original_name_location = 'foo');
GO

-- CREATE TABLE AS with the reserved option is blocked
CREATE TABLE bbf5975_reserved_cta WITH (bbf_original_rel_name = 'x') AS SELECT 1 AS c;
GO

-- ALTER with the reserved option is blocked
ALTER TABLE bbf5975_reserved_ixbase SET (bbf_original_rel_name = 'x');
GO

-- A quoted, upper-cased option name must also be blocked (case-insensitive match)
ALTER TABLE bbf5975_reserved_ixbase SET ("BBF_ORIGINAL_REL_NAME" = 'x');
GO

-- A legitimate reloption must still succeed (no false positive)
ALTER TABLE bbf5975_reserved_ixbase SET (fillfactor = 90);
GO

DROP TABLE bbf5975_reserved_ixbase;
GO

-- ===========================================
-- BABEL-5975: the bbf_original_rel_name / bbf_original_name options are
-- reserved for Babelfish and may not be set by a user from the T-SQL endpoint
-- either. Babelfish sets them internally via CREATE-time subcommands, so a
-- normal long-name CREATE still succeeds, but a user-issued
-- ALTER TABLE ... SET (...) naming either reserved option must be rejected.
-- This also closes the path that would otherwise let an over-long value reach
-- the single-byte TDS column-metadata name-length field.
-- ===========================================

-- tsql
-- ALTER TABLE SET of the reserved relation option is blocked from T-SQL
CREATE TABLE bbf5975_tsql_reserved (i int);
GO
ALTER TABLE bbf5975_tsql_reserved SET (bbf_original_rel_name = 'hacked');
GO

-- An over-long value (would overflow the TDS uint8 name length) is also blocked
ALTER TABLE bbf5975_tsql_reserved SET (bbf_original_rel_name = 'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA');
GO

-- The reserved column attoption is likewise blocked from T-SQL
ALTER TABLE bbf5975_tsql_reserved SET (bbf_original_name = 'hacked');
GO

-- The reserved bbf_rel_create_date reloption (feeds sys.objects.create_date)
-- is also blocked from T-SQL so a user cannot spoof an object's create date.
ALTER TABLE bbf5975_tsql_reserved SET (bbf_rel_create_date = '2000-01-01');
GO

-- A legitimate reloption from T-SQL must still succeed (no false positive)
ALTER TABLE bbf5975_tsql_reserved SET (fillfactor = 90);
GO

-- A normal long-name CREATE (Babelfish stores bbf_original_rel_name internally
-- via a CREATE-time subcommand) must still succeed and store the original name.
CREATE TABLE bbf5975_tsql_LongNameThatExceedsThePostgreSQLNameDataLenLimitOfSixtyThreeBytesHere (i int);
GO
SELECT name FROM sys.tables WHERE name = 'bbf5975_tsql_LongNameThatExceedsThePostgreSQLNameDataLenLimitOfSixtyThreeBytesHere';
GO

DROP TABLE bbf5975_tsql_LongNameThatExceedsThePostgreSQLNameDataLenLimitOfSixtyThreeBytesHere;
GO
DROP TABLE bbf5975_tsql_reserved;
GO

-- tsql

-- TDS display of long column names in different SELECT forms
-- Verified via sp_describe_first_result_set_internal which returns column names
-- ===========================================
CREATE TABLE babel5975_select_display ([This_Is_A_Very_Long_Column_Name_That_Exceeds_The_Sixty_Three_Characters_PostgreSQL_Limit_For_Testing_Purpose] int);
GO
INSERT INTO babel5975_select_display VALUES (1);
GO

-- SELECT * : full name via resorigname from attoptions
SELECT name FROM sys.sp_describe_first_result_set_internal(N'SELECT * FROM babel5975_select_display', NULL, 0);
GO

-- SELECT col (single-part column ref): full name via attoption lookup
SELECT name FROM sys.sp_describe_first_result_set_internal(N'SELECT This_Is_A_Very_Long_Column_Name_That_Exceeds_The_Sixty_Three_Characters_PostgreSQL_Limit_For_Testing_Purpose FROM babel5975_select_display', NULL, 0);
GO

-- SELECT t.col (multi-part column ref): full name via attoption lookup
SELECT name FROM sys.sp_describe_first_result_set_internal(N'SELECT t.This_Is_A_Very_Long_Column_Name_That_Exceeds_The_Sixty_Three_Characters_PostgreSQL_Limit_For_Testing_Purpose FROM babel5975_select_display t', NULL, 0);
GO

-- SELECT expr AS long_alias: full name via source text extraction
SELECT name FROM sys.sp_describe_first_result_set_internal(N'SELECT 1 AS This_Is_A_Very_Long_Column_Name_That_Exceeds_The_Sixty_Three_Characters_PostgreSQL_Limit_For_Testing_Purpose', NULL, 0);
GO

DROP TABLE babel5975_select_display;
GO


-- Nested subquery: long column names should propagate through nesting
-- ===========================================
CREATE TABLE babel5975_nested_src ([ID] int, [This_Is_A_Very_Long_Column_Name_That_Exceeds_The_Sixty_Three_Characters_PostgreSQL_Limit_For_Testing_Purpose] varchar(50));
GO
INSERT INTO babel5975_nested_src VALUES (1, 'nested_val');
GO

-- Single nesting
SELECT name FROM sys.sp_describe_first_result_set_internal(N'SELECT * FROM (SELECT * FROM babel5975_nested_src) sub', NULL, 0);
GO

-- Double nesting
SELECT name FROM sys.sp_describe_first_result_set_internal(N'SELECT * FROM (SELECT * FROM (SELECT * FROM babel5975_nested_src) s1) s2', NULL, 0);
GO

-- Nested with explicit column ref
SELECT name FROM sys.sp_describe_first_result_set_internal(N'SELECT * FROM (SELECT This_Is_A_Very_Long_Column_Name_That_Exceeds_The_Sixty_Three_Characters_PostgreSQL_Limit_For_Testing_Purpose FROM babel5975_nested_src) sub', NULL, 0);
GO

-- Nested view
CREATE VIEW babel5975_nested_view AS SELECT * FROM (SELECT * FROM babel5975_nested_src) sub;
GO
SELECT name FROM sys.columns WHERE object_id = OBJECT_ID('babel5975_nested_view');
GO

DROP VIEW babel5975_nested_view;
GO

-- ===========================================
-- JOIN / set-operation propagation of long identifiers
-- (Note: sp_describe_first_result_set_internal only supports queries that
--  start with SELECT, so CTE (WITH ...) cases are exercised via views and
--  direct TDS display elsewhere, not here.)
-- ===========================================

-- JOIN with a long column selected explicitly (avoid duplicate-column error)
SELECT name FROM sys.sp_describe_first_result_set_internal(N'SELECT a.This_Is_A_Very_Long_Column_Name_That_Exceeds_The_Sixty_Three_Characters_PostgreSQL_Limit_For_Testing_Purpose, b.ID FROM babel5975_nested_src a JOIN babel5975_nested_src b ON a.ID = b.ID', NULL, 0) ORDER BY column_ordinal;
GO

-- UNION SELECT *
SELECT name FROM sys.sp_describe_first_result_set_internal(N'SELECT * FROM babel5975_nested_src UNION ALL SELECT * FROM babel5975_nested_src', NULL, 0);
GO

-- UNION explicit column
SELECT name FROM sys.sp_describe_first_result_set_internal(N'SELECT This_Is_A_Very_Long_Column_Name_That_Exceeds_The_Sixty_Three_Characters_PostgreSQL_Limit_For_Testing_Purpose FROM babel5975_nested_src UNION SELECT This_Is_A_Very_Long_Column_Name_That_Exceeds_The_Sixty_Three_Characters_PostgreSQL_Limit_For_Testing_Purpose FROM babel5975_nested_src', NULL, 0);
GO

-- EXCEPT
SELECT name FROM sys.sp_describe_first_result_set_internal(N'SELECT This_Is_A_Very_Long_Column_Name_That_Exceeds_The_Sixty_Three_Characters_PostgreSQL_Limit_For_Testing_Purpose FROM babel5975_nested_src EXCEPT SELECT This_Is_A_Very_Long_Column_Name_That_Exceeds_The_Sixty_Three_Characters_PostgreSQL_Limit_For_Testing_Purpose FROM babel5975_nested_src', NULL, 0);
GO

-- CTE long identifier via a view (CTE resolver through view reparse path)
CREATE VIEW babel5975_cte_view AS WITH cte AS (SELECT This_Is_A_Very_Long_Column_Name_That_Exceeds_The_Sixty_Three_Characters_PostgreSQL_Limit_For_Testing_Purpose FROM babel5975_nested_src) SELECT * FROM cte;
GO
SELECT name FROM sys.columns WHERE object_id = OBJECT_ID('babel5975_cte_view');
GO
DROP VIEW babel5975_cte_view;
GO

-- ===========================================
-- CROSS APPLY / OUTER APPLY propagation of long identifiers (BABEL-5975 #3)
-- CROSS APPLY lowers to a LATERAL join; the resolver must follow the join's
-- alias var into the underlying subquery/relation to recover the full name.
-- ===========================================

-- CROSS APPLY selecting a long column of the applied (lateral) subquery
SELECT name FROM sys.sp_describe_first_result_set_internal(N'SELECT ca.This_Is_A_Very_Long_Column_Name_That_Exceeds_The_Sixty_Three_Characters_PostgreSQL_Limit_For_Testing_Purpose FROM babel5975_nested_src d CROSS APPLY (SELECT s.This_Is_A_Very_Long_Column_Name_That_Exceeds_The_Sixty_Three_Characters_PostgreSQL_Limit_For_Testing_Purpose FROM babel5975_nested_src s WHERE s.ID = d.ID) ca', NULL, 0);
GO

-- OUTER APPLY selecting a long column of the applied (lateral) subquery
SELECT name FROM sys.sp_describe_first_result_set_internal(N'SELECT ca.This_Is_A_Very_Long_Column_Name_That_Exceeds_The_Sixty_Three_Characters_PostgreSQL_Limit_For_Testing_Purpose FROM babel5975_nested_src d OUTER APPLY (SELECT s.This_Is_A_Very_Long_Column_Name_That_Exceeds_The_Sixty_Three_Characters_PostgreSQL_Limit_For_Testing_Purpose FROM babel5975_nested_src s WHERE s.ID = d.ID) ca', NULL, 0);
GO

-- CROSS APPLY wrapped in an outer subquery (compound RTE recursion)
SELECT name FROM sys.sp_describe_first_result_set_internal(N'SELECT outer_q.This_Is_A_Very_Long_Column_Name_That_Exceeds_The_Sixty_Three_Characters_PostgreSQL_Limit_For_Testing_Purpose FROM (SELECT ca.This_Is_A_Very_Long_Column_Name_That_Exceeds_The_Sixty_Three_Characters_PostgreSQL_Limit_For_Testing_Purpose FROM babel5975_nested_src d CROSS APPLY (SELECT s.This_Is_A_Very_Long_Column_Name_That_Exceeds_The_Sixty_Three_Characters_PostgreSQL_Limit_For_Testing_Purpose FROM babel5975_nested_src s WHERE s.ID = d.ID) ca) outer_q', NULL, 0);
GO

DROP TABLE babel5975_nested_src;
GO


